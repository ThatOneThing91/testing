local function count(t)
    local n = 0
    for _, value in pairs(t) do
        if value then n += 1 end
    end
    return n
end

local function filterGroup(label, options, target)
    section(label)

    local entries = {}
    local expanded = false
    local heading

    heading = button(label .. " (0 selected)", function()
        expanded = not expanded
        for _, entry in ipairs(entries) do
            entry.Visible = expanded
        end
    end)

    for _, option in ipairs(options) do
        local entry = button("[ ] " .. option, function()
            target[option] = not target[option]
            for _, item in ipairs(entries) do
                if item.option == option then
                    item.button.Text =
                        (target[option] and "[X] " or "[ ] ") .. option
                end
            end
            heading.Text = label .. " (" .. count(target) .. " selected)"
        end)
        entry.Visible = false
        table.insert(entries, {
            button = entry,
            option = option
        })
    end

    -- Keep expansion linked to actual buttons
    heading.MouseButton1Click:Connect(function()
        for _, entry in ipairs(entries) do
            entry.button.Visible = expanded
        end
    end)
end

local function getItemData(entry)
    if type(entry) ~= "table" then return nil end
    return entry.data or entry.Data or entry
end

local function selectedMatch(entry)
    local data = getItemData(entry)
    if not data then return false end

    local rarity = tostring(
        data.Rarity or data.rarity or ""
    )

    local name = tostring(
        data.Name or data.name or
        data.DisplayName or data.ItemName or ""
    ):lower()

    local mutators = data.Mutators or data.mutators or {}

    local match = selected.rarities[rarity] == true
        or selected.names[name] == true

    if type(mutators) == "table" then
        for key, value in pairs(mutators) do
            local mutation = type(key) == "number"
                and tostring(value)
                or tostring(key)

            if selected.mutators[mutation] and value ~= false then
                match = true
            end
        end
    end

    local total = count(selected.rarities)
        + count(selected.mutators)
        + count(selected.names)

    if total == 0 then
        return mode == "Exclude Selected"
    end

    if mode == "Grade Selected" then
        return match
    end

    return not match
end

local function getEligibleItems()
    local ok, response = invoke("GetGradableItems")
    if not ok or type(response) ~= "table" then
        return {}
    end

    local items = response.items or response.Items or response
    if type(items) ~= "table" then return {} end

    local result = {}

    for _, entry in pairs(items) do
        if type(entry) == "table" then
            local guid = entry.guid or entry.Guid
            local source = entry.source or entry.Source or "Inventory"

            if guid and selectedMatch(entry) then
                table.insert(result, {
                    guid = tostring(guid),
                    source = source,
                    entry = entry
                })
            end
        end
    end

    return result
end

local function getState()
    local ok, response = invoke("GetSlotState")
    if ok and type(response) == "table"
        and type(response.slots) == "table" then
        return response
    end
    return nil
end

local function slotInfo(state, slot)
    return state.slots[slot] or state.slots[tostring(slot)]
end

local function classify(info)
    if info == nil then return "empty" end
    if type(info) ~= "table" then return "unknown" end

    local state = tostring(
        info.status or info.Status or
        info.state or info.State or ""
    ):lower()

    if state:find("claim") then
        return "claim"
    elseif state:find("collect")
        or state:find("ready")
        or state:find("complete")
        or state:find("finish") then
        return "collect"
    elseif state:find("grading")
        or state:find("progress")
        or state:find("active") then
        return "working"
    end

    if info.readyToClaim == true
        or info.ReadyToClaim == true then
        return "claim"
    end

    if info.completed == true
        or info.Completed == true
        or info.isComplete == true then
        return "collect"
    end

    return "unknown"
end

local function canAttempt(cache, key, delay)
    local now = os.clock()
    if cache[key] and now - cache[key] < delay then
        return false
    end
    cache[key] = now
    return true
end

local function startInSlot(slot, used)
    local items = getEligibleItems()

    for _, item in ipairs(items) do
        if not auto or not running then return end

        if not used[item.guid]
            and canAttempt(lastStart, item.guid, 10) then

            used[item.guid] = true

            local ok, response = invoke(
                "StartGrading",
                slot,
                item.guid,
                item.source,
                nil
            )

            if ok and response ~= false then
                report("Slot " .. slot ..
                    ": start requested for " .. item.guid)

                task.wait(0.5)

                local after = getState()
                if after and slotInfo(after, slot) ~= nil then
                    report("Slot " .. slot .. ": grading confirmed")
                else
                    report("Slot " .. slot ..
                        ": start not confirmed")
                end
                return
            end
        end
    end
end

local function processSlots()
    local state = getState()

    if not state then
        status.Text = "Status: Could not read grading slots"
        return
    end

    local unlocked = math.clamp(
        tonumber(state.unlockedCount) or 0, 0, 3
    )

    local used = {}
    local emptyCount = 0
    local activeCount = 0

    for slot = 1, unlocked do
        if not auto or not running then return end

        local info = slotInfo(state, slot)
        local kind = classify(info)

        if kind == "empty" then
            emptyCount += 1
            startInSlot(slot, used)

        elseif kind == "collect" then
            activeCount += 1

            if canAttempt(lastCollect, slot, 5) then
                report("Slot " .. slot .. ": collecting")
                local ok, result = invoke("CollectGrade", slot)

                if ok and result ~= false then
                    task.wait(0.5)

                    if auto and running then
                        report("Slot " .. slot .. ": claiming")
                        invoke("ClaimGradedItem", slot)
                    end
                end
            end

        elseif kind == "claim" then
            activeCount += 1

            if canAttempt(lastClaim, slot, 5) then
                report("Slot " .. slot .. ": claiming")
                invoke("ClaimGradedItem", slot)
            end

        elseif kind == "unknown" then
            activeCount += 1

            if canAttempt(lastUnknown, slot, 15) then
                report("Slot " .. slot ..
                    " has an unrecognized occupied state")
                for key, value in pairs(info) do
                    report(tostring(key) .. " = " .. tostring(value))
                end
            end

        else
            activeCount += 1
        end
    end

    status.Text = string.format(
        "Status: %d unlocked | %d empty | %d occupied",
        unlocked, emptyCount, activeCount
    )
end

