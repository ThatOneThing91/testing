local function normalize(v)
    return tostring(v or ""):lower()
end

local function getItemId(item)
    if type(item) ~= "table" then return nil end
    return tonumber(
        item.ItemId or item.ItemID or item.itemId
        or item.Id or item.ID or item.id
    )
end

local function getItemName(item)
    if type(item) ~= "table" then return nil end
    return item.Name or item.name or item.DisplayName
        or item.displayName or item.ItemName or item.itemName
end

local function excluded(name)
    name = normalize(name)
    for _, word in ipairs({
        "pickaxe", "pickage", "shovel", "hammer",
        "wrench", "sword", "axe", "drill", "basketball"
    }) do
        if name:find(word, 1, true) then return true end
    end
    return false
end

local function fishingName(name)
    name = normalize(name)
    if excluded(name) then return false end
    return name:find("fishing rod", 1, true)
        or name:find("fishingrod", 1, true)
        or name:find("fishing pole", 1, true)
        or name:find("fishingpole", 1, true)
end

local function fishingCategory(v)
    v = normalize(v)
    return v == "fishingrod" or v == "fishing rod"
        or v == "fishing pole" or v == "fishingpole"
end

local function indexDefinitions(data, depth, visited)
    if type(data) ~= "table" or depth > 5 or visited[data] then
        return
    end
    visited[data] = true

    for key, value in pairs(data) do
        if type(value) == "table" then
            local id = getItemId(value) or tonumber(key)
            if id then
                local name = getItemName(value)
                local category = value.Category or value.Type or value.ItemType
                if not excluded(name) and (
                    fishingName(name) or fishingCategory(category)
                ) then
                    itemDefinitions[id] = value
                    knownRods[id] = true
                end
            end
            indexDefinitions(value, depth + 1, visited)
        end
    end
end

pcall(function()
    local modules = RS:FindFirstChild("Modules")
    local items = modules and modules:FindFirstChild("Items")
    if items and items:IsA("ModuleScript") then
        local data = require(items)
        if type(data) == "table" then
            indexDefinitions(data, 0, {})
        end
    end
end)

local function isFishingRod(item, fallbackId)
    if type(item) ~= "table" then return false end

    local id = getItemId(item) or fallbackId
    local name = getItemName(item)
    if excluded(name) then return false end

    if fishingName(name) or fishingCategory(
        item.Category or item.Type or item.ItemType
    ) then
        if id then knownRods[id] = true end
        return true
    end

    local def = id and itemDefinitions[id]
    if type(def) == "table" and not excluded(getItemName(def)) then
        return fishingName(getItemName(def))
            or fishingCategory(def.Category or def.Type or def.ItemType)
    end

    return false
end

local function isBroken(item)
    if type(item) ~= "table" then return false end
    if item.Broken == true or item.IsBroken == true then return true end

    local condition = tonumber(item.Condition or item.Durability)
    if condition and condition <= 0 then return true end
    if normalize(item.Status) == "broken" then return true end

    for key, value in pairs(item.Mutators or {}) do
        if normalize(key) == "broken" and value ~= false then return true end
        if normalize(value) == "broken" then return true end
        if type(value) == "table" then
            if normalize(value.Name or value.name or value.Mutator) == "broken" then
                return true
            end
        end
    end

    return false
end

local function getInventoryData()
    local ok, data = pcall(function()
        return GetInventory:InvokeServer()
    end)
    if not ok or type(data) ~= "table" then return nil end

    local inventory = data.Inventory or data.Items or data
    return type(inventory) == "table" and inventory or nil
end

local function findUsableRods(inventory)
    local rods = {}
    for key, item in pairs(inventory) do
        if type(item) == "table" and isFishingRod(item, getItemId(item))
            and not isBroken(item) then

            local guid = item.Guid or item.GUID or item.UUID or key
            if type(guid) == "string" then
                table.insert(rods, {
                    guid = guid,
                    id = getItemId(item),
                    condition = tonumber(item.Condition) or 0
                })
            end
        end
    end

    table.sort(rods, function(a, b)
        return a.condition > b.condition
    end)

    return rods
end

local function getToolId(tool)
    return tonumber(
        tool:GetAttribute("ItemId")
        or tool:GetAttribute("ItemID")
        or tool:GetAttribute("itemId")
    )
end

local function getToolGuid(tool)
    for _, attribute in ipairs({
        "Guid", "GUID", "UUID", "ItemGuid", "ItemGUID"
    }) do
        local value = tool:GetAttribute(attribute)
        if type(value) == "string" then return value end
    end
    return nil
end

local function getEquippedRod()
    local character = player.Character
    if not character then return nil end

    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            local id = getToolId(tool)
            if isFishingRod({
                ItemId = id,
                Name = tool.Name,
                Category = tool:GetAttribute("Category"),
                Type = tool:GetAttribute("Type")
            }, id) then
                return tool, id
            end
        end
    end
    return nil
end

local function equippedRodUsable(tool, id, inventory)
    if not tool then return false end
    if tool:GetAttribute("Broken") == true
        or tool:GetAttribute("IsBroken") == true then return false end

    local condition = tonumber(
        tool:GetAttribute("Condition")
        or tool:GetAttribute("Durability")
    )
    if condition and condition <= 0 then return false end

    local guid = getToolGuid(tool)
    if guid and inventory[guid] then
        return not isBroken(inventory[guid])
    end

    for _, item in pairs(inventory) do
        if type(item) == "table" and getItemId(item) == id
            and isFishingRod(item, id) and not isBroken(item) then
            return true
        end
    end
    return false
end

