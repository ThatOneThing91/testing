local function releaseMouse()
    if not mouseHeld then return end
    mouseHeld = false
    if type(mouse1release) == "function" then pcall(mouse1release) end
end

local function holdMouse()
    if mouseHeld then return true end
    if type(mouse1press) ~= "function" then return false end
    local ok = pcall(mouse1press)
    if ok then mouseHeld = true end
    return ok
end

local function ensureRod(token)
    local inventory = getInventoryData()
    if not inventory then return false, "Inventory unavailable" end

    local tool, id = getEquippedRod()
    if tool and equippedRodUsable(tool, id, inventory) then
        rodLabel.Text = "Rod: Equipped ItemId " .. tostring(id)
        return true
    end

    local candidates = findUsableRods(inventory)
    if #candidates == 0 then
        return false, "No verified usable fishing rods"
    end

    for _, rod in ipairs(candidates) do
        if destroyed or not running or token ~= generation then
            return false, "Cancelled"
        end

        status("Equipping fishing rod")
        local ok = pcall(function()
            EquipItem:FireServer(rod.guid)
        end)

        if ok then
            local deadline = os.clock() + 2.5
            while os.clock() < deadline do
                if destroyed or not running or token ~= generation then
                    return false, "Cancelled"
                end

                local equipped, equippedId = getEquippedRod()
                if equipped and equippedId == rod.id then
                    local equippedGuid = getToolGuid(equipped)
                    if not equippedGuid or equippedGuid == rod.guid then
                        rodLabel.Text = "Rod: Equipped ItemId " .. tostring(rod.id)
                        return true
                    end
                end
                task.wait(0.1)
            end
        end
    end
    return false, "Unable to equip fishing rod"
end

local function findWater()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = false

    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector

    for _, distance in ipairs(CAST_DISTANCES) do
        for _, offset in ipairs(SIDE_OFFSETS) do
            local point = root.Position + forward * distance + right * offset
            local result = workspace:Raycast(
                point + Vector3.new(0, 35, 0),
                Vector3.new(0, -110, 0),
                params
            )

            if result then
                local name = normalize(result.Instance.Name)
                if result.Material == Enum.Material.Water
                    or name:find("water", 1, true)
                    or name:find("pond", 1, true)
                    or name:find("lake", 1, true)
                    or name:find("river", 1, true) then
                    return result.Instance, result.Position, distance
                end
            end
        end
    end
    return nil
end

local function cancelCast()
    pcall(function() FishingCancel:FireServer() end)
end

local function stopFishing(message, cancel)
    running = false
    generation += 1
    releaseMouse()
    if cancel then cancelCast() end
    activeCastId = nil
    setPhase("idle")
    updateToggle()
    if message then status(message) end
end

--------------------------------------------------
-- EXPERIMENTAL TARGET TRACKING
--------------------------------------------------

local function isVisible(obj)
    if not obj:IsA("GuiObject") then return false end
    if not obj.Visible then return false end

    local parent = obj.Parent
    while parent and parent ~= playerGui do
        if parent:IsA("GuiObject") and not parent.Visible then
            return false
        end
        parent = parent.Parent
    end

    return true
end

local function findTrackingElements()
    local target, indicator
    local bestTargetScore = -1
    local bestIndicatorScore = -1

    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("GuiObject") and isVisible(obj) then
            local path = normalize(obj:GetFullName())
            local name = normalize(obj.Name)

            if not path:find("sh_fishing", 1, true)
                and not path:find("accessoryguide", 1, true)
                and not path:find("boombox", 1, true) then

                local targetScore = 0
                local indicatorScore = 0

                if name:find("target") then targetScore += 5 end
                if name:find("sweet") then targetScore += 5 end
                if name:find("gold") then targetScore += 4 end
                if name:find("zone") then targetScore += 2 end

                if name:find("cursor") then indicatorScore += 5 end
                if name:find("indicator") then indicatorScore += 5 end
                if name:find("needle") then indicatorScore += 4 end
                if name:find("marker") then indicatorScore += 2 end

                if path:find("fishing") or path:find("reel") then
                    targetScore += 2
                    indicatorScore += 2
                end

                if targetScore > bestTargetScore and targetScore >= 5 then
                    target = obj
                    bestTargetScore = targetScore
                end

                if indicatorScore > bestIndicatorScore and indicatorScore >= 5 then
                    indicator = obj
                    bestIndicatorScore = indicatorScore
                end
            end
        end
    end

    return target, indicator
end

local function getCenterX(obj)
    return obj.AbsolutePosition.X + obj.AbsoluteSize.X / 2
end

local function updateReeling()
    if phase ~= "reeling" then
        releaseMouse()
        return
    end

    if type(mouse1press) ~= "function"
        or type(mouse1release) ~= "function" then
        reelLabel.Text = "Reel: Mouse input unavailable"
        return
    end

    local now = os.clock()
    if now < nextReelAction then return end

    if trackingEnabled then
        local target, indicator = findTrackingElements()

        if target and indicator and target ~= indicator then
            local width = math.max(target.AbsoluteSize.X, indicator.AbsoluteSize.X, 1)
            local difference = (getCenterX(target) - getCenterX(indicator)) / width

            trackingLabel.Text = string.format(
                "Tracking: Target delta %.3f", difference
            )

            if math.abs(difference) <= TARGET_TOLERANCE then
                releaseMouse()
                nextReelAction = now + 0.035
            elseif difference > 0 then
                holdMouse()
                nextReelAction = now + 0.045
            else
                releaseMouse()
                nextReelAction = now + 0.045
            end

            return
        end

        trackingLabel.Text = "Tracking: GUI not identified (pulse fallback)"
    else
        trackingLabel.Text = "Tracking: Disabled (pulse mode)"
    end

    if reelHoldNext then
        if holdMouse() then
            reelLabel.Text = "Reel: Holding"
            nextReelAction = now + HOLD_TIME
        else
            reelLabel.Text = "Reel: Press failed"
        end
    else
        releaseMouse()
        reelLabel.Text = "Reel: Releasing"
        nextReelAction = now + RELEASE_TIME
    end

    reelHoldNext = not reelHoldNext
end

table.insert(connections,
    FishingState.OnClientEvent:Connect(function(state, data)
        if destroyed or not running then return end
        data = type(data) == "table" and data or {}

        if state == "cast" then
            if phase ~= "casting" then return end
            activeCastId = data.castId
            setPhase("waiting")
            status("Cast accepted - waiting for bite")

        elseif state == "reel" then
            if phase ~= "waiting" then return end
            if activeCastId ~= nil and data.castId ~= nil
                and activeCastId ~= data.castId then return end

            setPhase("reeling")
            reelHoldNext = true
            nextReelAction = 0
            status("Reeling...")
            reelLabel.Text = "Reel: Tracking test"

        elseif state == "done" then
            if phase ~= "casting" and phase ~= "waiting"
                and phase ~= "reeling" then return end
            if activeCastId ~= nil and data.castId ~= nil
                and activeCastId ~= data.castId then return end

            releaseMouse()

            if data.reason == "caught" then
                catches += 1
                status("Caught: " .. tostring(data.itemName or "Unknown"))
            else
                failures += 1
                status("Fishing ended: " .. tostring(data.reason or "Unknown"))
            end

            updateStats()
            activeCastId = nil
            setPhase("finishing")
            reelLabel.Text = "Reel: Session finished"
        end
    end)
)

task.spawn(function()
    while not destroyed do
        if not running then
            task.wait(0.15)
            continue
        end

        if phase == "idle" then
            local token = generation
            setPhase("equipping")

            local ok, err = ensureRod(token)
            if destroyed or not running or token ~= generation then
                continue
            end

            if not ok then
                stopFishing(err or "Rod unavailable", false)
                continue
            end

            local water, position, distance = findWater()
            if not water then
                status("Face nearby water")
                setPhase("searching")
                continue
            end

            waterLabel.Text = string.format(
                "Water: %s | %d studs", water.Name, distance
            )

            activeCastId = nil
            setPhase("casting")
            status("Casting...")
            casts += 1
            updateStats()

            local sent = pcall(function()
                FishingCast:FireServer(water, position)
            end)

            if not sent then
                failures += 1
                updateStats()
                stopFishing("Cast request failed", true)
            end

        elseif phase == "searching" then
            if os.clock() - phaseTime >= 1 then setPhase("idle") end

        elseif phase == "casting" then
            if os.clock() - phaseTime > CAST_TIMEOUT then
                failures += 1
                updateStats()
                stopFishing("Cast timeout", true)
            end

        elseif phase == "waiting" then
            if os.clock() - phaseTime > BITE_TIMEOUT then
                failures += 1
                updateStats()
                stopFishing("Bite timeout", true)
            end

        elseif phase == "reeling" then
            updateReeling()
            if os.clock() - phaseTime > REEL_TIMEOUT then
                failures += 1
                updateStats()
                stopFishing("Reeling timeout", true)
            end

        elseif phase == "finishing" then
            releaseMouse()
            if os.clock() - phaseTime >= NEXT_CAST_DELAY then
                setPhase("idle")
                status("Starting next cast")
            end
        end

        task.wait(0.06)
    end
end)

