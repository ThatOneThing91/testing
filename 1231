end

connect(cashButton.MouseButton1Click, function()
    task.spawn(collectCash)
end)

connect(buyButton.MouseButton1Click, function()
    autoBuy = not autoBuy
    buyGeneration += 1

    if autoBuy then
        task.spawn(runAutoBuy, buyGeneration)
    end

    refresh()
end)

connect(pizzaButton.MouseButton1Click, function()
    autoPizza = not autoPizza
    pizzaGeneration += 1
    resetPizza()

    if autoPizza then
        task.spawn(runAutoPizza, pizzaGeneration)
    else
        restorePizzaPositions()
    end

    refresh()
end)

connect(crateButton.MouseButton1Click, function()
    autoCrates = not autoCrates
    crateGeneration += 1

    if autoCrates then
        task.spawn(runAutoCrates, crateGeneration)
    end

    refresh()
end)

connect(UIS.InputBegan, function(input, processed)
    if processed or not alive then
        return
    end

    if input.KeyCode == Enum.KeyCode.P then
        task.spawn(collectCash)
    elseif input.KeyCode == Enum.KeyCode.Comma then
        frame.Visible = not frame.Visible
    end
end)

local tycoonFolder = RS:FindFirstChild("Tycoon")
local buttonRemote = tycoonFolder
    and tycoonFolder:FindFirstChild("TycoonButtonEvent")

if buttonRemote then
    connect(buttonRemote.OnClientEvent, function(action, data)
        if type(data) ~= "table" then
            return
        end

        if action ~= "Snapshot" and action ~= "State" then
            return
        end

        local plot, slot = getPlot()

        if plot
            and data.tycoon == plot
            and data.slot == slot
            and type(data.cash) == "number" then
            cachedCash = data.cash
        end
    end)
end

task.spawn(function()
    while alive do
        refresh()
        task.wait(0.2)
    end
end)

-- CLEANUP

_G.CheeseHubCleanup = function()
    alive = false

    autoBuy = false
    autoPizza = false
    autoCrates = false

    buyGeneration += 1
    pizzaGeneration += 1
    crateGeneration += 1

    restorePizzaPositions()
    resetPizza()

    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(connections)

    if gui then
        gui:Destroy()
    end

    _G.CheeseHubCleanup = nil
end

refresh()
