local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local pizzaFolder = RS:WaitForChild("Features"):WaitForChild("PizzaMaking")
local pizzaRemote = pizzaFolder:WaitForChild("Remote")

local configModule = pizzaFolder:FindFirstChild("Config")
local pizzaConfig = {}

if configModule and configModule:IsA("ModuleScript") then
    local ok, result = pcall(require, configModule)
    if ok and type(result) == "table" then
        pizzaConfig = result
