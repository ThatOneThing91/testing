local alive = true
local autoBuy = false
local autoPizza = false
local autoCrates = false

local buyGeneration = 0
local pizzaGeneration = 0
local crateGeneration = 0

local connections = {}
local teleportBusy = false
local collectingCash = false
local cachedCash = nil
local centeredFrames = {}

local function connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(connections, c)
    return c
end

local function getRoot()
    local character = player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getPlot()
    local tycoon = player:FindFirstChild("Tycoon")

    if not tycoon or not tycoon:IsA("ObjectValue") then
        return nil, nil
    end

    local slot = tycoon:GetAttribute("Slot")
    if slot ~= 1 and slot ~= 2 then
        return nil, nil
    end

    return tycoon.Value, slot
end

local function getObjects()
    local plot, slot = getPlot()
    local side = plot and plot:FindFirstChild("Player" .. slot)
    return side and side:FindFirstChild("Objects")
end

local function teleportTo(part)
    local root = getRoot()

    if not root or not part or not part:IsA("BasePart") then
        return false
    end

    local humanoid = root.Parent:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.Sit = false
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    root.CFrame = CFrame.new(
        part.Position.X,
        part.Position.Y + part.Size.Y / 2 + 3,
        part.Position.Z
    )

    return true
end

local function restore(root, cf)
    if root and root.Parent and cf then
        root.CFrame = cf
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function firePrompt(prompt)
    if type(fireproximityprompt) ~= "function" then
        return false
    end

    return pcall(function()
        fireproximityprompt(prompt)
    end)
end

-- CASH

local function collectCash()
    if not alive or teleportBusy or collectingCash then
        return
    end

    collectingCash = true
    teleportBusy = true

    local plot, slot = getPlot()
    local side = plot and plot:FindFirstChild("Player" .. slot)
    local essential = side and side:FindFirstChild("Essential")
    local atm = essential and essential:FindFirstChild("ATM")
    local touch = atm and atm:FindFirstChild("Touch")

    local root = getRoot()
    local old = root and root.CFrame

    if touch and touch:IsA("BasePart") and root then
        teleportTo(touch)
        task.wait(0.5)
        restore(root, old)
    end

    teleportBusy = false
    collectingCash = false
end

-- AUTO BUY

local function parseMoney(value)
    if type(value) == "number" then
        return value
    end

    if type(value) ~= "string" then
        return nil
    end

    local clean = value:gsub(",", ""):gsub("%$", "")
    local number, suffix = clean:match("([%d%.]+)%s*([KkMmBbTt]?)")

    number = tonumber(number)

    if not number then
        return nil
    end

    local scales = {
        K = 1e3,
        M = 1e6,
        B = 1e9,
        T = 1e12
    }

    return number * (scales[suffix:upper()] or 1)
end

local function getCash()
    local stats = player:FindFirstChild("leaderstats")

    if stats then
        for _, name in ipairs({"Cash", "Money"}) do
            local obj = stats:FindFirstChild(name)

            if obj and (
                obj:IsA("NumberValue")
                or obj:IsA("IntValue")
            ) then
                return obj.Value
            end
        end
    end

    for _, name in ipairs({"Cash", "Money"}) do
        local value = player:GetAttribute(name)

        if type(value) == "number" then
            return value
        end
    end

    return cachedCash
end

local function getButtonFolder()
    return workspace:FindFirstChild(
        "__TycoonButtons_" .. tostring(player.UserId)
    )
end

local function excludedButton(button)
    local name = button.Name:lower()

    if name:sub(1, 9) == "teammate_" then
        return true
    end

    if button:GetAttribute("IsTeammate") == true
        or button:GetAttribute("CanPurchase") == false then
        return true
    end

    local function excluded(value)
        local s = tostring(value):lower():gsub("[^%w]", "")

        return s:find("2xcash", 1, true)
            or s:find("doublecash", 1, true)
            or s:find("cashmultiplier", 1, true)
            or s:find("2timescash", 1, true)
    end

    if excluded(button.Name) then
        return true
    end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if excluded(obj.Text) then
                return true
            end
        end
    end

    return false
end

local function buttonPrice(button)
    local price = parseMoney(button:GetAttribute("Price"))

    if price then
        return price
    end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local value = parseMoney(obj.Text)

            if value then
                return value
            end
        end
    end

    return nil
end

local function buttonPart(button)
    local base = button:FindFirstChild("Base")

    if base and base:IsA("BasePart") then
        return base
    end

    if button:IsA("BasePart") then
        return button
    end

    return button:FindFirstChildWhichIsA("BasePart", true)
end

local function runAutoBuy(gen)
    local failed = {}
    local lastCash = nil

    while alive and autoBuy and gen == buyGeneration do
        if teleportBusy then
            task.wait(0.15)
            continue
        end

        local cash = getCash()

        if cash ~= lastCash then
            failed = {}
            lastCash = cash
        end

        local folder = getButtonFolder()
        local best
        local bestPrice = math.huge

        if folder and cash then
            for _, button in ipairs(folder:GetChildren()) do
                if not failed[button] and not excludedButton(button) then
                    local price = buttonPrice(button)
                    local part = buttonPart(button)

                    if price and price <= cash
                        and part and price < bestPrice then

                        best = {
                            button = button,
                            part = part
                        }

                        bestPrice = price
                    end
                end
            end
        end

        if not best then
            task.wait(0.5)
            continue
        end

        teleportBusy = true

        local root = getRoot()
        local old = root and root.CFrame

        teleportTo(best.part)

        local deadline = os.clock() + 2
        local purchased = false

        while alive and autoBuy
            and gen == buyGeneration
            and os.clock() < deadline do

            if not best.button.Parent
                or best.button.Parent ~= folder then
                purchased = true
                break
            end

            task.wait(0.05)
        end

        restore(root, old)
        teleportBusy = false

        if not purchased then
            failed[best.button] = true
        end

        task.wait(0.12)
    end
end

-- PIZZA GUI CENTERING
-- Moves one main container, not individual ingredients.

local function restorePizzaPositions()
    for frame, data in pairs(centeredFrames) do
        if frame and frame.Parent then
            pcall(function()
                frame.AnchorPoint = data.anchor
                frame.Position = data.position
            end)
        end

        centeredFrames[frame] = nil
    end
end

local function centerPizzaGui()
    if not alive or not autoPizza then
        return
    end

    local screen = playerGui:FindFirstChild("PizzaMaking")

    if not screen or not screen:IsA("ScreenGui") then
        return
    end

    local candidate
    local largestArea = 0

    -- Prefer top-level containers so child layouts remain intact.
    for _, obj in ipairs(screen:GetChildren()) do
        if obj:IsA("GuiObject")
            and obj.Visible
            and obj.AbsoluteSize.X > 100
            and obj.AbsoluteSize.Y > 100 then

            local area = obj.AbsoluteSize.X * obj.AbsoluteSize.Y

            if area > largestArea then
                candidate = obj
                largestArea = area
            end
        end
    end

    if not candidate then
        return
    end

    if not centeredFrames[candidate] then
        centeredFrames[candidate] = {
            position = candidate.Position,
            anchor = candidate.AnchorPoint
        }
    end

    candidate.AnchorPoint = Vector2.new(0.5, 0.5)
    candidate.Position = UDim2.fromScale(0.5, 0.5)
end

-- PIZZA STATE

local pizza = {
    session = nil,
    roundId = nil,
    phase = nil,
    progress = 0,
    round = 0,
    revision = 0,
    starting = false,
    lastStart = 0,
    remaining = {},
    status = "Idle",
    doughStep = 0,
    lastToppingAt = 0,
    completedAt = 0,
    lastProgressAt = 0,
    paidAt = 0,
    roundAt = 0,
    toppingAttempts = 0
}

local nextPhase = {
    Dough = "Sauce",
    Sauce = "Cheese",
    Cheese = "Toppings"
}

local function resetPizza()
    pizza.session = nil
    pizza.roundId = nil
    pizza.phase = nil
    pizza.progress = 0
    pizza.round = 0
    pizza.revision += 1
    pizza.starting = false
    pizza.lastStart = 0
    pizza.remaining = {}
    pizza.status = "Waiting for station"
    pizza.doughStep = 0
    pizza.lastToppingAt = 0
    pizza.completedAt = 0
    pizza.lastProgressAt = os.clock()
    pizza.paidAt = 0
    pizza.roundAt = 0
    pizza.toppingAttempts = 0
end

local function beginPhase(phase, force)
    if not force and pizza.phase == phase then
        return
    end

    pizza.phase = phase
    pizza.progress = 0
    pizza.revision += 1
    pizza.completedAt = 0
    pizza.lastProgressAt = os.clock()
    pizza.status = phase

    if phase == "Dough" then
        pizza.doughStep = 0
    elseif phase == "Toppings" then
        pizza.toppingAttempts = 0
        pizza.lastToppingAt = 0
    end
end

local function getPizzaStation()
    local objects = getObjects()

    if not objects then
        return nil
    end

    local best
    local bestNumber = -1

    for _, station in ipairs(objects:GetChildren()) do
        local allowed = pizzaConfig.StationNames

        local isStation = (
            type(allowed) == "table"
            and allowed[station.Name]
        ) or station.Name:match("^Pizza Prep Station %d+$")

        if isStation then
            local number = tonumber(
                station.Name:match("(%d+)$")
            ) or 0

            local start = station:FindFirstChild("StartGame", true)
            local prompt = start and start:FindFirstChildWhichIsA(
                "ProximityPrompt",
                true
            )

            if prompt and prompt.Enabled and number > bestNumber then
                best = prompt
                bestNumber = number
            end
        end
    end

    return best
end

local function promptPart(prompt)
    local parent = prompt.Parent

    if parent:IsA("BasePart") then
        return parent
    end

    if parent:IsA("Attachment")
        and parent.Parent:IsA("BasePart") then
        return parent.Parent
    end

    local model = prompt:FindFirstAncestorOfClass("Model")

    if model then
        return model.PrimaryPart
            or model:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function startPizza(gen)
    if pizza.session or pizza.starting or teleportBusy then
        return
    end

    pizza.starting = true
    pizza.lastStart = os.clock()
    pizza.status = "Starting station"

    local prompt = getPizzaStation()

    if prompt then
        local part = promptPart(prompt)

        if part then
            teleportBusy = true
            teleportTo(part)
            task.wait(0.25)
            teleportBusy = false
        end

        if alive and autoPizza and gen == pizzaGeneration then
            firePrompt(prompt)
        end
    end

    pizza.starting = false
end

local function getOrderName()
    local gui = playerGui:FindFirstChild("PizzaMaking")
    local root = gui and gui:FindFirstChild("Root")
    local recipe = root and root:FindFirstChild("Recipe")
    local order = recipe and recipe:FindFirstChild("Order")

    if order and (
        order:IsA("TextLabel")
        or order:IsA("TextButton")
    ) then
        return order.Text
    end

    return nil
end

local function getRecipeToppings()
    local result = {}
    local orderName = getOrderName()

    if not orderName then
        return result
    end

    local normalized = orderName:lower()

    for _, recipe in ipairs(pizzaConfig.Recipes or {}) do
        local recipeName = tostring(recipe.Name):lower()

        if normalized:find(recipeName, 1, true)
            or recipeName:find(normalized, 1, true) then

            for name, count in pairs(recipe.Toppings or {}) do
                result[name] = count
            end

            return result
        end
    end

    return result
end

local function sendPizza(action, point, ingredient)
    if not alive or not autoPizza or not pizza.session then
        return
    end

    -- Use the known session identifier for actions.
    -- The Round event's third argument is recorded
    -- separately rather than assumed to be an action ID.
    pizzaRemote:FireServer(
        pizza.session,
        action,
        point,
        ingredient
    )
end

-- PIZZA SERVER EVENTS

connect(pizzaRemote.OnClientEvent, function(action, session, a, b, c)
    if not alive or not autoPizza then
        return
    end

    if action == "Begin" then
        if type(session) ~= "string" then
            return
        end

        pizza.session = session
        pizza.roundId = nil
        pizza.round = 1
        pizza.starting = false
        pizza.remaining = {}
        pizza.paidAt = 0
        pizza.roundAt = 0

        beginPhase("Dough", true)
        centerPizzaGui()
        return
    end

    if session ~= pizza.session then
        return
    end

    if action == "Round" then
        -- Round always wins over the prior Paid event.
        -- New dough is already supplied by the game.
        pizza.roundId = a
        pizza.round = tonumber(b) or (pizza.round + 1)
        pizza.roundAt = os.clock()
        pizza.paidAt = 0
        pizza.remaining = {}

        beginPhase("Dough", true)
        pizza.status = "Dough - round " .. pizza.round
        centerPizzaGui()
        return
    end

    if action == "Paid" then
        -- Do not overwrite Dough if the Round event
        -- arrived before Paid.
        if pizza.phase == "Toppings"
            or pizza.phase == "Serving" then

            pizza.phase = "Serving"
            pizza.progress = 1
            pizza.paidAt = os.clock()
            pizza.status = "Paid - next pizza"
        end

        return
    end

    if action == "Phase" then
        if type(a) == "string" then
            beginPhase(a)

            if a == "Toppings" then
                pizza.remaining = getRecipeToppings()
            end
        end

    elseif action == "Progress" then
        if type(a) == "string" and type(b) == "number" then
            if pizza.phase ~= a then
                beginPhase(a)
            end

            if b > pizza.progress then
                pizza.lastProgressAt = os.clock()
            end

            pizza.progress = math.clamp(b, 0, 1)

            if pizza.progress >= 1
                and pizza.completedAt == 0 then
                pizza.completedAt = os.clock()
            end
        end

    elseif action == "PourComplete" then
        if a == pizza.phase then
            pizza.progress = 1
            pizza.completedAt = os.clock()
        end

    elseif action == "Topping" then
        if type(a) == "string" and type(c) == "number" then
            pizza.remaining[a] = c
            pizza.lastProgressAt = os.clock()
        end

    elseif action == "End" or action == "Cancel" then
        resetPizza()
    end
end)

-- CONTINUOUS PIZZA LOOP

local function runAutoPizza(gen)
    while alive and autoPizza and gen == pizzaGeneration do
        if not pizza.session then
            if not pizza.starting
                and os.clock() - pizza.lastStart >= 2 then
                startPizza(gen)
            end

            task.wait(0.1)
            continue
        end

        centerPizzaGui()

        local phase = pizza.phase

        -- Progress completion fallback:
        -- advance locally after a short grace period.
        -- A later authoritative server Phase/Progress
        -- event can still correct the phase.
        if nextPhase[phase]
            and pizza.progress >= 1
            and pizza.completedAt > 0
            and os.clock() - pizza.completedAt >= 0.12 then

            local target = nextPhase[phase]
            beginPhase(target)

            if target == "Toppings" then
                pizza.remaining = getRecipeToppings()
            end

            phase = target
        end

        if phase == "Dough" then
            if pizza.progress < 1 then
                pizza.doughStep += 1

                local angle = pizza.doughStep * 0.28
                local radius = 0.24

                sendPizza(
                    "Knead",
                    Vector2.new(
                        math.cos(angle) * radius,
                        math.sin(angle) * radius
                    ),
                    nil
                )
            end

            -- Faster but consistent kneading.
            task.wait(0.055)

        elseif phase == "Sauce" then
            if pizza.progress < 1 then
                sendPizza(
                    "Pour",
                    Vector2.new(-0.08625, -0.2192),
                    nil
                )
            end

            task.wait(0.035)

        elseif phase == "Cheese" then
            if pizza.progress < 1 then
                sendPizza(
                    "Pour",
                    Vector2.new(-0.08625, -0.2192),
                    nil
                )
            end

            task.wait(0.055)

        elseif phase == "Toppings" then
            local chosen

            for _, name in ipairs({
                "Pepperoni",
                "Mushroom",
                "Olive"
            }) do
                local count = pizza.remaining[name]

                if count and count > 0 then
                    chosen = name
                    break
                end
            end

            if chosen and os.clock() - pizza.lastToppingAt >= 0.12 then
                sendPizza(
                    "Topping",
                    Vector2.new(0.2, 0.17),
                    chosen
                )

                pizza.lastToppingAt = os.clock()
                pizza.toppingAttempts += 1
            end

            -- The server's Topping/Paid events determine
            -- whether toppings are complete.
            task.wait(0.04)

        elseif phase == "Serving" then
            -- Do not restart the station.
            -- Wait for the game's next Round event.
            task.wait(0.06)

        else
            task.wait(0.06)
        end
    end
end

-- CRATES

local function getCrates()
    local crates = {}

    for _, crate in ipairs(workspace:GetChildren()) do
        if crate.Name == "Crate" then
            local main = crate:FindFirstChild("Main")
            local prompt = main and main:FindFirstChild("Prompt")

            if main and main:IsA("BasePart")
                and prompt
                and prompt:IsA("ProximityPrompt")
                and prompt.Enabled then

                table.insert(crates, {
                    crate = crate,
                    main = main,
                    prompt = prompt
                })
            end
        end
    end

    return crates
end

local function crateCollected(entry)
    if not entry.crate.Parent then
        return true
    end

    if not entry.main.Parent
        or not entry.main:IsDescendantOf(entry.crate) then
        return true
    end

    if not entry.prompt.Parent
        or not entry.prompt:IsDescendantOf(entry.crate) then
        return true
    end

    if not entry.prompt.Enabled then
        return true
    end

    return false
end

local function collectCrate(entry, gen)
    if teleportBusy then
        return
    end

    local root = getRoot()

    if not root then
        return
    end

    teleportBusy = true
    local old = root.CFrame

    while alive and autoCrates and gen == crateGeneration do
        if crateCollected(entry) then
            break
        end

        if not teleportTo(entry.main) then
            break
        end

        task.wait(0.25)

        if not alive or not autoCrates
            or gen ~= crateGeneration then
            break
        end

        firePrompt(entry.prompt)

        local deadline = os.clock() + 1.5

        while alive and autoCrates
            and gen == crateGeneration
            and os.clock() < deadline do

            if crateCollected(entry) then
                break
            end

            task.wait(0.1)
        end

        if crateCollected(entry) then
            break
        end

        task.wait(0.35)
    end

    restore(root, old)
    teleportBusy = false
end

local function runAutoCrates(gen)
    while alive and autoCrates and gen == crateGeneration do
        if teleportBusy then
            task.wait(0.15)
            continue
        end

        for _, entry in ipairs(getCrates()) do
            if not alive or not autoCrates
                or gen ~= crateGeneration then
                break
            end

            if not crateCollected(entry) then
                collectCrate(entry, gen)
            end
        end

        task.wait(0.5)
    end
end

