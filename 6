-- CHARACTER / EQUIPPED TOOL
--------------------------------------------------

local function getCharacter()
    local character = player.Character

    if not character then
        return nil, nil
    end

    local root = character:FindFirstChild(
        "HumanoidRootPart"
    )

    return character, root
end

local function getToolId(tool)
    if not tool then return nil end

    return tonumber(
        tool:GetAttribute("ItemId")
        or tool:GetAttribute("ItemID")
        or tool:GetAttribute("itemId")
    )
end

local function getEquippedRod()
    local character = player.Character

    if not character then
        return nil
    end

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            local id = getToolId(child)

            if id and knownRodIds[id] then
                return child, id
            end
        end
    end

    return nil
end

--------------------------------------------------
-- INVENTORY
--------------------------------------------------

local function isBroken(item)
    if item.Broken == true or item.IsBroken == true then
        return true
    end

    if tonumber(item.Condition) == 0 then
        return true
    end

    local mutators = item.Mutators or {}

    for key, value in pairs(mutators) do
        if tostring(key):lower() == "broken"
            and value ~= false then
            return true
        end

        if tostring(value):lower() == "broken" then
            return true
        end

        if type(value) == "table" then
            local name = value.Name
                or value.name
                or value.Mutator

            if tostring(name):lower() == "broken" then
                return true
            end
        end
    end

    return false
end

local function getInventory()
    if not Events.Inventory then
        return nil
    end

    local ok, data = pcall(function()
        return Events.Inventory:InvokeServer()
    end)

    if not ok or type(data) ~= "table" then
        return nil
    end

    return data.Inventory
        or data.Items
        or data
end

local function findUsableRod()
    local inventory = getInventory()

    if not inventory then
        return nil, "Inventory unavailable"
    end

    local rods = {}

    for guid, item in pairs(inventory) do
        if type(item) == "table" then
            local id = tonumber(item.ItemId)

            if id
                and knownRodIds[id]
                and not isBroken(item) then

                local actualGuid = item.Guid
                    or item.UUID
                    or guid

                if type(actualGuid) == "string"
                    and not failedRods[actualGuid] then

                    table.insert(rods, {
                        guid = actualGuid,
                        id = id,
                        condition = tonumber(
                            item.Condition
                        ) or 0
                    })
                end
            end
        end
    end

    table.sort(rods, function(a, b)
        return a.condition > b.condition
    end)

    return rods[1], "No usable rods"
end

--------------------------------------------------
-- ROD EQUIPPING
--------------------------------------------------

local function ensureRodEquipped(token)
    local equipped, id = getEquippedRod()

    if equipped then
        rodLabel.Text =
            "Rod: Already equipped (ItemId " .. id .. ")"

        return true
    end

    local rod, err = findUsableRod()

    if not rod then
        return false, err
    end

    if token ~= generation or not running then
        return false, "Cancelled"
    end

    setStatus("Equipping rod " .. rod.id)

    local ok = pcall(function()
        Events.Equip:FireServer(rod.guid)
    end)

    if not ok then
        return false, "Equip failed"
    end

    activeRodGuid = rod.guid

    local deadline = os.clock() + 3

    while os.clock() < deadline do
        if destroyed
            or not running
            or token ~= generation then
            return false, "Cancelled"
        end

        local tool, toolId = getEquippedRod()

        if tool then
            rodLabel.Text =
                "Rod: Equipped ItemId " .. toolId

            return true
        end

        task.wait(0.1)
    end

    failedRods[rod.guid] = true

    return false, "Rod equip not confirmed"
end

--------------------------------------------------
-- DYNAMIC WATER DETECTION
--------------------------------------------------

local function isWater(result)
    if not result then return false end

    if result.Material == Enum.Material.Water then
        return true
    end

    local instance = result.Instance

    if not instance then return false end

    local name = instance.Name:lower()

    if name:find("water")
        or name:find("pond")
        or name:find("lake")
        or name:find("river") then
        return true
    end

    return false
end

local function findNearbyWater()
    local character, root = getCharacter()

    if not root then
        return nil
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = false

    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector

    local distances = {
        8, 12, 18, 25, 35, 45, WATER_DISTANCE
    }

    local offsets = {
        0, -5, 5, -10, 10
    }

    for _, distance in ipairs(distances) do
        for _, offset in ipairs(offsets) do
            local point = root.Position
                + forward * distance
                + right * offset

            local origin =
                point + Vector3.new(0, 35, 0)

            local direction =
                Vector3.new(0, -90, 0)

            local result = workspace:Raycast(
                origin,
                direction,
                params
            )

            if isWater(result) then
                return result.Instance, result.Position
            end
        end
    end

    return nil
end

--------------------------------------------------
-- SESSION MANAGEMENT
--------------------------------------------------

local function cancelCast()
    if Events.Cancel then
        pcall(function()
            Events.Cancel:FireServer()
        end)
    end
end

local function stopFishing(cancel)
    running = false
    generation += 1

    if cancel then
        cancelCast()
    end

    activeCastId = nil
    activeRodGuid = nil
    reelGuiObserved = false

    setPhase("idle")
    updateToggle()
end

--------------------------------------------------
-- REEL GUI DETECTION
--------------------------------------------------

local function isReelGuiVisible()
    -- Look for visible GUI objects associated with reeling.
    -- This is a conservative heuristic, not a confirmed GUI path.

    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("GuiObject") then
            local name = obj.Name:lower()

            if name:find("reel")
                or name:find("fishing") then

                if obj.Visible then
                    return true
                end
            end
        end
    end

    return false
end

--------------------------------------------------
-- FISHING EVENTS
--------------------------------------------------

if Events.State
    and Events.State:IsA("RemoteEvent") then

    table.insert(connections,
        Events.State.OnClientEvent:Connect(
            function(state, data)
                if destroyed or not running then
                    return
                end

                data = type(data) == "table"
                    and data or {}

                if state == "cast" then
                    if phase ~= "casting" then
                        return
                    end

                    activeCastId = data.castId
                    setPhase("waiting")

                    setStatus(
                        "Cast accepted - waiting for bite"
                    )

                elseif state == "reel" then
                    if phase ~= "waiting" then
                        return
                    end

                    if activeCastId ~= nil
                        and data.castId ~= nil
                        and data.castId ~= activeCastId then
                        return
                    end

                    setPhase("reeling")
                    reelGuiObserved = false

                    setStatus(
                        "Reeling - use normal minigame"
                    )

                elseif state == "done" then
                    if phase ~= "reeling"
                        and phase ~= "waiting"
                        and phase ~= "casting" then
                        return
                    end

                    if activeCastId ~= nil
                        and data.castId ~= nil
                        and data.castId ~= activeCastId then
                        return
                    end

                    if data.reason == "caught" then
                        catches += 1

                        setStatus(
                            "Caught: "
                            .. tostring(
                                data.itemName or "Unknown"
                            )
                        )
                    else
                        failures += 1

                        setStatus(
                            "Fishing ended: "
                            .. tostring(
                                data.reason or "Unknown"
                            )
                        )
                    end

                    updateStats()

                    activeCastId = nil
                    lastDoneAt = os.clock()

                    setPhase("finishing")
                end
            end
        )
    )
end

--------------------------------------------------
-- MAIN WORKER
--------------------------------------------------

task.spawn(function()
    while not destroyed do
        if not running then
            task.wait(0.15)
            continue
        end

        if phase == "idle" then
            local token = generation

            setPhase("equipping")

            local equipped, err =
                ensureRodEquipped(token)

            if destroyed
                or not running
                or token ~= generation then

                continue
            end

            if not equipped then
                stopFishing(false)
                setStatus(err or "No usable rod")
                continue
            end

            local water, position =
                findNearbyWater()

            if not water then
                waterLabel.Text =
                    "Water: Move closer and face water"

                setStatus("Searching for nearby water")
                setPhase("searching")

                continue
            end

            waterLabel.Text =
                "Water: " .. water.Name

            activeCastId = nil
            reelGuiObserved = false

            setPhase("casting")
            setStatus("Casting...")

            casts += 1
            updateStats()

            local ok = pcall(function()
                Events.Cast:FireServer(
                    water,
                    position
                )
            end)

            if not ok then
                failures += 1
                updateStats()

                stopFishing(true)
                setStatus("Cast request failed")
            end

        elseif phase == "searching" then
            if os.clock() - phaseStarted >= 1 then
                setPhase("idle")
            end

        elseif phase == "casting" then
            if os.clock() - phaseStarted > CAST_TIMEOUT then
                failures += 1
                updateStats()

                stopFishing(true)
                setStatus("Cast timeout")
            end

        elseif phase == "waiting" then
            if os.clock() - phaseStarted > BITE_TIMEOUT then
                failures += 1
                updateStats()

                stopFishing(true)
                setStatus("Bite timeout")
            end

        elseif phase == "reeling" then
            if isReelGuiVisible() then
                reelGuiObserved = true
            end

            if os.clock() - phaseStarted > REEL_TIMEOUT then
                failures += 1
                updateStats()

                stopFishing(true)
                setStatus("Reeling timeout")
            end

        elseif phase == "finishing" then
            local elapsed = os.clock() - lastDoneAt

            local guiStillOpen =
                reelGuiObserved
                and isReelGuiVisible()

            if elapsed >= FINISH_COOLDOWN
                and not guiStillOpen then

                setPhase("idle")
                setStatus("Ready for next cast")
            end

        end

        task.wait(0.1)
    end
end)

