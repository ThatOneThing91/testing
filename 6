
-- TYCOON HUB
-- Collect Cash / Auto Buy / Auto Make Pizzas
-- P = Collect Cash
-- Comma = Hide / Show Menu

if _G.CheeseHubCleanup then
    pcall(_G.CheeseHubCleanup)
end

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local pizzaRemote = RS:WaitForChild("Features")
    :WaitForChild("PizzaMaking")
    :WaitForChild("Remote")

local alive = true
local autoBuy = false
local autoPizza = false
local collecting = false

local buyGeneration = 0
local pizzaGeneration = 0
local connections = {}
local currentCash = nil

local activeSession = nil
local pizzaProgress = {}
local lastPizzaEnd = 0

local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

local function getRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getPlot()
    local tycoon = player:FindFirstChild("Tycoon")
    if not tycoon or not tycoon:IsA("ObjectValue") then
        return nil
    end

    local slot = tycoon:GetAttribute("Slot")
    if slot ~= 1 and slot ~= 2 then
        return nil
    end

    return tycoon.Value, slot
end

local function getMyObjects()
    local plot, slot = getPlot()
    if not plot then return nil end

    local side = plot:FindFirstChild("Player" .. slot)
    return side and side:FindFirstChild("Objects")
end

local function teleportAbove(part)
    local root = getRoot()

    if not root or not part or not part:IsA("BasePart") then
        return false
    end

    local hum = root.Parent:FindFirstChildOfClass("Humanoid")

    if hum then
        hum.Sit = false
        hum.PlatformStand = false
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    root.CFrame = CFrame.new(
        part.Position.X,
        part.Position.Y + part.Size.Y / 2 + 3,
        part.Position.Z
    )

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    return true
end

-- CASH COLLECTION

local function getATM()
    local plot, slot = getPlot()
    if not plot then return nil end

    local side = plot:FindFirstChild("Player" .. slot)
    local essential = side and side:FindFirstChild("Essential")
    local atm = essential and essential:FindFirstChild("ATM")
    local touch = atm and atm:FindFirstChild("Touch")

    if touch and touch:IsA("BasePart") then
        return touch
    end

    return nil
end

local function collectCash()
    if collecting or not alive then return end

    collecting = true

    local root = getRoot()
    local atm = getATM()

    if root and atm then
        local original = root.CFrame

        if teleportAbove(atm) then
            task.wait(0.5)

            if alive and root.Parent then
                root.CFrame = original
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end

    collecting = false
end

-- AUTO BUY

local function parseMoney(value)
    if type(value) == "number" then
        return value
    end

    if type(value) ~= "string" then
        return nil
    end

    local s = value:gsub(",", ""):gsub("%$", "")
    local number, suffix = s:match("([%d%.]+)%s*([KkMmBbTt]?)")

    number = tonumber(number)
    if not number then return nil end

    local multipliers = {
        K = 1000,
        M = 1000000,
        B = 1000000000,
        T = 1000000000000
    }

    return number * (multipliers[suffix:upper()] or 1)
end

local function getCash()
    if currentCash ~= nil then
        return currentCash
    end

    local stats = player:FindFirstChild("leaderstats")

    if stats then
        for _, name in ipairs({"Cash", "Money"}) do
            local value = stats:FindFirstChild(name)

            if value and (
                value:IsA("NumberValue")
                or value:IsA("IntValue")
            ) then
                return value.Value
            end
        end
    end

    for _, name in ipairs({"Cash", "Money"}) do
        local value = player:GetAttribute(name)

        if type(value) == "number" then
            return value
        end
    end

    return nil
end

local function getMyButtons()
    return workspace:FindFirstChild(
        "__TycoonButtons_" .. tostring(player.UserId)
    )
end

local function isExcludedButton(button)
    local name = button.Name:lower()

    -- Do not purchase the other owner's buttons.
    if name:sub(1, 9) == "teammate_" then
        return true
    end

    if button:GetAttribute("IsTeammate") == true then
        return true
    end

    if button:GetAttribute("CanPurchase") == false then
        return true
    end

    local function excluded(text)
        text = tostring(text):lower():gsub("[^%w]", "")

        return text:find("2xcash", 1, true)
            or text:find("doublecash", 1, true)
            or text:find("cashmultiplier", 1, true)
            or text:find("2timescash", 1, true)
    end

    if excluded(button.Name) then
        return true
    end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if excluded(obj.Text) then
                return true
            end
        end
    end

    return false
end

local function getButtonPrice(button)
    local price = parseMoney(button:GetAttribute("Price"))

    if price then
        return price
    end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local value = parseMoney(obj.Text)

            if value then
                return value
            end
        end
    end

    return nil
end

local function getButtonPart(button)
    local base = button:FindFirstChild("Base")

    if base and base:IsA("BasePart") then
        return base
    end

    if button:IsA("BasePart") then
        return button
    end

    return button:FindFirstChildWhichIsA("BasePart", true)
end

local function getAffordableButtons(failed)
    local folder = getMyButtons()
    local cash = getCash()
    local candidates = {}

    if not folder or cash == nil then
        return candidates
    end

    for _, button in ipairs(folder:GetChildren()) do
        if not failed[button] and not isExcludedButton(button) then
            local price = getButtonPrice(button)
            local part = getButtonPart(button)

            if price and price <= cash and part then
                table.insert(candidates, {
                    button = button,
                    part = part,
                    price = price
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.price < b.price
    end)

    return candidates
end

local function runAutoBuy(generation)
    local root = getRoot()
    local original = root and root.CFrame
    local failed = {}

    while alive and autoBuy and generation == buyGeneration do
        local candidates = getAffordableButtons(failed)
        local choice = candidates[1]

        if not choice then
            break
        end

        local folder = getMyButtons()
        local button = choice.button

        if not folder or button.Parent ~= folder
            or isExcludedButton(button) then

            failed[button] = true
            task.wait(0.1)
            continue
        end

        teleportAbove(choice.part)

        local startTime = os.clock()
        local disappeared = false

        while alive and autoBuy
            and generation == buyGeneration
            and os.clock() - startTime < 2 do

            if not button.Parent or button.Parent ~= folder then
                disappeared = true
                break
            end

            task.wait(0.05)
        end

        if not disappeared then
            failed[button] = true
        end

        task.wait(0.12)
    end

    if generation == buyGeneration then
        autoBuy = false

        local currentRoot = getRoot()

        if original and currentRoot then
            currentRoot.CFrame = original
            currentRoot.AssemblyLinearVelocity = Vector3.zero
            currentRoot.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

-- PIZZA STATION DISCOVERY

local function getBestPizzaStation()
    local objects = getMyObjects()
    if not objects then return nil end

    local bestPrompt = nil
    local bestNumber = -1

    for _, station in ipairs(objects:GetChildren()) do
        local number = tonumber(
            station.Name:match("^Pizza Prep Station (%d+)$")
        )

        if number then
            local startGame = station:FindFirstChild("StartGame", true)

            local prompt = startGame
                and startGame:FindFirstChildWhichIsA(
                    "ProximityPrompt",
                    true
                )

            if prompt and prompt.Enabled and number > bestNumber then
                bestNumber = number
                bestPrompt = prompt
            end
        end
    end

    return bestPrompt, bestNumber
end

local function getPromptPart(prompt)
    local parent = prompt.Parent

    if parent and parent:IsA("BasePart") then
        return parent
    end

    if parent and parent:IsA("Attachment")
        and parent.Parent
        and parent.Parent:IsA("BasePart") then

        return parent.Parent
    end

    local station = prompt:FindFirstAncestorOfClass("Model")

    if station then
        return station.PrimaryPart
            or station:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function startPizza()
    local prompt = getBestPizzaStation()

    if not prompt or not prompt.Enabled then
        return false
    end

    local part = getPromptPart(prompt)

    if part then
        teleportAbove(part)
        task.wait(0.2)
    end

    if not alive or not autoPizza then
        return false
    end

    if type(fireproximityprompt) == "function" then
        return pcall(function()
            fireproximityprompt(prompt)
        end)
    end

    return false
end

-- PIZZA SESSION TRACKING

local function clearPizzaSession()
    activeSession = nil
    pizzaProgress = {}
    lastPizzaEnd = os.clock()
end

connect(pizzaRemote.OnClientEvent, function(action, session, a, b)
    if action == "Begin" then
        local objects = getMyObjects()

        if objects and typeof(a) == "Instance"
            and a:IsDescendantOf(objects) then

            activeSession = session
            pizzaProgress = {}
        end

    elseif session == activeSession then
        if action == "Progress" then
            pizzaProgress[a] = b

        elseif action == "PourComplete" then
            pizzaProgress[a] = 1

        elseif action == "Done"
            or action == "Complete"
            or action == "End"
            or action == "Finished" then

            clearPizzaSession()
        end
    end
end)

local function getPizzaGui()
    local playerGui = player:FindFirstChild("PlayerGui")
    if not playerGui then return nil, nil end

    for _, gui in ipairs(playerGui:GetDescendants()) do
        if gui:IsA("ScreenGui") then
            local phase = gui:GetAttribute("Phase")

            if phase == "Dough"
                or phase == "Sauce"
                or phase == "Cheese"
                or phase == "Toppings"
                or phase == "Serving" then

                return gui, phase
            end
        end
    end

    return nil, nil
end

local function sendPizzaAction(session, action, position, ingredient)
    if not alive or not autoPizza then return end
    if session ~= activeSession then return end

    pizzaRemote:FireServer(
        session,
        action,
        position,
        ingredient
    )
end

local toppingNames = {
    "Pepperoni",
    "Mushroom",
    "Pineapple",
    "Olive",
    "Onion",
    "Pepper",
    "Sausage",
    "Bacon",
    "Ham",
    "Tomato"
}

local function getNeededToppings(gui)
    local counts = {}

    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local text = obj.Text
            local count = tonumber(
                text:match("(%d+)%s+left")
            )

            if count and count > 0 then
                local lower = text:lower()

                for _, topping in ipairs(toppingNames) do
                    if lower:find(topping:lower(), 1, true) then
                        counts[topping] = math.max(
                            counts[topping] or 0,
                            count
                        )
                    end
                end
            end
        end
    end

    return counts
end

-- CONTINUOUS AUTO PIZZA

local function runAutoPizza(generation)
    local lastPhase = nil
    local circleStep = 0
    local toppingStep = 0
    local lastToppingAt = 0
    local lastStartAttempt = 0

    local sawActiveGui = false
    local missingGuiSince = nil

    while alive and autoPizza
        and generation == pizzaGeneration do

        local gui, phase = getPizzaGui()

        -- Detect the previous pizza finishing.
        if activeSession then
            if gui then
                sawActiveGui = true
                missingGuiSince = nil
            elseif sawActiveGui then
                if not missingGuiSince then
                    missingGuiSince = os.clock()
                end

                if os.clock() - missingGuiSince >= 0.6 then
                    clearPizzaSession()
                    sawActiveGui = false
                    missingGuiSince = nil
                    lastPhase = nil
                end
            end
        else
            sawActiveGui = false
            missingGuiSince = nil
        end

        -- Automatically start another pizza.
        if not activeSession and not gui then
            if os.clock() - lastStartAttempt >= 2
                and os.clock() - lastPizzaEnd >= 0.6 then

                lastStartAttempt = os.clock()
                startPizza()
            end

            task.wait(0.15)
            continue
        end

        if not activeSession or not gui then
            task.wait(0.15)
            continue
        end

        local session = activeSession

        if phase ~= lastPhase then
            lastPhase = phase
            circleStep = 0
            toppingStep = 0
        end

        if phase == "Dough" then
            circleStep += 1

            local angle = circleStep * 0.48
            local radius = 0.22

            sendPizzaAction(
                session,
                "Knead",
                Vector2.new(
                    math.cos(angle) * radius,
                    math.sin(angle) * radius
                ),
                nil
            )

            task.wait(0.09)

        elseif phase == "Sauce" or phase == "Cheese" then
            sendPizzaAction(
                session,
                "Pour",
                Vector2.new(0, 0),
                nil
            )

            task.wait(0.1)

        elseif phase == "Toppings" then
            local counts = getNeededToppings(gui)
            local selected = nil

            for _, topping in ipairs(toppingNames) do
                if (counts[topping] or 0) > 0 then
                    selected = topping
                    break
                end
            end

            if selected
                and os.clock() - lastToppingAt >= 0.25 then

                toppingStep += 1

                local angle = toppingStep * 2.39996
                local radius = 0.2 * math.sqrt(
                    (toppingStep % 9 + 1) / 9
                )

                sendPizzaAction(
                    session,
                    "Topping",
                    Vector2.new(
                        math.cos(angle) * radius,
                        math.sin(angle) * radius
                    ),
                    selected
                )

                lastToppingAt = os.clock()
            end

            task.wait(0.12)

        elseif phase == "Serving" then
            task.wait(0.15)

        else
            task.wait(0.15)
        end
    end
end

