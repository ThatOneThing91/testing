
-- Cheese Tycoon Hub
-- Collect Cash [P] + Auto Buy
-- UserId-based folder detection

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

if _G.CheeseHubCleanup then
    pcall(_G.CheeseHubCleanup)
end

local alive = true
local buying = false
local collecting = false
local runId = 0
local savedPosition
local connections = {}
local latestCash

local function connect(signal, callback)
    local c = signal:Connect(callback)
    table.insert(connections, c)
    return c
end

local function getRoot()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function parseMoney(value)
    if typeof(value) == "number" then
        return value
    end

    if typeof(value) ~= "string" then
        return nil
    end

    local cleaned = value:gsub(",", ""):gsub("%$", "")
    local number, suffix = cleaned:match(
        "^%s*([%d%.]+)%s*([KkMmBbTt]?)%s*$"
    )

    number = tonumber(number)
    if not number then return nil end

    local multipliers = {
        K = 1000,
        M = 1000000,
        B = 1000000000,
        T = 1000000000000
    }

    return number * (multipliers[suffix:upper()] or 1)
end

-- Correct dynamic folder detection
local function getMyButtonsFolder()
    local folderName = "__TycoonButtons_" .. tostring(player.UserId)
    return workspace:FindFirstChild(folderName)
end

local function findATM()
    local tycoons = workspace:FindFirstChild("Tycoons")
    local cheese = tycoons and tycoons:FindFirstChild("Cheese Tycoon")
    local base = cheese and cheese:FindFirstChild("Player2")
    local essential = base and base:FindFirstChild("Essential")
    local atm = essential and essential:FindFirstChild("ATM")

    return atm and atm:FindFirstChild("Touch")
end

