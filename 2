local collectButton = makeButton(
    "Collect Cash [P]",
    12,
    Color3.fromRGB(45, 150, 75)
)

local buyButton = makeButton(
    "Auto Buy: OFF",
    66,
    Color3.fromRGB(160, 45, 45)
)

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -12, 0, 30)
status.Position = UDim2.fromOffset(6, 119)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.fromRGB(210, 210, 210)
status.Font = Enum.Font.Gotham
status.TextSize = 11
status.TextWrapped = true
status.Text = "Ready"
status.Parent = frame

local function setStatus(message)
    if alive then
        status.Text = message
    end
end

local function updateToggle()
    buyButton.Text = buying and "Auto Buy: ON" or "Auto Buy: OFF"

    buyButton.BackgroundColor3 = buying
        and Color3.fromRGB(45, 150, 75)
        or Color3.fromRGB(160, 45, 45)
end

-- Collect Cash
local function collectCash()
    if not alive or collecting or buying then return end

    collecting = true
    collectButton.Text = "Collecting..."

    local root = getRoot()
    local atm = findATM()

    if root and atm and atm:IsA("BasePart") then
        local oldPosition = root.CFrame

        root.CFrame = atm.CFrame *
            CFrame.new(0, atm.Size.Y / 2 + 2.5, 0)

        task.wait(0.5)

        if alive and root.Parent then
            root.CFrame = oldPosition
        end

        setStatus("Cash collection attempted")
    else
        setStatus("ATM not found")
    end

    if alive then
        collectButton.Text = "Collect Cash [P]"
    end

    collecting = false
end

-- Cash detection
local function getCash()
    local stats = player:FindFirstChild("leaderstats")

    if stats then
        for _, name in ipairs({"Cash", "Money", "Coins"}) do
            local value = stats:FindFirstChild(name)

            if value and (
                value:IsA("IntValue") or
                value:IsA("NumberValue")
            ) then
                return value.Value
            end
        end
    end

    for _, name in ipairs({"Cash", "Money", "Coins"}) do
        local value = player:GetAttribute(name)

        if typeof(value) == "number" then
            return value
        end
    end

    if latestCash ~= nil then
        return latestCash
    end

    local playerGui = player:FindFirstChild("PlayerGui")

    if playerGui then
        for _, obj in ipairs(playerGui:GetDescendants()) do
            if obj:IsA("TextLabel") then
                local name = obj.Name:lower()

                if name == "cash" or
                    name == "cashlabel" or
                    name == "money" or
                    name == "moneylabel" then

                    local amount = parseMoney(obj.Text)
                    if amount then return amount end
                end
            end
        end
    end

    return nil
end

-- Ignore 2x Cash and similar buttons
local function normalize(value)
    return tostring(value):lower():gsub("[^%w]", "")
end

local function isExcluded(button)
    local function matches(text)
        local s = normalize(text)

        return s:find("2xcash", 1, true)
            or s:find("doublecash", 1, true)
            or s:find("cashmultiplier", 1, true)
            or s:find("2timescash", 1, true)
    end

    if matches(button.Name) then
        return true
    end

    for _, obj in ipairs(button:GetDescendants()) do
        if matches(obj.Name) then
            return true
        end

        if obj:IsA("TextLabel") or
            obj:IsA("TextButton") then
            if matches(obj.Text) then
                return true
            end
        end
    end

    return false
end

-- Price detection
local function getPrice(button)
    local priceNames = {
        "Price", "Cost", "Cash",
        "Amount", "PurchasePrice", "ButtonPrice"
    }

    for _, name in ipairs(priceNames) do
        local value = parseMoney(button:GetAttribute(name))

        if value then return value end

        local child = button:FindFirstChild(name, true)

        if child and (
            child:IsA("NumberValue") or
            child:IsA("IntValue") or
            child:IsA("StringValue")
        ) then
            value = parseMoney(child.Value)
            if value then return value end
        end
    end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") or
            obj:IsA("TextButton") then

            local money = obj.Text:match(
                "%$[%d%.,]+[KkMmBbTt]?"
            )

            if money then
                return parseMoney(money)
            end
        end
    end

    return nil
end

-- Locate touch pad
local function getTouchPart(obj)
    if obj:IsA("BasePart") then
        return obj
    end

    for _, name in ipairs({
        "Touch", "Button", "Hitbox",
        "Purchase", "Part"
    }) do
        local part = obj:FindFirstChild(name, true)

        if part and part:IsA("BasePart") then
            return part
        end
    end

    if obj:IsA("Model") then
        return obj.PrimaryPart or
            obj:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

-- Scan and sort buttons
local function getSortedButtons(folder)
    local buttons = {}

    for _, obj in ipairs(folder:GetChildren()) do
        if not isExcluded(obj) then
            local part = getTouchPart(obj)
            local price = getPrice(obj)

            if part and price then
                table.insert(buttons, {
                    object = obj,
                    part = part,
                    price = price
                })
            end
        end
    end

    table.sort(buttons, function(a, b)
        if a.price == b.price then
            return a.object.Name < b.object.Name
        end

        return a.price < b.price
    end)

    return buttons
end

local function stopBuying(message)
    buying = false
    runId = runId + 1
    updateToggle()

    local root = getRoot()

    if root and savedPosition then
        root.CFrame = savedPosition
    end

    savedPosition = nil

    if message then
        setStatus(message)
    end
end

-- Auto Buy
local function startBuying()
    if buying or collecting then return end

    local root = getRoot()
    if not root then
        setStatus("Character unavailable")
        return
    end

    local folder = getMyButtonsFolder()

    if not folder then
        setStatus("Your button folder not found")
        return
    end

    buying = true
    runId = runId + 1

    local thisRun = runId
    savedPosition = root.CFrame

    updateToggle()

    task.spawn(function()
        local failed = {}

        while alive and buying and runId == thisRun do
            folder = getMyButtonsFolder()

            if not folder then
                stopBuying("Button folder disappeared")
                break
            end

            local cash = getCash()

            if cash == nil then
                stopBuying("Unable to read cash")
                break
            end

            local buttons = getSortedButtons(folder)
            local chosen
            local affordableFound = false

            for _, entry in ipairs(buttons) do
                if entry.price <= cash then
                    affordableFound = true

                    if not failed[entry.object] then
                        chosen = entry
                        break
                    end
                end
            end

            if not chosen then
                if #buttons == 0 then
                    stopBuying("No priced buttons detected")
                elseif not affordableFound then
                    stopBuying("Not enough cash - Auto Buy OFF")
                else
                    stopBuying("Affordable buttons failed to purchase")
                end

                break
            end

            root = getRoot()

            if not root then
                stopBuying("Character unavailable")
                break
            end

            setStatus("Buying: $" .. tostring(chosen.price))

            local part = chosen.part

            if not part:IsDescendantOf(folder) then
                task.wait(0.1)
                continue
            end

            -- Stand on the button
            root.CFrame = part.CFrame *
                CFrame.new(
                    0,
                    part.Size.Y / 2 + 2.5,
                    0
                )

            -- Wait until button disappears
            local purchased = false
            local deadline = os.clock() + 5

            while alive and buying and
                runId == thisRun and
                os.clock() < deadline do

                if not chosen.object:IsDescendantOf(folder) then
                    purchased = true
                    break
                end

                task.wait(0.15)
            end

            if not alive or not buying or
                runId ~= thisRun then
                break
            end

            if purchased then
                setStatus("Purchased - scanning next")
                task.wait(0.2)
            else
                failed[chosen.object] = true
                setStatus("Purchase not confirmed")
                task.wait(0.3)
            end
        end
    end)
end

-- Income event listener
local remotes = RS:FindFirstChild("Remotes")
local incomeEvent = remotes and remotes:FindFirstChild("Event")

if incomeEvent and incomeEvent:IsA("RemoteEvent") then
    connect(incomeEvent.OnClientEvent, function(action)
        if action == "Income" then
            if buying then
                setStatus("Income updated - checking cash")
            end
        end
    end)
end

-- Tycoon state cash listener
local tycoon = RS:FindFirstChild("Tycoon")
local stateEvent = tycoon and
    tycoon:FindFirstChild("TycoonButtonEvent")

if stateEvent and stateEvent:IsA("RemoteEvent") then
    connect(stateEvent.OnClientEvent, function(action, data)
        if action == "State" and type(data) == "table" then
            if type(data.cash) == "number" then
                latestCash = data.cash
            end
        end
    end)
end

-- Button controls
connect(collectButton.MouseButton1Click, function()
    task.spawn(collectCash)
end)

connect(buyButton.MouseButton1Click, function()
    if buying then
        stopBuying("Auto Buy stopped")
    else
        startBuying()
    end
end)

connect(UIS.InputBegan, function(input, processed)
    if processed then return end

    if input.KeyCode == Enum.KeyCode.P then
        task.spawn(collectCash)
    end
end)

-- Full cleanup
_G.CheeseHubCleanup = function()
    alive = false
    buying = false
    runId = runId + 1

    local root = getRoot()

    if root and savedPosition then
        root.CFrame = savedPosition
    end

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    gui:Destroy()
end
