-- STORAGE HUNTERS | EXACT ROD GUID INSPECTOR

local RS = game:GetService("ReplicatedStorage")

local TARGET_GUID = "42bfdb1e-96e7-4aba-b881-dce97bd25f4e"

local GetInventory = RS:WaitForChild("Events")
    :WaitForChild("Inventory")
    :WaitForChild("GetPlayerInventory")

local function formatValue(value)
    if type(value) == "table" then
        local parts = {}

        for key, v in pairs(value) do
            if type(v) ~= "table" then
                table.insert(parts,
                    tostring(key) .. "=" .. tostring(v))
            else
                table.insert(parts,
                    tostring(key) .. "={table}")
            end
        end

        return "{ " .. table.concat(parts, ", ") .. " }"
    end

    return tostring(value)
end

local success, inventory = pcall(function()
    return GetInventory:InvokeServer()
end)

if not success then
    warn("[ROD INSPECTOR] Inventory request failed:", inventory)
    return
end

local found = false
local visited = {}

local function search(tbl, path, depth)
    if type(tbl) ~= "table" or visited[tbl] or depth > 12 then
        return
    end

    visited[tbl] = true

    for key, value in pairs(tbl) do
        if tostring(key) == TARGET_GUID
            or (type(value) ~= "table"
                and tostring(value) == TARGET_GUID) then

            found = true

            print("========== ROD FOUND ==========")
            print("PATH:", path)
            print("MATCHING KEY:", tostring(key))

            -- If GUID is a table key, inspect its value.
            -- Otherwise inspect the parent item table.
            local item = type(value) == "table" and value or tbl

            for field, fieldValue in pairs(item) do
                print(
                    tostring(field) .. ":",
                    formatValue(fieldValue)
                )
            end

            print("========== END ROD ==========")
        end

        if type(value) == "table" then
            search(
                value,
                path .. "." .. tostring(key),
                depth + 1
            )
        end
    end
end

search(inventory, "Inventory", 0)

if not found then
    warn("[ROD INSPECTOR] GUID not found in inventory response.")
else
    print("[ROD INSPECTOR] Inspection complete.")
end
