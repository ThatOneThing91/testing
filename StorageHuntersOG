local PoliceGarages = {}

local function IsPoliceGarage(garage)
    if not garage then
        return false
    end

    return garage:FindFirstChild(
        "PoliceWarning",
        true
    ) ~= nil
end

local function CheckPoliceGarage(garage)
    if not garage
        or not garage.Parent then
        return
    end

    if PoliceGarages[garage] then
        return
    end

    if IsPoliceGarage(garage) then
        PoliceGarages[garage] = true

        -- ONLY notification generated
        -- by Police Auction detection.

        Notify(
            "Police Auction Found",
            garage.Name,
            3
        )
    end
end

local function ScanPoliceGarages()
    local debris =
        workspace:FindFirstChild(
            "_Debris"
        )

    if not debris then
        return
    end

    local garages =
        debris:FindFirstChild(
            "Garages"
        )

    if not garages then
        return
    end

    for _, garage in ipairs(
        garages:GetChildren()
    ) do

        CheckPoliceGarage(garage)
    end
end

task.spawn(function()
    local garages

    repeat
        local debris =
            workspace:FindFirstChild(
                "_Debris"
            )

        garages =
            debris
            and debris:FindFirstChild(
                "Garages"
            )

        task.wait(1)
    until garages

    ScanPoliceGarages()

    garages.ChildAdded:Connect(
        function(child)
            task.wait(0.1)
            CheckPoliceGarage(child)
        end
    )

    garages.DescendantAdded:Connect(
        function(descendant)

            if descendant.Name
                == "PoliceWarning" then

                local garage =
                    descendant:FindFirstAncestor(
                        "Model"
                    )

                if garage then
                    CheckPoliceGarage(
                        garage
                    )
                end
            end
        end
    )
end)

local function GetPoliceGarage()
    for garage in pairs(
        PoliceGarages
    ) do

        if garage
            and garage.Parent
            and IsPoliceGarage(garage) then

            return garage
        end
    end

    return nil
end

local function StartPoliceAuction(garage)
    if not garage then
        return false
    end

    local entry =
        garage:FindFirstChild(
            "EntrySquare",
            true
        )

    if not entry then
        return false
    end

    local promptPart =
        entry:FindFirstChild(
            "PromptPart",
            true
        )

    local destination =
        promptPart
        and promptPart:IsA("BasePart")
        and promptPart

    if not destination then
        destination =
            entry:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end

    local prompt =
        entry:FindFirstChild(
            "EnterAuction",
            true
        )

    if not prompt then
        prompt =
            garage:FindFirstChild(
                "EnterAuction",
                true
            )
    end

    local root = GetRoot()

    if not root
        or not destination then
        return false
    end

    -- Teleport.
    root.CFrame =
        destination.CFrame
        + Vector3.new(
            0,
            3,
            0
        )

    task.wait(0.4)

    -- Automatically start auction.
    if prompt then
        pcall(function()
            prompt.HoldDuration = 0
        end)

        if typeof(
            fireproximityprompt
        ) == "function" then

            pcall(function()
                fireproximityprompt(
                    prompt
                )
            end)

        elseif typeof(
            firePrompt
        ) == "function" then

            pcall(function()
                firePrompt(prompt)
            end)

        else
            pcall(function()
                prompt:InputHoldBegin()

                task.wait(0.1)

                prompt:InputHoldEnd()
            end)
        end

        return true
    end

    return false
end

