local function RunAutoBasketball(runId)
    task.spawn(function()
        while State.AutoBasketball
            and RunIds.Basketball == runId do

            local hrp = GetRoot()

            local ball
            local hoop

            pcall(function()
                ball =
                    workspace
                    :WaitForChild(
                        "ThatOneThing91",
                        3
                    )
                    :WaitForChild(
                        "Basketball",
                        3
                    )
            end)

            pcall(function()
                hoop =
                    workspace
                    :WaitForChild(
                        "BBOW Builder Assets",
                        3
                    )
                    :WaitForChild(
                        "Other Buildings and  Decoration",
                        3
                    )
                    :WaitForChild(
                        "Basket Ball ",
                        3
                    )
                    :WaitForChild(
                        "Hoop",
                        3
                    )
                    :WaitForChild(
                        "Ring",
                        3
                    )
            end)

            if hrp and ball and hoop then
                hrp.CFrame =
                    CFrame.new(
                        -274,
                        1723,
                        -590
                    )

                task.wait(0.5)

                while State.AutoBasketball
                    and RunIds.Basketball == runId do

                    local direction =
                        hoop.Position
                        - hrp.Position

                    direction =
                        Vector3.new(
                            direction.X,
                            0,
                            direction.Z
                        )

                    if direction.Magnitude > 0 then
                        hrp.CFrame =
                            CFrame.lookAt(
                                hrp.Position,
                                hrp.Position
                                    + direction
                            )
                    end

                    task.wait(0.1)

                    pcall(function()
                        ball:Activate()
                    end)

                    task.wait(1)

                    pcall(function()
                        ball:Deactivate()
                    end)

                    task.wait(0.5)
                end
            else
                task.wait(1)
            end
        end
    end)
end

