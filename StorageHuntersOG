local WashEvents =
    ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Wash")

local GetWashableItems =
    WashEvents:WaitForChild(
        "GetWashableItems"
    )

local GetSlotState =
    WashEvents:WaitForChild(
        "GetSlotState"
    )

local StartWash =
    WashEvents:WaitForChild(
        "StartWash"
    )

local CollectWash =
    WashEvents:WaitForChild(
        "CollectWash"
    )

local ClaimWashedItem =
    WashEvents:WaitForChild(
        "ClaimWashedItem"
    )

local function GetWashable()
    local result

    pcall(function()
        result =
            GetWashableItems:InvokeServer()
    end)

    return result
end

local function IsBrokenItem(item)
    if type(item) ~= "table" then
        return false
    end

    if item.name == "Broken"
        or item.Name == "Broken" then
        return true
    end

    local mutators =
        item.Mutators

    if type(mutators) == "table" then
        for _, mutator in pairs(
            mutators
        ) do

            if type(mutator)
                == "table" then

                if mutator.name
                    == "Broken"
                    or mutator.Name
                    == "Broken" then

                    return true
                end
            end
        end
    end

    return false
end

local function FindDirtyItem()
    local washable =
        GetWashable()

    if type(washable)
        ~= "table" then
        return nil
    end

    local items =
        washable.items
        or washable.Items

    if type(items)
        ~= "table" then
        return nil
    end

    for _, entry in pairs(items) do
        if type(entry)
            == "table"
            and not IsBrokenItem(entry) then

            local guid =
                entry.guid
                or entry.GUID
                or entry.ItemGUID

            local source =
                entry.source
                or entry.Source
                or "Inventory"

            local dirty = false

            if entry.name == "Dirty"
                or entry.Name == "Dirty" then

                dirty = true
            end

            local mutators =
                entry.Mutators

            if type(mutators)
                == "table" then

                for _, mutator in pairs(
                    mutators
                ) do

                    if type(mutator)
                        == "table" then

                        if mutator.name
                            == "Dirty"
                            or mutator.Name
                            == "Dirty" then

                            dirty = true
                        end
                    end
                end
            end

            if dirty
                and guid
                and source == "Inventory" then

                return tostring(guid)
            end
        end
    end

    return nil
end

local function GetSlotCompletion(slot)
    local state

    pcall(function()
        state =
            GetSlotState:InvokeServer(
                slot
            )
    end)

    if type(state)
        ~= "table" then
        return nil
    end

    local data =
        state.ItemData
        or state.itemData
        or state

    if type(data)
        ~= "table" then
        return nil
    end

    local startTime =
        tonumber(
            data.StartTime
            or data.startTime
        )

    local duration =
        tonumber(
            data.Duration
            or data.duration
        )

    if startTime
        and duration then

        return startTime + duration
    end

    return nil
end

local function RunAutoWash(runId)
    task.spawn(function()
        while State.AutoWash
            and RunIds.Wash == runId do

            for slot = 1, 3 do
                if not State.AutoWash
                    or RunIds.Wash ~= runId then
                    break
                end

                local completion =
                    GetSlotCompletion(
                        slot
                    )

                if completion then
                    if os.time()
                        >= completion then

                        pcall(function()
                            CollectWash:InvokeServer(
                                slot
                            )
                        end)

                        task.wait(1)

                        pcall(function()
                            ClaimWashedItem:InvokeServer(
                                slot
                            )
                        end)

                        task.wait(0.5)
                    end
                else
                    local guid =
                        FindDirtyItem()

                    if guid then
                        pcall(function()
                            StartWash:InvokeServer(
                                slot,
                                guid,
                                "Inventory"
                            )
                        end)

                        task.wait(0.5)
                    end
                end
            end

            task.wait(1)
        end
    end)
end

CreateToggle(
