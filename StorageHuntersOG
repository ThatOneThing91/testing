local function SetTheme(color)
    ThemeColor = color

    MainStroke.Color =
        ThemeColor

    HueCenter.BackgroundColor3 =
        ThemeColor

    if MainPage.Visible then
        MainTabButton.BackgroundColor3 =
            ThemeColor

        FarmingTabButton.BackgroundColor3 =
            ButtonBackground
    else
        MainTabButton.BackgroundColor3 =
            ButtonBackground

        FarmingTabButton.BackgroundColor3 =
            ThemeColor
    end

    for stateKey, updater in pairs(
        ToggleObjects
    ) do

        if updater then
            updater(
                State[stateKey]
            )
        end
    end
end

local function HueFromPosition(position)
    local center =
        HueWheel.AbsolutePosition
        + HueWheel.AbsoluteSize / 2

    local delta =
        position - center

    local angle =
        math.atan2(
            delta.Y,
            delta.X
        )

    local hue =
        (angle / (math.pi * 2))
        + 0.5

    if hue < 0 then
        hue += 1
    end

    return hue
end

HueWheel.InputBegan:Connect(
    function(input)

        if input.UserInputType
            == Enum.UserInputType.MouseButton1
            or input.UserInputType
            == Enum.UserInputType.Touch then

            local hue =
                HueFromPosition(
                    input.Position
                )

            SetTheme(
                Color3.fromHSV(
                    hue,
                    0.85,
                    0.9
                )
            )
        end
    end
)

HueWheel.InputChanged:Connect(
    function(input)

        if input.UserInputType
            == Enum.UserInputType.MouseMovement
            or input.UserInputType
            == Enum.UserInputType.Touch then

            if UserInputService:IsMouseButtonPressed(
                Enum.UserInputType.MouseButton1
            ) then

                local hue =
                    HueFromPosition(
                        input.Position
                    )

                SetTheme(
                    Color3.fromHSV(
                        hue,
                        0.85,
                        0.9
                    )
                )
            end
        end
    end
)

