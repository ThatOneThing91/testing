--// ============================================================
--// INSTANT AUCTION ENTRY
--// ============================================================

CreateActionButton(
    MainPage,
    "Instant Auction Entry",
    function()

        local garages =
            GetGaragesFolder()

        if not garages then
            return
        end

        local count = 0

        for _, garage in ipairs(
            garages:GetChildren()
        ) do

            local prompt =
                garage:FindFirstChild(
                    "EnterAuction",
                    true
                )

            if prompt
                and prompt:IsA(
                    "ProximityPrompt"
                ) then

                pcall(function()
                    prompt.HoldDuration = 0
                end)

                count += 1
            end
        end

        Notify(
            "Instant Auction Entry",
            "Updated "
                .. count
                .. " prompts.",
            2
        )
    end
)

