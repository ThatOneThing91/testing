local function GetNumberFromObject(object)
    if not object then
        return nil
    end

    if object:IsA("NumberValue")
        or object:IsA("IntValue") then

        return object.Value
    end

    if object:IsA("StringValue") then
        local number =
            tonumber(
                tostring(object.Value)
                    :gsub("[^%d%.]", "")
            )

        return number
    end

    return nil
end

local function FindMoneyInContainer(container)
    if not container then
        return nil
    end

    local names = {
        "Cash",
        "Money",
        "Coins",
        "Currency",
        "Balance",
        "Dollars",
        "Credits",
    }

    for _, name in ipairs(names) do
        local object =
            container:FindFirstChild(
                name,
                true
            )

        if object then
            local value =
                GetNumberFromObject(
                    object
                )

            if value ~= nil then
                return value
            end

            local attributes = {
                "Value",
                "Amount",
                "Balance",
            }

            for _, attribute in ipairs(
                attributes
            ) do

                local number =
                    tonumber(
                        object:GetAttribute(
                            attribute
                        )
                    )

                if number ~= nil then
                    return number
                end
            end
        end
    end

    return nil
end

local function GetPlayerMoney()
    local attributeNames = {
        "Cash",
        "Money",
        "Coins",
        "Currency",
        "Balance",
        "Dollars",
        "Credits",
    }

    for _, name in ipairs(
        attributeNames
    ) do

        local value =
            LocalPlayer:GetAttribute(
                name
            )

        if typeof(value) == "number" then
            return value
        end
    end

    local value =
        FindMoneyInContainer(
            LocalPlayer
        )

    if value ~= nil then
        return value
    end

    local leaderstats =
        LocalPlayer:FindFirstChild(
            "leaderstats"
        )

    if leaderstats then
        value =
            FindMoneyInContainer(
                leaderstats
            )

        if value ~= nil then
            return value
        end
    end

    local playerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if playerGui then
        value =
            FindMoneyInContainer(
                playerGui
            )

        if value ~= nil then
            return value
        end
    end

    return nil
end

local function ParsePriceText(text)
    if not text then
        return nil
    end

    text = tostring(text)

    local number =
        text:match(
            "[$€£]?%s*([%d,]+%.?%d*)"
        )

    if not number then
        return nil
    end

    number =
        tonumber(
            number:gsub(",", "")
        )

    return number
end

local function FindGaragePrice(garage)
    if not garage then
        return nil
    end

    local attributeNames = {
        "Price",
        "Cost",
        "AuctionPrice",
        "StartingPrice",
        "StartPrice",
        "BidPrice",
    }

    for _, name in ipairs(
        attributeNames
    ) do

        local value =
            garage:GetAttribute(
                name
            )

        if typeof(value) == "number" then
            return value
        end

        if typeof(value) == "string" then
            local parsed =
                ParsePriceText(value)

            if parsed then
                return parsed
            end
        end
    end

    local descendants =
        garage:GetDescendants()

    for _, object in ipairs(
        descendants
    ) do

        local lower =
            object.Name:lower()

        local looksLikePrice =
            lower:find("price")
            or lower:find("cost")
            or lower:find("starting")
            or lower:find("bid")

        if looksLikePrice then
            local value =
                GetNumberFromObject(
                    object
                )

            if value ~= nil then
                return value
            end

            if object:IsA(
                "TextLabel"
            )
            or object:IsA(
                "TextButton"
            )
            or object:IsA(
                "TextBox"
            ) then

                local parsed =
                    ParsePriceText(
                        object.Text
                    )

                if parsed then
                    return parsed
                end
            end
        end
    end

    return nil
end

local function CanAffordGarage(garage)
    if not garage then
        return false
    end

    local price =
        FindGaragePrice(
            garage
        )

    local money =
        GetPlayerMoney()

    -- If the game does not expose the price
    -- in a readable place, don't falsely reject it.
    --
    -- Once an exact price object is found,
    -- this becomes a real affordability check.

    if price == nil
        or money == nil then

        return true
    end

    return money >= price
end

