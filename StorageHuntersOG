--// ============================================================
--// COMMA = HUB SHOW/HIDE
--// ============================================================

UserInputService.InputBegan:Connect(
    function(input, gameProcessed)

        if gameProcessed then
            return
        end

        if input.KeyCode
            == Enum.KeyCode.Comma then

            State.HubVisible =
                not State.HubVisible

            Main.Visible =
                State.HubVisible

            if not State.HubVisible then
                ThemePicker.Visible = false
            end
        end
    end
)

--// ============================================================
--// P = AUTO BID
--// ============================================================

UserInputService.InputBegan:Connect(
    function(input, gameProcessed)

        if gameProcessed then
            return
        end

        if input.KeyCode
            == Enum.KeyCode.P then

            State.AutoBid =
                not State.AutoBid

            if ToggleObjects.AutoBid then
                ToggleObjects.AutoBid(
                    State.AutoBid
                )
            end

            Notify(
                "Auto Bid",
                State.AutoBid
                    and "ON"
                    or "OFF",
                1
            )
        end
    end
)

