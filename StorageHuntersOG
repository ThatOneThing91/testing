local AuctionDropdown

AreaDropdown = CreateDropdown(
    FarmingPage,
    "AREA",
    State.SelectedArea,
    AreaNames,
    function(value)

        State.SelectedArea =
            value

        -- THIS IS THE IMPORTANT PART:
        -- completely replace the options list.

        local auctions =
            AreaAuctions[value]
            or {}

        local first =
            auctions[1]

        State.SelectedAuction =
            first
            or "No auctions found"

        if AuctionDropdown then
            AuctionDropdown:SetOptions(
                auctions,
                State.SelectedAuction
            )
        end
    end
)

AuctionDropdown = CreateDropdown(
    FarmingPage,
    "STARTING AUCTION",
    State.SelectedAuction,
    AreaAuctions[
        State.SelectedArea
    ],
    function(value)

        State.SelectedAuction =
            value
    end
)

--// ============================================================
--// REFRESH FARMING DROPDOWN
--// ============================================================

local function RefreshAuctionDropdown()
    local area =
        State.SelectedArea

    local auctions =
        AreaAuctions[area]
        or {}

    local firstValid

    -- First prefer an actual garage that exists
    -- and that the player can afford.

    for _, name in ipairs(auctions) do
        local garage =
            GetGarageByNameForArea(
                area,
                name
            )

        if garage
            and CanAffordGarage(
                garage
            ) then

            firstValid = name
            break
        end
    end

    -- If no price can be determined for any
    -- garage, use the first existing garage.

    if not firstValid then
        for _, name in ipairs(
            auctions
        ) do

            local garage =
                GetGarageByNameForArea(
                    area,
                    name
                )

            if garage then
                firstValid = name
                break
            end
        end
    end

    if not firstValid then
        firstValid =
            auctions[1]
    end

    State.SelectedAuction =
        firstValid
        or "No auctions found"

    if AuctionDropdown then
        AuctionDropdown:SetOptions(
            auctions,
            State.SelectedAuction
        )
    end
end

