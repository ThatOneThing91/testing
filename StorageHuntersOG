--// ============================================================
--// WAIT FOR AUCTION FINISH
--// ============================================================

local function WaitForAuctionFinished(
    runId
)
    local sawAuction = false
    local closedChecks = 0

    while State.Farming
        and RunIds.Farming == runId do

        local container =
            GetAuctionContainer()

        local visible =
            container
            and container.Visible

        if visible then
            sawAuction = true
            closedChecks = 0
        elseif sawAuction then
            closedChecks += 1

            if closedChecks >= 5 then
                return true
            end
        end

        task.wait(0.2)
    end

    return false
end

--// ============================================================
--// FARMING
--// ============================================================

local function FarmGarage(
    garageName,
    area,
    runId
)
    if not State.Farming
        or RunIds.Farming ~= runId then

        return "stopped"
    end

    -- Always resolve the garage using the
    -- CURRENT selected area.

    local garage =
        GetGarageByNameForArea(
            area,
            garageName
        )

    if not garage then
        return "unavailable"
    end

    -- IMPORTANT:
    -- Check affordability BEFORE teleporting
    -- or firing EnterAuction.

    if not CanAffordGarage(
        garage
    ) then

        return "unaffordable"
    end

    if not TeleportToGarage(
        garage
    ) then

        return "start_failed"
    end

    task.wait(0.75)

    if not State.Farming
        or RunIds.Farming ~= runId then

        return "stopped"
    end

    if not CanAffordGarage(
        garage
    ) then

        return "unaffordable"
    end

    EnterGarage(
        garage
    )

    local started =
        WaitForAuctionStart(
            runId,
            30
        )

    if not started then
        return "start_failed"
    end

    if State.AutoBid then
        PerformBid()

        if State.PauseAuction then
            PauseAuctionWithRetry(
                runId
            )
        end
    end

    local finished =
        WaitForAuctionFinished(
            runId
        )

    if finished then
        return "finished"
    end

    return "stopped"
end

--// ============================================================
--// FARMING LOOP
--// ============================================================

local function StartFarming(runId)
    task.spawn(function()

        while State.Farming
            and RunIds.Farming == runId do

            local area =
                State.SelectedArea

            local auctions =
                AreaAuctions[area]
                or {}

            if #auctions == 0 then
                task.wait(2)
                continue
            end

            local selectedIndex = 1

            for index, name in ipairs(
                auctions
            ) do

                if name
                    == State.SelectedAuction then

                    selectedIndex =
                        index

                    break
                end
            end

            -- Continue through the current
            -- area's garages.

            local checkedThisCycle = {}

            while State.Farming
                and RunIds.Farming == runId do

                -- If the user changed area while
                -- farming, immediately abandon the
                -- old area's list.

                if State.SelectedArea
                    ~= area then

                    break
                end

                if #checkedThisCycle
                    >= #auctions then

                    checkedThisCycle = {}
                    selectedIndex = 1

                    task.wait(1)
                end

                local auctionName =
                    auctions[selectedIndex]

                if not auctionName then
                    selectedIndex = 1
                    continue
                end

                local alreadyChecked =
                    checkedThisCycle[
                        auctionName
                    ]

                if alreadyChecked then
                    selectedIndex += 1

                    if selectedIndex > #auctions then
                        selectedIndex = 1
                    end

                    continue
                end

                checkedThisCycle[
                    auctionName
                ] = true

                State.SelectedAuction =
                    auctionName

                local result =
                    FarmGarage(
                        auctionName,
                        area,
                        runId
                    )

                if result
                    == "finished" then

                    -- Successful auction:
                    -- advance only after UI closes.

                    selectedIndex += 1

                elseif result
                    == "unaffordable" then

                    -- Skip this garage immediately.
                    -- Do NOT retry it.

                    selectedIndex += 1

                elseif result
                    == "unavailable" then

                    selectedIndex += 1

                elseif result
                    == "start_failed" then

                    -- Auction didn't start.
                    -- Retry SAME garage after 5 sec.

                    task.wait(5)

                    checkedThisCycle[
                        auctionName
                    ] = nil

                elseif result
                    == "stopped" then

                    break
                end

                if selectedIndex > #auctions then
                    selectedIndex = 1
                end

                task.wait(0.5)
            end
        end
    end)
end

--// ============================================================
--// INSTANT UNLOAD
--// ============================================================

local function GetMyVehicle()
    local character =
        LocalPlayer.Character

    if not character then
        return nil
    end

    local humanoid =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if humanoid
        and humanoid.SeatPart then

        local vehicle =
            humanoid.SeatPart:FindFirstAncestorOfClass(
                "Model"
            )

        if vehicle then
            return vehicle
        end
    end

    return nil
end

local function InstantUnloadVehicle(
    targetVehicle
)
    pcall(function()

        local vehicle =
            targetVehicle
            or GetMyVehicle()

        local vehicleId =
            (
                vehicle
                and (
                    vehicle:GetAttribute(
                        "VehicleGUID"
                    )
                    or vehicle:GetAttribute(
                        "GUID"
                    )
                )
            )
            or LocalPlayer:GetAttribute(
                "EquippedVehicle"
            )

        if not vehicleId
            or vehicleId == "" then

            return
        end

        local vehicleEvents =
            ReplicatedStorage:FindFirstChild(
                "Events"
            )
            and ReplicatedStorage.Events:FindFirstChild(
                "Vehicles"
            )

        if not vehicleEvents then
            return
        end

        local getItemsRemote =
            vehicleEvents:FindFirstChild(
                "GetVehicleItems"
            )

        local transferRemote =
            vehicleEvents:FindFirstChild(
                "TransferVehicleItemsToInventory"
            )

        if not getItemsRemote
            or not transferRemote then

            return
        end

        local items

        pcall(function()
            items =
                getItemsRemote:InvokeServer(
                    vehicleId
                )
        end)

        if type(items)
            ~= "table" then

            return
        end

        local guids = {}

        -- Vehicle contents are keyed by GUID.

        for guid, _ in pairs(items) do
            table.insert(
                guids,
                guid
            )
        end

        if #guids > 0 then
            pcall(function()
                transferRemote:FireServer(
                    guids
                )
            end)

            task.wait(0.4)
        end

        if vehicle then
            pcall(function()
                vehicle:SetAttribute(
                    "CargoWeight",
                    0
                )
            end)
        end
    end)
end

local function RunInstantUnload(
    runId
)
    task.spawn(function()
        while State.InstantUnload
            and RunIds.Unload == runId do

            InstantUnloadVehicle()

            task.wait(1)
        end
    end)
end

