local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Events = ReplicatedStorage:WaitForChild("Events")
local Wash = Events:WaitForChild("Wash")

local GetWashableItems =
    Wash:WaitForChild("GetWashableItems")

local GetSlotState =
    Wash:WaitForChild("GetSlotState")

local StartWash =
    Wash:WaitForChild("StartWash")

--==================================================
-- CHECK FOR DIRTY MUTATOR
--==================================================

local function IsDirty(data)

    if typeof(data) ~= "table" then
        return false
    end

    local mutators = data.Mutators

    if typeof(mutators) ~= "table" then
        return false
    end

    for _, mutator in pairs(mutators) do

        if typeof(mutator) == "table" then

            if (mutator.name or mutator.Name) == "Dirty" then
                return true
            end

        end

    end

    return false
end

--==================================================
-- GET WASHABLE ITEMS
--==================================================

print("")
print("========================================")
print("        3-SLOT WASH START TEST")
print("========================================")

print("Getting washable items...")

local success, result = pcall(function()
    return GetWashableItems:InvokeServer()
end)

if not success then
    warn("GetWashableItems failed:", result)
    return
end

if typeof(result) ~= "table" then
    warn("Unexpected GetWashableItems result.")
    return
end

local washableItems = result.items

if typeof(washableItems) ~= "table" then
    warn("Could not find washable items.")
    return
end

--==================================================
-- FIND DIRTY INVENTORY ITEMS
--==================================================

local dirtyItems = {}

for _, item in pairs(washableItems) do

    if typeof(item) == "table" then

        local guid = item.guid
        local source = item.source
        local data = item.data

        if source == "Inventory"
            and typeof(guid) == "string"
            and IsDirty(data) then

            table.insert(
                dirtyItems,
                guid
            )

            print(
                "DIRTY WASHABLE:",
                guid
            )

        end

    end

end

print("")
print(
    "Dirty washable inventory items:",
    #dirtyItems
)

if #dirtyItems == 0 then
    warn("No Dirty inventory items were returned by GetWashableItems.")
    return
end

--==================================================
-- GET WASH SLOTS
--==================================================

print("")
print("Checking wash slots...")

local slotSuccess, slotState = pcall(function()
    return GetSlotState:InvokeServer()
end)

if not slotSuccess then
    warn("GetSlotState failed:", slotState)
    return
end

local unlockedCount =
    tonumber(slotState.unlockedCount) or 3

print(
    "Unlocked slots:",
    unlockedCount
)

local slots = slotState.slots

if typeof(slots) ~= "table" then
    warn("Could not find slot data.")
    return
end

--==================================================
-- FIND EMPTY SLOTS
--==================================================

local emptySlots = {}

for slotNumber = 1, math.min(unlockedCount, 3) do

    local slot = slots[slotNumber]

    if not slot or not slot.ItemData then

        print(
            "Slot",
            slotNumber,
            "= EMPTY"
        )

        table.insert(
            emptySlots,
            slotNumber
        )

    else

        print(
            "Slot",
            slotNumber,
            "= OCCUPIED"
        )

    end

end

print("")
print(
    "Empty slots:",
    #emptySlots
)

if #emptySlots == 0 then
    print("All 3 wash slots are occupied.")
    return
end

--==================================================
-- START WASHES
--==================================================

print("")
print("Starting washes...")

local itemIndex = 1

for _, slotNumber in ipairs(emptySlots) do

    local guid = dirtyItems[itemIndex]

    if not guid then
        break
    end

    print("")
    print("----------------------------------------")
    print("Starting wash")
    print("Slot:", slotNumber)
    print("GUID:", guid)
    print("----------------------------------------")

    local washSuccess, washResult = pcall(function()

        return StartWash:InvokeServer(
            slotNumber,
            guid,
            "Inventory"
        )

    end)

    if washSuccess then

        print(
            "SUCCESS: StartWash invoked"
        )

        print(
            "Result:",
            washResult
        )

    else

        warn(
            "StartWash FAILED:",
            washResult
        )

    end

    itemIndex += 1

    task.wait(0.5)

end

print("")
print("========================================")
print("           TEST FINISHED")
print("========================================")
