--==================================================
-- AUTO WASH
--==================================================

local AutoWashEnabled = false
local AutoWashThread = nil

local WashFolder = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Wash")

local GetWashableItems = WashFolder:WaitForChild("GetWashableItems")
local GetSlotState = WashFolder:WaitForChild("GetSlotState")
local StartWash = WashFolder:WaitForChild("StartWash")
local CollectWash = WashFolder:WaitForChild("CollectWash")
local ClaimWashedItem = WashFolder:WaitForChild("ClaimWashedItem")

local MAX_WASH_SLOTS = 3

local function hasMutator(data, wanted)
    if type(data) ~= "table" then
        return false
    end

    local mutators = data.Mutators or data.mutators

    if type(mutators) ~= "table" then
        return false
    end

    for _, mutator in pairs(mutators) do
        if type(mutator) == "table" then
            local name = mutator.name or mutator.Name

            if tostring(name) == wanted then
                return true
            end
        end
    end

    return false
end

local function getWashableDirtyItems()
    local ok, result = pcall(function()
        return GetWashableItems:InvokeServer()
    end)

    if not ok or type(result) ~= "table" then
        return {}
    end

    local items = result.items or result.Items

    if type(items) ~= "table" then
        return {}
    end

    local output = {}

    for _, entry in pairs(items) do
        if type(entry) == "table" then
            local source = entry.source or entry.Source

            if source == "Inventory" then
                local data = entry.data or entry.Data or entry

                local dirty = hasMutator(data, "Dirty")
                local broken = hasMutator(data, "Broken")

                if dirty and not broken then
                    local guid =
                        entry.guid
                        or entry.GUID
                        or entry.itemGUID
                        or entry.ItemGUID

                    if guid then
                        table.insert(output, {
                            guid = guid,
                            source = "Inventory"
                        })
                    end
                end
            end
        end
    end

    return output
end

local function getWashState()
    local ok, result = pcall(function()
        return GetSlotState:InvokeServer()
    end)

    if not ok or type(result) ~= "table" then
        return nil
    end

    return result
end

local function getSlot(state, index)
    if not state then
        return nil
    end

    local slots = state.slots or state.Slots

    if type(slots) == "table" then
        return slots[tostring(index)] or slots[index]
    end

    return state[tostring(index)] or state[index]
end

local function slotIsEmpty(slotData)
    if slotData == nil then
        return true
    end

    if type(slotData) ~= "table" then
        return false
    end

    return next(slotData) == nil
end

local function startWash(slot, item)
    local ok, result = pcall(function()
        return StartWash:InvokeServer(
            slot,
            item.guid,
            "Inventory"
        )
    end)

    if ok then
        notify(
            "Auto Wash",
            "Started wash in slot " .. tostring(slot)
        )
    else
        warn(
            "[Auto Wash] StartWash failed:",
            result
        )
    end

    return ok
end

local function collectAndClaim(slot)
    local collectOK, collectResult = pcall(function()
        return CollectWash:InvokeServer(slot)
    end)

    if not collectOK then
        warn(
            "[Auto Wash] CollectWash failed for slot",
            slot,
            collectResult
        )

        return false
    end

    -- Confirmed working sequence:
    -- CollectWash(slot)
    -- wait 1 second
    -- ClaimWashedItem(slot)

    task.wait(1)

    local claimOK, claimResult = pcall(function()
        return ClaimWashedItem:InvokeServer(slot)
    end)

    if not claimOK then
        warn(
            "[Auto Wash] ClaimWashedItem failed for slot",
            slot,
            claimResult
        )

        return false
    end

    notify(
        "Auto Wash",
        "Collected slot " .. tostring(slot)
    )

    return true
end

local function processWashCycle()
    local state = getWashState()

    if not state then
        return
    end

    local unlockedCount = tonumber(state.unlockedCount) or MAX_WASH_SLOTS
    unlockedCount = math.clamp(
        unlockedCount,
        1,
        MAX_WASH_SLOTS
    )

    --==============================================
    -- FIRST: COLLECT FINISHED WASHES
    --==============================================

    for slot = 1, unlockedCount do
        local slotData = getSlot(state, slot)

        if type(slotData) == "table" then

            -- Some versions explicitly expose Washed.
            if slotData.Washed == true then
                if collectAndClaim(slot) then
                    task.wait(0.5)
                end

            else
                local startTime =
                    slotData.StartTime
                    or slotData.startTime

                local duration =
                    slotData.Duration
                    or slotData.duration

                if startTime and duration then
                    local now = workspace:GetServerTimeNow()

                    local finishTime =
                        startTime + duration

                    if now >= finishTime then
                        if collectAndClaim(slot) then
                            task.wait(0.5)
                        end
                    end
                end
            end
        end
    end

    -- Refresh after collection.
    state = getWashState()

    if not state then
        return
    end

    unlockedCount = tonumber(state.unlockedCount)
        or MAX_WASH_SLOTS

    unlockedCount = math.clamp(
        unlockedCount,
        1,
        MAX_WASH_SLOTS
    )

    --==============================================
    -- FIND EMPTY SLOTS
    --==============================================

    local emptySlots = {}

    for slot = 1, unlockedCount do
        local slotData = getSlot(state, slot)

        if slotIsEmpty(slotData) then
            table.insert(emptySlots, slot)
        end
    end

    if #emptySlots == 0 then
        return
    end

    --==============================================
    -- GET DIRTY ITEMS
    --==============================================

    local dirtyItems = getWashableDirtyItems()

    if #dirtyItems == 0 then
        return
    end

    --==============================================
    -- FILL EMPTY SLOTS
    --==============================================

    for _, slot in ipairs(emptySlots) do
        local item = table.remove(dirtyItems, 1)

        if not item then
            break
        end

        startWash(slot, item)

        task.wait(0.5)
    end
end

local function startAutoWash()
    if AutoWashThread then
        return
    end

    AutoWashThread = task.spawn(function()
        notify(
            "Auto Wash",
            "Auto Wash enabled"
        )

        while AutoWashEnabled do
            pcall(processWashCycle)

            -- Frequent enough to detect completion,
            -- without hammering the remotes.
            task.wait(2)
        end

        AutoWashThread = nil
    end)
end

local function stopAutoWash()
    AutoWashEnabled = false

    if AutoWashThread then
        pcall(function()
            task.cancel(AutoWashThread)
        end)

        AutoWashThread = nil
    end

    notify(
        "Auto Wash",
        "Auto Wash disabled"
    )
end

local _, updateAutoWash = createToggle(
    MainPage,
    "Auto Wash",
    false,
    function(state)
        AutoWashEnabled = state

        if state then
            startAutoWash()
        else
            stopAutoWash()
        end
    end
)

