local TreeRunning = false

local function treeTeleport()
    local root = LocalPlayer.Character
        and LocalPlayer.Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return
    end

    local assets = workspace:FindFirstChild(
        "BBOW Builder Assets"
    )

    local other = assets
        and assets:FindFirstChild(
            "Other Buildings and  Decoration"
        )

    local trees = other
        and other:FindFirstChild("Trees")

    if not trees then
        return
    end

    local order = {
        "8",
        "Apple Tree",
        "4",
        "2",
        "6",
        "5",
        "7",
        "3"
    }

    for _, name in ipairs(order) do
        if not TreeRunning then
            break
        end

        local target = trees:FindFirstChild(name, true)

        if target then
            local part = target:IsA("BasePart")
                and target
                or target:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

            if part then
                root.CFrame =
                    part.CFrame + Vector3.new(0, 3, 0)

                task.wait(0.4)
            end
        end
    end
end

