local AutoBidEnabled = false
local InstantUnloadEnabled = false
local PauseAuctionEnabled = false
local FarmingEnabled = false

local BidEvent = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Auction")
    :WaitForChild("Bid")

local RequestAuctionPause = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Auction")
    :WaitForChild("RequestAuctionPause")

local function doAutoBid()
    if not AutoBidEnabled then
        return
    end

    local playerGui = LocalPlayer:FindFirstChild(
        "PlayerGui"
    )

    local ui = playerGui
        and playerGui:FindFirstChild(
            "UIControllerGui"
        )

    local container = ui
        and ui:FindFirstChild(
            "AuctionBiddingContainer"
        )

    local button = container
        and container:FindFirstChild(
            "BidButton",
            true
        )

    if container
        and container.Visible
        and button
        and button.Visible
        and button.Active then

        pcall(function()
            BidEvent:FireServer()
        end)

        if PauseAuctionEnabled then
            pcall(function()
                RequestAuctionPause:FireServer(true)
            end)
        end
    end
end

local function runInstantUnload()
    task.spawn(function()
        while InstantUnloadEnabled do
            pcall(function()
                local vehicleId =
                    LocalPlayer:GetAttribute(
                        "EquippedVehicle"
                    )

                if vehicleId then
                    local events =
                        ReplicatedStorage:FindFirstChild(
                            "Events"
                        )

                    local vehicles =
                        events
                        and events:FindFirstChild(
                            "Vehicles"
                        )

                    local getItems =
                        vehicles
                        and vehicles:FindFirstChild(
                            "GetVehicleItems"
                        )

                    local transfer =
                        vehicles
                        and vehicles:FindFirstChild(
                            "TransferVehicleItemsToInventory"
                        )

                    if getItems and transfer then
                        local data =
                            getItems:InvokeServer(
                                vehicleId
                            )

                        local ids = {}

                        local function collect(value)
                            if type(value) == "string" then
                                table.insert(ids, value)

                            elseif type(value) == "table" then
                                for _, child in pairs(value) do
                                    collect(child)
                                end
                            end
                        end

                        collect(data)

                        if #ids > 0 then
                            transfer:FireServer(ids)
                        end
                    end
                end
            end)

            task.wait(1)
