local function bind(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

local function rootPart()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function plotInfo()
    local value = player:FindFirstChild("Tycoon")
    if not value or not value:IsA("ObjectValue") then
        return nil, nil
    end
    return value.Value, value:GetAttribute("Slot")
end

local function plotObjects()
    local plot, slot = plotInfo()
    if not plot or not slot then return nil end
    local side = plot:FindFirstChild("Player" .. tostring(slot))
    return side and side:FindFirstChild("Objects")
end

local function teleport(part)
    local root = rootPart()
    if not root or not part or not part:IsA("BasePart") then
        return false
    end
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(
        part.Position + Vector3.new(0, part.Size.Y / 2 + 3, 0)
    )
    return true
end

local function restore(root, cf)
    if root and root.Parent and cf then
        root.CFrame = cf
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function promptFire(prompt)
    if type(fireproximityprompt) ~= "function" then
        return false
    end
    return pcall(fireproximityprompt, prompt)
end

-- COLLECT CASH

local function collectCash()
    if not alive or busy then return end
    busy = true

    local plot, slot = plotInfo()
    local side = plot and plot:FindFirstChild("Player" .. tostring(slot))
    local essential = side and side:FindFirstChild("Essential")
    local atm = essential and essential:FindFirstChild("ATM")
    local touch = atm and atm:FindFirstChild("Touch")

    local root = rootPart()
    local previous = root and root.CFrame

    if touch and touch:IsA("BasePart") then
        teleport(touch)
        task.wait(0.5)
        restore(root, previous)
    end

    busy = false
end

-- AUTO BUY

local function parseMoney(value)
    if type(value) == "number" then return value end
    if type(value) ~= "string" then return nil end

    local number, suffix = value:gsub(",", ""):gsub("%$", "")
        :match("([%d%.]+)%s*([KkMmBbTt]?)")

    number = tonumber(number)
    if not number then return nil end

    local scale = {
        K = 1e3,
        M = 1e6,
        B = 1e9,
        T = 1e12
    }

    return number * (scale[suffix:upper()] or 1)
end

local function currentCash()
    local stats = player:FindFirstChild("leaderstats")

    if stats then
        for _, name in ipairs({"Cash", "Money"}) do
            local value = stats:FindFirstChild(name)
            if value and (
                value:IsA("NumberValue")
                or value:IsA("IntValue")
            ) then
                return value.Value
            end
        end
    end

    for _, name in ipairs({"Cash", "Money"}) do
        local value = player:GetAttribute(name)
        if type(value) == "number" then return value end
    end

    return cachedCash
end

local function buttonExcluded(button)
    local name = button.Name:lower()
    if name:sub(1, 9) == "teammate_" then return true end
    if button:GetAttribute("IsTeammate") == true then return true end
    if button:GetAttribute("CanPurchase") == false then return true end

    local function excluded(s)
        s = tostring(s):lower():gsub("[^%w]", "")
        return s:find("2xcash", 1, true)
            or s:find("doublecash", 1, true)
            or s:find("cashmultiplier", 1, true)
            or s:find("2timescash", 1, true)
    end

    if excluded(button.Name) then return true end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if excluded(obj.Text) then return true end
        end
    end

    return false
end

local function buyPrice(button)
    local price = parseMoney(button:GetAttribute("Price"))
    if price then return price end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") then
            price = parseMoney(obj.Text)
            if price then return price end
        end
    end
end

local function buyPart(button)
    local base = button:FindFirstChild("Base")
    if base and base:IsA("BasePart") then return base end
    if button:IsA("BasePart") then return button end
    return button:FindFirstChildWhichIsA("BasePart", true)
end

local function runBuy(token)
    local failed = {}
    local lastCash

    while alive and autoBuy and token == buyToken do
        if busy then
            task.wait(0.15)
            continue
        end

        local cash = currentCash()
        if cash ~= lastCash then
            failed = {}
            lastCash = cash
        end

        local folder = workspace:FindFirstChild(
            "__TycoonButtons_" .. tostring(player.UserId)
        )

        local chosen, part, cheapest = nil, nil, math.huge

        if folder and cash then
            for _, button in ipairs(folder:GetChildren()) do
                if not failed[button] and not buttonExcluded(button) then
                    local price = buyPrice(button)
                    local candidate = buyPart(button)

                    if price and price <= cash
                        and price < cheapest and candidate then
                        chosen, part, cheapest = button, candidate, price
                    end
                end
            end
        end

        if not chosen then
            task.wait(0.5)
            continue
        end

        busy = true
        local root = rootPart()
        local previous = root and root.CFrame
        teleport(part)

        local deadline = os.clock() + 2
        local purchased = false

        while alive and autoBuy and token == buyToken
            and os.clock() < deadline do

            if not chosen.Parent or chosen.Parent ~= folder then
                purchased = true
                break
            end
            task.wait(0.05)
        end

        restore(root, previous)
        busy = false

        if not purchased then failed[chosen] = true end
        task.wait(0.12)
    end
end

