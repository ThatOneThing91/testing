-- Rod identification

local function isBroken(item)
    if item.Broken == true
        or item.IsBroken == true
        or tonumber(item.Condition) == 0 then
        return true
    end

    local mutators = item.Mutators or item.mutators

    if type(mutators) == "table" then
        for key, value in pairs(mutators) do
            if tostring(key):lower() == "broken"
                and value ~= false then
                return true
            end

            if type(value) == "string"
                and value:lower() == "broken" then
                return true
            end

            if type(value) == "table" then
                local name = value.Name or value.name
                    or value.Mutator or value.mutator

                if tostring(name):lower() == "broken" then
                    return true
                end
            end
        end
    end

    return false
end

-- Inspect ModuleScript names and attributes.
-- Does not require or execute unknown modules.

local function discoverRodDefinitions()
    local discovered = 0
    local modules = RS:FindFirstChild("Modules")

    if not modules then
        return 0
    end

    for _, obj in ipairs(modules:GetDescendants()) do
        local name = obj.Name:lower()

        if name:find("fishing")
            or name:find("rod") then

            if obj:IsA("ModuleScript")
                or obj:IsA("Folder") then

                local attributes = obj:GetAttributes()

                for key, value in pairs(attributes) do
                    local field = tostring(key):lower()

                    if field == "itemid"
                        or field == "item_id" then

                        local id = tonumber(value)

                        if id and not knownRodIds[id] then
                            knownRodIds[id] = true
                            discovered += 1
                        end
                    end
                end
            end
        end
    end

    return discovered
end

local function findRod()
    local ok, inventory = pcall(function()
        return remotes.Inventory:InvokeServer()
    end)

    if not ok or type(inventory) ~= "table" then
        return nil, "Inventory request failed"
    end

    local items = inventory.Items
        or inventory.items
        or inventory.Inventory
        or inventory.inventory
        or inventory

    if type(items) ~= "table" then
        return nil, "Unknown inventory format"
    end

    local available = {}

    for guid, item in pairs(items) do
        if type(item) == "table" then
            local id = tonumber(
                item.ItemId or item.itemId
            )

            if id and knownRodIds[id]
                and not isBroken(item) then

                local itemGuid = item.UUID
                    or item.uuid
                    or item.Guid
                    or item.guid
                    or guid

                if type(itemGuid) == "string" then
                    table.insert(available, {
                        guid = itemGuid,
                        itemId = id,
                        condition = tonumber(
                            item.Condition
                        ) or 0
                    })
                end
            end
        end
    end

    table.sort(available, function(a, b)
        return a.condition > b.condition
    end)

    if #available > 0 then
        return available[1]
    end

    return nil, "No usable known rods found"
end

local function equipRod()
    local rod, err = findRod()

    if not rod then
        return false, err
    end

    if rod.guid ~= currentRod then
        setStatus("Equipping rod...")

        local ok = pcall(function()
            remotes.Equip:FireServer(rod.guid)
        end)

        if not ok then
            return false, "Equip remote failed"
        end

        currentRod = rod.guid
        task.wait(0.35)
    end

    setDetail(
        "Rod ItemId: " .. rod.itemId
        .. " | Condition: " .. rod.condition
    )

    return true
end

local function stopFishing(cancel)
    running = false
    generation += 1
    phase = "idle"
    currentCastId = nil
    updateToggle()

    if cancel and remotes.Cancel then
        pcall(function()
            remotes.Cancel:FireServer()
        end)
    end
end

local function connectState()
    if stateConnection then
        stateConnection:Disconnect()
    end

    stateConnection = remotes.State.OnClientEvent:Connect(
        function(state, data)
            if destroyed or not running then return end
            if type(data) ~= "table" then data = {} end

            if state == "cast" then
                if phase ~= "casting"
                    and phase ~= "waiting" then
                    return
                end

                currentCastId = data.castId
                phase = "waiting"
                phaseTime = os.clock()

                setStatus("Waiting for bite...")
                setDetail(
                    "Bite estimate: "
                    .. tostring(data.biteIn)
                    .. " seconds"
                )

            elseif state == "reel" then
                if phase ~= "casting"
                    and phase ~= "waiting" then
                    return
                end

                if currentCastId ~= nil
                    and data.castId ~= nil
                    and currentCastId ~= data.castId then
                    return
                end

                phase = "result_sent"
                phaseTime = os.clock()

                setStatus(
                    "Reeling: "
                    .. tostring(data.itemName or "Unknown")
                )

                pcall(function()
                    remotes.Result:FireServer("caught")
                end)

            elseif state == "done" then
                if phase == "idle"
                    or phase == "preparing" then
                    return
                end

                if tostring(data.reason) == "caught" then
                    catches += 1

                    setStatus(
                        "Caught: "
                        .. tostring(data.itemName or "Unknown")
                    )
                else
                    setStatus(
                        "Fishing ended: "
                        .. tostring(data.reason)
                    )
                end

                phase = "done"
                phaseTime = os.clock()
                currentCastId = nil
                updateStats()
            end
        end
    )
end

local function startFishing()
    local ok, err = loadRemotes()

    if not ok then
        setStatus(err)
        return
    end

    if not getWater() then
        setStatus("Water target not found")
        return
    end

    discoverRodDefinitions()
    connectState()

    running = true
    generation += 1
    phase = "idle"
    currentRod = nil

    updateToggle()
    setStatus("Starting...")
end

toggle.MouseButton1Click:Connect(function()
    if running then
        stopFishing(true)
        setStatus("Stopped")
    else
        startFishing()
    end
end)

scanButton.MouseButton1Click:Connect(function()
    local added = discoverRodDefinitions()

    local count = 0
    for _ in pairs(knownRodIds) do
        count += 1
    end

    setStatus("Rod scan complete")
    setDetail(
        "Known rod IDs: " .. count
        .. " | Newly discovered: " .. added
    )
end)

-- Main worker

task.spawn(function()
    while not destroyed do
        if not running then
            task.wait(0.1)

        elseif phase == "idle" or phase == "done" then
            local token = generation
            phase = "preparing"

            local equipped, err = equipRod()

            if not running or token ~= generation then
                continue
            end

            if not equipped then
                stopFishing(false)
                setStatus(err or "Rod unavailable")
                continue
            end

            local water = getWater()

            if not water then
                stopFishing(false)
                setStatus("Water target missing")
                continue
            end

            phase = "casting"
            phaseTime = os.clock()
            casts += 1
            updateStats()
            setStatus("Casting...")

            local success = pcall(function()
                remotes.Cast:FireServer(
                    water,
                    CAST_POSITION
                )
            end)

            if not success then
                stopFishing(false)
                setStatus("Cast failed")
            end

        elseif phase == "casting" then
            if os.clock() - phaseTime > 8 then
                stopFishing(true)
                setStatus("Cast timeout")
            end

            task.wait(0.1)

        elseif phase == "waiting" then
            if os.clock() - phaseTime > 35 then
                stopFishing(true)
                setStatus("Bite timeout")
            end

            task.wait(0.1)

        elseif phase == "result_sent" then
            if os.clock() - phaseTime > 12 then
                stopFishing(true)
                setStatus("Catch confirmation timeout")
            end

            task.wait(0.1)

        else
            task.wait(0.1)
        end
    end
end)

-- Cleanup

local function cleanup()
    if destroyed then return end

    stopFishing(true)
    destroyed = true

    if stateConnection then
        stateConnection:Disconnect()
    end

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    gui:Destroy()

    if env.SH_AutoFishingCleanup == cleanup then
        env.SH_AutoFishingCleanup = nil
    end
end

