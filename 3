local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GetPlayerInventory = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Inventory")
    :WaitForChild("GetPlayerInventory")

local function IsDirtyItem(item)
    if typeof(item) ~= "table" then
        return false
    end

    local mutators = item.Mutators

    if typeof(mutators) ~= "table" then
        return false
    end

    for _, mutator in pairs(mutators) do
        if typeof(mutator) == "table" then
            if (mutator.name or mutator.Name) == "Dirty" then
                return true
            end
        end
    end

    return false
end

local function Scan(value, path, seen)
    if typeof(value) ~= "table" then
        return
    end

    seen = seen or {}

    if seen[value] then
        return
    end

    seen[value] = true

    if IsDirtyItem(value) then
        print("")
        print("========================================")
        print("              DIRTY ITEM")
        print("========================================")
        print("PATH:", path)

        print("")

        for key, child in pairs(value) do
            print(
                "FIELD:",
                tostring(key),
                "=>",
                tostring(child)
            )
        end

        print("")

        if typeof(value.Mutators) == "table" then
            print("MUTATORS:")

            for key, mutator in pairs(value.Mutators) do
                print(
                    "  ",
                    tostring(key),
                    "=>",
                    tostring(mutator)
                )

                if typeof(mutator) == "table" then
                    for k, v in pairs(mutator) do
                        print(
                            "      ",
                            tostring(k),
                            "=",
                            tostring(v)
                        )
                    end
                end
            end
        end

        print("========================================")
    end

    for key, child in pairs(value) do
        if typeof(child) == "table" then
            Scan(
                child,
                path .. "." .. tostring(key),
                seen
            )
        end
    end
end

print("Getting inventory...")

local success, inventory = pcall(function()
    return GetPlayerInventory:InvokeServer()
end)

if not success then
    warn("FAILED TO GET INVENTORY:", inventory)
    return
end

print("Inventory received.")
print("Scanning...")

Scan(inventory, "Inventory")

print("")
print("========================================")
print("SCAN FINISHED")
print("========================================")
