local function findPath(...)
    local obj = RS

    for _, name in ipairs({...}) do
        obj = obj:FindFirstChild(name)
        if not obj then return nil end
    end

    return obj
end

local function loadRemotes()
    remotes.Cast = findPath(
        "Events", "Misc", "FishingCast"
    )
    remotes.Result = findPath(
        "Events", "Misc", "FishingResult"
    )
    remotes.Cancel = findPath(
        "Events", "Misc", "FishingCancel"
    )
    remotes.State = findPath(
        "Events", "Misc", "FishingState"
    )
    remotes.Inventory = findPath(
        "Events", "Inventory", "GetPlayerInventory"
    )
    remotes.Equip = findPath(
        "Events", "Inventory", "EquipItem"
    )

    local expected = {
        Cast = "RemoteEvent",
        Result = "RemoteEvent",
        Cancel = "RemoteEvent",
        State = "RemoteEvent",
        Inventory = "RemoteFunction",
        Equip = "RemoteEvent"
    }

    for name, class in pairs(expected) do
        if not remotes[name] then
            return false, "Missing remote: " .. name
        end

        if not remotes[name]:IsA(class) then
            return false, "Wrong remote type: " .. name
        end
    end

    return true
end

