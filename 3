local function centerPizza()
    local gui = pizzaGui()
    if not gui or not gui.Enabled then return end

    local root = gui:FindFirstChild("Root")
    if not root or not root:IsA("GuiObject") then return end

    if not originalGui[root] then
        originalGui[root] = {
            position = root.Position,
            anchor = root.AnchorPoint
        }
    end

    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.Position = UDim2.fromScale(0.5, 0.5)
end

local function restorePizzaGui()
    for frame, original in pairs(originalGui) do
        if frame and frame.Parent then
            pcall(function()
                frame.AnchorPoint = original.anchor
                frame.Position = original.position
            end)
        end
        originalGui[frame] = nil
    end
end

-- EXIT USING THE ACTUAL ROOT.FOOTER.EXIT CONTROL

local function activateExit()
    local button = exitButton()
    if not button then return false, "Exit button missing" end

    -- Try executor-exposed button handlers first.
    if type(getconnections) == "function" then
        for _, signal in ipairs({
            button.Activated,
            button.MouseButton1Click
        }) do
            local ok, handlers = pcall(getconnections, signal)

            if ok and type(handlers) == "table" then
                for _, handler in ipairs(handlers) do
                    if handler.Function then
                        local success = pcall(handler.Function)
                        if success then
                            return true, "Exit handler called"
                        end
                    end
                end
            end
        end
    end

    if type(firesignal) == "function" then
        local ok = pcall(firesignal, button.Activated)
        if ok then return true, "Exit signal fired" end

        ok = pcall(firesignal, button.MouseButton1Click)
        if ok then return true, "Exit click fired" end
    end

    -- Real screen input fallback. Only click when the
    -- minigame and Exit button are actually visible.
    if pizzaVisible() and button.Visible
        and button.AbsoluteSize.X > 0
        and button.AbsoluteSize.Y > 0 then

        local center = button.AbsolutePosition
            + button.AbsoluteSize / 2

        local ok = pcall(function()
            VIM:SendMouseButtonEvent(
                center.X, center.Y, 0, true, game, 0
            )
            task.wait(0.06)
            VIM:SendMouseButtonEvent(
                center.X, center.Y, 0, false, game, 0
            )
        end)

        if ok then return true, "Exit screen click sent" end
    end

    return false, "Unable to activate Exit"
end

-- PIZZA SESSION

local pizza = {
    session = nil,
    phase = nil,
    progress = 0,
    remaining = {},
    status = "Idle",
    state = "idle",
    startedAt = 0,
    lastPromptAt = 0,
    lastExitAt = 0,
    paidAt = 0,
    doughStep = 0,
    lastToppingAt = 0,
    completedAt = 0,
    completedCount = 0,
    exitTries = 0,
    closeConfirmedAt = 0,
    lastEventAt = 0
}

local phaseOrder = {
    Dough = 1,
    Sauce = 2,
    Cheese = 3,
    Toppings = 4
}

local nextPhase = {
    Dough = "Sauce",
    Sauce = "Cheese",
    Cheese = "Toppings"
}

local function resetPizza()
    pizza.session = nil
    pizza.phase = nil
    pizza.progress = 0
    pizza.remaining = {}
    pizza.status = "Waiting for station"
    pizza.state = "idle"
    pizza.startedAt = 0
    pizza.lastPromptAt = 0
    pizza.lastExitAt = 0
    pizza.paidAt = 0
    pizza.doughStep = 0
    pizza.lastToppingAt = 0
    pizza.completedAt = 0
    pizza.exitTries = 0
    pizza.closeConfirmedAt = 0
    pizza.lastEventAt = 0
end

local function setPhase(phase, force)
    if pizza.state ~= "making" then return end

    local current = phaseOrder[pizza.phase] or 0
    local incoming = phaseOrder[phase] or 0

    if incoming == 0 then return end
    if not force and incoming <= current then return end

    pizza.phase = phase
    pizza.progress = 0
    pizza.completedAt = 0
    pizza.status = phase

    if phase == "Dough" then
        pizza.doughStep = 0
    elseif phase == "Toppings" then
        pizza.lastToppingAt = 0
    end
end

local function stationPrompt()
    local objects = plotObjects()
    if not objects then return nil end

    local best, highest = nil, -1

    for _, station in ipairs(objects:GetChildren()) do
        if station.Name:match("^Pizza Prep Station %d+$") then
            local number = tonumber(station.Name:match("(%d+)$")) or 0
            local start = station:FindFirstChild("StartGame", true)
            local prompt = start and start:FindFirstChildWhichIsA(
                "ProximityPrompt", true
            )

            if prompt and prompt.Enabled and number > highest then
                best, highest = prompt, number
            end
        end
    end

    return best
end

local function promptBase(prompt)
    local parent = prompt.Parent
    if parent:IsA("BasePart") then return parent end
    if parent:IsA("Attachment")
        and parent.Parent:IsA("BasePart") then
        return parent.Parent
    end

    local model = prompt:FindFirstAncestorOfClass("Model")
    if model then
        return model.PrimaryPart
            or model:FindFirstChildWhichIsA("BasePart", true)
    end
end

local function startPizza(token)
    if pizza.state ~= "idle" or busy then return end

    pizza.state = "opening"
    pizza.status = "Firing pizza prompt"
    pizza.lastPromptAt = os.clock()

    local prompt = stationPrompt()

    if not prompt then
        pizza.status = "Station prompt unavailable"
        pizza.state = "idle"
        return
    end

    busy = true
    local base = promptBase(prompt)

    if base then teleport(base) end
    task.wait(0.25)

    if alive and autoPizza and token == pizzaToken then
        promptFire(prompt)
    end

    busy = false
end

local function recipeToppings()
    local result = {}
    local gui = pizzaGui()
    local root = gui and gui:FindFirstChild("Root")
    local recipe = root and root:FindFirstChild("Recipe")
    local order = recipe and recipe:FindFirstChild("Order")

    local name = order and order:IsA("TextLabel")
        and order.Text:lower() or ""

    for _, entry in pairs(config.Recipes or {}) do
        if type(entry) == "table" then
            local recipeName = tostring(entry.Name or ""):lower()
            if recipeName ~= ""
                and name:find(recipeName, 1, true) then
                for topping, count in pairs(entry.Toppings or {}) do
                    result[topping] = count
                end
                break
            end
        end
    end

    return result
end

local function sendPizza(action, point, topping)
    if not alive or not autoPizza
        or pizza.state ~= "making"
        or not pizza.session then return end

    pizzaRemote:FireServer(
        pizza.session, action, point, topping
    )
end

local function markPaid()
    if pizza.state ~= "making" then return end

    pizza.completedCount += 1
    pizza.state = "exiting"
    pizza.phase = "Finished"
    pizza.progress = 1
    pizza.paidAt = os.clock()
    pizza.lastExitAt = 0
    pizza.exitTries = 0
    pizza.status = "Paid - exiting minigame"
end

bind(pizzaRemote.OnClientEvent, function(action, session, a, b, c)
    if not alive or not autoPizza then return end

    if action == "Begin" then
        if pizza.state ~= "opening"
            or type(session) ~= "string" then
            return
        end

        pizza.session = session
        pizza.state = "making"
        pizza.phase = nil
        pizza.progress = 0
        pizza.remaining = {}
        pizza.startedAt = os.clock()
        pizza.lastEventAt = os.clock()
        setPhase("Dough", true)
        centerPizza()
        return
    end

    if session ~= pizza.session then return end
    pizza.lastEventAt = os.clock()

    if action == "Paid" then
        markPaid()
        return
    end

    if action == "End" or action == "Cancel" then
        -- Server session has ended.
        if pizza.state == "exiting"
            or pizza.state == "waitingClose" then
            pizza.session = nil
            pizza.state = "waitingClose"
            pizza.status = "Waiting for minigame to close"
        elseif pizza.state == "making" then
            pizza.session = nil
            pizza.state = "waitingClose"
            pizza.status = "Session ended"
        end
        return
    end

    -- A Round event does not start another pizza.
    -- This version deliberately exits and re-prompts.
    if action == "Round" then return end

    if pizza.state ~= "making" then return end

    if action == "Phase" then
        if type(a) == "string" then
            setPhase(a)

            if a == "Toppings" then
                pizza.remaining = recipeToppings()
            end
        end

    elseif action == "Progress" then
        if type(a) == "string" and type(b) == "number" then
            setPhase(a)
            if pizza.phase == a then
                pizza.progress = math.max(
                    pizza.progress,
                    math.clamp(b, 0, 1)
                )

                if pizza.progress >= 1
                    and pizza.completedAt == 0 then
                    pizza.completedAt = os.clock()
                end
            end
        end

    elseif action == "PourComplete" then
        if a == pizza.phase then
            pizza.progress = 1
            if pizza.completedAt == 0 then
                pizza.completedAt = os.clock()
            end
        end

    elseif action == "Topping" then
        if type(a) == "string" and type(c) == "number" then
            pizza.remaining[a] = c
        end
    end
end)

local function runPizza(token)
    while alive and autoPizza and token == pizzaToken do
        local state = pizza.state
        local now = os.clock()

        if state == "idle" then
            if not pizzaVisible()
                and now - pizza.lastPromptAt >= 1.5 then
                startPizza(token)
            end

            task.wait(0.1)

        elseif state == "opening" then
            if pizza.session then
                pizza.state = "making"
            elseif now - pizza.lastPromptAt >= 3 then
                pizza.state = "idle"
                pizza.status = "Retrying station prompt"
            end
            task.wait(0.1)

        elseif state == "exiting" or state == "waitingClose" then
            -- The GUI being closed is required before
            -- we attempt to start another session.
            if not pizzaVisible() then
                if pizza.closeConfirmedAt == 0 then
                    pizza.closeConfirmedAt = now
                end

                -- Give the server a brief chance to finish
                -- the old session before re-prompting.
                if now - pizza.closeConfirmedAt >= 0.4 then
                    pizza.session = nil
                    pizza.phase = nil
                    pizza.progress = 0
                    pizza.state = "idle"
                    pizza.status = "Closed - restarting station"
                    pizza.lastPromptAt = now - 1.5
                    pizza.closeConfirmedAt = 0
                    restorePizzaGui()
                end
            else
                pizza.closeConfirmedAt = 0

                if now - pizza.lastExitAt >= 1.2 then
                    pizza.lastExitAt = now
                    pizza.exitTries += 1

                    local success, method = activateExit()

                    if success then
                        pizza.status = "Exiting: " .. method
                    else
                        pizza.status = method
                    end
                end
            end

            task.wait(0.08)

        elseif state == "making" then
            centerPizza()

            local phase = pizza.phase

            if nextPhase[phase]
                and pizza.progress >= 1
                and pizza.completedAt > 0
                and now - pizza.completedAt >= 0.1 then

                local target = nextPhase[phase]
                setPhase(target)

                if target == "Toppings" then
                    pizza.remaining = recipeToppings()
                end

                phase = target
            end

            if phase == "Dough" then
                if pizza.progress < 1 then
                    pizza.doughStep += 1
                    local angle = pizza.doughStep * 0.28
                    local radius = 0.24

                    sendPizza(
                        "Knead",
                        Vector2.new(
                            math.cos(angle) * radius,
                            math.sin(angle) * radius
                        ),
                        nil
                    )
                end
                task.wait(0.055)

            elseif phase == "Sauce" then
                if pizza.progress < 1 then
                    sendPizza(
                        "Pour",
                        Vector2.new(-0.08625, -0.2192),
                        nil
                    )
                end
                task.wait(0.035)

            elseif phase == "Cheese" then
                if pizza.progress < 1 then
                    sendPizza(
                        "Pour",
                        Vector2.new(-0.08625, -0.2192),
                        nil
                    )
                end
                task.wait(0.055)

            elseif phase == "Toppings" then
                local chosen

                for _, name in ipairs({
                    "Pepperoni", "Mushroom", "Olive"
                }) do
                    if (pizza.remaining[name] or 0) > 0 then
                        chosen = name
                        break
                    end
                end

                if chosen
                    and now - pizza.lastToppingAt >= 0.12 then
                    sendPizza(
                        "Topping",
                        Vector2.new(0.2, 0.17),
                        chosen
                    )
                    pizza.lastToppingAt = now
                end

                task.wait(0.04)
            else
                task.wait(0.06)
            end
        else
            task.wait(0.1)
        end
    end
end

-- CRATES

local function findCrates()
    local result = {}

    for _, crate in ipairs(workspace:GetChildren()) do
        if crate.Name == "Crate" then
            local main = crate:FindFirstChild("Main")
            local prompt = main and main:FindFirstChild("Prompt")

            if main and main:IsA("BasePart")
                and prompt and prompt:IsA("ProximityPrompt")
                and prompt.Enabled then
                table.insert(result, {
                    crate = crate,
                    main = main,
                    prompt = prompt
                })
            end
        end
    end

    return result
end

local function crateGone(entry)
    return not entry.crate.Parent
        or not entry.prompt.Parent
        or not entry.prompt.Enabled
end

local function runCrates(token)
    while alive and autoCrates and token == crateToken do
        if busy then
            task.wait(0.15)
            continue
        end

        for _, entry in ipairs(findCrates()) do
            if not alive or not autoCrates
                or token ~= crateToken then break end

            if not crateGone(entry) then
                busy = true
                local root = rootPart()
                local previous = root and root.CFrame

                while alive and autoCrates
                    and token == crateToken
                    and not crateGone(entry) do

                    teleport(entry.main)
                    task.wait(0.25)
                    promptFire(entry.prompt)

                    local deadline = os.clock() + 1.5
                    while os.clock() < deadline
                        and not crateGone(entry)
                        and alive and autoCrates do
                        task.wait(0.1)
                    end

                    if crateGone(entry) then break end
                    task.wait(0.35)
                end

                restore(root, previous)
                busy = false
            end
        end

        task.wait(0.5)
    end
end

