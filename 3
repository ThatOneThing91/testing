    buyButton.BackgroundColor3 = autoBuy
        and Color3.fromRGB(40, 135, 85)
        or Color3.fromRGB(48, 51, 65)

    pizzaButton.BackgroundColor3 = autoPizza
        and Color3.fromRGB(40, 135, 85)
        or Color3.fromRGB(48, 51, 65)

    crateButton.BackgroundColor3 = autoCrates
        and Color3.fromRGB(40, 135, 85)
        or Color3.fromRGB(48, 51, 65)

    if autoPizza then
        status.Text = "Pizza: " .. pizza.status
            .. " (" .. math.floor(pizza.progress * 100) .. "%)"
    else
        status.Text = "Pizza: Idle"
    end
end

bind(cashButton.MouseButton1Click, function()
    task.spawn(collectCash)
end)

bind(buyButton.MouseButton1Click, function()
    autoBuy = not autoBuy
    buyToken += 1
    if autoBuy then task.spawn(runBuy, buyToken) end
    refresh()
end)

bind(pizzaButton.MouseButton1Click, function()
    autoPizza = not autoPizza
    pizzaToken += 1
    resetPizza()

    if autoPizza then
        task.spawn(runPizza, pizzaToken)
    else
        restorePizzaGui()
    end

    refresh()
end)

bind(crateButton.MouseButton1Click, function()
    autoCrates = not autoCrates
    crateToken += 1
    if autoCrates then task.spawn(runCrates, crateToken) end
    refresh()
end)

bind(UIS.InputBegan, function(input, processed)
    if processed or not alive then return end

    if input.KeyCode == Enum.KeyCode.P then
        task.spawn(collectCash)
    elseif input.KeyCode == Enum.KeyCode.Comma then
        frame.Visible = not frame.Visible
    end
end)

local tycoonFolder = RS:FindFirstChild("Tycoon")
local buttonRemote = tycoonFolder
    and tycoonFolder:FindFirstChild("TycoonButtonEvent")

if buttonRemote then
    bind(buttonRemote.OnClientEvent, function(action, data)
        if type(data) ~= "table" then return end
        if action ~= "Snapshot" and action ~= "State" then return end

        local plot, slot = plotInfo()
        if plot and data.tycoon == plot
            and data.slot == slot
            and type(data.cash) == "number" then
            cachedCash = data.cash
        end
    end)
end

task.spawn(function()
    while alive do
        refresh()
        task.wait(0.2)
    end
end)

_G.CheeseHubCleanup = function()
    alive = false
    autoBuy = false
    autoPizza = false
    autoCrates = false

    buyToken += 1
    pizzaToken += 1
    crateToken += 1

    restorePizzaGui()

    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(connections)
    gui:Destroy()
    _G.CheeseHubCleanup = nil
end

refresh()
