local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Wash = ReplicatedStorage:WaitForChild("Events"):WaitForChild("Wash")

local StartWash = Wash:WaitForChild("StartWash")
local CollectWash = Wash:WaitForChild("CollectWash")
local ClaimWashedItem = Wash:WaitForChild("ClaimWashedItem")
local GetSlotState = Wash:WaitForChild("GetSlotState")
local GetWashableItems = Wash:WaitForChild("GetWashableItems")

local MAX_SLOTS = 3

local function log(...)
    print("[AUTO WASH]", ...)
end

-- Check whether an item contains a particular mutator
local function HasMutator(item, wanted)
    if type(item) ~= "table" then
        return false
    end

    local mutators = item.Mutators or item.mutators

    if type(mutators) ~= "table" then
        return false
    end

    for _, mutator in pairs(mutators) do
        if type(mutator) == "table" then
            local name = mutator.name or mutator.Name

            if name == wanted then
                return true
            end
        end
    end

    return false
end

-- Get current wash slot state
local function GetSlots()
    local ok, result = pcall(function()
        return GetSlotState:InvokeServer()
    end)

    if not ok then
        warn("[AUTO WASH] GetSlotState failed:", result)
        return nil
    end

    return result
end

-- Find dirty, non-broken inventory items
local function GetDirtyItems()
    local ok, result = pcall(function()
        return GetWashableItems:InvokeServer()
    end)

    if not ok then
        warn("[AUTO WASH] GetWashableItems failed:", result)
        return {}
    end

    local found = {}

    if type(result) ~= "table" then
        return found
    end

    local items = result.items or result.Items or result

    if type(items) ~= "table" then
        return found
    end

    for _, entry in pairs(items) do
        if type(entry) == "table" then
            local source = entry.source or entry.Source

            if source == "Inventory" then
                local data = entry.data or entry.Data or entry

                local isDirty = HasMutator(data, "Dirty")
                local isBroken = HasMutator(data, "Broken")

                if isDirty and not isBroken then
                    local guid =
                        entry.guid
                        or entry.GUID
                        or entry.itemGUID
                        or entry.ItemGUID

                    if guid then
                        table.insert(found, guid)
                    end
                end
            end
        end
    end

    return found
end

-- Start one item
local function StartItem(slot, guid)
    log("Starting wash | Slot:", slot, "| GUID:", guid)

    local ok, result = pcall(function()
        return StartWash:InvokeServer(slot, guid, "Inventory")
    end)

    if ok then
        log("StartWash result:", result)
    else
        warn("[AUTO WASH] StartWash failed:", result)
    end

    return ok
end

-- Collect and claim one slot
local function FinishSlot(slot)
    log("Finishing slot", slot)

    local collectOK, collectResult = pcall(function()
        return CollectWash:InvokeServer(slot)
    end)

    if collectOK then
        log("CollectWash slot", slot, "result:", collectResult)
    else
        warn("[AUTO WASH] CollectWash failed:", collectResult)
    end

    task.wait(0.25)

    local claimOK, claimResult = pcall(function()
        return ClaimWashedItem:InvokeServer(slot)
    end)

    if claimOK then
        log("ClaimWashedItem slot", slot, "result:", claimResult)
    else
        warn("[AUTO WASH] ClaimWashedItem failed:", claimResult)
    end

    return collectOK and claimOK
end

-- Determine whether a slot is occupied and/or finished
local function GetSlotInfo(slotState, slotNumber)
    if type(slotState) ~= "table" then
        return nil
    end

    local slot = slotState[slotNumber]

    if slot == nil then
        slot = slotState[tostring(slotNumber)]
    end

    return slot
end

log("========================================")
log("       AUTO WASH TEST STARTED")
log("========================================")

-- First collect anything already finished
local initialSlots = GetSlots()

if initialSlots then
    for slot = 1, MAX_SLOTS do
        local info = GetSlotInfo(initialSlots, slot)

        if type(info) == "table" then
            local startTime = info.StartTime or info.startTime
            local duration = info.Duration or info.duration

            if startTime and duration then
                if os.time() >= startTime + duration then
                    log("Slot", slot, "appears complete. Collecting...")
                    FinishSlot(slot)
                    task.wait(0.5)
                end
            end
        end
    end
end

-- Main loop
while true do
    local slots = GetSlots()

    if slots then
        -- First handle completed slots
        for slot = 1, MAX_SLOTS do
            local info = GetSlotInfo(slots, slot)

            if type(info) == "table" then
                local startTime = info.StartTime or info.startTime
                local duration = info.Duration or info.duration

                if startTime and duration then
                    if os.time() >= startTime + duration then
                        log("Slot", slot, "wash complete!")

                        FinishSlot(slot)

                        task.wait(0.5)

                        -- Refresh slot data after claiming
                        slots = GetSlots() or slots
                    end
                end
            end
        end

        -- Find currently empty slots
        local emptySlots = {}

        for slot = 1, MAX_SLOTS do
            local info = GetSlotInfo(slots, slot)

            if info == nil then
                table.insert(emptySlots, slot)
            elseif type(info) == "table" then
                -- Some versions represent an empty slot as an empty table
                if next(info) == nil then
                    table.insert(emptySlots, slot)
                end
            end
        end

        if #emptySlots > 0 then
            local dirtyItems = GetDirtyItems()

            if #dirtyItems > 0 then
                log("Found", #dirtyItems, "washable Dirty item(s).")

                for _, slot in ipairs(emptySlots) do
                    local guid = table.remove(dirtyItems, 1)

                    if not guid then
                        break
                    end

                    StartItem(slot, guid)
                    task.wait(0.5)
                end
            else
                log("No Dirty non-Broken items available.")
            end
        end
    end

    task.wait(1)
end
