--------------------------------------------------
-- START + VERIFY ONE SLOT
--------------------------------------------------

local function startAndVerify(slot, guid)
    print("[AUTO WASH] Slot", slot, "sending StartWash:", guid)

    local ok, result = pcall(function()
        return StartWash:InvokeServer(
            slot,
            guid,
            "Inventory",
            nil
        )
    end)

    if not ok then
        warn("[AUTO WASH] Slot", slot, "StartWash error:", result)
        return false
    end

    --------------------------------------------------
    -- GIVE SERVER TIME TO UPDATE SLOT
    --------------------------------------------------

    task.wait(0.75)

    --------------------------------------------------
    -- VERIFY SLOT ACTUALLY CHANGED
    --------------------------------------------------

    local state = getSlotState(slot)

    if state == nil then
        warn("[AUTO WASH] Slot", slot, "couldn't verify state")
        return false
    end

    print("[AUTO WASH] Slot", slot, "accepted by washer")

    return true
end

--------------------------------------------------
-- FILL EMPTY WASHERS SEQUENTIALLY
--------------------------------------------------

local function fillWashers()
    for slot = 1, 3 do
        if not running then
            return
        end

        --------------------------------------------------
        -- REFRESH WASHABLE ITEMS FOR EACH SLOT
        --------------------------------------------------

        local guid = getNextWashableGUID()

        if not guid then
            print(
                "[AUTO WASH] No more washable items for slot",
                slot
            )

            break
        end

        --------------------------------------------------
        -- START THIS SLOT
        --------------------------------------------------

        local started = startAndVerify(slot, guid)

        if started then
            print(
                "[AUTO WASH] Slot",
                slot,
                "loaded:",
                guid
            )

            --------------------------------------------------
            -- IMPORTANT:
            -- Let server/inventory update BEFORE asking
            -- GetWashableItems for the next slot.
            --------------------------------------------------

            task.wait(1)
        else
            reserved[guid] = nil

            warn(
                "[AUTO WASH] Slot",
                slot,
                "did not start"
            )

            task.wait(1)
        end
    end
end
