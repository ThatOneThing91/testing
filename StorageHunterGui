local TreeTeleportEnabled = false
local TreeTeleportDelay = 0.15

local TreeTargets = {}

local TreeItemOrder = {
    8,
    "Apple Tree",
    4,
    2,
    6,
    5,
    7,
    3
}

local TreeFolders = {}

local Trees =
    workspace
        ["BBOW Builder Assets"]
        ["Other Buildings and  Decoration"]
        .Trees

for _, folder in ipairs(
    Trees:GetChildren()
) do

    if folder:FindFirstChild(
        "Apple Tree"
    ) then

        table.insert(
            TreeFolders,
            folder
        )

    end

end

for _, folder in ipairs(
    TreeFolders
) do

    for _, itemIndex in ipairs(
        TreeItemOrder
    ) do

        local item

        if typeof(itemIndex) == "number" then

            item =
                folder:GetChildren()[
                    itemIndex
                ]

        else

            item =
                folder[itemIndex]

        end

        if item then

            table.insert(
                TreeTargets,
                item
            )

        end

    end

end

local function getTreePosition(object)

    if not object then
        return nil
    end

    if object:IsA("BasePart") then
        return object.Position
    end

    if object:IsA("Model") then
        return object:GetPivot().Position
    end

    local part =
        object:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

    if part then
        return part.Position
    end

    return nil
end

local function teleportToTree(object)

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return
    end

    local position =
        getTreePosition(object)

    if position then

        root.CFrame =
            CFrame.new(
                position +
                Vector3.new(0, 3, 0)
            )

    end
end

task.spawn(function()

    while true do

        if TreeTeleportEnabled then

            for _, target in ipairs(
                TreeTargets
            ) do

                if not TreeTeleportEnabled then
                    break
                end

                teleportToTree(target)

                task.wait(
                    TreeTeleportDelay
                )

            end

        else

            task.wait(0.1)

        end

    end

end)

