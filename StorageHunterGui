for _, garage in ipairs(
    Garages:GetChildren()
) do

    checkGarage(garage)

end

Garages.ChildAdded:Connect(
    function(garage)

        task.wait(0.5)

        checkGarage(garage)

    end
)

Garages.DescendantAdded:Connect(
    function(obj)

        if obj.Name == "PoliceWarning" then

            task.wait(0.2)

            for _, garage in ipairs(
                Garages:GetChildren()
            ) do

                checkGarage(garage)

            end

        end

    end
)

local function teleportToPoliceAuction()

    local target

    for garage in pairs(
        PoliceAuctions
    ) do

        if garage
            and garage.Parent == Garages then

            target = garage
            break

        end

    end

    if not target then

        notify(
            "Police Auction",
            "No police auction detected"
        )

        return

    end

    local entry =
        target:FindFirstChild(
            "EntrySquare"
        )

    if not entry then

        notify(
            "Police Auction",
            "No EntrySquare in " ..
            target.Name
        )

        return
    end

    local promptPart =
        entry:FindFirstChild(
            "PromptPart"
        )

    if not promptPart then

        notify(
            "Police Auction",
            "No PromptPart in " ..
            target.Name
        )

        return
    end

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not root then
        return
    end

    local destination

    if promptPart:IsA("BasePart") then

        destination = promptPart

    else

        destination =
            promptPart:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

    end

    if not destination then

        notify(
            "Police Auction",
            "PromptPart has no BasePart"
        )

        return
    end

    root.CFrame =
        destination.CFrame +
        Vector3.new(0, 3, 0)

    notify(
        "Police Auction",
        "Teleported to " ..
        target.Name
    )
end

