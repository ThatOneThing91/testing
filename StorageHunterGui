local InstantUnloadEnabled = false
local UnloadBusy = false

local Vehicles =
    ReplicatedStorage
        :WaitForChild("Events")
        :WaitForChild("Vehicles")

local GetVehicleItems =
    Vehicles:WaitForChild("GetVehicleItems")

local TransferVehicleItems =
    Vehicles:WaitForChild(
        "TransferVehicleItemsToInventory"
    )

local function getMyVehicle(vehicleId)

    for _, obj in ipairs(workspace:GetDescendants()) do

        if obj:IsA("Model") then

            local guid =
                obj:GetAttribute("VehicleGUID")
                or obj:GetAttribute("GUID")

            if guid and tostring(guid) == tostring(vehicleId) then
                return obj
            end

        end

    end

    return nil
end

local function unloadVehicle()

    if UnloadBusy then
        return
    end

    UnloadBusy = true

    local vehicleId =
        LocalPlayer:GetAttribute(
            "EquippedVehicle"
        )

    if not vehicleId or vehicleId == "" then

        notify(
            "Instant Unload",
            "No equipped vehicle found."
        )

        UnloadBusy = false
        return
    end

    local vehicle =
        getMyVehicle(vehicleId)

    if vehicle then

        local character =
            LocalPlayer.Character

        local humanoid =
            character and
            character:FindFirstChildOfClass(
                "Humanoid"
            )

        if humanoid then

            local seat =
                vehicle:FindFirstChild(
                    "DriveSeat"
                )
                or vehicle:FindFirstChildWhichIsA(
                    "VehicleSeat",
                    true
                )

            if seat and humanoid.SeatPart ~= seat then

                seat:Sit(humanoid)

                task.wait(0.2)

            end

        end

    end

    local success, items =
        pcall(function()
            return GetVehicleItems:InvokeServer(
                vehicleId
            )
        end)

    if not success or type(items) ~= "table" then

        notify(
            "Instant Unload",
            "Failed to get vehicle items."
        )

        UnloadBusy = false
        return
    end

    local guids = {}

    for guid in pairs(items) do
        table.insert(guids, guid)
    end

    if #guids == 0 then

        notify(
            "Instant Unload",
            "Vehicle is empty."
        )

        UnloadBusy = false
        return
    end

    notify(
        "Instant Unload",
        "Unloading " .. #guids .. " items..."
    )

    local transferSuccess =
        pcall(function()

            TransferVehicleItems:FireServer(
                guids
            )

        end)

    if transferSuccess then

        notify(
            "Instant Unload",
            "Successfully unloaded " ..
            #guids ..
            " items!"
        )

    else

        notify(
            "Instant Unload",
            "Unload failed."
        )

    end

    if vehicle then

        pcall(function()

            vehicle:SetAttribute(
                "CargoWeight",
                0
            )

        end)

    end

    task.wait(0.4)

    UnloadBusy = false
end

