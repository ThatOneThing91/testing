end

local function getHoop()

    local success, result =
        pcall(function()

            return workspace
                ["BBOW Builder Assets"]
                ["Other Buildings and  Decoration"]
                ["Basket Ball "]
                .Hoop
                .Ring

        end)

    if success then
        return result
    end

    return nil
end

local function lockToRim()

    local character =
        LocalPlayer.Character

    local hrp =
        character and
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    local hoop =
        getHoop()

    if not hrp or not hoop then
        return false
    end

    local direction =
        hoop.Position - hrp.Position

    direction =
        Vector3.new(
            direction.X,
            0,
            direction.Z
        )

    if direction.Magnitude > 0 then

        hrp.CFrame =
            CFrame.lookAt(
                hrp.Position,
                hrp.Position + direction
            )

    end

    return true
end

local function startBasketball()

    if BasketballRunning then
        return
    end

    BasketballRunning = true

    local character =
        LocalPlayer.Character

    local hrp =
        character and
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not hrp then

        BasketballRunning = false
        AutoBasketballEnabled = false

        notify(
            "Auto Basketball",
            "Character not found."
        )

        return
    end

    local ball =
        getBasketball()

    if not ball then

        BasketballRunning = false
        AutoBasketballEnabled = false

        notify(
            "Auto Basketball",
            "Basketball not found."
        )

        return
    end

    hrp.CFrame =
        CFrame.new(
            -274,
            1723,
            -590
        )

    task.wait(0.5)

    notify(
        "Auto Basketball",
        "ON"
    )

    task.spawn(function()

        while AutoBasketballEnabled do

            ball =
                getBasketball()

            if not ball then

                notify(
                    "Auto Basketball",
                    "Basketball not found."
                )

                break
            end

            lockToRim()

            task.wait(0.1)

            pcall(function()
                ball:Activate()
            end)

            task.wait(1)

            pcall(function()
                ball:Deactivate()
            end)

            task.wait(0.5)

        end

        BasketballRunning = false

    end)
end

