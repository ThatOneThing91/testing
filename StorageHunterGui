local AutoUnfavoriteEnabled = false
local AutoUnfavoriteRunning = false

local InventoryEvents =
    ReplicatedStorage
        :WaitForChild("Events")
        :WaitForChild("Inventory")

local GetInventory =
    InventoryEvents:WaitForChild(
        "GetPlayerInventory"
    )

local ToggleFavorite =
    InventoryEvents:WaitForChild(
        "ToggleFavoriteItem"
    )

local function isUUID(value)

    return type(value) == "string"
        and value:match(
            "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
        ) ~= nil

end

local function getItemId(key, value)

    if type(value) == "string"
        and isUUID(value) then

        return value

    end

    if type(key) == "string"
        and isUUID(key) then

        return key

    end

    return nil
end

local function collectIds(
    value,
    results,
    seen
)

    if type(value) ~= "table" then
        return
    end

    if seen[value] then
        return
    end

    seen[value] = true

    for key, child in pairs(value) do

        local id =
            getItemId(
                key,
                child
            )

        if id then
            results[id] = true
        end

        if type(child) == "table" then

            collectIds(
                child,
                results,
                seen
            )

        end

    end
end

local function getAllItemIds()

    local success, inventory =
        pcall(function()

            return GetInventory:InvokeServer()

        end)

    if not success then

        warn(
            "GetPlayerInventory failed:",
            inventory
        )

        return nil
    end

    local ids = {}

    collectIds(
        inventory,
        ids,
        {}
    )

    return ids
end

local function startAutoUnfavorite()

    if AutoUnfavoriteRunning then
        return
    end

    AutoUnfavoriteRunning = true

    notify(
        "Auto Unfavorite",
        "Reading full inventory..."
    )

    task.spawn(function()

        local ids =
            getAllItemIds()

        if not ids then

            AutoUnfavoriteEnabled = false
            AutoUnfavoriteRunning = false

            notify(
                "Auto Unfavorite",
                "Couldn't read inventory"
            )

            return
        end

        local list = {}

        for id in pairs(ids) do

            table.insert(
                list,
                id
            )

        end

        notify(
            "Auto Unfavorite",
            "Found " ..
            #list ..
            " items"
        )

        local completed = 0

        for _, itemId in ipairs(list) do

            if not AutoUnfavoriteEnabled then
                break
            end

            local success =
                pcall(function()

                    return ToggleFavorite:
                        InvokeServer(
                            itemId
                        )

                end)

            if success then
                completed += 1
            end

            if completed > 0
                and completed % 25 == 0 then

                notify(
                    "Auto Unfavorite",
                    "Progress: " ..
                    completed ..
                    "/" ..
                    #list
                )

            end

            task.wait(0.08)

        end

        if AutoUnfavoriteEnabled then

            AutoUnfavoriteEnabled = false

            notify(
                "Auto Unfavorite",
                "DONE - processed " ..
                completed ..
                " items"
            )

        else

            notify(
                "Auto Unfavorite",
                "STOPPED at " ..
                completed ..
                "/" ..
                #list
            )

        end

        AutoUnfavoriteRunning = false

    end)
end

