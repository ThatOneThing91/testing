local AutoBasketballEnabled = false
local BasketballRunning = false

local function getBasketball()

    local success, result =
        pcall(function()

            return workspace
                .ThatOneThing91
                :FindFirstChild(
                    "Basketball"
                )

        end)

    if success then
        return result
    end

