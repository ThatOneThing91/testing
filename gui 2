--//========================================================
--// TREE TELEPORT
--//========================================================

local function TreeTeleport()

    local success = pcall(function()

        local Assets =
            workspace
                :WaitForChild("BBOW Builder Assets")

        local Buildings =
            Assets
                :WaitForChild("Other Buildings and  Decoration")

        local Trees =
            Buildings:WaitForChild("Trees")

        local Order = {
            8,
            "Apple Tree",
            4,
            2,
            6,
            5,
            7,
            3
        }

        local Character = LocalPlayer.Character
        local HRP =
            Character
            and Character:FindFirstChild("HumanoidRootPart")

        if not HRP then
            return
        end

        for _, item in ipairs(Order) do

            if not Features["Tree Teleport"] then
                break
            end

            local target

            if typeof(item) == "number" then
                target = Trees:FindFirstChild(tostring(item))
            else
                target = Trees:FindFirstChild(item, true)
            end

            if target then

                local part

                if target:IsA("BasePart") then
                    part = target
                elseif target:IsA("Model") then
                    part =
                        target.PrimaryPart
                        or target:FindFirstChildWhichIsA(
                            "BasePart",
                            true
                        )
                else
                    part =
                        target:FindFirstChildWhichIsA(
                            "BasePart",
                            true
                        )
                end

                if part then

                    HRP.CFrame =
                        part.CFrame
                        + Vector3.new(0, 4, 0)

                    task.wait(0.35)
                end
            end
        end

    end)

    if not success then
        Notify("Tree Teleport", "Tree search failed", 3)
    end
end

