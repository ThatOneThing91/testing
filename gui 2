--//========================================================

local function GetSelectedGarage()

    local Debris =
        workspace:FindFirstChild("_Debris")

    if not Debris then
        return nil
    end

    local Garages =
        Debris:FindFirstChild("Garages")

    if not Garages then
        return nil
    end

    local garage =
        Garages:FindFirstChild(
            SelectedFarm
        )

    if garage then
        return garage
    end

    -- fallback: only search inside selected area
    local areaFolder =
        workspace:FindFirstChild("Areas")
        and workspace.Areas:FindFirstChild(
            SelectedArea
        )

    if areaFolder then

        garage =
            areaFolder:FindFirstChild(
                SelectedFarm,
                true
            )

        if garage then
            return garage
        end
    end

    return nil
end

--//========================================================
--// TELEPORT TO SELECTED FARM
--//========================================================

local function TeleportToFarm()

    local garage = GetSelectedGarage()

    if not garage then
        Notify(
            "Farming",
            "Could not find " .. SelectedFarm,
            3
        )
        return
    end

    local Entry =
        garage:FindFirstChild(
            "EntrySquare",
            true
        )

    local Target

    if Entry then

        Target =
            Entry:FindFirstChild(
                "PromptPart",
                true
            )

        if not Target then
            Target =
                Entry:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )
        end
    end

    if not Target then
        Target =
            garage:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end

    if not Target then
        Notify(
            "Farming",
            "No teleport position found",
            3
        )
        return
    end

    local Character =
        LocalPlayer.Character

    local HRP =
        Character
        and Character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not HRP then
        return
    end

    HRP.CFrame =
        Target.CFrame
        + Vector3.new(0, 3, 0)

    Notify(
        "Farming",
        "Teleported to " .. SelectedFarm,
        2
    )
end

--//========================================================
--// ENTER SELECTED AUCTION
--//========================================================

local function EnterSelectedAuction()

    local garage = GetSelectedGarage()

    if not garage then
        Notify(
            "Farming",
            "Could not find " .. SelectedFarm,
            3
        )
        return
    end

    local prompt =
        garage:FindFirstChild(
            "EnterAuction",
            true
        )

    if not prompt
        or not prompt:IsA("ProximityPrompt") then

        Notify(
            "Farming",
            "EnterAuction prompt not found",
            3
        )

        return
    end

    pcall(function()
        prompt.HoldDuration = 0
    end)

    if fireproximityprompt then

        fireproximityprompt(prompt)

        Notify(
            "Farming",
            "Entered " .. SelectedFarm,
            2
        )

    else

        Notify(
            "Farming",
            "Prompt found, but executor cannot fire it",
            3
        )

    end
end

