local function AutoUnfavorite()

    local InventoryEvents =
        ReplicatedStorage
            :FindFirstChild("Events")
            and ReplicatedStorage.Events:FindFirstChild(
                "Inventory"
            )

    if not InventoryEvents then
        Notify("Auto Unfavorite", "Inventory events not found", 3)
        return
    end

    local GetInventory =
        InventoryEvents:FindFirstChild(
            "GetPlayerInventory"
        )

    local ToggleFavorite =
        InventoryEvents:FindFirstChild(
            "ToggleFavoriteItem"
        )

    if not GetInventory or not ToggleFavorite then
        Notify("Auto Unfavorite", "Inventory remotes missing", 3)
        return
    end

    local success, inventory =
        pcall(function()
            return GetInventory:InvokeServer()
        end)

    if not success or not inventory then
        Notify("Auto Unfavorite", "Could not get inventory", 3)
        return
    end

    local Count = 0

    local function process(tbl)

        if typeof(tbl) ~= "table" then
            return
        end

        for key, value in pairs(tbl) do

            if typeof(value) == "table" then

                if value.Favorited == true
                    or value.Favorite == true then

                    local id =
                        value.UUID
                        or value.Id
                        or value.ID
                        or key

                    pcall(function()
                        ToggleFavorite:InvokeServer(id)
                    end)

                    Count += 1
                end

                process(value)

            elseif typeof(key) == "string" then

                if #key >= 8 then
                    -- UUID-like inventory entry
                end
            end
        end
    end

    process(inventory)

    Notify(
        "Auto Unfavorite",
        "Processed " .. tostring(Count) .. " item(s)",
        3
    )
end

