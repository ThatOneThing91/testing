                obj.Color = ThemeColor
            end

        end

        if obj:IsA("TextButton") then

            if obj.Text == "ON" then
                obj.BackgroundColor3 = ThemeColor
            end

        end
    end
end

ApplyTheme.MouseButton1Click:Connect(function()

    local r =
        math.clamp(
            tonumber(RSlider.Text) or 125,
            0,
            255
        )

    local g =
        math.clamp(
            tonumber(GSlider.Text) or 25,
            0,
            255
        )

    local b =
        math.clamp(
            tonumber(BSlider.Text) or 25,
            0,
            255
        )

    setTheme(
        Color3.fromRGB(
            r,
            g,
            b
        )
    )

    ThemePicker.Visible = false
end)

