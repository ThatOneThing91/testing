--//========================================================
--// INSTANT UNLOAD
--//========================================================

local function InstantUnload()

    local Events = ReplicatedStorage:FindFirstChild("Events")
    if not Events then
        return
    end

    local Vehicles = Events:FindFirstChild("Vehicles")
    if not Vehicles then
        return
    end

    local GetVehicleItems = Vehicles:FindFirstChild("GetVehicleItems")
    local TransferVehicleItems = Vehicles:FindFirstChild("TransferVehicleItemsToInventory")

    if not GetVehicleItems or not TransferVehicleItems then
        Notify("Instant Unload", "Vehicle remotes not found", 3)
        return
    end

    local VehicleGUID = LocalPlayer:GetAttribute("EquippedVehicle")

    if not VehicleGUID then
        Notify("Instant Unload", "No equipped vehicle found", 3)
        return
    end

    local vehicleModel

    local function findVehicle(parent)

        for _, obj in ipairs(parent:GetChildren()) do

            if obj:IsA("Model") then

                local guid =
                    obj:GetAttribute("VehicleGUID")
                    or obj:GetAttribute("GUID")

                if guid == VehicleGUID then
                    return obj
                end

                local found = findVehicle(obj)

                if found then
                    return found
                end
            end
        end
    end

    vehicleModel = findVehicle(workspace)

    local Character = LocalPlayer.Character
    local Humanoid =
        Character and Character:FindFirstChildOfClass("Humanoid")

    if Humanoid and vehicleModel then

        pcall(function()

            local seat =
                vehicleModel:FindFirstChildWhichIsA(
                    "VehicleSeat",
                    true
                )

            if seat then
                seat:Sit(Humanoid)
            end

        end)
    end

    local success, data =
        pcall(function()
            return GetVehicleItems:InvokeServer(VehicleGUID)
        end)

    if not success or not data then
        Notify("Instant Unload", "Could not retrieve vehicle items", 3)
        return
    end

    local GUIDs = {}

    local function collect(value)

        if typeof(value) == "string" then

            if #value >= 8 then
                table.insert(GUIDs, value)
            end

        elseif typeof(value) == "table" then

            for key, child in pairs(value) do

                if typeof(key) == "string" then

                    if #key >= 8 then
                        table.insert(GUIDs, key)
                    end
                end

                collect(child)
            end
        end
    end

    collect(data)

    if #GUIDs == 0 then
        Notify("Instant Unload", "Vehicle is empty", 2)
        return
    end

    pcall(function()
        TransferVehicleItems:FireServer(GUIDs)
    end)

    pcall(function()
        LocalPlayer:SetAttribute("CargoWeight", 0)
    end)

    Notify(
        "Instant Unload",
        "Unloaded " .. tostring(#GUIDs) .. " item(s)",
        3
    )
end

