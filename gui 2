    local Selector = {
        Container = Container,
        Button = Button,
        Value = Value
    }

    Button.MouseButton1Click:Connect(function()

        if ActiveDropdownButton == Button then
            closeDropdown()
            return
        end

        closeDropdown()

        local options = getOptions()

        if not options or #options == 0 then
            return
        end

        local buttonPosition = Button.AbsolutePosition
        local buttonSize = Button.AbsoluteSize

        local rowHeight = 32
        local padding = 8
        local maxHeight = 220

        local dropdownHeight =
            math.min(
                (#options * rowHeight) + padding,
                maxHeight
            )

        local viewport =
            workspace.CurrentCamera
            and workspace.CurrentCamera.ViewportSize
            or Vector2.new(1920, 1080)

        local x = buttonPosition.X
        local y =
            buttonPosition.Y
            + buttonSize.Y
            + 4

        if x + buttonSize.X > viewport.X - 5 then
            x = viewport.X - buttonSize.X - 5
        end

        if y + dropdownHeight > viewport.Y - 5 then

            y =
                buttonPosition.Y
                - dropdownHeight
                - 4

        end

        local Dropdown = Instance.new("Frame")
        Dropdown.Name = "ActiveDropdown"
        Dropdown.Position = UDim2.fromOffset(x, y)
        Dropdown.Size =
            UDim2.fromOffset(
                buttonSize.X,
                dropdownHeight
            )
        Dropdown.BackgroundColor3 =
            Color3.fromRGB(20, 20, 23)
        Dropdown.BorderSizePixel = 0
        Dropdown.ZIndex = 210
        Dropdown.Parent = DropdownOverlay

        local DropCorner = Instance.new("UICorner")
