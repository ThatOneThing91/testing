    if not RequestAuctionPause then
        Notify(
            "Farming",
            "Auction pause remote not found",
            3
        )
        return
    end

    RequestAuctionPause:FireServer(true)

    Notify(
        "Farming",
        "Auction paused",
        2
    )
end

local function ResumeAuction()

    if not RequestAuctionPause then
        Notify(
            "Farming",
            "Auction pause remote not found",
            3
        )
        return
    end

    RequestAuctionPause:FireServer(false)

    Notify(
        "Farming",
        "Auction resumed",
        2
    )
end

