    Label.Size = UDim2.new(1, -75, 1, 0)
    Label.Text = name
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = 12
    Label.TextColor3 = TextColor
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = Container

    local Toggle = Instance.new("TextButton")
    Toggle.Size = UDim2.new(0, 48, 0, 25)
    Toggle.Position = UDim2.new(1, -59, 0.5, -12)
    Toggle.BackgroundColor3 = OffColor
    Toggle.BorderSizePixel = 0
    Toggle.Text = "OFF"
    Toggle.Font = Enum.Font.GothamBold
    Toggle.TextSize = 9
    Toggle.TextColor3 = TextColor
    Toggle.AutoButtonColor = false
    Toggle.Parent = Container

    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(1, 0)
    ToggleCorner.Parent = Toggle

    local state = false

    local function update(value)
        state = value

        if state then
            Toggle.BackgroundColor3 = ThemeColor
            Toggle.Text = "ON"
        else
            Toggle.BackgroundColor3 = OffColor
            Toggle.Text = "OFF"
        end
    end

    Toggle.MouseButton1Click:Connect(function()

        state = not state
        update(state)

        Features[name] = state

        local success, result = pcall(function()
            return callback(state)
        end)

        if not success then
            warn("[Storage Hunters] " .. name .. ": " .. tostring(result))
        end
    end)

    ToggleObjects[name] = Toggle

    return Container, Toggle, update
end

