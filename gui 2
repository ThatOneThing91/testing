--//========================================================
--// POLICE AUCTION
--//========================================================

local function PoliceAuction()

    local Garages =
        workspace:FindFirstChild("_Debris")
        and workspace._Debris:FindFirstChild("Garages")

    if not Garages then
        Notify("Police Auction", "Garages not found", 3)
        return
    end

    local Character = LocalPlayer.Character
    local HRP =
        Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not HRP then
        return
    end

    for _, garage in ipairs(Garages:GetChildren()) do

        if garage:FindFirstChild("PoliceWarning", true) then

            local Entry =
                garage:FindFirstChild("EntrySquare", true)

            local PromptPart =
                Entry
                and Entry:FindFirstChild(
                    "PromptPart",
                    true
                )

            local Target =
                PromptPart
                or Entry
                or garage:FindFirstChildWhichIsA(
                    "BasePart",
                    true
                )

            if Target then

                if Target:IsA("BasePart") then

                    HRP.CFrame =
                        Target.CFrame
                        + Vector3.new(0, 3, 0)

                    Notify(
                        "Police Auction",
                        "Police auction found",
                        3
                    )

                    return
                end
            end
        end
    end

    Notify(
        "Police Auction",
        "No police auction found",
        3
    )
end

