local function createToggleBar(name, yPosition, callback)
    local Bar = Instance.new("Frame")
    Bar.Name = name .. "Bar"
    Bar.Size = UDim2.new(1, -20, 0, 55)
    Bar.Position = UDim2.new(0, 10, 0, yPosition)
    Bar.BackgroundColor3 = Color3.fromRGB(55, 15, 15)
    Bar.BorderSizePixel = 0
    Bar.Parent = Main

    local BarCorner = Instance.new("UICorner")
    BarCorner.CornerRadius = UDim.new(0, 6)
    BarCorner.Parent = Bar

    local ScriptName = Instance.new("TextLabel")
    ScriptName.Size = UDim2.new(1, -75, 1, 0)
    ScriptName.Position = UDim2.new(0, 12, 0, 0)
    ScriptName.BackgroundTransparency = 1
    ScriptName.Text = name
    ScriptName.TextColor3 = Color3.fromRGB(255, 255, 255)
    ScriptName.TextSize = 14
    ScriptName.Font = Enum.Font.GothamMedium
    ScriptName.TextXAlignment = Enum.TextXAlignment.Left
    ScriptName.Parent = Bar

    local Toggle = Instance.new("TextButton")
    Toggle.Size = UDim2.new(0, 55, 0, 28)
    Toggle.Position = UDim2.new(1, -65, 0.5, -14)
    Toggle.BackgroundColor3 = Color3.fromRGB(80, 25, 25)
    Toggle.Text = "OFF"
    Toggle.TextColor3 = Color3.fromRGB(255, 255, 255)
    Toggle.TextSize = 12
    Toggle.Font = Enum.Font.GothamBold
    Toggle.BorderSizePixel = 0
    Toggle.Parent = Bar

    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(0, 6)
    ToggleCorner.Parent = Toggle

    local enabled = false

    Toggle.MouseButton1Click:Connect(function()
        enabled = not enabled

        if enabled then
            Toggle.Text = "ON"
            Toggle.BackgroundColor3 = Color3.fromRGB(30, 110, 45)

            callback(true)
        else
            Toggle.Text = "OFF"
            Toggle.BackgroundColor3 = Color3.fromRGB(80, 25, 25)

            callback(false)
        end
    end)

    return Bar
end

