local function centerPizza()
    local gui = pizzaGui()

    if not gui or not gui.Enabled then
        return
    end

    local root = gui:FindFirstChild("Root")

    if not root or not root:IsA("GuiObject") then
        return
    end

    if not centered[root] then
        centered[root] = {
            position = root.Position,
            anchor = root.AnchorPoint
        }
    end

    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.Position = UDim2.fromScale(0.5, 0.5)
end

local function restorePizzaGui()
    for frame, data in pairs(centered) do
        if frame and frame.Parent then
            pcall(function()
                frame.AnchorPoint = data.anchor
                frame.Position = data.position
            end)
        end

        centered[frame] = nil
    end
end

-- PIZZA STATE
-- Exit 1.5 seconds after pizza completion.
-- Paid event is NOT required.

local PIZZA_FINISH_EXIT_DELAY = 1.5
local PIZZA_EXIT_RETRY_DELAY = 1

local pizza = {
    session = nil,
    phase = nil,
    progress = 0,
    remaining = {},
    state = "idle",
    status = "Idle",

    lastPrompt = 0,
    promptAttempts = 0,
    promptBusy = false,

    lastExit = 0,
    exitAttempts = 0,
    closedAt = 0,

    finishAt = 0,
    paidAt = 0,

    doughStep = 0,
    completedAt = 0,
    lastTopping = 0,
    count = 0
}

local nextPhase = {
    Dough = "Sauce",
    Sauce = "Cheese",
    Cheese = "Toppings"
}

local phaseRank = {
    Dough = 1,
    Sauce = 2,
    Cheese = 3,
    Toppings = 4
}

local function resetPizza()
    pizza.session = nil
    pizza.phase = nil
    pizza.progress = 0
    pizza.remaining = {}

    pizza.state = "idle"
    pizza.status = "Waiting for station"

    pizza.lastPrompt = 0
    pizza.promptAttempts = 0
    pizza.promptBusy = false

    pizza.lastExit = 0
    pizza.exitAttempts = 0
    pizza.closedAt = 0

    pizza.finishAt = 0
    pizza.paidAt = 0

    pizza.doughStep = 0
    pizza.completedAt = 0
    pizza.lastTopping = 0
end

local function beginPhase(phase, force)
    if pizza.state ~= "making" then
        return
    end

    local old = phaseRank[pizza.phase] or 0
    local new = phaseRank[phase] or 0

    if new == 0 then
        return
    end

    if not force and new <= old then
        return
    end

    pizza.phase = phase
    pizza.progress = 0
    pizza.completedAt = 0
    pizza.status = phase

    if phase == "Dough" then
        pizza.doughStep = 0
    elseif phase == "Toppings" then
        pizza.lastTopping = 0
    end
end

local function stationPrompt()
    local objects = getObjects()

    if not objects then
        return nil
    end

    local best
    local highest = -1

    for _, station in ipairs(objects:GetChildren()) do
        if station.Name:match(
            "^Pizza Prep Station %d+$"
        ) then

            local number = tonumber(
                station.Name:match("(%d+)$")
            ) or 0

            local start = station:FindFirstChild(
                "StartGame",
                true
            )

            local prompt = start
                and start:FindFirstChildWhichIsA(
                    "ProximityPrompt",
                    true
                )

            if prompt
                and prompt.Enabled
                and number > highest then

                best = prompt
                highest = number
            end
        end
    end

    return best
end

local function promptPart(prompt)
    local parent = prompt.Parent

    if parent:IsA("BasePart") then
        return parent
    end

    if parent:IsA("Attachment")
        and parent.Parent:IsA("BasePart") then

        return parent.Parent
    end

    local model = prompt:FindFirstAncestorOfClass("Model")

    if model then
        return model.PrimaryPart
            or model:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end

    return nil
end

local function tryPizzaPrompt(token)
    if pizza.state ~= "opening"
        or pizza.promptBusy
        or busy
        or pizza.session
        or pizzaVisible() then

        return
    end

    local now = os.clock()

    if now - pizza.lastPrompt < 0.4 then
        return
    end

    pizza.promptBusy = true
    pizza.lastPrompt = now
    pizza.promptAttempts += 1

    pizza.status = "Starting pizza - attempt "
        .. tostring(pizza.promptAttempts)

    local prompt = stationPrompt()

    if not prompt then
        pizza.status = "Waiting for station prompt"
        pizza.promptBusy = false
        return
    end

    busy = true

    local part = promptPart(prompt)

    if part then
        teleportTo(part)
    end

    task.wait(0.08)

    if alive and autoPizza
        and token == pizzaToken
        and pizza.state == "opening"
        and not pizza.session then

        firePrompt(prompt)
    end

    busy = false
    pizza.promptBusy = false
end

local function recipeToppings()
    local result = {}

    local gui = pizzaGui()
    local root = gui and gui:FindFirstChild("Root")
    local recipe = root and root:FindFirstChild("Recipe")
    local order = recipe and recipe:FindFirstChild("Order")

    local name = ""

    if order and order:IsA("TextLabel") then
        name = order.Text:lower()
    end

    for _, entry in pairs(pizzaConfig.Recipes or {}) do
        if type(entry) == "table" then
            local recipeName = tostring(
                entry.Name or ""
            ):lower()

            if recipeName ~= ""
                and name:find(recipeName, 1, true) then

                for topping, count in pairs(
                    entry.Toppings or {}
                ) do
                    result[topping] = count
                end

                break
            end
        end
    end

    return result
end

local function sendPizza(action, point, topping)
    if not alive
        or not autoPizza
        or pizza.state ~= "making"
        or not pizza.session then

        return
    end

    pizzaRemote:FireServer(
        pizza.session,
        action,
        point,
        topping
    )
end

local function markPizzaFinished()
    if pizza.finishAt > 0 then
        return
    end

    pizza.finishAt = os.clock()
    pizza.state = "exiting"
    pizza.phase = "Finished"
    pizza.progress = 1
    pizza.lastExit = 0
    pizza.exitAttempts = 0
    pizza.closedAt = 0
    pizza.status = "Finished - waiting 1.5s"
end

local function sendPizzaExit()
    if not alive
        or not autoPizza
        or not pizza.session
        or pizza.finishAt <= 0 then

        return false
    end

    if os.clock() - pizza.finishAt
        < PIZZA_FINISH_EXIT_DELAY then

        return false
    end

    local ok = pcall(function()
        pizzaRemote:FireServer(
            pizza.session,
            "Exit",
            nil,
            nil
        )
    end)

    if ok then
        pizza.lastExit = os.clock()
        pizza.exitAttempts += 1
        pizza.status = "Exiting completed pizza"
    else
        pizza.status = "Exit failed - retrying"
    end

    return ok
end

-- PIZZA SERVER EVENTS

bind(pizzaRemote.OnClientEvent, function(
    action,
    session,
    a,
    b,
    c
)
    if not alive or not autoPizza then
        return
    end

    if action == "Begin" then
        if pizza.state ~= "opening"
            or type(session) ~= "string" then

            return
        end

        pizza.session = session
        pizza.state = "making"
        pizza.phase = nil
        pizza.progress = 0
        pizza.remaining = {}
        pizza.doughStep = 0
        pizza.completedAt = 0
        pizza.lastTopping = 0
        pizza.promptBusy = false
        pizza.promptAttempts = 0
        pizza.finishAt = 0
        pizza.paidAt = 0

        beginPhase("Dough", true)
        centerPizza()
        return
    end

    if session ~= pizza.session then
        return
    end

    if action == "Paid" then
        pizza.paidAt = os.clock()
        pizza.count += 1

        -- Payment notification does not control
        -- the exit timer anymore.
        return
    end

    if action == "Round" then
        return
    end

    if action == "End" or action == "Cancel" then
        if pizza.state == "making"
            and action == "End" then

            markPizzaFinished()
        end

        return
    end

    if pizza.state ~= "making" then
        return
    end

    if action == "Phase" then
        if type(a) == "string" then
            beginPhase(a)

            if a == "Toppings" then
                pizza.remaining = recipeToppings()
            end
        end

    elseif action == "Progress" then
        if type(a) == "string"
            and type(b) == "number" then

            beginPhase(a)

            if pizza.phase == a then
                pizza.progress = math.max(
                    pizza.progress,
                    math.clamp(b, 0, 1)
                )

                if pizza.progress >= 1
                    and pizza.completedAt == 0 then

                    pizza.completedAt = os.clock()
                end
            end
        end

    elseif action == "PourComplete" then
        if a == pizza.phase then
            pizza.progress = 1

            if pizza.completedAt == 0 then
                pizza.completedAt = os.clock()
            end
        end

    elseif action == "Topping" then
        if type(a) == "string"
            and type(c) == "number" then

            pizza.remaining[a] = c
        end
    end
end)

-- PIZZA LOOP

local function runPizza(token)
    while alive and autoPizza
        and token == pizzaToken do

        local state = pizza.state
        local now = os.clock()

        if state == "idle" then
            if not pizzaVisible() then
                pizza.state = "opening"
                pizza.status = "Preparing new pizza"
                pizza.promptAttempts = 0
                pizza.lastPrompt = now - 0.4
            end

            task.wait(0.04)

        elseif state == "opening" then
            if pizza.session then
                pizza.state = "making"
            elseif not pizzaVisible() then
                tryPizzaPrompt(token)
            end

            task.wait(0.04)

        elseif state == "exiting" then
            if not pizzaVisible() then
                if pizza.closedAt == 0 then
                    pizza.closedAt = now
                end

                if now - pizza.closedAt >= 0.15 then
                    restorePizzaGui()

                    pizza.session = nil
                    pizza.phase = nil
                    pizza.progress = 0
                    pizza.remaining = {}
                    pizza.state = "idle"
                    pizza.status = "Closed - restarting"
                    pizza.closedAt = 0
                    pizza.finishAt = 0
                    pizza.paidAt = 0
                    pizza.promptAttempts = 0
                    pizza.lastPrompt = now - 0.4
                end
            else
                pizza.closedAt = 0

                if pizza.finishAt > 0
                    and now - pizza.finishAt
                        >= PIZZA_FINISH_EXIT_DELAY
                    and now - pizza.lastExit
                        >= PIZZA_EXIT_RETRY_DELAY then

                    sendPizzaExit()
                else
                    pizza.status = "Finished - waiting 1.5s"
                end
            end

            task.wait(0.04)

        elseif state == "making" then
            centerPizza()

            local phase = pizza.phase

            if nextPhase[phase]
                and pizza.progress >= 1
                and pizza.completedAt > 0
                and now - pizza.completedAt >= 0.1 then

                local target = nextPhase[phase]
                beginPhase(target)

                if target == "Toppings" then
                    pizza.remaining = recipeToppings()
                end

                phase = target
            end

            if phase == "Dough" then
                if pizza.progress < 1 then
                    pizza.doughStep += 1

                    local angle = pizza.doughStep * 0.28

                    sendPizza(
                        "Knead",
                        Vector2.new(
                            math.cos(angle) * 0.24,
                            math.sin(angle) * 0.24
                        ),
                        nil
                    )
                end

                task.wait(0.055)

            elseif phase == "Sauce" then
                if pizza.progress < 1 then
                    sendPizza(
                        "Pour",
                        Vector2.new(-0.08625, -0.2192),
                        nil
                    )
                end

                task.wait(0.035)

            elseif phase == "Cheese" then
                if pizza.progress < 1 then
                    sendPizza(
                        "Pour",
                        Vector2.new(-0.08625, -0.2192),
                        nil
                    )
                end

                task.wait(0.055)

            elseif phase == "Toppings" then
                local chosen

                for _, name in ipairs({
                    "Pepperoni",
                    "Mushroom",
                    "Olive"
                }) do
                    if (pizza.remaining[name] or 0) > 0 then
                        chosen = name
                        break
                    end
                end

                if chosen
                    and now - pizza.lastTopping >= 0.12 then

                    sendPizza(
                        "Topping",
                        Vector2.new(0.2, 0.17),
                        chosen
                    )

                    pizza.lastTopping = now
                end

                task.wait(0.04)
            else
                task.wait(0.06)
            end

        else
            task.wait(0.08)
        end
    end
end

-- AUTO CRATES

local function findCrates()
    local result = {}

    for _, crate in ipairs(workspace:GetChildren()) do
        if crate.Name == "Crate" then
            local main = crate:FindFirstChild("Main")
            local prompt = main and main:FindFirstChild("Prompt")

            if main
                and main:IsA("BasePart")
                and prompt
                and prompt:IsA("ProximityPrompt")
                and prompt.Enabled then

                table.insert(result, {
                    crate = crate,
                    main = main,
                    prompt = prompt
                })
            end
        end
    end

    return result
end

local function crateGone(entry)
    return not entry.crate.Parent
        or not entry.prompt.Parent
        or not entry.prompt.Enabled
end

local function runCrates(token)
    while alive and autoCrates
        and token == crateToken do

        if busy then
            task.wait(0.15)
            continue
        end

        for _, entry in ipairs(findCrates()) do
            if not alive
                or not autoCrates
                or token ~= crateToken then

                break
            end

            if not crateGone(entry) then
                busy = true

                local root = getRoot()
                local old = root and root.CFrame

                while alive
                    and autoCrates
                    and token == crateToken
                    and not crateGone(entry) do

                    teleportTo(entry.main)
                    task.wait(0.25)
                    firePrompt(entry.prompt)

                    local deadline = os.clock() + 1.5

                    while os.clock() < deadline
                        and not crateGone(entry)
                        and alive
                        and autoCrates do

                        task.wait(0.1)
                    end

                    if crateGone(entry) then
                        break
                    end

                    task.wait(0.35)
                end

                restore(root, old)
                busy = false
            end
        end

        task.wait(0.5)
    end
end

-- AUTO OBBY
-- TouchInterest -> Confirm entry -> End

local OBBY_COOLDOWN = 30
local OBBY_ENTRY_TIMEOUT = 5
local OBBY_RETRY_INTERVAL = 3
local OBBY_MIN_ENTRY_MOVEMENT = 35

local obbyStatus = "Idle"
local obbyCompleted = 0
local obbyNextAttempt = 0

local function obbyActive(token)
    return alive
        and autoObby
        and token == obbyToken
end

local function obbyPart(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA(
                "BasePart",
                true
            )
    end

    return object:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

local function getObby()
    local map = workspace:FindFirstChild("Map")
    return map and map:FindFirstChild("Obby")
end

local function getObbyEntrance()
    local obby = getObby()

    if not obby then
        return nil
    end

    local cave = obby:FindFirstChild("cave")
        or obby:FindFirstChild("Cave")

    if not cave then
        return nil
    end

    for _, obj in ipairs(cave:GetDescendants()) do
        if obj:IsA("TouchTransmitter")
            or obj.ClassName == "TouchInterest" then

            if obj.Parent
                and obj.Parent:IsA("BasePart") then

                return obj.Parent
            end
        end
    end

    if cave:IsA("BasePart") then
        local touch = cave:FindFirstChildOfClass(
            "TouchTransmitter"
        )

        if touch then
            return cave
        end
    end

    return nil
end

local function getObbyEnd()
    local obby = getObby()

    if not obby then
        return nil
    end

    return obbyPart(obby:FindFirstChild("End"))
end

local function enterObbyTouch(part)
    local root = getRoot()

    if not root or not part then
        return false
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = part.CFrame

    if type(firetouchinterest) == "function" then
        pcall(function()
            firetouchinterest(root, part, 0)
        end)

        task.wait(0.12)

        pcall(function()
            firetouchinterest(root, part, 1)
        end)
    end

    return true
end

local function waitForObbyEntry(
    token,
    entrance,
    character,
    root
)
    local deadline = os.clock() + OBBY_ENTRY_TIMEOUT

    while obbyActive(token)
        and os.clock() < deadline do

        if player.Character ~= character
            or getRoot() ~= root then

            return false
        end

        local distance = (
            root.Position - entrance.Position
        ).Magnitude

        if distance >= OBBY_MIN_ENTRY_MOVEMENT then
            task.wait(0.2)

            if not obbyActive(token)
                or getRoot() ~= root then

                return false
            end

            local confirmed = (
                root.Position - entrance.Position
            ).Magnitude

            if confirmed >= OBBY_MIN_ENTRY_MOVEMENT then
                return true
            end
        end

        task.wait(0.05)
    end

    return false
end

local function runObby(token)
    while obbyActive(token) do
        local now = os.clock()

        if now < obbyNextAttempt then
            obbyStatus = "Cooldown: "
                .. tostring(
                    math.ceil(obbyNextAttempt - now)
                )
                .. "s"

            task.wait(0.2)
            continue
        end

        if busy then
            obbyStatus = "Waiting for other action"
            task.wait(0.15)
            continue
        end

        local entrance = getObbyEntrance()
        local finish = getObbyEnd()

        if not entrance then
            obbyStatus = "Waiting for cave TouchInterest"
            task.wait(1)
            continue
        end

        if not finish then
            obbyStatus = "Waiting for obby End"
            task.wait(1)
            continue
        end

        local root = getRoot()
        local character = player.Character

        if not root or not character then
            obbyStatus = "Waiting for character"
            task.wait(0.5)
            continue
        end

        busy = true
        obbyStatus = "Touching cave entrance"

        local entered = enterObbyTouch(entrance)
        local started = false

        if entered and obbyActive(token) then
            obbyStatus = "Checking obby entry"

            started = waitForObbyEntry(
                token,
                entrance,
                character,
                root
            )
        end

        if not obbyActive(token) then
            busy = false
            break
        end

        if started then
            obbyStatus = "Entry confirmed - going to End"

            if teleportTo(finish) then
                obbyCompleted += 1
                obbyStatus = "Finish reached - cooldown"

                task.wait(0.7)

                obbyNextAttempt = os.clock()
                    + OBBY_COOLDOWN
            else
                obbyStatus = "Could not reach End"
            end
        else
            obbyStatus = "Entry not activated - retrying"
        end

        busy = false

        if not started then
            local deadline = os.clock()
                + OBBY_RETRY_INTERVAL

            while obbyActive(token)
                and os.clock() < deadline do

                task.wait(0.1)
            end
        end
    end
end

-- KING OF THE HILL
-- Save position -> Claim -> Return

local hillStatus = "Idle"
local hillClaims = 0

local HILL_CHECK_INTERVAL = 0.4
local HILL_CLAIM_TIMEOUT = 20
local HILL_RETRY_AFTER_FAILURE = 4

local OWNER_NAMES = {
    "Owner",
    "CurrentOwner",
    "King",
    "CurrentKing",
    "Controller",
    "CapturedBy",
    "OwnerUserId",
    "KingUserId",
    "CurrentUserId",
    "Player",
    "CurrentPlayer"
}

local function getHill()
    local map = workspace:FindFirstChild("Map")
    return map and map:FindFirstChild("Hill")
end

local function getHillHitbox()
    local hill = getHill()
    local hitbox = hill and hill:FindFirstChild("Hitbox")

    if hitbox and hitbox:IsA("BasePart") then
        return hitbox
    end

    return nil
end

local function isLocalOwner(value)
    if typeof(value) == "Instance" then
        return value == player
    end

    if type(value) == "number" then
        return value == player.UserId
    end

    if type(value) == "string" then
        local text = value:lower()

        return text == player.Name:lower()
            or text == player.DisplayName:lower()
            or tonumber(text) == player.UserId
    end

    return false
end

local function readOwnerValue(object)
    if not object then
        return nil
    end

    for _, name in ipairs(OWNER_NAMES) do
        local attribute = object:GetAttribute(name)

        if attribute ~= nil then
            return attribute
        end

        local child = object:FindFirstChild(name)

        if child and child:IsA("ValueBase") then
            return child.Value
        end
    end

    return nil
end

local function getHillOwner()
    local hill = getHill()

    if not hill then
        return nil
    end

    local controller = hill:FindFirstChild(
        "CaptureController"
    )

    local owner = readOwnerValue(controller)

    if owner ~= nil then
        return owner
    end

    owner = readOwnerValue(hill)

    if owner ~= nil then
        return owner
    end

    return readOwnerValue(
        hill:FindFirstChild("Hitbox")
    )
end

local function hillActive(token)
    return alive
        and autoHill
        and token == hillToken
end

local function teleportToHill()
    local hitbox = getHillHitbox()
    local root = getRoot()

    if not hitbox or not root then
        return false
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    root.CFrame = CFrame.new(
        hitbox.Position.X,
        hitbox.Position.Y + hitbox.Size.Y / 2 + 2.5,
        hitbox.Position.Z
    )

    return true
end

local function claimHill(token)
    if not hillActive(token) or busy then
        return false
    end

    local root = getRoot()
    local hitbox = getHillHitbox()

    if not root or not hitbox then
        hillStatus = "Waiting for hill"
        return false
    end

    local savedCharacter = player.Character
    local savedRoot = root
    local savedPosition = root.CFrame

    busy = true
    hillStatus = "Claiming hill"

    if not teleportToHill() then
        busy = false
        return false
    end

    local claimed = false
    local deadline = os.clock() + HILL_CLAIM_TIMEOUT

    while hillActive(token)
        and os.clock() < deadline do

        if player.Character ~= savedCharacter
            or getRoot() ~= savedRoot then

            break
        end

        local owner = getHillOwner()

        if owner ~= nil and isLocalOwner(owner) then
            claimed = true
            break
        end

        local currentHitbox = getHillHitbox()

        if currentHitbox then
            local horizontal = Vector3.new(
                root.Position.X - currentHitbox.Position.X,
                0,
                root.Position.Z - currentHitbox.Position.Z
            ).Magnitude

            if horizontal > 10 then
                teleportToHill()
            end
        end

        task.wait(HILL_CHECK_INTERVAL)
    end

    if claimed then
        hillClaims += 1
        hillStatus = "Claimed - returning"

        task.wait(0.2)

        if hillActive(token)
            and player.Character == savedCharacter
            and getRoot() == savedRoot then

            restore(savedRoot, savedPosition)
        end

        hillStatus = "Owned - monitoring"
    else
        hillStatus = "Capture not confirmed"

        if hillActive(token)
            and player.Character == savedCharacter
            and getRoot() == savedRoot then

            restore(savedRoot, savedPosition)
        end
    end

    busy = false
    return claimed
end

local function runHill(token)
    local wasOwner = false
    local attemptedInitial = false
    local retryAt = 0

    while hillActive(token) do
        local owner = getHillOwner()

        if owner == nil then
            hillStatus = "Ownership status unavailable"
            task.wait(HILL_CHECK_INTERVAL)
            continue
        end

        local mine = isLocalOwner(owner)

        if mine then
            wasOwner = true
            attemptedInitial = true
            hillStatus = "Owned - monitoring"

        elseif wasOwner then
            wasOwner = false
            retryAt = 0
            hillStatus = "Hill lost - reclaiming"

        elseif not attemptedInitial then
            attemptedInitial = true
            retryAt = 0
        end

        if not mine and os.clock() >= retryAt then
            if not busy then
                local success = claimHill(token)

                if success then
                    wasOwner = true
                else
                    retryAt = os.clock()
                        + HILL_RETRY_AFTER_FAILURE
                end
            end
        end

        task.wait(HILL_CHECK_INTERVAL)
    end
end

-- DELETE AIM ASSIST
-- One-click action, not a toggle.

local function deleteAimAssist()
    local removed = 0

    local starterScripts = game:GetService("StarterPlayer")
        :FindFirstChild("StarterPlayerScripts")

    local playerScripts = player:FindFirstChild("PlayerScripts")

    for _, folder in ipairs({
        starterScripts,
        playerScripts
    }) do
        if folder then
            for _, name in ipairs({
                "AimAssist",
                "AimAssit"
            }) do
                local scriptObject = folder:FindFirstChild(name)

                if scriptObject then
                    local success = pcall(function()
                        if scriptObject:IsA("BaseScript") then
                            scriptObject.Disabled = true
                        end

                        scriptObject:Destroy()
                    end)

                    if success and not scriptObject.Parent then
                        removed += 1
                    end
                end
            end
        end
    end

    return removed
end

