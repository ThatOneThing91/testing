-- AUTO BUY

local function parseMoney(value)
    if type(value) == "number" then return value end
    if type(value) ~= "string" then return nil end

    local clean = value:gsub(",", ""):gsub("%$", "")
    local number, suffix = clean:match(
        "([%d%.]+)%s*([KkMmBbTt]?)"
    )

    number = tonumber(number)
    if not number then return nil end

    local scales = {
        K = 1e3,
        M = 1e6,
        B = 1e9,
        T = 1e12
    }

    return number * (scales[suffix:upper()] or 1)
end

local function getCash()
    local stats = player:FindFirstChild("leaderstats")

    if stats then
        for _, name in ipairs({"Cash", "Money"}) do
            local value = stats:FindFirstChild(name)

            if value and (
                value:IsA("NumberValue")
                or value:IsA("IntValue")
            ) then
                return value.Value
            end
        end
    end

    for _, name in ipairs({"Cash", "Money"}) do
        local value = player:GetAttribute(name)

        if type(value) == "number" then
            return value
        end
    end

    return cachedCash
end

local function excludedButton(button)
    local name = button.Name:lower()

    if name:sub(1, 9) == "teammate_" then
        return true
    end

    if button:GetAttribute("IsTeammate") == true
        or button:GetAttribute("CanPurchase") == false then
        return true
    end

    local function excluded(value)
        local s = tostring(value):lower()
            :gsub("[^%w]", "")

        return s:find("2xcash", 1, true)
            or s:find("doublecash", 1, true)
            or s:find("cashmultiplier", 1, true)
            or s:find("2timescash", 1, true)
    end

    if excluded(button.Name) then
        return true
    end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel")
            or obj:IsA("TextButton") then

            if excluded(obj.Text) then
                return true
            end
        end
    end

    return false
end

local function buttonPrice(button)
    local price = parseMoney(button:GetAttribute("Price"))

    if price then
        return price
    end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") then
            price = parseMoney(obj.Text)

            if price then
                return price
            end
        end
    end

    return nil
end

local function buttonPart(button)
    local base = button:FindFirstChild("Base")

    if base and base:IsA("BasePart") then
        return base
    end

    if button:IsA("BasePart") then
        return button
    end

    return button:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

local function runBuy(token)
    local failed = {}
    local lastCash

    while alive and autoBuy and token == buyToken do
        if busy then
            task.wait(0.15)
            continue
        end

        local cash = getCash()

        if cash ~= lastCash then
            failed = {}
            lastCash = cash
        end

        local folder = workspace:FindFirstChild(
            "__TycoonButtons_" .. tostring(player.UserId)
        )

        local chosen
        local part
        local cheapest = math.huge

        if folder and cash then
            for _, button in ipairs(folder:GetChildren()) do
                if not failed[button]
                    and not excludedButton(button) then

                    local price = buttonPrice(button)
                    local candidate = buttonPart(button)

                    if price
                        and price <= cash
                        and price < cheapest
                        and candidate then

                        chosen = button
                        part = candidate
                        cheapest = price
                    end
                end
            end
        end

        if not chosen then
            task.wait(0.5)
            continue
        end

        busy = true

        local root = getRoot()
        local old = root and root.CFrame

        teleportTo(part)

        local deadline = os.clock() + 2
        local purchased = false

        while alive and autoBuy
            and token == buyToken
            and os.clock() < deadline do

            if not chosen.Parent
                or chosen.Parent ~= folder then

                purchased = true
                break
            end

            task.wait(0.05)
        end

        restore(root, old)
        busy = false

        if not purchased then
            failed[chosen] = true
        end

        task.wait(0.12)
    end
end

