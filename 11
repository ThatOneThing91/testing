local function getRoot()
    local character = player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getPlot()
    local tycoon = player:FindFirstChild("Tycoon")
    if not tycoon or not tycoon:IsA("ObjectValue") then
        return nil, nil
    end
    return tycoon.Value, tycoon:GetAttribute("Slot")
end

local function getObjects()
    local plot, slot = getPlot()
    if not plot or not slot then return nil end

    local side = plot:FindFirstChild("Player" .. tostring(slot))
    return side and side:FindFirstChild("Objects")
end

local function teleportTo(part)
    local root = getRoot()

    if not root or not part or not part:IsA("BasePart") then
        return false
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    root.CFrame = CFrame.new(
        part.Position.X,
        part.Position.Y + part.Size.Y / 2 + 3,
        part.Position.Z
    )

    return true
end

local function restore(root, cf)
    if root and root.Parent and cf then
        root.CFrame = cf
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function firePrompt(prompt)
    if type(fireproximityprompt) ~= "function" then
        return false
    end

    return pcall(fireproximityprompt, prompt)
end

