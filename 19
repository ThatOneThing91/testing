local function collectCash()
    if not alive or busy then return end
    busy = true
    local plot, slot = getPlot()
    local side = plot and slot and plot:FindFirstChild('Player' .. tostring(slot))
    local essential = side and side:FindFirstChild('Essential')
    local atm = essential and essential:FindFirstChild('ATM')
    local touch = atm and atm:FindFirstChild('Touch')
    local root = getRoot()
    local old = root and root.CFrame
