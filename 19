local function teleportTo(part)
    local root = getRoot()
    if not root or not part or not part:IsA('BasePart') then return false end
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(part.Position + Vector3.new(0, part.Size.Y / 2 + 3, 0))
    return true
end
local function restore(root, cf)
    if root and root.Parent and cf then
        root.CFrame = cf
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end
local function firePrompt(prompt)
    if type(fireproximityprompt) ~= 'function' then return false end
    return pcall(fireproximityprompt, prompt)
end

