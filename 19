local function teleportToHill()
    local hitbox, root = getHillHitbox(), getRoot()
    if not hitbox or not root then return false end
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(hitbox.Position + Vector3.new(0, hitbox.Size.Y / 2 + 2.5, 0))
    return true
end
local function returnFromHill()
    if hillSavedRoot and hillSavedCFrame and player.Character == hillSavedCharacter
        and getRoot() == hillSavedRoot then
        restore(hillSavedRoot, hillSavedCFrame)
    end
    hillSavedRoot, hillSavedCFrame, hillSavedCharacter = nil, nil, nil
end
local remotesFolder = RS:FindFirstChild('Remotes')
local hillEvent = remotesFolder and remotesFolder:FindFirstChild('Event')
if hillEvent and hillEvent:IsA('RemoteEvent') then
    bind(hillEvent.OnClientEvent, function(action, state, amount)
        if not alive or not autoHill then return end
        if action == 'HillClaimStatus' and state == 'Progress' and type(amount) == 'number' then
            hillProgress = amount
            hillStatus = 'Capturing: ' .. tostring(math.floor(amount)) .. '%'
            if amount >= 100 then hillFinished = true end
        end
        -- Hidden and HillClaimed are deliberately ignored: neither is required.
    end)
end
local function runHill(token)
    while hillActive(token) and busy do
        hillStatus = 'Waiting for other action'
        task.wait(0.15)
    end
    if not hillActive(token) then return end
    local root, hitbox = getRoot(), getHillHitbox()
    if not root or not hitbox then
        hillStatus = 'Hill or character unavailable'
        autoHill = false
        return
    end
    busy = true
    hillOwnsBusy = true
    hillSavedRoot, hillSavedCFrame, hillSavedCharacter = root, root.CFrame, player.Character
    hillProgress, hillFinished = nil, false
    hillStatus = 'Teleporting to hill'
    if not teleportToHill() then
        hillStatus = 'Could not teleport to hill'
        returnFromHill()
        if hillOwnsBusy then busy = false; hillOwnsBusy = false end
        if hillActive(token) then autoHill = false end
        return
    end
    while hillActive(token) and not hillFinished do
        if player.Character ~= hillSavedCharacter or getRoot() ~= hillSavedRoot then
            hillStatus = 'Character changed - stopped'
            break
        end
        local current = getHillHitbox()
        if current then
            local offset = root.Position - current.Position
            if Vector3.new(offset.X, 0, offset.Z).Magnitude > 10 then
                teleportToHill()
            end
        end
        task.wait(HILL_CHECK_INTERVAL)
    end
    if token ~= hillToken then return end
    local completed = hillFinished
    returnFromHill()
    if hillOwnsBusy then busy = false; hillOwnsBusy = false end
    autoHill = false
    if completed then
        hillStatus = '100% - returned to start'
    elseif hillStatus ~= 'Character changed - stopped' then
        hillStatus = 'Stopped - returned to start'
    end
end

