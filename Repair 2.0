--====================================================
-- STORAGE HUNTERS - AUTO REPAIR
-- 3 Slots + Auto Collect + Auto Claim + Auto Refill
-- Attempts SpeedUpRepair automatically if available
--====================================================

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Events = ReplicatedStorage:WaitForChild("Events")
local Repair = Events:WaitForChild("Repair")

local GetSlotState =
    Repair:WaitForChild("GetSlotState")

local GetRepairableItems =
    Repair:WaitForChild("GetRepairableItems")

local StartRepair =
    Repair:WaitForChild("StartRepair")

local CollectRepair =
    Repair:WaitForChild("CollectRepair")

local ClaimRepairedItem =
    Repair:WaitForChild("ClaimRepairedItem")

-- Optional speed-up remote
local SpeedUpRepair =
    Repair:FindFirstChild("SpeedUpRepair")

--====================================================
-- SETTINGS
--====================================================

local LOOP_DELAY = 0.5
local ACTION_DELAY = 0.25
local START_DELAY = 0.35

-- Kill previous copy
_G.StorageHuntersAutoRepairRunId =
    (_G.StorageHuntersAutoRepairRunId or 0) + 1

local RUN_ID =
    _G.StorageHuntersAutoRepairRunId

print("======================================")
print("[AUTO REPAIR] STARTED")
print("[AUTO REPAIR] 3-slot automation active")

if SpeedUpRepair then
    print("[AUTO REPAIR] SpeedUpRepair found!")
else
    print("[AUTO REPAIR] SpeedUpRepair not found - normal timing")
end

print("======================================")

--====================================================
-- GET SLOT STATE
--====================================================

local function getSlotState()

    local ok, result = pcall(function()
        return GetSlotState:InvokeServer()
    end)

    if not ok then
        warn(
            "[AUTO REPAIR] GetSlotState failed:",
            result
        )

        return nil
    end

    return result
end

--====================================================
-- GET REPAIRABLE ITEMS
--====================================================

local function getRepairableItems()

    local ok, result = pcall(function()
        return GetRepairableItems:InvokeServer()
    end)

    if not ok then
        warn(
            "[AUTO REPAIR] GetRepairableItems failed:",
            result
        )

        return {}
    end

    if type(result) ~= "table" then
        return {}
    end

    return result.items or {}
end

--====================================================
-- FIND SLOT
--====================================================

local function getSlot(slots, slotIndex)

    if type(slots) ~= "table" then
        return nil
    end

    return
        slots[tostring(slotIndex)]
        or slots[slotIndex]
end

--====================================================
-- CHOOSE REPAIRABLE ITEM
--====================================================

local function chooseItem(items, used)

    if type(items) ~= "table" then
        return nil
    end

    for _, item in ipairs(items) do

        local guid =
            item.guid
            or item.GUID
            or item.Guid

        if guid and not used[guid] then

            return item
        end
    end

    return nil
end

--====================================================
-- SPEED UP
--====================================================

local function speedUp(slotIndex)

    if not SpeedUpRepair then
        return false
    end

    local ok, result = pcall(function()

        if SpeedUpRepair:IsA("RemoteFunction") then
            return SpeedUpRepair:InvokeServer(slotIndex)

        elseif SpeedUpRepair:IsA("RemoteEvent") then
            SpeedUpRepair:FireServer(slotIndex)
            return true
        end

    end)

    if ok then

        print(
            "[AUTO REPAIR] Speed up sent for slot",
            slotIndex
        )

        return true

    else

        warn(
            "[AUTO REPAIR] SpeedUpRepair failed:",
            slotIndex,
            result
        )

        return false
    end
end

--====================================================
-- START REPAIR
--====================================================

local function startRepair(slotIndex, item)

    if not item then
        return false
    end

    local guid =
        item.guid
        or item.GUID
        or item.Guid

    if not guid then
        return false
    end

    local source =
        item.source
        or item.Source
        or "Inventory"

    local vehicleGUID =
        item.vehicleGUID
        or item.VehicleGUID
        or item.vehicleGuid

    print(
        "[AUTO REPAIR] Loading slot",
        slotIndex,
        guid
    )

    local ok, result = pcall(function()

        return StartRepair:InvokeServer(
            slotIndex,
            guid,
            source,
            vehicleGUID
        )

    end)

    if not ok then

        warn(
            "[AUTO REPAIR] StartRepair failed:",
            slotIndex,
            result
        )

        return false
    end

    print(
        "[AUTO REPAIR] Slot",
        slotIndex,
        "loaded"
    )

    task.wait(START_DELAY)

    -- Attempt speed up immediately
    speedUp(slotIndex)

    return true
end

--====================================================
-- COLLECT
--====================================================

local function collectRepair(slotIndex)

    local ok, result = pcall(function()

        return CollectRepair:InvokeServer(
            slotIndex
        )

    end)

    if not ok then

        warn(
            "[AUTO REPAIR] Collect failed:",
            slotIndex,
            result
        )

        return false
    end

    print(
        "[AUTO REPAIR] Collected slot",
        slotIndex
    )

    return true
end

--====================================================
-- CLAIM
--====================================================

local function claimRepair(slotIndex)

    local ok, result = pcall(function()

        return ClaimRepairedItem:InvokeServer(
            slotIndex
        )

    end)

    if not ok then

        warn(
            "[AUTO REPAIR] Claim failed:",
            slotIndex,
            result
        )

        return false
    end

    print(
        "[AUTO REPAIR] Claimed slot",
        slotIndex
    )

    return true
end

--====================================================
-- CHECK IF TIMER FINISHED
--====================================================

local function timerFinished(slotData)

    if type(slotData) ~= "table" then
        return false
    end

    local startTime =
        tonumber(slotData.StartTime)

    local duration =
        tonumber(slotData.Duration)

    if not startTime or not duration then
        return false
    end

    local elapsed =
        workspace:GetServerTimeNow()
        - startTime

    return elapsed >= duration
end

--====================================================
-- CHECK READY TO CLAIM
--====================================================

local function readyToClaim(slotData)

    if type(slotData) ~= "table" then
        return false
    end

    return
        slotData.Repaired == true
        or slotData.Completed == true
        or slotData.Ready == true
        or slotData.Finished == true
end

--====================================================
-- CLEAR A FINISHED SLOT
--====================================================

local function clearFinishedSlot(slotIndex)

    local state =
        getSlotState()

    if not state
        or type(state.slots) ~= "table"
    then
        return false
    end

    local slotData =
        getSlot(
            state.slots,
            slotIndex
        )

    if not slotData then
        return true
    end

    -- Already collected and waiting for claim
    if readyToClaim(slotData) then

        claimRepair(slotIndex)

        task.wait(ACTION_DELAY)

        return true
    end

    -- Timer finished but still needs collecting
    if timerFinished(slotData) then

        collectRepair(slotIndex)

        task.wait(ACTION_DELAY)

        -- Re-read after CollectRepair
        state = getSlotState()

        if state
            and type(state.slots) == "table"
        then

            slotData =
                getSlot(
                    state.slots,
                    slotIndex
                )

            if slotData then

                -- Try claim immediately
                claimRepair(slotIndex)

                task.wait(ACTION_DELAY)
            end
        end

        return true
    end

    return false
end

--====================================================
-- PROCESS ONE SLOT
--====================================================

local function processSlot(slotIndex, used)

    -- Always use fresh state
    local state =
        getSlotState()

    if not state
        or type(state.slots) ~= "table"
    then
        return
    end

    local slotData =
        getSlot(
            state.slots,
            slotIndex
        )

    --================================================
    -- SLOT CURRENTLY OCCUPIED
    --================================================

    if slotData then

        -- Keep attempting speed-up while active
        if SpeedUpRepair
            and not readyToClaim(slotData)
            and not timerFinished(slotData)
        then

            speedUp(slotIndex)

            task.wait(0.15)

            -- Refresh immediately
            state = getSlotState()

            if state
                and type(state.slots) == "table"
            then

                slotData =
                    getSlot(
                        state.slots,
                        slotIndex
                    )
            end
        end

        if slotData then

            if readyToClaim(slotData) then

                claimRepair(slotIndex)

                task.wait(ACTION_DELAY)

            elseif timerFinished(slotData) then

                collectRepair(slotIndex)

                task.wait(ACTION_DELAY)

                -- Try claim right after collect
                claimRepair(slotIndex)

                task.wait(ACTION_DELAY)

            else
                return
            end
        end
    end

    --================================================
    -- CHECK IF SLOT IS NOW EMPTY
    --================================================

    state =
        getSlotState()

    if not state
        or type(state.slots) ~= "table"
    then
        return
    end

    slotData =
        getSlot(
            state.slots,
            slotIndex
        )

    if slotData then
        return
    end

    --================================================
    -- FIND NEXT REPAIRABLE ITEM
    --================================================

    local items =
        getRepairableItems()

    local item =
        chooseItem(
            items,
            used
        )

    if not item then
        return
    end

    local guid =
        item.guid
        or item.GUID
        or item.Guid

    used[guid] = true

    startRepair(
        slotIndex,
        item
    )
end

--====================================================
-- MAIN AUTO REPAIR LOOP
--====================================================

task.spawn(function()

    while
        _G.StorageHuntersAutoRepairRunId
            == RUN_ID
    do

        local ok, err = pcall(function()

            local state =
                getSlotState()

            if not state then
                return
            end

            local unlocked =
                tonumber(state.unlockedCount)
                or 1

            unlocked =
                math.clamp(
                    unlocked,
                    1,
                    3
                )

            local used = {}

            -- Process every available repair slot
            for slotIndex = 1, unlocked do

                processSlot(
                    slotIndex,
                    used
                )

                task.wait(0.1)
            end
        end)

        if not ok then

            warn(
                "[AUTO REPAIR] Loop error:",
                err
            )
        end

        task.wait(LOOP_DELAY)
    end

    print("[AUTO REPAIR] STOPPED")
end)
