local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

local function getRoot()
    local character = player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getPlot()
    local tycoon = player:FindFirstChild("Tycoon")

    if not tycoon or not tycoon:IsA("ObjectValue") then
        return nil
    end

    local slot = tycoon:GetAttribute("Slot")

    if slot ~= 1 and slot ~= 2 then
        return nil
    end

    return tycoon.Value, slot
end

local function getMyObjects()
    local plot, slot = getPlot()

    if not plot then
        return nil
    end

    local side = plot:FindFirstChild("Player" .. slot)
    return side and side:FindFirstChild("Objects")
end

local function teleportAbove(part)
    local root = getRoot()

    if not root or not part or not part:IsA("BasePart") then
        return false
    end

    local humanoid = root.Parent:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.Sit = false
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    root.CFrame = CFrame.new(
        part.Position.X,
        part.Position.Y + part.Size.Y / 2 + 3,
        part.Position.Z
    )

    return true
end

local function restorePosition(root, original)
    if root and root.Parent and original then
        root.CFrame = original
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

-- CASH COLLECTION

local function getATM()
    local plot, slot = getPlot()

    if not plot then
        return nil
    end

    local side = plot:FindFirstChild("Player" .. slot)
    local essential = side and side:FindFirstChild("Essential")
    local atm = essential and essential:FindFirstChild("ATM")
    local touch = atm and atm:FindFirstChild("Touch")

    if touch and touch:IsA("BasePart") then
        return touch
    end

    return nil
end

local function collectCash()
    if collecting or not alive or teleportBusy then
        return
    end

    collecting = true
    teleportBusy = true

    local root = getRoot()
    local atm = getATM()

    if root and atm then
        local original = root.CFrame

        if teleportAbove(atm) then
            task.wait(0.5)
            restorePosition(root, original)
        end
    end

    teleportBusy = false
    collecting = false
end

-- AUTO BUY

local function parseMoney(value)
    if type(value) == "number" then
        return value
    end

    if type(value) ~= "string" then
        return nil
    end

    local s = value:gsub(",", ""):gsub("%$", "")
    local number, suffix = s:match("([%d%.]+)%s*([KkMmBbTt]?)")

    number = tonumber(number)

    if not number then
        return nil
    end

    local multipliers = {
        K = 1000,
        M = 1000000,
        B = 1000000000,
        T = 1000000000000
    }

    return number * (multipliers[suffix:upper()] or 1)
end

local function getCash()
    local stats = player:FindFirstChild("leaderstats")

    if stats then
        for _, name in ipairs({"Cash", "Money"}) do
            local value = stats:FindFirstChild(name)

            if value and (
                value:IsA("NumberValue")
                or value:IsA("IntValue")
            ) then
                return value.Value
            end
        end
    end

    for _, name in ipairs({"Cash", "Money"}) do
        local value = player:GetAttribute(name)

        if type(value) == "number" then
            return value
        end
    end

    return currentCash
end

local function getMyButtons()
    return workspace:FindFirstChild(
        "__TycoonButtons_" .. tostring(player.UserId)
    )
end

local function isExcludedButton(button)
    local name = button.Name:lower()

    if name:sub(1, 9) == "teammate_" then
        return true
    end

    if button:GetAttribute("IsTeammate") == true then
        return true
    end

    if button:GetAttribute("CanPurchase") == false then
        return true
    end

    local function excluded(text)
        text = tostring(text):lower():gsub("[^%w]", "")

        return text:find("2xcash", 1, true)
            or text:find("doublecash", 1, true)
            or text:find("cashmultiplier", 1, true)
            or text:find("2timescash", 1, true)
    end

    if excluded(button.Name) then
        return true
    end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if excluded(obj.Text) then
                return true
            end
        end
    end

    return false
end

local function getButtonPrice(button)
    local price = parseMoney(button:GetAttribute("Price"))

    if price then
        return price
    end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local value = parseMoney(obj.Text)

            if value then
                return value
            end
        end
    end

    return nil
end

local function getButtonPart(button)
    local base = button:FindFirstChild("Base")

    if base and base:IsA("BasePart") then
        return base
    end

    if button:IsA("BasePart") then
        return button
    end

    return button:FindFirstChildWhichIsA("BasePart", true)
end

local function getAffordableButtons(failed)
    local folder = getMyButtons()
    local cash = getCash()
    local candidates = {}

    if not folder or cash == nil then
        return candidates
    end

    for _, button in ipairs(folder:GetChildren()) do
        if not failed[button] and not isExcludedButton(button) then
            local price = getButtonPrice(button)
            local part = getButtonPart(button)

            if price and price <= cash and part then
                table.insert(candidates, {
                    button = button,
                    part = part,
                    price = price
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.price < b.price
    end)

    return candidates
end

local function runAutoBuy(generation)
    local failed = {}
    local lastCash = nil

    while alive and autoBuy and generation == buyGeneration do
        if teleportBusy then
            task.wait(0.15)
            continue
        end

        local cash = getCash()

        if cash ~= lastCash then
            failed = {}
            lastCash = cash
        end

        local candidates = getAffordableButtons(failed)
        local choice = candidates[1]

        if not choice then
            task.wait(0.5)
            continue
        end

        local folder = getMyButtons()
        local button = choice.button

        if not folder
            or button.Parent ~= folder
            or isExcludedButton(button) then

            failed[button] = true
            task.wait(0.1)
            continue
        end

        local root = getRoot()
        local original = root and root.CFrame

        teleportBusy = true
        teleportAbove(choice.part)

        local startedAt = os.clock()
        local disappeared = false

        while alive and autoBuy
            and generation == buyGeneration
            and os.clock() - startedAt < 2 do

            if not button.Parent or button.Parent ~= folder then
                disappeared = true
                break
            end

            task.wait(0.05)
        end

        restorePosition(root, original)
        teleportBusy = false

        if not disappeared then
            failed[button] = true
        end

        task.wait(0.12)
    end
end

-- PIZZA

local function getPizzaGui()
    local playerGui = player:FindFirstChild("PlayerGui")
    local gui = playerGui and playerGui:FindFirstChild("PizzaMaking")

    if not gui or not gui:IsA("ScreenGui") or not gui.Enabled then
        return nil, nil
    end

    local phase = gui:GetAttribute("Phase")

    if phase == "Dough"
        or phase == "Sauce"
        or phase == "Cheese"
        or phase == "Toppings"
        or phase == "Serving" then

        return gui, phase
    end

    return gui, nil
end

local function getBestPizzaStation()
    local objects = getMyObjects()

    if not objects then
        return nil
    end

    local bestPrompt
    local bestNumber = -1

    for _, station in ipairs(objects:GetChildren()) do
        if pizzaConfig.StationNames[station.Name] then
            local number = tonumber(
                station.Name:match("(%d+)$")
            ) or 0

            local startGame = station:FindFirstChild(
                "StartGame",
                true
            )

            local prompt = startGame
                and startGame:FindFirstChildWhichIsA(
                    "ProximityPrompt",
                    true
                )

            if prompt and prompt.Enabled and number > bestNumber then
                bestNumber = number
                bestPrompt = prompt
            end
        end
    end

    return bestPrompt
end

local function getPromptPart(prompt)
    local parent = prompt.Parent

    if parent and parent:IsA("BasePart") then
        return parent
    end

    if parent and parent:IsA("Attachment")
        and parent.Parent
        and parent.Parent:IsA("BasePart") then

        return parent.Parent
    end

    local station = prompt:FindFirstAncestorOfClass("Model")

    if station then
        return station.PrimaryPart
            or station:FindFirstChildWhichIsA("BasePart", true)
    end

    return nil
end

local function resetPizzaState()
    activeSession = nil
    pizzaStarted = false
    pizzaStartPending = false
    pizzaOrder = 0
    lastPizzaBegin = 0
end

-- Register this listener before starting the station.
connect(pizzaRemote.OnClientEvent, function(action, session, a)
    if not alive or not autoPizza then
        return
    end

    if action == "Begin" and session ~= nil then
        -- The old station ancestry check could reject a valid
        -- Begin event and leave the automation waiting forever.
        activeSession = session
        pizzaStarted = true
        pizzaStartPending = false
        pizzaOrder += 1
        lastPizzaBegin = os.clock()
    end
end)

local function startPizzaOnce(generation)
    if pizzaStartPending or activeSession or teleportBusy then
        return
    end

    pizzaStartPending = true

    local prompt = getBestPizzaStation()

    if not prompt then
        pizzaStartPending = false
        return
    end

    local part = getPromptPart(prompt)

    if part then
        teleportBusy = true
        teleportAbove(part)
        task.wait(0.2)
        teleportBusy = false
    end

    if not alive or not autoPizza or generation ~= pizzaGeneration then
        pizzaStartPending = false
        return
    end

    if type(fireproximityprompt) == "function" then
        pcall(function()
            fireproximityprompt(prompt)
        end)
    end

    pizzaStartPending = false
end

local function spiralPoint(step, maxRadius, totalSteps)
    local fraction = ((step - 1) % totalSteps + 1) / totalSteps
    local radius = maxRadius * math.sqrt(fraction)
    local angle = step * 2.399963229728653

    return Vector2.new(
        math.cos(angle) * radius,
        math.sin(angle) * radius
    )
end

local toppingNames = {
    "Pepperoni",
    "Mushroom",
    "Olive"
}

local function getNeededToppings(gui)
    local counts = {}

    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local text = obj.Text:lower()
            local count = tonumber(text:match("(%d+)%s+left"))

            if count and count > 0 then
                if text:find("pepperoni", 1, true) then
                    counts.Pepperoni = count
                elseif text:find("mushroom", 1, true) then
                    counts.Mushroom = count
                elseif text:find("olive", 1, true) then
                    counts.Olive = count
                end
            end
        end
    end

    return counts
end

local function sendPizzaAction(session, action, position, ingredient)
    if not alive or not autoPizza or not session then
        return
    end

    -- Session may be refreshed by a later Begin event.
    if session ~= activeSession then
        return
    end

    pizzaRemote:FireServer(session, action, position, ingredient)
end

local function runAutoPizza(generation)
    local lastPhase
    local lastSession
    local lastOrder = -1
    local lastStartAttempt = 0

    local kneadStep = 0
    local pourStep = 0
    local toppingStep = 0
    local lastToppingAt = 0

    while alive and autoPizza and generation == pizzaGeneration do
        local gui, phase = getPizzaGui()

        if not gui and not activeSession then
            if os.clock() - lastStartAttempt >= 2 then
                lastStartAttempt = os.clock()
                startPizzaOnce(generation)
            end

            task.wait(0.1)
            continue
        end

        -- Wait for Begin instead of permanently marking the
        -- session as started merely because the GUI opened.
        if not activeSession then
            task.wait(0.1)
            continue
        end

        if not gui or not phase then
            task.wait(0.1)
            continue
        end

        local session = activeSession

        if phase ~= lastPhase
            or session ~= lastSession
            or pizzaOrder ~= lastOrder then

            lastPhase = phase
            lastSession = session
            lastOrder = pizzaOrder

            kneadStep = 0
            pourStep = 0
            toppingStep = 0
            lastToppingAt = 0
        end

        if phase == "Dough" then
            kneadStep += 1

            local angle = kneadStep * 0.48
            local point = Vector2.new(
                math.cos(angle) * 0.22,
                math.sin(angle) * 0.22
            )

            sendPizzaAction(session, "Knead", point, nil)
            task.wait(pizzaConfig.SampleInterval)

        elseif phase == "Sauce" or phase == "Cheese" then
            pourStep += 1

            local point = spiralPoint(
                pourStep,
                math.min(pizzaConfig.PourCursorRadius, 0.82),
                phase == "Sauce"
                    and pizzaConfig.SaucePortions
                    or pizzaConfig.CheesePortions
            )

            if pizzaRules.CanPourAt(point) then
                sendPizzaAction(session, "Pour", point, nil)
            end

            task.wait(
                phase == "Sauce"
                    and pizzaConfig.SauceStreamInterval
                    or pizzaConfig.SampleInterval
            )

        elseif phase == "Toppings" then
            local counts = getNeededToppings(gui)
            local selected

            for _, topping in ipairs(toppingNames) do
                if (counts[topping] or 0) > 0 then
                    selected = topping
                    break
                end
            end

            if selected
                and os.clock() - lastToppingAt
                    >= pizzaConfig.ToppingInterval then

                toppingStep += 1

                local point = spiralPoint(
                    toppingStep,
                    pizzaConfig.ToppingPlacementRadius * 0.9,
                    16
                )

                sendPizzaAction(
                    session,
                    "Topping",
                    point,
                    selected
                )

                lastToppingAt = os.clock()
            end

            task.wait(0.05)

        elseif phase == "Serving" then
            task.wait(pizzaConfig.ServeTime)

        else
            task.wait(0.1)
        end
    end
end

-- AUTO COLLECT CRATES

local function getCratePrompts()
    local results = {}

    for _, obj in ipairs(workspace:GetChildren()) do
        if obj.Name == "Crate" then
            local main = obj:FindFirstChild("Main")
            local prompt = main and main:FindFirstChild("Prompt")

            if main
                and main:IsA("BasePart")
                and prompt
                and prompt:IsA("ProximityPrompt")
                and prompt.Enabled then

                table.insert(results, {
                    crate = obj,
                    main = main,
                    prompt = prompt
                })
            end
        end
    end

    return results
end

local function crateCollected(entry)
    local crate = entry.crate
    local main = entry.main
    local prompt = entry.prompt

    if not crate.Parent then
        return true
    end

    if not main.Parent or not main:IsDescendantOf(crate) then
        return true
    end

    if not prompt.Parent or not prompt:IsDescendantOf(crate) then
        return true
    end

    if not prompt.Enabled then
        return true
    end

    return false
end

local function collectCrate(entry, generation)
    if teleportBusy then
        return false
    end

    local root = getRoot()

    if not root then
        return false
    end

    teleportBusy = true

    local original = root.CFrame
    local confirmed = false

    while alive
        and autoCrates
        and generation == crateGeneration
        and not confirmed do

        if crateCollected(entry) then
            confirmed = true
            break
        end

        if not teleportAbove(entry.main) then
            break
        end

        task.wait(0.25)

        if not alive or not autoCrates
            or generation ~= crateGeneration then
            break
        end

        if type(fireproximityprompt) == "function" then
            pcall(function()
                fireproximityprompt(entry.prompt)
            end)
        end

        local deadline = os.clock() + 1.5

        while alive
            and autoCrates
            and generation == crateGeneration
            and os.clock() < deadline do

            if crateCollected(entry) then
                confirmed = true
                break
            end

            task.wait(0.1)
        end

        if not confirmed then
            task.wait(0.35)
        end
    end

    restorePosition(root, original)
    teleportBusy = false

    return confirmed
end

local function runAutoCrates(generation)
    while alive
        and autoCrates
        and generation == crateGeneration do

        if teleportBusy then
            task.wait(0.15)
            continue
        end

        for _, entry in ipairs(getCratePrompts()) do
            if not alive
                or not autoCrates
                or generation ~= crateGeneration then
                break
            end

            if not crateCollected(entry) then
                collectCrate(entry, generation)
            end
        end

        task.wait(0.5)
    end
end

