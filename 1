local function addLine(message, color)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 0, 0)
    label.AutomaticSize = Enum.AutomaticSize.Y
    label.BackgroundTransparency = 1
    label.Text = tostring(message)
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextColor3 = color or Color3.fromRGB(220, 220, 220)
    label.Font = Enum.Font.Code
    label.TextSize = 12
    label.Parent = output
end

local function clear()
    for _, child in ipairs(output:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end
end

local function scanInventory()
    clear()
    addLine("Scanning inventory...", Color3.fromRGB(255, 210, 120))

    local remote = RS:FindFirstChild("Events")
    remote = remote and remote:FindFirstChild("Inventory")
    remote = remote and remote:FindFirstChild("GetPlayerInventory")

    if not remote then
        addLine("GetPlayerInventory not found.", Color3.fromRGB(255, 100, 100))
        return
    end

    local success, inventory = pcall(function()
        return remote:InvokeServer()
    end)

    if not success or type(inventory) ~= "table" then
        addLine("Inventory request failed.", Color3.fromRGB(255, 100, 100))
        return
    end

    local found = 0
    local inspected = 0

    local function inspect(tbl, depth)
        if depth > 5 or inspected > 1000 then return end

        for key, value in pairs(tbl) do
            if type(value) == "table" then
                inspected += 1

                local name = tostring(
                    value.Name or value.name
                    or value.ItemName or value.itemName
                    or value.DisplayName or value.displayName
                    or ""
                )

                local category = tostring(
                    value.Category or value.category
                    or value.Type or value.type
                    or ""
                )

                local combined = (name .. " " .. category):lower()

                if combined:find("fish")
                    or combined:find("rod") then

                    found += 1

                    local guid = value.UUID or value.uuid
                        or value.Guid or value.guid
                        or value.Id or value.id
                        or key

                    local mutators = value.Mutators or value.mutators

                    local broken = value.Broken == true
                        or value.IsBroken == true

                    if type(mutators) == "table" then
                        for mk, mv in pairs(mutators) do
                            if tostring(mk):lower() == "broken"
                                and mv ~= false then
                                broken = true
                            end

                            if tostring(mv):lower() == "broken" then
                                broken = true
                            end
                        end
                    end

                    addLine("------------------------------")
                    addLine("NAME: " .. name)
                    addLine("CATEGORY: " .. category)
                    addLine("GUID: " .. tostring(guid))
                    addLine(
                        "BROKEN: " .. tostring(broken),
                        broken and Color3.fromRGB(255, 100, 100)
                            or Color3.fromRGB(100, 255, 150)
                    )
                end

                inspect(value, depth + 1)
            end
        end
    end

    inspect(inventory, 0)

    if found == 0 then
        addLine("No rods matched name/category search.",
            Color3.fromRGB(255, 190, 100))
        addLine("The game may store rod names in an item database.")
    else
        addLine("Detected " .. found .. " possible rods.",
            Color3.fromRGB(100, 255, 150))
    end
end

