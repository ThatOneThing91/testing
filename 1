local okWashable, washable = pcall(function()
    return GetWashableItems:InvokeServer()
end)

print("")
print("========================================")
print("        GET WASHABLE ITEMS")
print("========================================")
print("Success:", okWashable)

if not okWashable then
    warn("GetWashableItems failed:", washable)
else
    print("Returned type:", typeof(washable))

    for i, dirty in ipairs(dirtyItems) do
        for _, uuid in ipairs(dirty.ids) do
            if containsUUID(washable, uuid) then
                print(
                    "MATCH FOUND:",
                    "Dirty #" .. i,
                    uuid
                )
            end
        end
    end

    print("")
    print("Full washable response:")
    dump(washable)
end

