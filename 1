local function countSelected(tbl)
    local n = 0

    for _, selectedValue in pairs(tbl) do
        if selectedValue then n += 1 end
    end

    return n
end

local function addFilterGroup(name, options, target)
    section(name)

    local expanded = false
    local entries = {}

    local heading
    heading = button(name .. " (0 selected)", function()
        expanded = not expanded

        for _, entry in ipairs(entries) do
            entry.Visible = expanded
        end
    end)

    for _, option in ipairs(options) do
        local entry

        entry = button("[ ] " .. option, function()
            target[option] = not target[option]

            entry.Text =
                (target[option] and "[X] " or "[ ] ") .. option

            heading.Text = name .. " (" ..
                countSelected(target) .. " selected)"
        end)

        entry.Visible = false
        table.insert(entries, entry)
    end
end

local function getState()
    local ok, response = invoke("GetSlotState")

    if ok
        and type(response) == "table"
        and type(response.slots) == "table" then
        return response
    end

    return nil
end

local function getSlot(state, slot)
    return state.slots[slot]
        or state.slots[tostring(slot)]
end

local function remainingTime(info)
    if type(info) ~= "table" then
        return nil
    end

    local start = tonumber(info.StartTime)
    local duration = tonumber(
        info.RequiredDuration or info.Duration
    )

    if not start or not duration then
        return nil
    end

    return math.max(
        0,
        start + duration - workspace:GetServerTimeNow()
    )
end

local function attemptAllowed(key, delay)
    local now = os.clock()
    local last = attemptMemory[key]

    if last and now - last < delay then
        return false
    end

    attemptMemory[key] = now
    return true
end

local function isSelected(entry)
    local data = entry.data or entry.Data or {}

    if filterMode == "Grade All" then
        return true
    end

    local matches = false

    local mutators = data.Mutators or {}

    if type(mutators) == "table" then
        for key, value in pairs(mutators) do
            local mutation = type(key) == "number"
                and tostring(value)
                or tostring(key)

            if selected.mutators[mutation]
                and value ~= false then
                matches = true
            end
        end
    end

    -- ItemId must be resolved through the item database
    -- before rarity/name filtering can be trusted.
    -- For now, avoid treating unknown rarity/name as a match.

    if filterMode == "Grade Selected" then
        return matches
    elseif filterMode == "Exclude Selected" then
        return not matches
    end

    return false
end

local function getItems()
    local ok, response = invoke("GetGradableItems")

    if not ok or type(response) ~= "table" then
        return {}
    end

    local entries = response.items
        or response.Items
        or response

    if type(entries) ~= "table" then
        return {}
    end

    local result = {}

    for _, entry in pairs(entries) do
        if type(entry) == "table" then
            local guid = entry.guid or entry.Guid
            local source = entry.source
                or entry.Source
                or "Inventory"

            if guid and isSelected(entry) then
                table.insert(result, {
                    guid = tostring(guid),
                    source = source
                })
            end
        end
    end

    return result
end

local function verifyEmpty(slot)
    local state = getState()

    if not state then
        return false
    end

    return getSlot(state, slot) == nil
end

local function handleOccupied(slot, info)
    local remaining = remainingTime(info)

    if remaining == nil then
        if attemptAllowed("unknown_" .. slot, 12) then
            report("Slot " .. slot ..
                ": unknown timer/state")
        end
        return "Unknown"
    end

    if remaining > 0 then
        return tostring(math.ceil(remaining)) .. "s"
    end

    local itemKey = tostring(info.ItemGUID or "unknown")

    -- First collect / reveal the finished grade
    if attemptAllowed("collect_" .. slot .. "_" .. itemKey, 4) then
        report("Slot " .. slot .. ": timer done; revealing")

        local ok, result = invoke("CollectGrade", slot)

        if not ok or result == false then
            report("Slot " .. slot .. ": collect failed")
            return "Collect retry"
        end

        task.wait(0.4)
    end

    if not enabled or not alive then
        return "Paused"
    end

    -- Claim the graded item
    if attemptAllowed("claim_" .. slot .. "_" .. itemKey, 4) then
        report("Slot " .. slot .. ": claiming")

        local ok, result = invoke("ClaimGradedItem", slot)

        if not ok or result == false then
            report("Slot " .. slot .. ": claim failed")
            return "Claim retry"
        end

        task.wait(0.5)

        if verifyEmpty(slot) then
            report("Slot " .. slot .. ": cleared successfully")
            slotMemory[slot] = nil
            return "Empty"
        else
            report("Slot " .. slot ..
                ": still occupied; retrying")
            return "Claim retry"
        end
    end

    return "Completed"
end

local function startItem(slot, used)
    local items = getItems()

    if #items == 0 then
        return "No matching items"
    end

    for _, item in ipairs(items) do
        if not enabled or not alive then
            return "Paused"
        end

        if not used[item.guid]
            and attemptAllowed(
                "start_" .. item.guid, 10
            ) then

            used[item.guid] = true

            report("Slot " .. slot ..
                ": starting " .. item.guid)

            local ok, result = invoke(
                "StartGrading",
                slot,
                item.guid,
                item.source,
                nil
            )

            if ok and result ~= false then
                task.wait(0.4)

                local state = getState()

                if state and getSlot(state, slot) ~= nil then
                    report("Slot " .. slot ..
                        ": grading started")
                    return "Started"
                end

                report("Slot " .. slot ..
                    ": start not confirmed")
            end
        end
    end

    return "No start"
end

local function process()
    local state = getState()

    if not state then
        status.Text = "Status: Failed to read slots"
        return
    end

    local unlocked = math.clamp(
        tonumber(state.unlockedCount) or 0,
        0,
        3
    )

    local used = {}
    local display = {}

    for slot = 1, unlocked do
        if not enabled or not alive then
            break
        end

        local info = getSlot(state, slot)
        local result

        if info == nil then
            result = startItem(slot, used)
        else
            result = handleOccupied(slot, info)
        end

        table.insert(
            display,
            tostring(slot) .. ": " .. tostring(result)
        )
    end

    slotStatus.Text = "Slots: " .. table.concat(display, " | ")
    status.Text = "Status: Auto Grading ON"
end

