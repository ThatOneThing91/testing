
-- Cheese Tycoon Hub
-- Collect Cash [P] + Auto Buy
-- Dynamic buttons, cheapest first, excludes 2x Cash

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

if _G.CheeseHubCleanup then
    pcall(_G.CheeseHubCleanup)
end

local alive = true
local buying = false
local collecting = false
local buyRun = 0
local savedPosition = nil
local connections = {}

local latestState = nil
local cashVersion = 0

local function connect(signal, callback)
    local c = signal:Connect(callback)
    table.insert(connections, c)
    return c
end

local function rootPart()
    local character = player.Character
    return character and
        character:FindFirstChild("HumanoidRootPart")
end

local function parseMoney(value)
    if type(value) == "number" then
        return value
    end

    if type(value) ~= "string" then
        return nil
    end

    local clean = value:gsub(",", ""):gsub("%$", "")
    local n, suffix = clean:match(
        "([%d%.]+)%s*([KkMmBbTt]?)"
    )

    n = tonumber(n)
    if not n then return nil end

    local multipliers = {
        K = 1e3,
        M = 1e6,
        B = 1e9,
        T = 1e12
    }

    return n * (multipliers[suffix:upper()] or 1)
end

local function findATM()
    local tycoons = workspace:FindFirstChild("Tycoons")
    local cheese = tycoons and
        tycoons:FindFirstChild("Cheese Tycoon")
    local base = cheese and cheese:FindFirstChild("Player2")
    local essential = base and base:FindFirstChild("Essential")
    local atm = essential and essential:FindFirstChild("ATM")
    return atm and atm:FindFirstChild("Touch")
end

