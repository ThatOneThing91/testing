local okInventory, inventory = pcall(function()
    return GetPlayerInventory:InvokeServer()
end)

if not okInventory then
    warn("GetPlayerInventory failed:", inventory)
    return
end

local dirtyItems = {}

local function findDirty(value, path, seen)
    if typeof(value) ~= "table" then
        return
    end

    seen = seen or {}

    if seen[value] then
        return
    end

    seen[value] = true

    local itemName = value.name or value.Name

    if itemName == "Dirty" then
        local ids = {}

        for k, v in pairs(value) do
            if isUUID(v) then
                table.insert(ids, v)
            end

            if isUUID(k) then
                table.insert(ids, k)
            end
        end

        table.insert(dirtyItems, {
            path = path,
            data = value,
            ids = ids
        })
    end

    for k, v in pairs(value) do
        if typeof(v) == "table" then
            findDirty(
                v,
                path .. "." .. tostring(k),
                seen
            )
        end
    end
end

findDirty(inventory, "Inventory")

print("")
print("========================================")
print("       AUTO WASH DIAGNOSTIC")
print("========================================")
print("Dirty items found:", #dirtyItems)

for i, item in ipairs(dirtyItems) do
    print("")
    print("DIRTY ITEM #" .. i)
    print("Path:", item.path)

    if #item.ids > 0 then
        for _, id in ipairs(item.ids) do
            print("UUID:", id)
        end
    else
        print("UUID: none found at this level")
    end
end

