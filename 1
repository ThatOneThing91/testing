local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Inventory = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Inventory")

local Wash = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Wash")

local GetPlayerInventory = Inventory:WaitForChild("GetPlayerInventory")
local GetWashableItems = Wash:WaitForChild("GetWashableItems")
local GetSlotState = Wash:WaitForChild("GetSlotState")

local function isUUID(v)
    return typeof(v) == "string"
        and v:match(
            "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
        ) ~= nil
end

local function containsUUID(value, uuid, seen)
    if typeof(value) ~= "table" then
        return false
    end

    seen = seen or {}

    if seen[value] then
        return false
    end

    seen[value] = true

    for k, v in pairs(value) do
        if tostring(v) == uuid or tostring(k) == uuid then
            return true
        end

        if typeof(v) == "table" then
            if containsUUID(v, uuid, seen) then
                return true
            end
        end
    end

    return false
end

local function dump(value, indent, seen, maxDepth)
    indent = indent or 0
    seen = seen or {}
    maxDepth = maxDepth or 6

    local prefix = string.rep("  ", indent)

    if indent > maxDepth then
        print(prefix .. "<max depth>")
        return
    end

    if typeof(value) ~= "table" then
        print(prefix .. tostring(value))
        return
    end

    if seen[value] then
        print(prefix .. "<recursive>")
        return
    end

    seen[value] = true

    for k, v in pairs(value) do
        if typeof(v) == "table" then
            print(prefix .. tostring(k) .. " = {")

            dump(
                v,
                indent + 1,
                seen,
                maxDepth
            )

            print(prefix .. "}")
        else
            print(
                prefix ..
                tostring(k) ..
                " = " ..
                tostring(v)
            )
        end
    end
end

