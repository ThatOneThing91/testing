--========================================================
-- LIVE MONITOR
--========================================================

task.spawn(function()

    while running and gui.Parent do

        local success, err = pcall(function()

            -- Inventory
            local invCount =
                player:GetAttribute("InventoryCount") or 0

            local invCap =
                player:GetAttribute("InventoryCap") or 0

            local invPct = 0

            if invCap > 0 then
                invPct = (invCount / invCap) * 100
            end

            inventoryLabel.Text =
                string.format(
                    "Inventory: %d / %d   (%.1f%%)",
                    invCount,
                    invCap,
                    invPct
                )

            -- Pawn state
            local state =
                GetPawnState:InvokeServer()

            local rate = 0
            local seconds = 0

            if state then
                rate =
                    math.floor(
                        ((state.rate or 0) * 100) + 0.5
                    )

                seconds =
                    math.max(
                        0,
                        math.floor(
                            state.secondsUntilNext or 0
                        )
                    )
            end

            rateLabel.Text =
                "Pawn Rate: " .. tostring(rate) .. "%"

            timerLabel.Text =
                string.format(
                    "Next Rate Change: %02d:%02d",
                    math.floor(seconds / 60),
                    seconds % 60
                )

            -- Analyze sellable items
            local guids, count, value =
                analyzeItems()

            sellableLabel.Text =
                "Matching Sellable Items: "
                .. tostring(count)

            valueLabel.Text =
                "Matching Base/Mutation Value: $"
                .. tostring(math.floor(value))

            -- Inventory trigger
            if Settings.AutoInventory
                and invPct >= Settings.InventoryTrigger
            then
                quickSell(
                    string.format(
                        "Inventory %.0f%%",
                        invPct
                    )
                )
            end

            -- Pawn rate trigger
            if Settings.AutoRate
                and rate >= Settings.TargetRate
            then
                quickSell(
                    "Pawn Rate " .. rate .. "%"
                )
            end
        end)

        if not success then
            status.Text =
                "Monitor error: " .. tostring(err)
        end

        task.wait(3)
    end
end)
