--========================================================
-- SELLABLE ITEM ANALYSIS
--========================================================

local function analyzeItems()
    local items = GetSellableItems:InvokeServer()

    if type(items) ~= "table" then
        return {}, 0, 0
    end

    local guids = {}
    local total = 0
    local count = 0

    for guid, data in pairs(items) do
        local conf =
            ItemsData[tostring(data.ItemId)]
            or ItemsData[tonumber(data.ItemId)]

        if conf then
            local basePrice = conf.BasePrice or 0

            local price = 0

            pcall(function()
                price =
                    MutatorModule:CalculatePriceForEntry(
                        basePrice,
                        data
                    ) or 0
            end)

            local maxActive = Settings.MaxValue > 0
            local minActive = Settings.MinValue > 0

            local allowed = true

            if maxActive and minActive then
                allowed =
                    price < Settings.MaxValue
                    or price > Settings.MinValue

            elseif maxActive then
                allowed = price <= Settings.MaxValue

            elseif minActive then
                allowed = price >= Settings.MinValue
            end

            if allowed then
                table.insert(guids, guid)
                total += price
                count += 1
            end
        end
    end

    return guids, count, total
end

--========================================================
-- QUICK SELL
--========================================================

local function quickSell(reason)
    if os.clock() - lastSale < 4 then
        return
    end

    lastSale = os.clock()

    local guids, count =
        analyzeItems()

    if #guids == 0 then
        status.Text = "Nothing matches current filters."
        return
    end

    status.Text =
        "Selling " .. tostring(count) .. " items..."

    local success, result = pcall(function()
        return SellItems:InvokeServer(guids)
    end)

    if success and result and result.success then
        status.Text =
            string.format(
                "%s | Sold %d | Earned $%d",
                reason or "Quick Sell",
                result.sold or count,
                result.totalEarned or 0
            )
    else
        status.Text = "Sale failed."
    end
end

