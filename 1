
-- STORAGE HUNTERS | FISHING GUI DETECTOR V1
-- Standalone diagnostic; does not modify Auto Fishing.

local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local env = (getgenv and getgenv()) or _G

if type(env.SH_FishingDetectorCleanup) == "function" then
    pcall(env.SH_FishingDetectorCleanup)
end

local old = playerGui:FindFirstChild("SH_FishingDetector")
if old then old:Destroy() end

local alive = true
local watching = false
local watchToken = 0
local connections = {}
local previous = {}
local results = {}
local MAX_RESULTS = 90

local function visible(obj)
    if not obj:IsA("GuiObject") or not obj.Visible then
        return false
    end

    local parent = obj.Parent
    while parent and parent ~= playerGui do
        if parent:IsA("GuiObject") and not parent.Visible then
            return false
        end
        parent = parent.Parent
    end

    return true
end

local function relevant(obj)
    local path = obj:GetFullName():lower()

    if path:find("sh_fishingdetector", 1, true)
        or path:find("sh_fishingv", 1, true)
        or path:find("boombox", 1, true)
        or path:find("accessoryguide", 1, true)
        or path:find("authenticationpanel", 1, true) then
        return false
    end

    return true
end

local function score(obj)
    local name = obj.Name:lower()
    local path = obj:GetFullName():lower()
    local s = 0

    for _, word in ipairs({
        "fish", "reel", "minigame", "target",
        "cursor", "indicator", "needle",
        "marker", "tension", "progress",
        "bar", "track", "zone", "gold"
    }) do
        if name:find(word, 1, true) then
            s += 4
        end
    end

    if path:find("fish", 1, true)
        or path:find("reel", 1, true)
        or path:find("minigame", 1, true) then
        s += 5
    end

    local camera = workspace.CurrentCamera
    if camera then
        local viewport = camera.ViewportSize
        local pos = obj.AbsolutePosition
        local size = obj.AbsoluteSize

        if pos.Y >= viewport.Y * 0.05
            and pos.Y <= viewport.Y * 0.65
            and size.X > 1 and size.Y > 1 then
            s += 1
        end
    end

    return s
end

