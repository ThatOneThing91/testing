local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GetPlayerInventory = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Inventory")
    :WaitForChild("GetPlayerInventory")

local function IsUUID(v)
    return typeof(v) == "string"
        and v:match(
            "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
        ) ~= nil
end

local function ContainsDirty(value)
    if typeof(value) ~= "table" then
        return false
    end

    local mutators = value.Mutators

    if typeof(mutators) ~= "table" then
        return false
    end

    for _, mutator in pairs(mutators) do
        if typeof(mutator) == "table" then
            if (mutator.name or mutator.Name) == "Dirty" then
                return true
            end
        end
    end

    return false
end

local function Dump(value, path, depth, seen)
    if typeof(value) ~= "table" then
        return
    end

    if depth > 8 then
        return
    end

    seen = seen or {}

    if seen[value] then
        return
    end

    seen[value] = true

    for key, child in pairs(value) do

        local currentPath =
            path .. "[" .. tostring(key) .. "]"

        if IsUUID(child) then
            print("UUID FOUND:")
            print(currentPath, "=", child)
        elseif typeof(child) == "table" then
            Dump(
                child,
                currentPath,
                depth + 1,
                seen
            )
        end

    end
end

local function FindDirty(value, path, seen)

    if typeof(value) ~= "table" then
        return
    end

    seen = seen or {}

    if seen[value] then
        return
    end

    seen[value] = true

    if ContainsDirty(value) then

        print("")
        print("========================================")
        print("DIRTY ITEM FOUND")
        print("LOCATION:", path)
        print("========================================")

        print("")
        print("Searching this item's entire surrounding table for UUIDs...")

        Dump(value, path, 0, {})

        print("")
        print("========================================")

        return true
    end

    for key, child in pairs(value) do

        if typeof(child) == "table" then

            FindDirty(
                child,
                path .. "." .. tostring(key),
                seen
            )

        end

    end
end

print("Getting inventory...")

local success, inventory = pcall(function()
    return GetPlayerInventory:InvokeServer()
end)

if not success then
    warn("Inventory request failed:", inventory)
    return
end

print("Inventory received.")
print("Searching for Dirty items...")

FindDirty(inventory, "Inventory", {})

print("")
print("========== SCAN COMPLETE ==========")
