local function refresh()
    if not alive then return end
    content.Text = table.concat(results, "\n\n")
    if #results == 0 then
        content.Text = "No results yet."
    end
end

local function push(line)
    table.insert(results, line)

    while #results > MAX_RESULTS do
        table.remove(results, 1)
    end

    refresh()
end

local function describe(obj, prefix)
    local pos = obj.AbsolutePosition
    local size = obj.AbsoluteSize

    return string.format(
        "%s %s\n%s\nPOS: %.0f, %.0f | SIZE: %.0f, %.0f",
        prefix,
        obj.ClassName,
        obj:GetFullName(),
        pos.X, pos.Y,
        size.X, size.Y
    )
end

local function scan()
    if not alive then return end

    local candidates = {}

    for _, obj in ipairs(playerGui:GetDescendants()) do
        if visible(obj) and relevant(obj) then
            local s = score(obj)

            if s >= 4 then
                table.insert(candidates, {
                    obj = obj,
                    score = s
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.score > b.score
    end)

    results = {}

    push("=== ACTIVE GUI SCAN ===")
    push("Candidates found: " .. #candidates)

    for i = 1, math.min(#candidates, 30) do
        local entry = candidates[i]
        push(describe(entry.obj, "[" .. i .. "]"))
    end

    status.Text = "Scan complete: " .. #candidates .. " candidates"
end

local function capturePositions()
    local snapshot = {}

    for _, obj in ipairs(playerGui:GetDescendants()) do
        if visible(obj) and relevant(obj) then
            local pos = obj.AbsolutePosition
            local size = obj.AbsoluteSize

            if size.X > 1 and size.Y > 1 then
                snapshot[obj] = {
                    x = pos.X,
                    y = pos.Y,
                    sx = size.X,
                    sy = size.Y,
                    score = score(obj)
                }
            end
        end
    end

    return snapshot
end

local function watchStep()
    local current = capturePositions()
    local changes = {}

    for obj, data in pairs(current) do
        local oldData = previous[obj]

        if oldData then
            local dx = math.abs(data.x - oldData.x)
            local dy = math.abs(data.y - oldData.y)

            if (dx >= 3 or dy >= 3)
                and (data.score >= 4 or oldData.score >= 4) then

                table.insert(changes, {
                    obj = obj,
                    distance = dx + dy
                })
            end
        end
    end

    table.sort(changes, function(a, b)
        return a.distance > b.distance
    end)

    for i = 1, math.min(#changes, 4) do
        push(describe(changes[i].obj, "[MOVING]"))
    end

    previous = current
end

makeButton("SCAN ACTIVE GUI", 12, 85, 132, scan)

local watchButton
watchButton = makeButton("WATCH: OFF", 152, 85, 114, function()
    watching = not watching
    watchToken += 1

    watchButton.Text = watching
        and "WATCH: ON"
        or "WATCH: OFF"

    if not watching then
        status.Text = "GUI watch stopped."
        return
    end

    previous = capturePositions()
    local token = watchToken
    status.Text = "Watching moving GUI elements..."

    task.spawn(function()
        while alive and watching and token == watchToken do
            task.wait(0.25)

            if alive and watching and token == watchToken then
                watchStep()
            end
        end
    end)
end)

makeButton("COPY RESULTS", 274, 85, 142, function()
    local text = table.concat(results, "\n\n")

    if type(setclipboard) == "function" then
        local ok = pcall(setclipboard, text)

        status.Text = ok
            and "Results copied to clipboard."
            or "Clipboard failed."
    else
        status.Text = "Clipboard not supported by executor."
        print(text)
    end
end)

local function cleanup()
    if not alive then return end

    alive = false
    watching = false
    watchToken += 1

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    gui:Destroy()

    if env.SH_FishingDetectorCleanup == cleanup then
        env.SH_FishingDetectorCleanup = nil
    end
end

local close = makeButton("X", 391, 8, 27, cleanup)
close.Size = UDim2.fromOffset(27, 27)

env.SH_FishingDetectorCleanup = cleanup

