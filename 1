local messages = {}

local function report(message)
    if not alive then return end

    table.insert(messages, tostring(message))

    while #messages > 13 do
        table.remove(messages, 1)
    end

    log.Text = table.concat(messages, "\n")
    print("[Auto Grading V3]", message)
end

local function invoke(name, ...)
    local remote = grading:FindFirstChild(name)

    if not remote or not remote:IsA("RemoteFunction") then
        report("Missing RemoteFunction: " .. name)
        return false, nil
    end

    local args = table.pack(...)

    local ok, result = pcall(function()
        return remote:InvokeServer(
            table.unpack(args, 1, args.n)
        )
    end)

    if not ok then
        report(name .. " ERROR: " .. tostring(result))
    end

    return ok, result
end

