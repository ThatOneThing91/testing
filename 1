local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Events = ReplicatedStorage:WaitForChild("Events")
local InventoryEvents = Events:WaitForChild("Inventory")
local WashEvents = Events:WaitForChild("Wash")

local GetPlayerInventory =
    InventoryEvents:WaitForChild("GetPlayerInventory")

local GetSlotState =
    WashEvents:WaitForChild("GetSlotState")

local StartWash =
    WashEvents:WaitForChild("StartWash")

--==================================================
-- CHECK IF AN ITEM IS DIRTY
--==================================================

local function IsDirtyItem(item)

    if typeof(item) ~= "table" then
        return false
    end

    local mutators = item.Mutators

    if typeof(mutators) ~= "table" then
        return false
    end

    for _, mutator in pairs(mutators) do

        if typeof(mutator) == "table" then

            if (mutator.name or mutator.Name) == "Dirty" then
                return true
            end

        end

    end

    return false
end

--==================================================
-- FIND DIRTY INVENTORY ITEMS
-- UUID IS THE TABLE KEY
--==================================================

local function GetDirtyItems(inventory)

    local dirtyItems = {}

    for itemGUID, itemData in pairs(inventory) do

        if typeof(itemGUID) == "string"
            and IsDirtyItem(itemData) then

            table.insert(dirtyItems, itemGUID)

            print(
                "DIRTY ITEM:",
                itemGUID
            )

        end

    end

    return dirtyItems
end

--==================================================
-- GET INVENTORY
--==================================================

print("")
print("========================================")
print("        3-SLOT WASH TEST")
print("========================================")

print("Getting inventory...")

local success, inventory = pcall(function()
    return GetPlayerInventory:InvokeServer()
end)

if not success then
    warn("Inventory failed:", inventory)
    return
end

-- Some inventory responses may wrap the actual
-- inventory table, so locate the table containing
-- the UUID-keyed items if necessary.

local dirtyItems = GetDirtyItems(inventory)

-- Fallback: recursively look for UUID-keyed
-- Dirty items if the inventory is wrapped.

if #dirtyItems == 0 then

    local visited = {}

    local function Search(value)

        if typeof(value) ~= "table" then
            return
        end

        if visited[value] then
            return
        end

        visited[value] = true

        for key, child in pairs(value) do

            if typeof(key) == "string"
                and typeof(child) == "table"
                and IsDirtyItem(child) then

                table.insert(
                    dirtyItems,
                    key
                )

                print(
                    "DIRTY ITEM:",
                    key
                )

            end

            if typeof(child) == "table" then
                Search(child)
            end

        end

    end

    Search(inventory)

end

print("")
print(
    "Dirty items found:",
    #dirtyItems
)

if #dirtyItems == 0 then

    warn("Still couldn't find Dirty items.")
    return

end

--==================================================
-- GET SLOT STATE
--==================================================

print("")
print("Checking wash slots...")

local slotSuccess, slotState = pcall(function()
    return GetSlotState:InvokeServer()
end)

if not slotSuccess then
    warn(
        "GetSlotState failed:",
        slotState
    )
    return
end

local unlockedCount =
    tonumber(slotState.unlockedCount) or 3

print(
    "Unlocked slots:",
    unlockedCount
)

local slots = slotState.slots

if typeof(slots) ~= "table" then
    warn("Slot table wasn't found.")
    return
end

--==================================================
-- FIND EMPTY SLOTS
--==================================================

local emptySlots = {}

for slotNumber = 1, math.min(unlockedCount, 3) do

    local slot = slots[slotNumber]

    if not slot
        or not slot.ItemData then

        print(
            "Slot",
            slotNumber,
            "= EMPTY"
        )

        table.insert(
            emptySlots,
            slotNumber
        )

    else

        print(
            "Slot",
            slotNumber,
            "= OCCUPIED"
        )

    end

end

print("")
print(
    "Empty slots:",
    #emptySlots
)

if #emptySlots == 0 then

    print(
        "All 3 wash slots are currently occupied."
    )

    return

end

--==================================================
-- START WASHES
--==================================================

print("")
print("Starting washes...")

for index, slotNumber in ipairs(emptySlots) do

    local itemGUID = dirtyItems[index]

    if not itemGUID then
        break
    end

    print("")
    print("----------------------------------------")
    print("STARTING WASH")
    print("Slot:", slotNumber)
    print("Item:", itemGUID)
    print("----------------------------------------")

    local washSuccess, result = pcall(function()

        return StartWash:InvokeServer(
            slotNumber,
            itemGUID,
            "Inventory"
        )

    end)

    if washSuccess then

        print(
            "SUCCESS - StartWash accepted"
        )

        print(
            "Result:",
            result
        )

    else

        warn(
            "FAILED:",
            result
        )

    end

    task.wait(0.5)

end

print("")
print("========================================")
print("          TEST FINISHED")
print("========================================")
