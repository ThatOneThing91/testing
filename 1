local function makeToggle(text, y, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -28, 0, 30)
    btn.Position = UDim2.new(0, 14, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(35, 39, 50)
    btn.TextColor3 = Color3.fromRGB(220, 225, 240)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.Parent = main

    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

    local state = false

    local function update()
        btn.Text = text .. ": " .. (state and "ON" or "OFF")

        if state then
            btn.TextColor3 = Color3.fromRGB(80, 220, 130)
        else
            btn.TextColor3 = Color3.fromRGB(220, 225, 240)
        end
    end

    btn.MouseButton1Click:Connect(function()
        state = not state
        update()
        callback(state)
    end)

    update()

    return btn
end

