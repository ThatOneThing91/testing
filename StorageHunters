--//========================================================

local TreeTeleportEnabled = false

local TreeItemOrder = {
    8,
    "Apple Tree",
    4,
    2,
    6,
    5,
    7,
    3
}

local function findAppleTreeFolders(trees)

    local result = {}

    for _, obj in ipairs(
        trees:GetChildren()
    ) do

        if obj:IsA("Folder")
            or obj:IsA("Model") then

            local found = false

            for _, descendant in ipairs(
                obj:GetDescendants()
            ) do

                if descendant.Name ==
                    "Apple Tree" then

                    found = true
                    break
                end
            end

            if found then
                table.insert(
                    result,
                    obj
                )
            end
        end
    end

    return result
end

local function treeTeleportLoop()

    while TreeTeleportEnabled do

        local trees =
            getTrees()

        if trees then

            local folders =
                findAppleTreeFolders(
                    trees
                )

            for _, folder in ipairs(
                folders
            ) do

                if not TreeTeleportEnabled then
                    break
                end

                for _, item in ipairs(
                    TreeItemOrder
                ) do

                    if not TreeTeleportEnabled then
                        break
                    end

                    local target

                    if type(item) == "number" then

                        target =
                            folder:GetChildren()[item]

                    else

                        target =
                            folder:FindFirstChild(
                                item,
                                true
                            )
                    end

                    if target then

                        teleportToObject(
                            target
                        )

                        task.wait(
                            0.15
                        )
                    end
                end
            end
        end

        task.wait(0.2)
    end
end

