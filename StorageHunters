local PoliceAuctionEnabled = false
local PoliceAuctions = {}

local Garages

pcall(function()

    Garages =
        workspace
        :WaitForChild("_Debris")
        :WaitForChild("Garages")

end)

local function checkPoliceGarage(
    garage
)

    if not garage then
        return
    end

    if Garages
        and not garage:IsDescendantOf(
            Garages
        ) then

        return
    end

    if garage:FindFirstChild(
        "PoliceWarning",
        true
    ) then

        PoliceAuctions[
            garage
        ] = true
    end
end

local function scanPoliceAuctions()

    table.clear(
        PoliceAuctions
    )

    if not Garages then
        return
    end

    for _, garage in ipairs(
        Garages:GetChildren()
    ) do

        checkPoliceGarage(
            garage
        )
    end
end

local function teleportToPoliceAuction()

    if not Garages then
        return
    end

    scanPoliceAuctions()

    local selectedGarage

    for garage in pairs(
        PoliceAuctions
    ) do

        if garage
            and garage.Parent ==
                Garages then

            selectedGarage =
                garage

            break
        end
    end

    if not selectedGarage then

        notify(
            "Police Auction",
            "No police auction found"
        )

        return
    end

    local EntrySquare =
        selectedGarage:FindFirstChild(
            "EntrySquare",
            true
        )

    if not EntrySquare then

        notify(
            "Police Auction",
            "EntrySquare not found"
        )

        return
    end

    local PromptPart =
        EntrySquare:FindFirstChild(
            "PromptPart",
            true
        )

    local destination =
        PromptPart

