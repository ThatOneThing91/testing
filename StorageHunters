local function getHoop()

    local assets =
        workspace:FindFirstChild(
            "BBOW Builder Assets"
        )

    if not assets then
        return nil
    end

    local other =
        assets:FindFirstChild(
            "Other Buildings and  Decoration"
        )

    if not other then
        return nil
    end

    local basket =
        other:FindFirstChild(
            "Basket Ball "
        )

    if not basket then
        return nil
    end

    local hoop =
        basket:FindFirstChild(
            "Hoop"
        )

    if not hoop then
        return nil
    end

    return hoop:FindFirstChild(
        "Ring"
    )
end

local function lockToRim()

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local hrp =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not hrp then
        return
    end

    local ring =
        getHoop()

    if not ring then
        return
    end

    local pos = hrp.Position
    local target = ring.Position

    local flatTarget =
        Vector3.new(
            target.X,
            pos.Y,
            target.Z
        )

    hrp.CFrame =
        CFrame.lookAt(
            pos,
            flatTarget
        )
end

local function basketballLoop()

    if BasketballRunning then
        return
    end

    BasketballRunning = true

    while AutoBasketballEnabled do

        local ball =
            getBasketball()

        if ball then

            local character =
                LocalPlayer.Character

            if character then

                local hrp =
                    character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if hrp then

                    pcall(function()

                        hrp.CFrame =
                            CFrame.new(
                                -274,
                                1723,
                                -590
                            )

                        task.wait(0.15)

                        lockToRim()

                        ball:Activate()

                        task.wait(1)

                        ball:Deactivate()

                    end)
                end
            end

            task.wait(0.5)

        else

            task.wait(1)
        end
    end

    BasketballRunning = false
end

