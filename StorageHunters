--//========================================================

local CurrentHue = 0
local CurrentSaturation = 1
local CurrentValue = 0.49

local function colorToHex(color)

    local r =
        math.floor(
            color.R * 255 + 0.5
        )

    local g =
        math.floor(
            color.G * 255 + 0.5
        )

    local b =
        math.floor(
            color.B * 255 + 0.5
        )

    return string.format(
        "#%02X%02X%02X",
        r,
        g,
        b
    )
end

local function setTheme(color)

    ThemeColor = color

    MainStroke.Color =
        ThemeColor

    TitleBar.BackgroundColor3 =
        ThemeColor

    Scroll.ScrollBarImageColor3 =
        ThemeColor

    ResizeHandle.TextColor3 =
        ThemeColor

    PickerStroke.Color =
        ThemeColor

    Preview.BackgroundColor3 =
        ThemeColor

    HexLabel.Text =
        colorToHex(
            ThemeColor
        )

    for _, object in ipairs(
        ToggleObjects
    ) do

        object.Stroke.Color =
            ThemeColor

        if object.Enabled then

            object.Toggle.BackgroundColor3 =
                ThemeColor
        end
    end
end

local function updateSVBackground()

    SVBox.BackgroundColor3 =
        Color3.fromHSV(
            CurrentHue,
            1,
            1
        )
end

local function updateSVSelector()

    SVSelector.Position =
        UDim2.new(
            CurrentSaturation,
            0,
            1 - CurrentValue,
            0
        )
end

local function updateHueSelector()

    HueSelector.Position =
        UDim2.new(
            CurrentHue,
            0,
            0.5,
            0
        )
end

local function updatePickedColor()

    local color =
        Color3.fromHSV(
            CurrentHue,
            CurrentSaturation,
            CurrentValue
        )

    setTheme(color)
end

local function updateFromSV(position)

    local absolute =
        SVBox.AbsolutePosition

    local size =
        SVBox.AbsoluteSize

    local x =
        math.clamp(
            position.X - absolute.X,
            0,
            size.X
        )

    local y =
        math.clamp(
            position.Y - absolute.Y,
            0,
            size.Y
        )

    CurrentSaturation =
        math.clamp(
            x / size.X,
            0,
            1
        )

    CurrentValue =
        math.clamp(
            1 - (y / size.Y),
            0,
            1
        )

    updateSVSelector()
    updatePickedColor()
end

local function updateFromHue(position)

    local absolute =
        HueBar.AbsolutePosition

    local size =
        HueBar.AbsoluteSize

    local x =
        math.clamp(
            position.X - absolute.X,
            0,
            size.X
        )

    CurrentHue =
        math.clamp(
            x / size.X,
            0,
            1
        )

    updateHueSelector()
    updateSVBackground()
    updatePickedColor()
end

