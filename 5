local function getCharacter()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    return character, root
end

local function getEquippedRod()
    local character = player.Character
    if not character then return nil end

    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("Tool") then
            local id = tonumber(
                obj:GetAttribute("ItemId")
                or obj:GetAttribute("ItemID")
                or obj:GetAttribute("itemId")
            )

            if id and knownRodIds[id] then
                return obj, id
            end
        end
    end

    return nil
end

local function isBroken(item)
    if item.Broken == true or item.IsBroken == true then
        return true
    end

    if tonumber(item.Condition) == 0 then
        return true
    end

    for key, value in pairs(item.Mutators or {}) do
        if tostring(key):lower() == "broken" and value ~= false then
            return true
        end

        if tostring(value):lower() == "broken" then
            return true
        end

        if type(value) == "table" then
            local name = value.Name or value.name or value.Mutator
            if tostring(name):lower() == "broken" then
                return true
            end
        end
    end

    return false
end

local function getInventory()
    local ok, data = pcall(function()
        return Events.Inventory:InvokeServer()
    end)

    if not ok or type(data) ~= "table" then return nil end

    return data.Inventory or data.Items or data
end

local function findUsableRod()
    local inventory = getInventory()
    if not inventory then return nil, "Inventory unavailable" end

    local rods = {}

    for guid, item in pairs(inventory) do
        if type(item) == "table" then
            local id = tonumber(item.ItemId)

            if id and knownRodIds[id] and not isBroken(item) then
                local actualGuid = item.Guid or item.UUID or guid

                if type(actualGuid) == "string"
                    and not failedRodGuids[actualGuid] then
                    table.insert(rods, {
                        guid = actualGuid,
                        id = id,
                        condition = tonumber(item.Condition) or 0
                    })
                end
            end
        end
    end

    table.sort(rods, function(a, b)
        return a.condition > b.condition
    end)

    return rods[1], "No usable fishing rods"
end

local function ensureRodEquipped()
    local equipped, equippedId = getEquippedRod()

    -- Don't re-equip an already equipped usable rod.
    if equipped then
        rodLabel.Text = "Rod: Equipped ItemId " .. equippedId
        return true
    end

    local rod, err = findUsableRod()
    if not rod then return false, err end

    setStatus("Equipping rod " .. rod.id)

    local ok = pcall(function()
        Events.Equip:FireServer(rod.guid)
    end)

    if not ok then
        return false, "Equip remote failed"
    end

    currentRodGuid = rod.guid

    -- Confirm the Tool actually appeared.
    local deadline = os.clock() + 3
    while os.clock() < deadline and running and not destroyed do
        local tool, id = getEquippedRod()

        if tool then
            rodLabel.Text = "Rod: Equipped ItemId " .. id
            return true
        end

        task.wait(0.1)
    end

    failedRodGuids[rod.guid] = true
    return false, "Rod equip not confirmed"
end

-- Water detection:
-- Raycasts in front of the player at different distances.
-- Uses Terrain water or parts whose names/material suggest water.

local function isWaterPart(part)
    if not part then return false end

    if part == workspace.Terrain then
        return true
    end

    local name = part.Name:lower()

    if name:find("water") or name:find("lake")
        or name:find("pond") or name:find("river") then
        return true
    end

    if part:IsA("BasePart") then
        if part.Material == Enum.Material.Water then
            return true
        end
    end

    return false
end

local function findNearbyWater()
    local character, root = getCharacter()
    if not root then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = false

    local origin = root.Position
    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector

    local distances = {8, 14, 22, 32, 45, 60}
    local offsets = {0, -5, 5, -12, 12}

    for _, distance in ipairs(distances) do
        for _, side in ipairs(offsets) do
            local point = origin
                + forward * distance
                + right * side

            local rayOrigin = point + Vector3.new(0, 35, 0)
            local rayDirection = Vector3.new(0, -90, 0)

            local result = workspace:Raycast(
                rayOrigin,
                rayDirection,
                params
            )

            if result and isWaterPart(result.Instance) then
                return result.Instance, result.Position
            end
        end
    end

    return nil
end

local function cancelCurrent()
    if Events.Cancel then
        pcall(function()
            Events.Cancel:FireServer()
        end)
    end
end

local function stopFishing(cancel)
    running = false
    session += 1
    busy = false
    activeCastId = nil

    if cancel then cancelCurrent() end

    setPhase("idle")
    updateToggle()
end

-- Fishing events

if Events.State and Events.State:IsA("RemoteEvent") then
    table.insert(connections,
        Events.State.OnClientEvent:Connect(function(state, data)
            if destroyed or not running then return end

            data = type(data) == "table" and data or {}

            if state == "cast" then
                if phase ~= "casting" then return end

                activeCastId = data.castId
                setPhase("waiting")
                setStatus("Cast accepted")

            elseif state == "reel" then
                if phase ~= "waiting" then return end

                if activeCastId ~= nil and data.castId ~= activeCastId then
                    return
                end

                setPhase("reeling")
                setStatus("Reeling: " .. tostring(data.itemName or "?"))

                local ok = pcall(function()
                    Events.Result:FireServer("caught")
                end)

                if ok then
                    setPhase("confirming")
                else
                    failures += 1
                    updateStats()
                    stopFishing(true)
                    setStatus("Result request failed")
                end

            elseif state == "done" then
                if phase ~= "confirming"
                    and phase ~= "reeling"
                    and phase ~= "waiting" then
                    return
                end

                if activeCastId ~= nil and data.castId ~= nil
                    and data.castId ~= activeCastId then
                    return
                end

                if data.reason == "caught" then
                    catches += 1
                    setStatus("Caught: " .. tostring(data.itemName or "?"))
                else
                    failures += 1
                    setStatus("Ended: " .. tostring(data.reason or "?"))
                end

                updateStats()
                activeCastId = nil
                busy = false
                setPhase("cooldown")
            end
        end)
    )
end

-- Main worker: only one fishing session at a time.

task.spawn(function()
    while not destroyed do
        if not running then
            task.wait(0.15)
            continue
        end

        if phase == "idle" and not busy then
            busy = true
            local token = session
            setPhase("equipping")

            local ok, err = ensureRodEquipped()

            if destroyed or not running or token ~= session then
                busy = false
                continue
            end

            if not ok then
                stopFishing(false)
                setStatus(err or "No usable rod")
                continue
            end

            local water, hitPosition = findNearbyWater()

            if not water then
                busy = false
                setPhase("searching")
                setStatus("No nearby water detected")
                waterLabel.Text = "Water: Walk closer and face the water"
                continue
            end

            waterLabel.Text = "Water: " .. water.Name
            setPhase("casting")
            setStatus("Casting...")

            casts += 1
            updateStats()

            local success = pcall(function()
                Events.Cast:FireServer(water, hitPosition)
            end)

            if not success then
                failures += 1
                updateStats()
                stopFishing(true)
                setStatus("Cast failed")
            end

        elseif phase == "searching" then
            if os.clock() - phaseStarted >= 1 then
                setPhase("idle")
            end

        elseif phase == "cooldown" then
            if os.clock() - phaseStarted >= 1.5 then
                busy = false
                setPhase("idle")
            end

        elseif phase == "casting" then
            if os.clock() - phaseStarted > 8 then
                failures += 1
                updateStats()
                stopFishing(true)
                setStatus("Cast timeout")
            end

        elseif phase == "waiting" then
            if os.clock() - phaseStarted > 35 then
                failures += 1
                updateStats()
                stopFishing(true)
                setStatus("Bite timeout")
            end

        elseif phase == "confirming" then
            if os.clock() - phaseStarted > 12 then
                failures += 1
                updateStats()
                stopFishing(true)
                setStatus("Catch confirmation timeout")
            end
        end

        task.wait(0.1)
    end
end)

