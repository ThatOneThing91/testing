    if running then
        setStatus("Turn fishing OFF before learning")
        return
    end

    local character = player.Character
    local tool = character and character:FindFirstChildOfClass("Tool")

    if not tool then
        setStatus("Equip a fishing rod first")
        return
    end

    local id = tonumber(
        tool:GetAttribute("ItemId")
        or tool:GetAttribute("ItemID")
        or tool:GetAttribute("itemId")
    )

    if not id then
        setStatus("Tool has no ItemId attribute")
        return
    end

    knownRodIds[id] = true
    setStatus("Learned fishing rod ItemId: " .. id)
    info.Text = "Known rod IDs include: " .. id
end)

toggle.MouseButton1Click:Connect(function()
    if running then
        stopFishing(true)
        setStatus("Stopped")
        return
    end

    local types = {
        Cast = "RemoteEvent",
        Result = "RemoteEvent",
        Cancel = "RemoteEvent",
        State = "RemoteEvent",
        Inventory = "RemoteFunction",
        Equip = "RemoteEvent"
    }

    for name, class in pairs(types) do
        if not Events[name] or not Events[name]:IsA(class) then
            setStatus("Missing remote: " .. name)
            return
        end
    end

    running = true
    session += 1
    busy = false
    activeCastId = nil
    currentRodGuid = nil
    failedRodGuids = {}

    setPhase("idle")
    updateToggle()
    setStatus("Searching for water...")
end)

local function cleanup()
    if destroyed then return end

    stopFishing(true)
    destroyed = true

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    gui:Destroy()

    if env.SH_FishingV5Cleanup == cleanup then
        env.SH_FishingV5Cleanup = nil
    end
end

close.MouseButton1Click:Connect(cleanup)
env.SH_FishingV5Cleanup = cleanup

