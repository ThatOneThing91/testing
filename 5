
-- Tycoon Hub
-- Collect Cash / Auto Buy / Auto Make Pizzas
-- P = Collect Cash
-- Comma = Hide / Show GUI

if _G.CheeseHubCleanup then
    pcall(_G.CheeseHubCleanup)
end

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local pizzaFolder = RS:WaitForChild("Features"):WaitForChild("PizzaMaking")
local pizzaRemote = pizzaFolder:WaitForChild("Remote")

local alive = true
local autoBuy = false
local autoPizza = false
local connections = {}
local activeSession = nil
local pizzaProgress = {}
local currentCash = nil
local buyGeneration = 0
local pizzaGeneration = 0

local function connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(connections, connection)
    return connection
end

local function root()
    local char = player.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function teleportAbove(part)
    local r = root()
    if not r or not part or not part:IsA("BasePart") then
        return false
    end

    local hum = r.Parent:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.Sit = false
        hum.PlatformStand = false
    end

    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    r.CFrame = CFrame.new(
        part.Position.X,
        part.Position.Y + part.Size.Y / 2 + 3,
        part.Position.Z
    )

    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero

    return true
end

local function getPlot()
    local tycoon = player:FindFirstChild("Tycoon")
    if not tycoon or not tycoon:IsA("ObjectValue") then
        return nil
    end

    local slot = tycoon:GetAttribute("Slot")
    if slot ~= 1 and slot ~= 2 then
        return nil
    end

    return tycoon.Value, slot
end

local function findATM()
    local plot, slot = getPlot()
    if not plot then return nil end

    local side = plot:FindFirstChild("Player" .. slot)
    local essential = side and side:FindFirstChild("Essential")
    local atm = essential and essential:FindFirstChild("ATM")
    local touch = atm and atm:FindFirstChild("Touch")

    if touch and touch:IsA("BasePart") then
        return touch
    end

    return nil
end

local collecting = false

local function collectCash()
    if collecting or not alive then return end
    collecting = true

    local r = root()
    local atm = findATM()

    if r and atm then
        local original = r.CFrame

        if teleportAbove(atm) then
            task.wait(0.5)
            if alive and r.Parent then
                r.CFrame = original
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end

    collecting = false
end

-- Auto Buy

local function getMyButtons()
    return workspace:FindFirstChild(
        "__TycoonButtons_" .. tostring(player.UserId)
    )
end

local function money(value)
    if type(value) == "number" then return value end
    if type(value) ~= "string" then return nil end

    local s = value:gsub(",", ""):gsub("%$", "")
    local number, suffix = s:match("([%d%.]+)%s*([KkMmBbTt]?)")
    number = tonumber(number)

    if not number then return nil end

    local multipliers = {
        K = 1e3, M = 1e6, B = 1e9, T = 1e12
    }

    return number * (multipliers[suffix:upper()] or 1)
end

local function getCash()
    if currentCash ~= nil then return currentCash end

    local stats = player:FindFirstChild("leaderstats")
    if stats then
        for _, name in ipairs({"Cash", "Money"}) do
            local v = stats:FindFirstChild(name)
            if v and (v:IsA("IntValue") or v:IsA("NumberValue")) then
                return v.Value
            end
        end
    end

    for _, name in ipairs({"Cash", "Money"}) do
        local v = player:GetAttribute(name)
        if type(v) == "number" then return v end
    end

    return nil
end

local function isExcluded(button)
    local name = button.Name:lower()

    -- Critical: never buy teammate/other-owner buttons.
    if name:sub(1, 9) == "teammate_" then
        return true
    end

    if button:GetAttribute("IsTeammate") == true then
        return true
    end

    if button:GetAttribute("CanPurchase") == false then
        return true
    end

    local function forbidden(text)
        text = tostring(text):lower():gsub("[^%w]", "")
        return text:find("2xcash", 1, true)
            or text:find("doublecash", 1, true)
            or text:find("cashmultiplier", 1, true)
            or text:find("2timescash", 1, true)
    end

    if forbidden(button.Name) then return true end

    for _, obj in ipairs(button:GetDescendants()) do
        if (obj:IsA("TextLabel") or obj:IsA("TextButton"))
            and forbidden(obj.Text) then
            return true
        end
    end

    return false
end

local function getPrice(button)
    local value = money(button:GetAttribute("Price"))
    if value then return value end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") then
            local price = money(obj.Text)
            if price then return price end
        end
    end

    return nil
end

local function getBuyPart(button)
    local base = button:FindFirstChild("Base")
    if base and base:IsA("BasePart") then return base end

    if button:IsA("BasePart") then return button end

    return button:FindFirstChildWhichIsA("BasePart", true)
end

local function getAffordableButtons(failed)
    local folder = getMyButtons()
    local cash = getCash()
    local candidates = {}

    if not folder or cash == nil then
        return candidates
    end

    for _, button in ipairs(folder:GetChildren()) do
        if not failed[button] and not isExcluded(button) then
            local price = getPrice(button)
            local part = getBuyPart(button)

            if price and price <= cash and part then
                table.insert(candidates, {
                    button = button,
                    part = part,
                    price = price
                })
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.price < b.price
    end)

    return candidates
end

local function runAutoBuy(generation)
    local r = root()
    local original = r and r.CFrame
    local failed = {}

    while alive and autoBuy and generation == buyGeneration do
        local candidates = getAffordableButtons(failed)
        local choice = candidates[1]

        if not choice then
            break
        end

        local button = choice.button
        local folder = getMyButtons()

        if not folder or button.Parent ~= folder
            or isExcluded(button) then
            failed[button] = true
            task.wait(0.1)
            continue
        end

        teleportAbove(choice.part)

        local start = os.clock()
        local disappeared = false

        while alive and autoBuy
            and generation == buyGeneration
            and os.clock() - start < 2 do

            if not button.Parent or button.Parent ~= folder then
                disappeared = true
                break
            end

            task.wait(0.05)
        end

        if not disappeared then
            failed[button] = true
        end

        task.wait(0.12)
    end

    if generation == buyGeneration then
        autoBuy = false

        local currentRoot = root()
        if original and currentRoot then
            currentRoot.CFrame = original
            currentRoot.AssemblyLinearVelocity = Vector3.zero
            currentRoot.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

-- Pizza Making
-- Works on a pizza minigame that has already been opened.
-- Session ID comes from the actual server Begin event.

local function findPizzaGui()
    local pg = player:FindFirstChild("PlayerGui")
    if not pg then return nil end

    for _, gui in ipairs(pg:GetDescendants()) do
        if gui:IsA("ScreenGui")
            and gui:GetAttribute("Phase") ~= nil then
            local phase = gui:GetAttribute("Phase")
            if phase == "Dough" or phase == "Sauce"
                or phase == "Cheese" or phase == "Toppings"
                or phase == "Serving" then
                return gui, phase
            end
        end
    end

    return nil
end

connect(pizzaRemote.OnClientEvent, function(action, session, a, b)
    if action == "Begin" then
        activeSession = session
        pizzaProgress = {}
    elseif action == "Progress" and session == activeSession then
        pizzaProgress[a] = b
    elseif action == "PourComplete" and session == activeSession then
        pizzaProgress[a] = 1
    end
end)

local function pizzaAction(session, action, position, ingredient)
    if not alive or not autoPizza or session ~= activeSession then
        return
    end

    pizzaRemote:FireServer(
        session,
        action,
        position,
        ingredient
    )
end

local function readToppingCounts(gui)
    local counts = {}

    for _, obj in ipairs(gui:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local text = obj.Text
            local count = tonumber(text:match("(%d+)%s+left"))

            if count and count > 0 then
                local lower = text:lower()

                for _, topping in ipairs({
                    "Pepperoni", "Mushroom", "Pineapple",
                    "Olive", "Onion", "Pepper", "Sausage",
                    "Bacon", "Ham", "Tomato"
                }) do
                    if lower:find(topping:lower(), 1, true) then
                        counts[topping] = math.max(
                            counts[topping] or 0,
                            count
                        )
                    end
                end
            end
        end
    end

    return counts
end

local function runAutoPizza(generation)
    local lastPhase = nil
    local circleStep = 0
    local toppingIndex = 0
    local lastToppingAt = 0

    while alive and autoPizza and generation == pizzaGeneration do
        local gui, phase = findPizzaGui()
        local session = activeSession

        if not gui or not session then
            lastPhase = nil
            task.wait(0.25)
            continue
        end

        if phase ~= lastPhase then
            lastPhase = phase
            circleStep = 0
            toppingIndex = 0
        end

        if phase == "Dough" then
            -- Repeated circular kneading positions.
            circleStep += 1

            local angle = circleStep * 0.48
            local radius = 0.22

            pizzaAction(
                session,
                "Knead",
                Vector2.new(
                    math.cos(angle) * radius,
                    math.sin(angle) * radius
                ),
                nil
            )

            task.wait(0.09)

        elseif phase == "Sauce" or phase == "Cheese" then
            -- Stationary pouring/sprinkling.
            pizzaAction(
                session,
                "Pour",
                Vector2.new(0, 0),
                nil
            )

            task.wait(0.1)

        elseif phase == "Toppings" then
            local counts = readToppingCounts(gui)
            local selected = nil

            for _, topping in ipairs({
                "Pepperoni", "Mushroom", "Pineapple",
                "Olive", "Onion", "Pepper", "Sausage",
                "Bacon", "Ham", "Tomato"
            }) do
                if (counts[topping] or 0) > 0 then
                    selected = topping
                    break
                end
            end

            if selected and os.clock() - lastToppingAt >= 0.25 then
                toppingIndex += 1

                local angle = toppingIndex * 2.39996
                local radius = 0.2 * math.sqrt(
                    (toppingIndex % 9 + 1) / 9
                )

                pizzaAction(
                    session,
                    "Topping",
                    Vector2.new(
                        math.cos(angle) * radius,
                        math.sin(angle) * radius
                    ),
                    selected
                )

                lastToppingAt = os.clock()
            end

            task.wait(0.12)
        else
            task.wait(0.3)
        end
    end
end

