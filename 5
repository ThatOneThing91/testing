local function refreshButtons()
    buyButton.Text = "Auto Buy: " .. (autoBuy and "ON" or "OFF")
    buyButton.BackgroundColor3 = autoBuy
        and Color3.fromRGB(40, 135, 85)
        or Color3.fromRGB(48, 51, 65)

    pizzaButton.Text = "Auto Make Pizzas: "
        .. (autoPizza and "ON" or "OFF")

    pizzaButton.BackgroundColor3 = autoPizza
        and Color3.fromRGB(40, 135, 85)
        or Color3.fromRGB(48, 51, 65)
end

connect(collectButton.MouseButton1Click, function()
    task.spawn(collectCash)
end)

connect(buyButton.MouseButton1Click, function()
    autoBuy = not autoBuy
    buyGeneration += 1

    if autoBuy then
        local generation = buyGeneration
        task.spawn(runAutoBuy, generation)
    end

    refreshButtons()
end)

connect(pizzaButton.MouseButton1Click, function()
    autoPizza = not autoPizza
    pizzaGeneration += 1

    if autoPizza then
        local generation = pizzaGeneration
        task.spawn(runAutoPizza, generation)
    end

    refreshButtons()
end)

connect(UIS.InputBegan, function(input, processed)
    if processed or not alive then return end

    if input.KeyCode == Enum.KeyCode.P then
        task.spawn(collectCash)
    elseif input.KeyCode == Enum.KeyCode.Comma then
        frame.Visible = not frame.Visible
    end
end)

local tycoonFolder = RS:FindFirstChild("Tycoon")
local buttonRemote = tycoonFolder
    and tycoonFolder:FindFirstChild("TycoonButtonEvent")

if buttonRemote then
    connect(buttonRemote.OnClientEvent, function(action, data)
        if type(data) ~= "table" then return end
        if action ~= "Snapshot" and action ~= "State" then return end

        local plot, slot = getPlot()

        if plot and data.tycoon == plot
            and data.slot == slot
            and type(data.cash) == "number" then
            currentCash = data.cash
        end
    end)
end

-- Keep toggle labels synchronized when Auto Buy stops itself.
task.spawn(function()
    while alive do
        refreshButtons()
        task.wait(0.25)
    end
end)

_G.CheeseHubCleanup = function()
    alive = false
    autoBuy = false
    autoPizza = false
    buyGeneration += 1
    pizzaGeneration += 1

    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    connections = {}

    if gui then
        gui:Destroy()
    end

    _G.CheeseHubCleanup = nil
end

refreshButtons()
