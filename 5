local function WaitForAuctionStart(runId, timeout)
    local start = os.clock()

    while not HubDestroyed
        and State.Farming
        and RunIds.Farming == runId
        and os.clock() - start < timeout do

        if AuctionIsOpen() and GetBidButton() then
