local ReplicatedStorage = game:GetService("ReplicatedStorage")

local InventoryEvents = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Inventory")

local WashEvents = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Wash")

local GetPlayerInventory =
    InventoryEvents:WaitForChild("GetPlayerInventory")

local GetSlotState =
    WashEvents:WaitForChild("GetSlotState")

local StartWash =
    WashEvents:WaitForChild("StartWash")

--==================================================
-- FIND DIRTY ITEMS
--==================================================

local function IsUUID(value)
    return typeof(value) == "string"
        and value:match(
            "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
        ) ~= nil
end

local function FindDirtyItems(value, path, results, seen)

    if typeof(value) ~= "table" then
        return
    end

    seen = seen or {}
    results = results or {}

    if seen[value] then
        return results
    end

    seen[value] = true

    local mutators = value.Mutators

    if typeof(mutators) == "table" then

        for index, mutator in pairs(mutators) do

            if typeof(mutator) == "table" then

                local name =
                    mutator.name or mutator.Name

                if name == "Dirty" then

                    local guid

                    -- Search this item for its UUID
                    for key, child in pairs(value) do

                        if IsUUID(child) then
                            guid = child
                            break
                        end

                        if IsUUID(key) then
                            guid = key
                            break
                        end

                    end

                    if guid then
                        table.insert(results, guid)

                        print(
                            "DIRTY:",
                            guid
                        )
                    end
                end
            end
        end
    end

    for key, child in pairs(value) do

        if typeof(child) == "table" then

            FindDirtyItems(
                child,
                path .. "." .. tostring(key),
                results,
                seen
            )

        end
    end

    return results
end

--==================================================
-- GET INVENTORY
--==================================================

print("Getting inventory...")

local inventorySuccess, inventory =
    pcall(function()
        return GetPlayerInventory:InvokeServer()
    end)

if not inventorySuccess then
    warn("Inventory request failed:", inventory)
    return
end

local dirtyItems =
    FindDirtyItems(
        inventory,
        "Inventory",
        {}
    )

print("")
print("Dirty items found:", #dirtyItems)

if #dirtyItems == 0 then
    warn("No Dirty items found.")
    return
end

--==================================================
-- GET WASH SLOTS
--==================================================

print("")
print("Checking wash slots...")

local slotSuccess, slotState =
    pcall(function()
        return GetSlotState:InvokeServer()
    end)

if not slotSuccess then
    warn("GetSlotState failed:", slotState)
    return
end

local unlockedCount =
    tonumber(slotState.unlockedCount) or 3

print(
    "Unlocked wash slots:",
    unlockedCount
)

local slots = slotState.slots

if typeof(slots) ~= "table" then
    warn("Could not read wash slots.")
    return
end

--==================================================
-- FIND EMPTY SLOTS
--==================================================

local emptySlots = {}

for slotNumber = 1, math.min(unlockedCount, 3) do

    local slot = slots[slotNumber]

    if not slot or not slot.ItemData then

        table.insert(
            emptySlots,
            slotNumber
        )

        print(
            "Slot",
            slotNumber,
            "= EMPTY"
        )

    else

        print(
            "Slot",
            slotNumber,
            "= OCCUPIED"
        )

    end
end

print("")
print(
    "Empty slots:",
    #emptySlots
)

if #emptySlots == 0 then
    print("All wash slots are occupied.")
    return
end

--==================================================
-- START WASHES
--==================================================

print("")
print("Starting washes...")

local itemIndex = 1

for _, slotNumber in ipairs(emptySlots) do

    local itemGUID =
        dirtyItems[itemIndex]

    if not itemGUID then
        break
    end

    print("")
    print(
        "Starting:",
        "Slot",
        slotNumber
    )

    print(
        "Item:",
        itemGUID
    )

    local success, result =
        pcall(function()

            return StartWash:InvokeServer(
                slotNumber,
                itemGUID,
                "Inventory"
            )

        end)

    if success then

        print(
            "START WASH SUCCESS",
            "Slot:",
            slotNumber,
            "Result:",
            result
        )

    else

        warn(
            "START WASH FAILED",
            "Slot:",
            slotNumber,
            "Error:",
            result
        )

    end

    itemIndex += 1

    task.wait(0.5)
end

print("")
print("================================")
print("3-SLOT WASH TEST FINISHED")
print("================================")
