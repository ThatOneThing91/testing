section("MONITOR")

local monitoring = false

button("Toggle Slot Monitor (2 seconds)", function()
    monitoring = not monitoring
    output("Slot monitor: " .. (monitoring and "ON" or "OFF"))

    if monitoring then
        task.spawn(function()
            while monitoring and gui.Parent do
                for slot = 1, 3 do
                    if not monitoring then break end
                    call("GetSlotState", slot)
                end
                task.wait(2)
            end
        end)
    end
end)

