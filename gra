section("SLOT CONTROL")

local slotInput = inputBox("1", "Slot number (1-3)")

local function selectedSlot()
    local n = tonumber(slotInput.Text)
    if n and n >= 1 and n <= 3 and n % 1 == 0 then
        return n
    end
    output("Invalid slot. Choose 1, 2, or 3.")
    return nil
end

button("Get All Slot States", function()
    for slot = 1, 3 do
        call("GetSlotState", slot)
    end
end)

button("Get Selected Slot State", function()
    local slot = selectedSlot()
    if slot then call("GetSlotState", slot) end
end)

