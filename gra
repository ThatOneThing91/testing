local function output(message)
    log.Text = (log.Text .. "\n" .. tostring(message)):sub(-4500)
    print("[Grading Test]", message)
end

local function stringify(value, depth)
    depth = depth or 0
    if depth > 3 then return "..." end
    if type(value) ~= "table" then return tostring(value) end

    local parts = {}
    local count = 0
    for k, v in pairs(value) do
        count += 1
        if count > 20 then
            table.insert(parts, "...")
            break
        end
        table.insert(parts, tostring(k) .. "=" .. stringify(v, depth + 1))
    end
    return "{" .. table.concat(parts, ", ") .. "}"
end

local function call(remoteName, ...)
    local remote = grading:FindFirstChild(remoteName)
    if not remote then
        output(remoteName .. ": REMOTE MISSING")
        return nil
    end

    local args = {...}
    output("Calling " .. remoteName .. " " .. stringify(args))

    local ok, result = pcall(function()
        if remote:IsA("RemoteFunction") then
            return remote:InvokeServer(unpack(args))
        elseif remote:IsA("RemoteEvent") then
            remote:FireServer(unpack(args))
            return "Event fired"
        else
            error("Unsupported remote type")
        end
    end)

    if ok then
        output(remoteName .. " -> " .. stringify(result))
        return result
    else
        output("ERROR: " .. tostring(result))
        return nil
    end
end

