    label.TextSize = 10
    label.Font = Enum.Font.GothamSemibold

    label.TextXAlignment =
        Enum.TextXAlignment.Left

    label.Parent =
        container

    local selector =
        Instance.new("TextButton")

    selector.Size =
        UDim2.new(1, -20, 0, 30)

    selector.Position =
        UDim2.new(0, 10, 0, 29)

    selector.BackgroundColor3 =
        DarkerBackground

    selector.Text =
        initialValue

    selector.TextColor3 =
        TextColor

    selector.TextSize = 11

    selector.Font =
        Enum.Font.GothamSemibold

    selector.TextXAlignment =
        Enum.TextXAlignment.Left

    selector.AutoButtonColor =
        false

    selector.ZIndex =
        201

    selector.Parent =
        container

    local selectorPadding =
        Instance.new("UIPadding")

    selectorPadding.PaddingLeft =
        UDim.new(0, 10)

    selectorPadding.Parent =
        selector

    local selectorCorner =
        Instance.new("UICorner")

    selectorCorner.CornerRadius =
        UDim.new(0, 6)

    selectorCorner.Parent =
        selector

    selector.MouseButton1Click:Connect(function()

        CloseDropdown()

        local options =
            getOptions()

        if not options
            or #options == 0 then
            return
        end

        local dropdown =
            Instance.new("Frame")

        dropdown.BackgroundColor3 =
            DarkerBackground

        dropdown.BorderSizePixel = 0
        dropdown.ZIndex = 210
        dropdown.Parent =
            DropdownOverlay

        local dropdownCorner =
            Instance.new("UICorner")

        dropdownCorner.CornerRadius =
            UDim.new(0, 7)

        dropdownCorner.Parent =
            dropdown

        local dropdownStroke =
            Instance.new("UIStroke")

        dropdownStroke.Color =
            ThemeColor

        dropdownStroke.Thickness = 1

        dropdownStroke.Parent =
            dropdown

        local list =
            Instance.new("ScrollingFrame")

        list.Size =
            UDim2.new(1, 0, 1, 0)

        list.BackgroundTransparency = 1
        list.BorderSizePixel = 0
        list.ScrollBarThickness = 4
        list.ScrollBarImageColor3 =
            ThemeColor

        list.CanvasSize =
            UDim2.new(0, 0, 0, 0)

        list.AutomaticCanvasSize =
            Enum.AutomaticSize.Y

        list.ZIndex = 211
        list.Parent =
            dropdown

        local padding =
            Instance.new("UIPadding")

        padding.PaddingTop =
            UDim.new(0, 5)

        padding.PaddingBottom =
            UDim.new(0, 5)

        padding.Parent =
            list

        local layout =
            Instance.new("UIListLayout")

        layout.Padding =
            UDim.new(0, 3)

        layout.Parent =
            list

        for _, option in ipairs(options) do

            local optionButton =
                Instance.new("TextButton")

            optionButton.Size =
                UDim2.new(1, -10, 0, 30)

            optionButton.BackgroundColor3 =
                ButtonBackground

            optionButton.Text =
                tostring(option)

            optionButton.TextColor3 =
                TextColor

            optionButton.TextSize = 10

            optionButton.Font =
                Enum.Font.GothamSemibold

            optionButton.TextXAlignment =
                Enum.TextXAlignment.Left

            optionButton.AutoButtonColor =
                false

            optionButton.ZIndex =
                212

            optionButton.Parent =
                list

            local optionPadding =
                Instance.new("UIPadding")

            optionPadding.PaddingLeft =
                UDim.new(0, 8)

            optionPadding.Parent =
                optionButton

            local optionCorner =
                Instance.new("UICorner")

            optionCorner.CornerRadius =
                UDim.new(0, 5)

            optionCorner.Parent =
                optionButton

            optionButton.MouseButton1Click:Connect(function()

                selector.Text =
                    tostring(option)

                CloseDropdown()

                pcall(function()
                    onSelected(option)
                end)

            end)

        end

        local buttonPos =
            selector.AbsolutePosition

        local buttonSize =
            selector.AbsoluteSize

        local height =
            math.min(
                250,
                (#options * 33) + 10
            )

        dropdown.Size =
            UDim2.new(
                0,
                buttonSize.X,
                0,
                height
            )

        dropdown.Position =
            UDim2.new(
                0,
                buttonPos.X,
                0,
                buttonPos.Y
                + buttonSize.Y
                + 3
            )

        CurrentDropdown =
            dropdown
    end)

    return container, selector
end

