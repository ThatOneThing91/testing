local currentHue,
      currentSaturation,
      currentValue =
    Color3.toHSV(
        ThemeColor
    )

local function UpdateTheme(
    color
)

    ThemeColor =
        color

    MainStroke.Color =
        ThemeColor

    MainTab.BackgroundColor3 =
        MainPage.Visible
        and ThemeColor
        or ButtonBackground

    FarmingTab.BackgroundColor3 =
        FarmingPage.Visible
        and ThemeColor
        or ButtonBackground

    ThemeButton.BackgroundColor3 =
        ThemeColor

    PickerStroke.Color =
        ThemeColor

    WheelCenter.BackgroundColor3 =
        ThemeColor

    -- Update active toggles
    for _, page in ipairs({
        MainPage,
        FarmingPage
    }) do

        for _, object in ipairs(
            page:GetChildren()
        ) do

            if object:IsA("Frame") then

                local label =
                    object:FindFirstChildWhichIsA(
                        "TextLabel"
                    )

                local toggle =
                    object:FindFirstChildWhichIsA(
                        "TextButton"
                    )

                if label
                    and toggle
                    and Features[
                        label.Text
                    ] then

                    toggle.BackgroundColor3 =
                        ThemeColor
                end
            end
        end
    end

    -- Update scrollbars
    for _, object in ipairs(
        ScreenGui:GetDescendants()
    ) do

        if object:IsA(
            "ScrollingFrame"
        ) then

            object.ScrollBarImageColor3 =
                ThemeColor
        end
    end

end

local function UpdateWheelPointer()

    local center =
        Vector2.new(
            85,
            85
        )

    local angle =
        currentHue
        * math.pi
        * 2

    local radius =
        currentSaturation
        * 80

    local x =
        center.X
        + math.cos(angle)
        * radius

    local y =
        center.Y
        + math.sin(angle)
        * radius

    WheelPointer.Position =
        UDim2.new(
            0,
            110 - 85 + x - 4,
            0,
            48 + y - 4
        )

end

local function SelectWheel(
    inputPosition
)

    local absolute =
        Wheel.AbsolutePosition

    local size =
        Wheel.AbsoluteSize

    local center =
        Vector2.new(
            absolute.X
                + size.X / 2,

            absolute.Y
                + size.Y / 2
        )

    local position =
        Vector2.new(
            inputPosition.X,
            inputPosition.Y
        )

    local delta =
        position - center

    local distance =
        delta.Magnitude

    if distance > size.X / 2 then
        return
    end

    local angle =
        math.atan2(
            delta.Y,
            delta.X
        )

    currentHue =
        (angle / (math.pi * 2))
        % 1

    currentSaturation =
        math.clamp(
            distance
                / (size.X / 2),
            0,
            1
        )

    currentValue = 1

    local color =
        Color3.fromHSV(
            currentHue,
            currentSaturation,
            currentValue
        )

    UpdateTheme(
        color
    )

    UpdateWheelPointer()
end

local wheelDragging = false

Wheel.InputBegan:Connect(
    function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            wheelDragging = true

            SelectWheel(
                input.Position
            )
        end
    end
)

Wheel.InputEnded:Connect(
    function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1 then

            wheelDragging = false
        end
    end
)

UserInputService.InputChanged:Connect(
    function(input)

        if wheelDragging
            and input.UserInputType ==
                Enum.UserInputType.MouseMovement then

            SelectWheel(
                input.Position
            )
        end
    end
)

UpdateWheelPointer()

ThemeButton.MouseButton1Click:Connect(
