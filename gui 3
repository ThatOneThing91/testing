--==================================================
-- AUTO BASKETBALL
--==================================================

local AutoBasketballEnabled = false
local BasketballRunning = false

local Ball = workspace.ThatOneThing91:WaitForChild("Basketball")

local Hoop = workspace["BBOW Builder Assets"]
    ["Other Buildings and  Decoration"]
    ["Basket Ball "]
    .Hoop
    .Ring

local function lockToRim()
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    if not hrp or not Hoop then
        return
    end

    local direction = Hoop.Position - hrp.Position
    direction = Vector3.new(direction.X, 0, direction.Z)

    if direction.Magnitude > 0 then
        hrp.CFrame = CFrame.lookAt(
            hrp.Position,
            hrp.Position + direction
        )
    end
end

local function startBasketball()
    if BasketballRunning then
        return
    end

    BasketballRunning = true

    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        BasketballRunning = false
        notify("Auto Basketball", "Character not found.")
        return
    end

    -- Perfect shooting position
    hrp.CFrame = CFrame.new(-274, 1723, -590)

    task.wait(0.5)

    notify("Auto Basketball", "ON")

    task.spawn(function()
        while AutoBasketballEnabled do
            lockToRim()

            task.wait(0.1)

            pcall(function()
                Ball:Activate()
            end)

            task.wait(1)

            pcall(function()
                Ball:Deactivate()
            end)

            task.wait(0.5)
        end

        BasketballRunning = false

        notify("Auto Basketball", "OFF")
    end)
end

--==================================================
-- ADD AUTO BASKETBALL BAR
--==================================================

createToggleBar("Auto Basketball", 168, function(enabled)

    AutoBasketballEnabled = enabled

    if enabled then
        startBasketball()
    else
        -- The shooting loop sees this and stops
        AutoBasketballEnabled = false
    end

end)
