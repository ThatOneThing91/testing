--// INSTANT UNLOAD
----------------------------------------------------------------

do

    local running = false

    local function GetVehicleId()

        local id =
            LocalPlayer:GetAttribute(
                "EquippedVehicle"
            )

        if typeof(id) ==
            "string" then

            return id
        end

        return nil
    end

    local function GetVehicleItems()

        local events =
            ReplicatedStorage:FindFirstChild(
                "Events"
            )

        if not events then
            return nil
        end

        local vehicles =
            events:FindFirstChild(
                "Vehicles"
            )

        if not vehicles then
            return nil
        end

        local remote =
            vehicles:FindFirstChild(
                "GetVehicleItems"
            )

        if not remote then
            return nil
        end

        local vehicleId =
            GetVehicleId()

        if not vehicleId then
            return nil
        end

        local success, result =
            pcall(function()

                return remote:InvokeServer(
                    vehicleId
                )

            end)

        if success then
            return result
        end

        return nil
    end

    local function TransferItems(
        items
    )

        local events =
            ReplicatedStorage:FindFirstChild(
                "Events"
            )

        if not events then
            return false
        end

        local vehicles =
            events:FindFirstChild(
                "Vehicles"
            )

        if not vehicles then
            return false
        end

        local transfer =
            vehicles:FindFirstChild(
                "TransferVehicleItemsToInventory"
            )

        if not transfer then
            return false
        end

        local ids = {}

        local function collect(value)

            if typeof(value) ==
                "string" then

                table.insert(
                    ids,
                    value
                )

            elseif typeof(value) ==
                "table" then

                for _, child in pairs(
                    value
                ) do

                    collect(child)

                end
            end
        end

        collect(items)

        if #ids == 0 then
            return false
        end

        local success =
            pcall(function()

                transfer:FireServer(
                    ids
                )

            end)

        return success
    end

    local function Unload()

        local items =
            GetVehicleItems()

        if not items then
            return false
        end

        return TransferItems(
            items
        )
    end

    createToggleBar(
        "Instant Unload",
        function(state)

            running = state

            if state then

                Notify(
                    "Instant Unload",
                    "Enabled",
                    2
                )

                task.spawn(function()

                    while running do

                        pcall(
                            Unload
                        )

                        task.wait(1)
                    end

                end)

            else

                Notify(
                    "Instant Unload",
                    "Disabled",
                    2
                )
            end

        end,
        FarmingPage,
        6
    )
end

