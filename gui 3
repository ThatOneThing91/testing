----------------------------------------------------------------
--// GARAGE FINDING
----------------------------------------------------------------

local function GetGarageByName(name)

    local debris =
        workspace:FindFirstChild(
            "_Debris"
        )

    if debris then

        local garages =
            debris:FindFirstChild(
                "Garages"
            )

        if garages then

            local garage =
                garages:FindFirstChild(
                    name
                )

            if garage then
                return garage
            end
        end
    end

    -- SAME AREA FALLBACK
    local areas =
        workspace:FindFirstChild(
            "Areas"
        )

    if areas then

        local area =
            areas:FindFirstChild(
                SelectedArea
            )

        if area then

            local garage =
                area:FindFirstChild(
                    name,
                    true
                )

            if garage then
                return garage
            end
        end
    end

    return nil
end

local function GetGarageEntry(garage)

    if not garage then
        return nil
    end

    local entry =
        garage:FindFirstChild(
            "EntrySquare",
            true
        )

    if entry then

        local promptPart =
            entry:FindFirstChild(
                "PromptPart",
                true
            )

        if promptPart then
            return promptPart
        end

        local base =
            entry:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if base then
            return base
        end
    end

    return garage:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

local function GetGaragePrompt(garage)

    if not garage then
        return nil
    end

    local prompt =
        garage:FindFirstChild(
            "EnterAuction",
            true
        )

    if prompt
        and prompt:IsA(
            "ProximityPrompt"
        ) then

        return prompt
    end

    return nil
end

----------------------------------------------------------------
--// TELEPORT
----------------------------------------------------------------

local function TeleportToGarage(name)

    local garage =
        GetGarageByName(
            name
        )

    if not garage then
        return false
    end

    local target =
        GetGarageEntry(
            garage
        )

    local character =
        LocalPlayer.Character

    local hrp =
        character
        and character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not target
        or not hrp then

        return false
    end

    hrp.CFrame =
        target.CFrame
        + Vector3.new(
            0,
            3,
            0
        )

    return true
end

----------------------------------------------------------------
--// ENTER AUCTION
----------------------------------------------------------------

local function EnterGarage(name)

    local garage =
        GetGarageByName(
            name
        )

    if not garage then
        return false
    end

    local prompt =
        GetGaragePrompt(
            garage
        )

    if not prompt then
        return false
    end

    pcall(function()
        prompt.HoldDuration = 0
    end)

    if typeof(
        fireproximityprompt
    ) ~= "function" then

        return false
    end

    local success =
        pcall(function()

            fireproximityprompt(
                prompt
            )

        end)

    return success
end

