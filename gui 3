--// TOGGLE
local function createToggleBar(
    name,
    callback,
    page,
    order
)

    local container =
        Instance.new("Frame")

    container.Size =
        UDim2.new(1, -4, 0, 48)

    container.BackgroundColor3 =
        ButtonBackground

    container.BorderSizePixel = 0

    container.LayoutOrder =
        order or 2

    container.Parent = page

    local corner =
        Instance.new("UICorner")

    corner.CornerRadius =
        UDim.new(0, 8)

    corner.Parent =
        container

    local label =
        Instance.new("TextLabel")

    label.Size =
        UDim2.new(1, -75, 1, 0)

    label.Position =
        UDim2.new(0, 14, 0, 0)

    label.BackgroundTransparency = 1
    label.Text = name
    label.TextColor3 = TextColor
    label.TextSize = 13
    label.Font = Enum.Font.GothamSemibold

    label.TextXAlignment =
        Enum.TextXAlignment.Left

    label.Parent =
        container

    local toggle =
        Instance.new("TextButton")

    toggle.Size =
        UDim2.new(0, 52, 0, 26)

    toggle.Position =
        UDim2.new(1, -64, 0.5, -13)

    toggle.BackgroundColor3 =
        OffColor

    toggle.Text = "OFF"
    toggle.TextColor3 =
        TextColor

    toggle.TextSize = 10
    toggle.Font =
        Enum.Font.GothamBold

    toggle.AutoButtonColor =
        false

    toggle.Parent =
        container

    local toggleCorner =
        Instance.new("UICorner")

    toggleCorner.CornerRadius =
        UDim.new(1, 0)

    toggleCorner.Parent =
        toggle

    local state = false

    local function setState(
        newState,
        runCallback
    )

        state = newState
        Features[name] = state

        if state then

            toggle.BackgroundColor3 =
                ThemeColor

            toggle.Text = "ON"

        else

            toggle.BackgroundColor3 =
                OffColor

            toggle.Text = "OFF"
        end

        if runCallback then

            pcall(function()
                callback(state)
            end)

        end

    end

    toggle.MouseButton1Click:Connect(function()

        setState(
            not state,
            true
        )

    end)

    setState(false, false)

    return container, toggle, function(newState)
        setState(newState, true)
    end
end

