        Enum.KeyCode.P then

        local newState =
            not (
                Features["Auto Bid"]
                == true
            )

        Features["Auto Bid"] =
            newState

        -- Update visual toggle
        for _, object in ipairs(
            FarmingPage:GetChildren()
        ) do

            if object:IsA("Frame") then

                local label =
                    object:FindFirstChildWhichIsA(
                        "TextLabel"
                    )

                if label
                    and label.Text ==
                        "Auto Bid" then

                    local toggle =
                        object:FindFirstChildWhichIsA(
                            "TextButton"
                        )

                    if toggle then

                        if newState then

                            toggle.BackgroundColor3 =
                                ThemeColor

                            toggle.Text =
                                "ON"

                        else

                            toggle.BackgroundColor3 =
                                OffColor

                            toggle.Text =
                                "OFF"
                        end
                    end
                end
            end
        end

        if newState then

            Notify(
                "Auto Bid",
                "Enabled (P)",
                2
            )

            task.spawn(function()

                while Features[
                    "Auto Bid"
                ] do

                    pcall(function()

