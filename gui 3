----------------------------------------------------------------
--// PAUSE WITH RETRIES
----------------------------------------------------------------

local function PauseAuctionWithRetry(
    runId
)

    if not Features[
        "Pause Auction"
    ] then

        return false
    end

    -- First attempt immediately after bid
    if PauseAuctionExact() then

        task.wait(0.15)

        -- The remote itself doesn't return
        -- whether the game accepted the pause,
        -- so keep sending the same proven call
        -- briefly to handle timing.
    end

    for attempt = 1, 8 do

        if not Features[
            "Farming"
        ] then

            return false
        end

        if FarmingRunId ~= runId then
            return false
        end

        if not Features[
            "Pause Auction"
        ] then

            return false
        end

        pcall(function()

            RequestAuctionPause:FireServer(
                true
            )

        end)

        task.wait(0.25)
    end

    return true
end

----------------------------------------------------------------
--// FIND NEXT GARAGE
----------------------------------------------------------------

local function GetNextGarage()

    local auctions =
        AuctionAreas[
            SelectedArea
        ]

    if not auctions
        or #auctions == 0 then

        return nil
    end

    local count =
        #auctions

    for offset = 0, count - 1 do

        local index =
            (
                (
                    CurrentFarmIndex
                    - 1
                    + offset
                )
                % count
            )
            + 1

        local name =
            auctions[index]

        local garage =
            GetGarageByName(
                name
            )

        if garage then

            CurrentFarmIndex =
                index

            return name,
                index
        end
    end

    return nil
end

----------------------------------------------------------------
--// ADVANCE
----------------------------------------------------------------

local function AdvanceGarage()

    local auctions =
        AuctionAreas[
            SelectedArea
        ]

    if not auctions
        or #auctions == 0 then

        return nil
    end

    CurrentFarmIndex =
        CurrentFarmIndex + 1

    if CurrentFarmIndex >
        #auctions then

        CurrentFarmIndex = 1
    end

    local name =
        auctions[
            CurrentFarmIndex
        ]

    SelectedFarm =
        name

    if FarmSelector then

        FarmSelector.Text =
            name
    end

    UpdateFarmingInfo()

    return name
end

----------------------------------------------------------------
--// FARM ONE GARAGE
----------------------------------------------------------------

local function FarmGarage(
    garageName,
    runId
)

    if not garageName then
        return false
    end

    if not Features[
        "Farming"
    ] then

        return false
    end

    if FarmingRunId ~= runId then
        return false
    end

    ------------------------------------------------------------
    -- TELEPORT
    ------------------------------------------------------------

    if not TeleportToGarage(
        garageName
    ) then

        return false
    end

    task.wait(0.75)

    if not Features[
        "Farming"
    ] then

        return false
    end

    ------------------------------------------------------------
    -- ENTER
    ------------------------------------------------------------

    if not EnterGarage(
        garageName
    ) then

        return false
    end

    ------------------------------------------------------------
    -- WAIT FOR AUCTION UI
    ------------------------------------------------------------

    local bidButton =
        WaitForBidButton(
            runId,
            30
        )

    if not bidButton then
        return false
    end

    ------------------------------------------------------------
    -- BID
    ------------------------------------------------------------

    if Features[
        "Auto Bid"
    ] then

        local bidSuccess =
            PerformBid()

        if not bidSuccess then
            return false
        end

        Notify(
            "Auction Farming",
            "Bid placed at "
            .. garageName,
            2
        )

        --------------------------------------------------------
        -- PAUSE IMMEDIATELY AFTER BID
        --------------------------------------------------------

        if Features[
            "Pause Auction"
        ] then

            task.wait(0.05)

            local paused =
                PauseAuctionWithRetry(
                    runId
                )

            if paused then

                Notify(
                    "Auction Farming",
                    "Pause requested",
                    2
                )

            end
        end
    end

    ------------------------------------------------------------
    -- GIVE AUCTION TIME TO COMPLETE
    ------------------------------------------------------------

    task.wait(2)

    return true
end

----------------------------------------------------------------
--// START FARMING
----------------------------------------------------------------

local function StartFarming()

    if FarmingBusy then
        return
    end

    FarmingBusy = true

    FarmingRunId += 1

    local runId =
        FarmingRunId

    task.spawn(function()

        while
            Features["Farming"]
            and FarmingRunId == runId
        do

            ----------------------------------------------------
            -- FIND AVAILABLE GARAGE
            ----------------------------------------------------

            local garageName =
                GetNextGarage()

            if not garageName then

                Notify(
                    "Auction Farming",
                    "No garage available — retrying in 5 seconds",
                    3
                )

                task.wait(5)

                continue
            end

            SelectedFarm =
                garageName

            if FarmSelector then

                FarmSelector.Text =
                    garageName
            end

            UpdateFarmingInfo()

            ----------------------------------------------------
            -- ATTEMPT
            ----------------------------------------------------

            Notify(
                "Auction Farming",
                "Going to "
                .. garageName,
                2
            )

            local success =
                FarmGarage(
                    garageName,
                    runId
                )

            if not Features[
                "Farming"
            ]
                or FarmingRunId ~= runId then

                break
            end

            ----------------------------------------------------
            -- SUCCESS
            ----------------------------------------------------

            if success then

                Notify(
                    "Auction Farming",
                    "Finished "
                    .. garageName
                    .. " — next garage",
                    2
                )

                task.wait(1)

                AdvanceGarage()

            else

                ------------------------------------------------
                -- FAILED
                ------------------------------------------------

                Notify(
                    "Auction Farming",
                    garageName
                    .. " unavailable — retrying in 5 seconds",
                    3
                )

                task.wait(5)

                if Features[
                    "Farming"
                ]
                    and FarmingRunId == runId then

                    AdvanceGarage()
                end
            end
        end

        FarmingBusy = false
    end)
end

