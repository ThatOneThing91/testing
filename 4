local function updateStats()
    if destroyed then return end

    statsLabel.Text = string.format(
        "Casts: %d | Catches: %d | Failed: %d",
        casts,
        catches,
        failures
    )
end

local function updateToggle()
    if destroyed then return end

    toggle.Text = running
        and "AUTO FISHING: ON"
        or "AUTO FISHING: OFF"

    toggle.BackgroundColor3 = running
        and Color3.fromRGB(35, 125, 65)
        or Color3.fromRGB(65, 65, 65)
end

local function setPhaseState(value)
    phase = value
    phaseStarted = os.clock()
    setPhase(value)
end

local function getWater()
    local assets = workspace:FindFirstChild("BBOW Builder Assets")
    local grass = assets and assets:FindFirstChild("Grass and Water")
    local model = grass and grass:FindFirstChild("Model")

    return model and model:GetChildren()[6]
end

local function validRemotes()
    local types = {
        Cast = "RemoteEvent",
        Result = "RemoteEvent",
        Cancel = "RemoteEvent",
        State = "RemoteEvent",
        Inventory = "RemoteFunction",
        Equip = "RemoteEvent"
    }

    for name, class in pairs(types) do
        if not Events[name] or not Events[name]:IsA(class) then
            return false, name
        end
    end

    return true
end

local function isBroken(item)
    if item.Broken == true or item.IsBroken == true then
        return true
    end

    if tonumber(item.Condition) == 0 then
        return true
    end

    for key, value in pairs(item.Mutators or {}) do
        if tostring(key):lower() == "broken" and value ~= false then
            return true
        end

        if tostring(value):lower() == "broken" then
            return true
        end

        if type(value) == "table" then
            local name = value.Name or value.name or value.Mutator

            if tostring(name):lower() == "broken" then
                return true
            end
        end
    end

    return false
end

local function getInventory()
    local ok, data = pcall(function()
        return Events.Inventory:InvokeServer()
    end)

    if not ok or type(data) ~= "table" then
        return nil
    end

    lastInventory = data

    return data.Inventory or data.Items or data
end

local function findRod(excludeGuid)
    local inventory = getInventory()

    if not inventory then
        return nil, "Inventory unavailable"
    end

    local rods = {}

    for guid, item in pairs(inventory) do
        if type(item) == "table" then
            local id = tonumber(item.ItemId)

            if id
                and knownRodIds[id]
                and not isBroken(item)
                and guid ~= excludeGuid then

                table.insert(rods, {
                    guid = guid,
                    id = id,
                    condition = tonumber(item.Condition) or 0
                })
            end
        end
    end

    table.sort(rods, function(a, b)
        return a.condition > b.condition
    end)

    return rods[1], #rods == 0 and "No usable known rods" or nil
end

local function equipRod()
    local rod, err = findRod()

    if not rod then
        return false, err
    end

    if currentRod ~= rod.guid then
        local ok = pcall(function()
            Events.Equip:FireServer(rod.guid)
        end)

        if not ok then
            return false, "Equip failed"
        end

        currentRod = rod.guid
        task.wait(0.5)
    end

    rodLabel.Text = string.format(
        "Rod: ItemId %s | Condition %s",
        tostring(rod.id),
        tostring(rod.condition)
    )

    return true
end

local function cancelCurrent()
    if Events.Cancel then
        pcall(function()
            Events.Cancel:FireServer()
        end)
    end
end

local function stopFishing(cancel)
    running = false
    session += 1
    busy = false
    activeCastId = nil

    if cancel then
        cancelCurrent()
    end

    setPhaseState("idle")
    updateToggle()
end

-- Fishing state listener

if Events.State and Events.State:IsA("RemoteEvent") then
    table.insert(connections,
        Events.State.OnClientEvent:Connect(function(state, data)
            if destroyed or not running then return end

            data = type(data) == "table" and data or {}

            if state == "cast" then
                if phase ~= "casting" then
                    return
                end

                activeCastId = data.castId
                setPhaseState("waiting")

                setStatus("Cast accepted, waiting for bite")

            elseif state == "reel" then
                if phase ~= "waiting" then
                    return
                end

                if activeCastId ~= nil
                    and data.castId ~= activeCastId then
                    return
                end

                setPhaseState("reeling")
                setStatus("Reeling: " .. tostring(data.itemName or "?"))

                -- Experimental result request.
                -- Only one result submission per session.
                local ok = pcall(function()
                    Events.Result:FireServer("caught")
                end)

                if ok then
                    setPhaseState("confirming")
                else
                    failures += 1
                    updateStats()
                    stopFishing(true)
                    setStatus("Result request failed")
                end

            elseif state == "done" then
                if phase ~= "confirming"
                    and phase ~= "reeling"
                    and phase ~= "waiting" then
                    return
                end

                if data.castId ~= nil
                    and activeCastId ~= nil
                    and data.castId ~= activeCastId then
                    return
                end

                if data.reason == "caught" then
                    catches += 1
                    setStatus(
                        "Caught: " .. tostring(data.itemName or "Unknown")
                    )
                else
                    failures += 1
                    setStatus(
                        "Ended: " .. tostring(data.reason or "Unknown")
                    )
                end

                updateStats()

                activeCastId = nil
                busy = false
                setPhaseState("cooldown")
            end
        end)
    )
end

-- Main fishing worker
-- One worker, one active cast at a time.

task.spawn(function()
    while not destroyed do
        if not running then
            task.wait(0.1)
            continue
        end

        if phase == "idle" and not busy then
            busy = true

            local token = session
            setPhaseState("equipping")

            local ok, err = equipRod()

            if destroyed or not running or token ~= session then
                busy = false
                continue
            end

            if not ok then
                failures += 1
                updateStats()
                stopFishing(false)
                setStatus(err or "No rod")
                continue
            end

            local water = getWater()

            if not water then
                stopFishing(false)
                setStatus("Water not found")
                continue
            end

            casts += 1
            updateStats()

            setPhaseState("casting")
            setStatus("Casting...")

            local success = pcall(function()
                Events.Cast:FireServer(water, CAST_POSITION)
            end)

            if not success then
                failures += 1
                updateStats()
                stopFishing(true)
                setStatus("Cast remote failed")
            end

        elseif phase == "cooldown" then
            if os.clock() - phaseStarted >= 1.25 then
                busy = false
                setPhaseState("idle")
            end

        elseif phase == "casting" then
            if os.clock() - phaseStarted > 8 then
                failures += 1
                updateStats()
                stopFishing(true)
                setStatus("Cast acknowledgement timeout")
            end

        elseif phase == "waiting" then
            if os.clock() - phaseStarted > 35 then
                failures += 1
                updateStats()
                stopFishing(true)
                setStatus("Bite timeout")
            end

        elseif phase == "confirming" then
            if os.clock() - phaseStarted > 12 then
                failures += 1
                updateStats()
                stopFishing(true)
                setStatus("Catch confirmation timeout")
            end
        end

        task.wait(0.1)
    end
end)

-- Learn a new rod using the equipped Tool's metadata.

learn.MouseButton1Click:Connect(function()
    if running then
        setStatus("Turn Auto Fishing OFF before learning")
        return
    end

    local character = player.Character
    local tool = character and character:FindFirstChildOfClass("Tool")

    if not tool then
        setStatus("Equip a fishing rod first")
        return
    end

    local id = tonumber(
        tool:GetAttribute("ItemId")
        or tool:GetAttribute("ItemID")
        or tool:GetAttribute("itemId")
    )

    if not id then
        setStatus("Equipped Tool has no ItemId attribute")
        info.Text = "Tool: " .. tool.Name
        return
    end

    knownRodIds[id] = true

    setStatus("Learned fishing rod ItemId: " .. id)
    info.Text = "Learned Tool: " .. tool.Name
end)

toggle.MouseButton1Click:Connect(function()
    if running then
        stopFishing(true)
        setStatus("Stopped")
        return
    end

    local ok, missing = validRemotes()

    if not ok then
        setStatus("Missing remote: " .. tostring(missing))
        return
    end

    if not getWater() then
        setStatus("Water target unavailable")
        return
    end

    running = true
    session += 1
    busy = false
    activeCastId = nil
    currentRod = nil

    setPhaseState("idle")
    updateToggle()
    setStatus("Starting...")
end)

local function cleanup()
    if destroyed then return end

    stopFishing(true)
    destroyed = true

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    gui:Destroy()

    if env.SH_FishingV4Cleanup == cleanup then
        env.SH_FishingV4Cleanup = nil
    end
end

close.MouseButton1Click:Connect(cleanup)
env.SH_FishingV4Cleanup = cleanup

setStatus("Ready")
print("[Auto Fishing V4] Launched")
