-- CLEANUP

_G.CheeseHubCleanup = function()
    alive = false
    autoBuy = false
    autoPizza = false
    autoCrates = false

    buyGeneration += 1
    pizzaGeneration += 1
    crateGeneration += 1

    resetPizzaState()

    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(connections)

    if gui then
        gui:Destroy()
    end

    _G.CheeseHubCleanup = nil
end

refreshButtons()
