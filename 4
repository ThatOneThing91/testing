local function getReelGui()
    local fishingGui =
        playerGui:FindFirstChild("FishingReelGui")

    if not fishingGui then return nil end

    local minigame =
        fishingGui:FindFirstChild("ReelMinigame")

    if not minigame then return nil end

    local catchBar =
        minigame:FindFirstChild("CatchBar")

    if not catchBar then return nil end

    local fish = catchBar:FindFirstChild("Fish")
    local zone = catchBar:FindFirstChild("Zone")

    if not fish or not zone then return nil end

    if not fish:IsA("GuiObject")
        or not zone:IsA("GuiObject") then
        return nil
    end

    if not minigame.Visible
        or not catchBar.Visible
        or not fish.Visible
        or not zone.Visible then
        return nil
    end

    return catchBar, fish, zone
end

--------------------------------------------------
-- V15 REEL TRACKING
--------------------------------------------------

local function resetReelTracking()
    releaseMouse()

    lastInputChange = 0
    previousFishX = nil
    previousZoneX = nil
    previousSampleTime = nil

    smoothedFishVelocity = 0
    smoothedZoneVelocity = 0

    nextReelAction = 0
    reelHoldNext = true
end

local function updateReeling()
    if phase ~= "reeling" then
        releaseMouse()
        return
    end

    local now = os.clock()

    if now < nextReelAction then
        return
    end

    if trackingEnabled then
        local catchBar, fish, zone = getReelGui()

        if catchBar and fish and zone then
            local trackX = catchBar.AbsolutePosition.X
            local trackWidth = math.max(
                catchBar.AbsoluteSize.X, 1
            )

            local fishX = (
                fish.AbsolutePosition.X
                + fish.AbsoluteSize.X / 2
                - trackX
            ) / trackWidth

            local zoneX = (
                zone.AbsolutePosition.X
                + zone.AbsoluteSize.X / 2
                - trackX
            ) / trackWidth

            local dt = previousSampleTime
                and math.max(
                    now - previousSampleTime,
                    0.01
                )
                or FOLLOW_INTERVAL

            if previousFishX then
                local velocity = math.clamp(
                    (fishX - previousFishX) / dt,
                    -4, 4
                )

                smoothedFishVelocity =
                    smoothedFishVelocity * 0.65
                    + velocity * 0.35
            end

            if previousZoneX then
                local velocity = math.clamp(
                    (zoneX - previousZoneX) / dt,
                    -4, 4
                )

                smoothedZoneVelocity =
                    smoothedZoneVelocity * 0.65
                    + velocity * 0.35
            end

            previousFishX = fishX
            previousZoneX = zoneX
            previousSampleTime = now

            local predictedFish = math.clamp(
                fishX
                + smoothedFishVelocity * FOLLOW_LOOKAHEAD,
                0, 1
            )

            local predictedZone = math.clamp(
                zoneX
                + smoothedZoneVelocity * FOLLOW_LOOKAHEAD,
                0, 1
            )

            local error = predictedFish - predictedZone

            local deadzone = FOLLOW_DEADZONE

            if math.abs(smoothedFishVelocity) > 0.35 then
                deadzone = 0.012
            end

            local desiredHold

            if error > deadzone then
                desiredHold = true
            elseif error < -deadzone then
                desiredHold = false
            else
                -- Counter the zone's momentum.
                if smoothedZoneVelocity > 0.06 then
                    desiredHold = false
                elseif smoothedZoneVelocity < -0.06 then
                    desiredHold = true
                else
                    desiredHold = mouseHeld
                end
            end

            if now - lastInputChange >= FOLLOW_MIN_SWITCH then
                if desiredHold and not mouseHeld then
                    if holdMouse() then
                        lastInputChange = now
                    end
                elseif not desiredHold and mouseHeld then
                    releaseMouse()
                    lastInputChange = now
                end
            end

            local insideZone =
                math.abs(fishX - zoneX)
                <= (
                    zone.AbsoluteSize.X
                    - fish.AbsoluteSize.X
                ) / (2 * trackWidth)

            trackingLabel.Text = string.format(
                "Fish %.3f | Zone %.3f | Error %+.3f",
                fishX, zoneX, error
            )

            reelLabel.Text = string.format(
                "%s | %s",
                insideZone and "FISH IN ZONE"
                    or "FISH OUTSIDE ZONE",
                mouseHeld and "HOLD" or "RELEASE"
            )

            nextReelAction = now + FOLLOW_INTERVAL
            return
        end

        trackingLabel.Text =
            "Tracking: Fishing GUI unavailable"
    else
        trackingLabel.Text = "Tracking: Timed mode"
    end

    -- Fallback: hold 1.5 seconds, release 0.5 seconds.
    if reelHoldNext then
        holdMouse()
        reelLabel.Text = "Reel: Hold 1.5s"
        nextReelAction = now + FALLBACK_HOLD
    else
        releaseMouse()
        reelLabel.Text = "Reel: Release 0.5s"
        nextReelAction = now + FALLBACK_RELEASE
    end

    reelHoldNext = not reelHoldNext
end

--------------------------------------------------
-- SESSION
--------------------------------------------------

local function cancelCast()
    pcall(function()
        FishingCancel:FireServer()
    end)
end

local function stopFishing(message, cancel)
    running = false
    generation += 1

    resetReelTracking()

    if cancel then
        cancelCast()
    end

    activeCastId = nil
    setPhase("idle")
    updateToggle()

    if message then
        status(message)
    end
end

table.insert(connections,
    FishingState.OnClientEvent:Connect(function(state, data)
        if destroyed or not running then return end

        data = type(data) == "table" and data or {}

        if state == "cast" then
            if phase ~= "casting" then return end

            activeCastId = data.castId
            setPhase("waiting")
            status("Waiting for bite")

        elseif state == "reel" then
            if phase ~= "waiting" then return end

            if activeCastId ~= nil
                and data.castId ~= nil
                and activeCastId ~= data.castId then
                return
            end

            resetReelTracking()
            setPhase("reeling")
            status("Reeling...")

        elseif state == "done" then
            if phase ~= "casting"
                and phase ~= "waiting"
                and phase ~= "reeling" then
                return
            end

            if activeCastId ~= nil
                and data.castId ~= nil
                and activeCastId ~= data.castId then
                return
            end

            resetReelTracking()

            if data.reason == "caught" then
                catches += 1
                status(
                    "Caught: "
                    .. tostring(data.itemName or "Unknown")
                )
            else
                failures += 1
                status(
                    "Fishing ended: "
                    .. tostring(data.reason or "Unknown")
                )
            end

            updateStats()

            activeCastId = nil
            setPhase("finishing")
        end
    end)
)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

task.spawn(function()
    while not destroyed do
        if not running then
            task.wait(0.15)
            continue
        end

        if phase == "idle" then
            local token = generation

            setPhase("equipping")

            local ok, err = ensureRod(token)

            if destroyed
                or not running
                or token ~= generation then
                continue
            end

            if not ok then
                stopFishing(
                    err or "Rod unavailable",
                    false
                )
                continue
            end

            local water, position, distance = findWater()

            if not water then
                status("Face nearby water")
                setPhase("searching")
                continue
            end

            waterLabel.Text = string.format(
                "Water: %s | %d studs",
                water.Name, distance
            )

            activeCastId = nil

            setPhase("casting")
            status("Casting...")

            casts += 1
            updateStats()

            local sent = pcall(function()
                FishingCast:FireServer(water, position)
            end)

            if not sent then
                failures += 1
                updateStats()

                stopFishing("Cast request failed", true)
            end

        elseif phase == "searching" then
            if os.clock() - phaseTime >= 1 then
                setPhase("idle")
            end

        elseif phase == "casting" then
            if os.clock() - phaseTime > CAST_TIMEOUT then
                failures += 1
                updateStats()

                stopFishing("Cast timeout", true)
            end

        elseif phase == "waiting" then
            if os.clock() - phaseTime > BITE_TIMEOUT then
                failures += 1
                updateStats()

                stopFishing("Bite timeout", true)
            end

        elseif phase == "reeling" then
            updateReeling()

            if os.clock() - phaseTime > REEL_TIMEOUT then
                failures += 1
                updateStats()

                stopFishing("Reeling timeout", true)
            end

        elseif phase == "finishing" then
            releaseMouse()

            if os.clock() - phaseTime >= NEXT_CAST_DELAY then
                setPhase("idle")
                status("Starting next cast")
            end
        end

        task.wait(0.04)
    end
end)

