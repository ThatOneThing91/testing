--------------------------------------------------
-- UTILITIES
--------------------------------------------------

local function normalize(value)
    return tostring(value or ""):lower()
end

local function getItemId(item)
    if type(item) ~= "table" then
        return nil
    end

    return tonumber(
        item.ItemId
        or item.ItemID
        or item.itemId
        or item.Id
        or item.ID
        or item.id
    )
end

local function getItemName(item)
    if type(item) ~= "table" then
        return nil
    end

    return item.Name
        or item.name
        or item.DisplayName
        or item.displayName
        or item.ItemName
        or item.itemName
end

local function isExcludedName(name)
    name = normalize(name)

    for _, word in ipairs({
        "pickaxe",
        "pickage",
        "shovel",
        "hammer",
        "wrench",
        "sword",
        "axe",
        "drill",
        "basketball"
    }) do
        if name:find(word, 1, true) then
            return true
        end
    end

    return false
end

local function isFishingName(name)
    name = normalize(name)

    if isExcludedName(name) then
        return false
    end

    return name:find("fishing rod", 1, true)
        or name:find("fishingrod", 1, true)
        or name:find("fishing pole", 1, true)
        or name:find("fishingpole", 1, true)
end

local function isFishingCategory(value)
    value = normalize(value)

    return value == "fishingrod"
        or value == "fishing rod"
        or value == "fishing pole"
        or value == "fishingpole"
end

--------------------------------------------------
-- ITEM DEFINITIONS
--------------------------------------------------

local function indexDefinitions(data, depth, visited)
    if type(data) ~= "table" or depth > 5 then
        return
    end

    if visited[data] then
        return
    end

    visited[data] = true

    for key, value in pairs(data) do
        if type(value) == "table" then
            local id = getItemId(value) or tonumber(key)

            if id then
                -- Only index definitions that contain
                -- recognizable fishing rod information.
                local name = getItemName(value)

                local category = value.Category
                    or value.Type
                    or value.ItemType

                if not isExcludedName(name)
                    and (
                        isFishingName(name)
                        or isFishingCategory(category)
                    ) then

                    itemDefinitions[id] = value
                    KNOWN_RODS[id] = true
                end
            end

            indexDefinitions(value, depth + 1, visited)
        end
    end
end

local function loadDefinitions()
    local modules = RS:FindFirstChild("Modules")
    local items = modules and modules:FindFirstChild("Items")

    if not items or not items:IsA("ModuleScript") then
        return
    end

    local ok, data = pcall(require, items)

    if ok and type(data) == "table" then
        indexDefinitions(data, 0, {})
    end
end

pcall(loadDefinitions)

--------------------------------------------------
-- STRICT ROD IDENTIFICATION
--------------------------------------------------

local function isFishingRod(item, fallbackId)
    if type(item) ~= "table" then
        return false
    end

    local id = getItemId(item) or fallbackId
    local name = getItemName(item)

    -- Explicitly reject unrelated tools.
    if isExcludedName(name) then
        return false
    end

    if isFishingName(name) then
        if id then
            KNOWN_RODS[id] = true
        end

        return true
    end

    local category = item.Category
        or item.Type
        or item.ItemType

    if isFishingCategory(category) then
        if id then
            KNOWN_RODS[id] = true
        end

        return true
    end

    -- Fall back to a VERIFIED item definition.
    local definition = id and itemDefinitions[id]

    if type(definition) == "table" then
        local definitionName = getItemName(definition)

        if isExcludedName(definitionName) then
            return false
        end

        if isFishingName(definitionName)
            or isFishingCategory(
                definition.Category
                or definition.Type
                or definition.ItemType
            ) then

            return true
        end
    end

    -- Never trust an ItemId by itself.
    return false
end

--------------------------------------------------
-- BROKEN ROD DETECTION
--------------------------------------------------

local function isBroken(item)
    if type(item) ~= "table" then
        return false
    end

    if item.Broken == true
        or item.IsBroken == true then
        return true
    end

    local condition = tonumber(
        item.Condition or item.Durability
    )

    if condition and condition <= 0 then
        return true
    end

    if normalize(item.Status) == "broken" then
        return true
    end

    for key, value in pairs(item.Mutators or {}) do
        if normalize(key) == "broken"
            and value ~= false then
            return true
        end

        if normalize(value) == "broken" then
            return true
        end

        if type(value) == "table" then
            local name = value.Name
                or value.name
                or value.Mutator

            if normalize(name) == "broken" then
                return true
            end
        end
    end

    return false
end

--------------------------------------------------
-- INVENTORY
--------------------------------------------------

local function getInventoryData()
    local ok, data = pcall(function()
        return GetInventory:InvokeServer()
    end)

    if not ok or type(data) ~= "table" then
        return nil
    end

    local inventory = data.Inventory
        or data.Items
        or data

    if type(inventory) ~= "table" then
        return nil
    end

    return inventory
end

local function findUsableRods(inventory)
    local candidates = {}

    for key, item in pairs(inventory) do
        if type(item) == "table" then
            local id = getItemId(item)

            if isFishingRod(item, id)
                and not isBroken(item) then

                local guid = item.Guid
                    or item.GUID
                    or item.UUID
                    or key

                if type(guid) == "string" then
                    table.insert(candidates, {
                        guid = guid,
                        id = id,
                        condition = tonumber(
                            item.Condition
                        ) or 0
                    })
                end
            end
        end
    end

    table.sort(candidates, function(a, b)
        return a.condition > b.condition
    end)

    return candidates
end

--------------------------------------------------
-- EQUIPPED ROD
--------------------------------------------------

local function getToolId(tool)
    if not tool then return nil end

    return tonumber(
        tool:GetAttribute("ItemId")
        or tool:GetAttribute("ItemID")
        or tool:GetAttribute("itemId")
    )
end

local function getToolGuid(tool)
    if not tool then return nil end

    for _, attribute in ipairs({
        "Guid",
        "GUID",
        "UUID",
        "ItemGuid",
        "ItemGUID"
    }) do
        local value = tool:GetAttribute(attribute)

        if type(value) == "string" then
            return value
        end
    end

    return nil
end

local function getEquippedRod()
    local character = player.Character

    if not character then
        return nil
    end

    for _, tool in ipairs(character:GetChildren()) do
        if tool:IsA("Tool") then
            local id = getToolId(tool)

            if isFishingRod({
                ItemId = id,
                Name = tool.Name,
                Category = tool:GetAttribute("Category"),
                Type = tool:GetAttribute("Type")
            }, id) then

                return tool, id
            end
        end
    end

    return nil
end

local function equippedRodUsable(tool, id, inventory)
    if not tool then return false end

    if tool:GetAttribute("Broken") == true
        or tool:GetAttribute("IsBroken") == true then
        return false
    end

    local condition = tonumber(
        tool:GetAttribute("Condition")
        or tool:GetAttribute("Durability")
    )

    if condition and condition <= 0 then
        return false
    end

    local guid = getToolGuid(tool)

    if guid then
        local item = inventory[guid]

        if item then
            return not isBroken(item)
        end
    end

    for _, item in pairs(inventory) do
        if type(item) == "table"
            and getItemId(item) == id
            and isFishingRod(item, id)
            and not isBroken(item) then

            return true
        end
    end

    return false
end

