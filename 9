--------------------------------------------------
-- MOUSE INPUT
--------------------------------------------------

local function releaseMouse()
    if not mouseHeld then return end

    mouseHeld = false

    if type(mouse1release) == "function" then
        pcall(mouse1release)
    end
end

local function holdMouse()
    if mouseHeld then return true end

    if type(mouse1press) ~= "function" then
        return false
    end

    local ok = pcall(mouse1press)

    if ok then
        mouseHeld = true
    end

    return ok
end

--------------------------------------------------
-- EQUIP ROD
--------------------------------------------------

local function ensureRod(token)
    local inventory = getInventoryData()

    if not inventory then
        return false, "Inventory unavailable"
    end

    local tool, id = getEquippedRod()

    if tool and equippedRodUsable(tool, id, inventory) then
        rodLabel.Text =
            "Rod: Equipped ItemId " .. tostring(id)

        return true
    end

    local candidates = findUsableRods(inventory)

    if #candidates == 0 then
        return false, "No verified usable fishing rods"
    end

    for _, rod in ipairs(candidates) do
        if destroyed
            or not running
            or token ~= generation then

            return false, "Cancelled"
        end

        status("Equipping fishing rod")

        local ok = pcall(function()
            EquipItem:FireServer(rod.guid)
        end)

        if ok then
            local deadline = os.clock() + 2.5

            while os.clock() < deadline do
                if destroyed
                    or not running
                    or token ~= generation then

                    return false, "Cancelled"
                end

                local equipped, equippedId = getEquippedRod()

                if equipped and equippedId == rod.id then
                    local equippedGuid = getToolGuid(equipped)

                    if not equippedGuid
                        or equippedGuid == rod.guid then

                        rodLabel.Text =
                            "Rod: Equipped ItemId "
                            .. tostring(rod.id)

                        return true
                    end
                end

                task.wait(0.1)
            end
        end
    end

    return false, "Unable to equip fishing rod"
end

--------------------------------------------------
-- WATER DETECTION
--------------------------------------------------

local function findWater()
    local character = player.Character
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not root then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = false

    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector

    for _, distance in ipairs(CAST_DISTANCES) do
        for _, offset in ipairs(SIDE_OFFSETS) do
            local point = root.Position
                + forward * distance
                + right * offset

            local result = workspace:Raycast(
                point + Vector3.new(0, 35, 0),
                Vector3.new(0, -110, 0),
                params
            )

            if result then
                local name = normalize(result.Instance.Name)

                if result.Material == Enum.Material.Water
                    or name:find("water", 1, true)
                    or name:find("pond", 1, true)
                    or name:find("lake", 1, true)
                    or name:find("river", 1, true) then

                    return result.Instance,
                        result.Position,
                        distance
                end
            end
        end
    end

    return nil
end

--------------------------------------------------
-- SESSION MANAGEMENT
--------------------------------------------------

local function cancelCast()
    pcall(function()
        FishingCancel:FireServer()
    end)
end

local function stopFishing(message, cancel)
    running = false
    generation += 1

    releaseMouse()

    if cancel then
        cancelCast()
    end

    activeCastId = nil

    setPhase("idle")
    updateToggle()

    if message then
        status(message)
    end
end

--------------------------------------------------
-- EXPERIMENTAL REELING
--------------------------------------------------

local function updateReeling()
    if phase ~= "reeling" then
        releaseMouse()
        return
    end

    if type(mouse1press) ~= "function"
        or type(mouse1release) ~= "function" then

        reelLabel.Text =
            "Reel: Mouse input unavailable"

        return
    end

    local now = os.clock()

    if now < nextReelAction then
        return
    end

    if reelHoldNext then
        if holdMouse() then
            reelLabel.Text = "Reel: Holding"
            nextReelAction = now + REEL_HOLD_TIME
        else
            reelLabel.Text = "Reel: Press failed"
            return
        end
    else
        releaseMouse()
        reelLabel.Text = "Reel: Releasing"
        nextReelAction = now + REEL_RELEASE_TIME
    end

    reelHoldNext = not reelHoldNext
end

--------------------------------------------------
-- SERVER EVENTS
--------------------------------------------------

table.insert(connections,
    FishingState.OnClientEvent:Connect(function(state, data)
        if destroyed or not running then
            return
        end

        data = type(data) == "table" and data or {}

        if state == "cast" then
            if phase ~= "casting" then return end

            activeCastId = data.castId

            setPhase("waiting")
            status("Cast accepted - waiting for bite")

        elseif state == "reel" then
            if phase ~= "waiting" then return end

            if activeCastId ~= nil
                and data.castId ~= nil
                and activeCastId ~= data.castId then
                return
            end

            setPhase("reeling")

            reelHoldNext = true
            nextReelAction = 0

            status("Reeling...")
            reelLabel.Text = "Reel: Balancing test"

        elseif state == "done" then
            if phase ~= "casting"
                and phase ~= "waiting"
                and phase ~= "reeling" then
                return
            end

            if activeCastId ~= nil
                and data.castId ~= nil
                and activeCastId ~= data.castId then
                return
            end

            releaseMouse()

            if data.reason == "caught" then
                catches += 1
                status(
                    "Caught: "
                    .. tostring(data.itemName or "Unknown")
                )
            else
                failures += 1
                status(
                    "Fishing ended: "
                    .. tostring(data.reason or "Unknown")
                )
            end

            updateStats()
            activeCastId = nil

            setPhase("finishing")
            reelLabel.Text = "Reel: Session finished"
        end
    end)
)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

task.spawn(function()
    while not destroyed do
        if not running then
            task.wait(0.15)
            continue
        end

        if phase == "idle" then
            local token = generation

            setPhase("equipping")

            local ok, err = ensureRod(token)

            if destroyed
                or not running
                or token ~= generation then
                continue
            end

            if not ok then
                stopFishing(err or "Rod unavailable", false)
                continue
            end

            local water, position, distance = findWater()

            if not water then
                status("Face nearby water")
                setPhase("searching")
                continue
            end

            waterLabel.Text = string.format(
                "Water: %s | %d studs",
                water.Name,
                distance
            )

            activeCastId = nil

            setPhase("casting")
            status("Casting...")

            casts += 1
            updateStats()

            local sent = pcall(function()
                FishingCast:FireServer(water, position)
            end)

            if not sent then
                failures += 1
                updateStats()

                stopFishing("Cast request failed", true)
            end

        elseif phase == "searching" then
            if os.clock() - phaseTime >= 1 then
                setPhase("idle")
            end

        elseif phase == "casting" then
            if os.clock() - phaseTime > CAST_TIMEOUT then
                failures += 1
                updateStats()

                stopFishing("Cast timeout", true)
            end

        elseif phase == "waiting" then
            if os.clock() - phaseTime > BITE_TIMEOUT then
                failures += 1
                updateStats()

                stopFishing("Bite timeout", true)
            end

        elseif phase == "reeling" then
            updateReeling()

            if os.clock() - phaseTime > REEL_TIMEOUT then
                failures += 1
                updateStats()

                stopFishing("Reeling timeout", true)
            end

        elseif phase == "finishing" then
            releaseMouse()

            if os.clock() - phaseTime >= NEXT_CAST_DELAY then
                setPhase("idle")
                status("Starting next cast")
            end
        end

        task.wait(0.06)
    end
end)

