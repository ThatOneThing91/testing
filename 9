local function cleanup()
    if destroyed then return end

    stopFishing(nil, true)
    destroyed = true

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    gui:Destroy()

    if env.SH_FishingV9Cleanup == cleanup then
        env.SH_FishingV9Cleanup = nil
    end
end

