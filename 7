local function cleanup()
    if destroyed then return end

    running = false
    generation += 1
    releaseMouse()

    pcall(function()
        FishingCancel:FireServer()
    end)

    destroyed = true

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    gui:Destroy()

    if env.SH_FishingV7Cleanup == cleanup then
        env.SH_FishingV7Cleanup = nil
    end
end

