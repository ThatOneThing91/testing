local function getRoot()
    local character = player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local function getPlot()
    local tycoon = player:FindFirstChild("Tycoon")
    if not tycoon or not tycoon:IsA("ObjectValue") then
        return nil, nil
    end
    return tycoon.Value, tycoon:GetAttribute("Slot")
end

local function getObjects()
    local plot, slot = getPlot()
    if not plot or not slot then return nil end
    local side = plot:FindFirstChild("Player" .. tostring(slot))
    return side and side:FindFirstChild("Objects")
end

local function teleportTo(part)
    local root = getRoot()
    if not root or not part or not part:IsA("BasePart") then
        return false
    end

    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(
        part.Position.X,
        part.Position.Y + part.Size.Y / 2 + 3,
        part.Position.Z
    )
    return true
end

local function restore(root, cf)
    if root and root.Parent and cf then
        root.CFrame = cf
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end
end

local function firePrompt(prompt)
    if type(fireproximityprompt) ~= "function" then
        return false
    end
    return pcall(fireproximityprompt, prompt)
end

-- COLLECT CASH

local function collectCash()
    if not alive or busy then return end
    busy = true

    local plot, slot = getPlot()
    local side = plot and plot:FindFirstChild("Player" .. tostring(slot))
    local essential = side and side:FindFirstChild("Essential")
    local atm = essential and essential:FindFirstChild("ATM")
    local touch = atm and atm:FindFirstChild("Touch")

    local root = getRoot()
    local previous = root and root.CFrame

    if touch and touch:IsA("BasePart") then
        teleportTo(touch)
        task.wait(0.5)
        restore(root, previous)
    end

    busy = false
end

-- AUTO BUY

local function parseMoney(value)
    if type(value) == "number" then return value end
    if type(value) ~= "string" then return nil end

    local clean = value:gsub(",", ""):gsub("%$", "")
    local number, suffix = clean:match("([%d%.]+)%s*([KkMmBbTt]?)")
    number = tonumber(number)

    if not number then return nil end

    local scales = {
        K = 1e3,
        M = 1e6,
        B = 1e9,
        T = 1e12
    }

    return number * (scales[suffix:upper()] or 1)
end

local function getCash()
    local stats = player:FindFirstChild("leaderstats")
    if stats then
        for _, name in ipairs({"Cash", "Money"}) do
            local value = stats:FindFirstChild(name)
            if value and (
                value:IsA("NumberValue")
                or value:IsA("IntValue")
            ) then
                return value.Value
            end
        end
    end

    for _, name in ipairs({"Cash", "Money"}) do
        local value = player:GetAttribute(name)
        if type(value) == "number" then
            return value
        end
    end

    return cachedCash
end

local function excludedButton(button)
    local name = button.Name:lower()

    if name:sub(1, 9) == "teammate_" then return true end
    if button:GetAttribute("IsTeammate") == true then return true end
    if button:GetAttribute("CanPurchase") == false then return true end

    local function excluded(text)
        local s = tostring(text):lower():gsub("[^%w]", "")
        return s:find("2xcash", 1, true)
            or s:find("doublecash", 1, true)
            or s:find("cashmultiplier", 1, true)
            or s:find("2timescash", 1, true)
    end

    if excluded(button.Name) then return true end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            if excluded(obj.Text) then return true end
        end
    end

    return false
end

local function buttonPrice(button)
    local price = parseMoney(button:GetAttribute("Price"))
    if price then return price end

    for _, obj in ipairs(button:GetDescendants()) do
        if obj:IsA("TextLabel") then
            price = parseMoney(obj.Text)
            if price then return price end
        end
    end
    return nil
end

local function buttonPart(button)
    local base = button:FindFirstChild("Base")
    if base and base:IsA("BasePart") then return base end
    if button:IsA("BasePart") then return button end
    return button:FindFirstChildWhichIsA("BasePart", true)
end

local function runBuy(token)
    local failed = {}
    local lastCash

    while alive and autoBuy and token == buyToken do
        if busy then
            task.wait(0.15)
            continue
        end

        local cash = getCash()
        if cash ~= lastCash then
            failed = {}
            lastCash = cash
        end

        local folder = workspace:FindFirstChild(
            "__TycoonButtons_" .. tostring(player.UserId)
        )

        local chosen, part, cheapest = nil, nil, math.huge

        if folder and cash then
            for _, button in ipairs(folder:GetChildren()) do
                if not failed[button] and not excludedButton(button) then
                    local price = buttonPrice(button)
                    local candidate = buttonPart(button)

                    if price and price <= cash
                        and price < cheapest and candidate then
                        chosen, part, cheapest = button, candidate, price
                    end
                end
            end
        end

        if not chosen then
            task.wait(0.5)
            continue
        end

        busy = true
        local root = getRoot()
        local previous = root and root.CFrame
        teleportTo(part)

        local deadline = os.clock() + 2
        local purchased = false

        while alive and autoBuy and token == buyToken
            and os.clock() < deadline do
            if not chosen.Parent or chosen.Parent ~= folder then
                purchased = true
                break
            end
            task.wait(0.05)
        end

        restore(root, previous)
        busy = false

        if not purchased then failed[chosen] = true end
        task.wait(0.12)
    end
end

-- PIZZA GUI

local function pizzaGui()
    local gui = playerGui:FindFirstChild("PizzaMaking")
    return gui and gui:IsA("ScreenGui") and gui or nil
end

local function pizzaVisible()
    local gui = pizzaGui()
    return gui ~= nil and gui.Enabled
end

local function centerPizza()
    local gui = pizzaGui()
    if not gui or not gui.Enabled then return end

    local root = gui:FindFirstChild("Root")
    if not root or not root:IsA("GuiObject") then return end

    if not centered[root] then
        centered[root] = {
            position = root.Position,
            anchor = root.AnchorPoint
        }
    end

    root.AnchorPoint = Vector2.new(0.5, 0.5)
    root.Position = UDim2.fromScale(0.5, 0.5)
end

local function restorePizzaGui()
    for frame, original in pairs(centered) do
        if frame and frame.Parent then
            pcall(function()
                frame.AnchorPoint = original.anchor
                frame.Position = original.position
            end)
        end
        centered[frame] = nil
    end
end

-- PIZZA STATE

local pizza = {
    session = nil,
    phase = nil,
    progress = 0,
    remaining = {},
    state = "idle",
    status = "Idle",
    lastPrompt = 0,
    promptAttempts = 0,
    promptBusy = false,
    lastExit = 0,
    exitAttempts = 0,
    exitConfirmed = false,
    closedAt = 0,
    doughStep = 0,
    completedAt = 0,
    lastTopping = 0,
    count = 0
}

local nextPhase = {
    Dough = "Sauce",
    Sauce = "Cheese",
    Cheese = "Toppings"
}

local phaseRank = {
    Dough = 1,
    Sauce = 2,
    Cheese = 3,
    Toppings = 4
}

local function resetPizza()
    pizza.session = nil
    pizza.phase = nil
    pizza.progress = 0
    pizza.remaining = {}
    pizza.state = "idle"
    pizza.status = "Waiting for station"
    pizza.lastPrompt = 0
    pizza.promptAttempts = 0
    pizza.promptBusy = false
    pizza.lastExit = 0
    pizza.exitAttempts = 0
    pizza.exitConfirmed = false
    pizza.closedAt = 0
    pizza.doughStep = 0
    pizza.completedAt = 0
    pizza.lastTopping = 0
end

local function beginPhase(phase, force)
    if pizza.state ~= "making" then return end

    local old = phaseRank[pizza.phase] or 0
    local new = phaseRank[phase] or 0

    if new == 0 then return end
    if not force and new <= old then return end

    pizza.phase = phase
    pizza.progress = 0
    pizza.completedAt = 0
    pizza.status = phase

    if phase == "Dough" then
        pizza.doughStep = 0
    elseif phase == "Toppings" then
        pizza.lastTopping = 0
    end
end

local function stationPrompt()
    local objects = getObjects()
    if not objects then return nil end

    local best, highest = nil, -1

    for _, station in ipairs(objects:GetChildren()) do
        if station.Name:match("^Pizza Prep Station %d+$") then
            local number = tonumber(station.Name:match("(%d+)$")) or 0
            local start = station:FindFirstChild("StartGame", true)
            local prompt = start and start:FindFirstChildWhichIsA(
                "ProximityPrompt", true
            )

            if prompt and prompt.Enabled and number > highest then
                best, highest = prompt, number
            end
        end
    end

    return best
end

local function promptPart(prompt)
    local parent = prompt.Parent
    if parent:IsA("BasePart") then return parent end

    if parent:IsA("Attachment")
        and parent.Parent:IsA("BasePart") then
        return parent.Parent
    end

    local model = prompt:FindFirstAncestorOfClass("Model")
    if model then
        return model.PrimaryPart
            or model:FindFirstChildWhichIsA("BasePart", true)
    end
end

local function tryPizzaPrompt(token)
    if pizza.state ~= "opening"
        or pizza.promptBusy
        or busy
        or pizza.session
        or pizzaVisible() then
        return
    end

    local now = os.clock()

    if now - pizza.lastPrompt < 0.4 then
        return
    end

    pizza.promptBusy = true
    pizza.lastPrompt = now
    pizza.promptAttempts += 1
    pizza.status = "Starting pizza - attempt "
        .. tostring(pizza.promptAttempts)

    local prompt = stationPrompt()

    if not prompt then
        pizza.status = "Waiting for station prompt"
        pizza.promptBusy = false
        return
    end

    busy = true
    local part = promptPart(prompt)

    if part then teleportTo(part) end
    task.wait(0.08)

    if alive and autoPizza
        and token == pizzaToken
        and pizza.state == "opening"
        and not pizza.session then
        firePrompt(prompt)
    end

    busy = false
    pizza.promptBusy = false
end

local function recipeToppings()
    local result = {}
    local gui = pizzaGui()
    local root = gui and gui:FindFirstChild("Root")
    local recipe = root and root:FindFirstChild("Recipe")
    local order = recipe and recipe:FindFirstChild("Order")

    local name = ""
    if order and order:IsA("TextLabel") then
        name = order.Text:lower()
    end

    for _, entry in pairs(pizzaConfig.Recipes or {}) do
        if type(entry) == "table" then
            local recipeName = tostring(entry.Name or ""):lower()

            if recipeName ~= ""
                and name:find(recipeName, 1, true) then
                for topping, count in pairs(entry.Toppings or {}) do
                    result[topping] = count
                end
                break
            end
        end
    end

    return result
end

local function sendPizza(action, point, topping)
    if not alive or not autoPizza
        or pizza.state ~= "making"
        or not pizza.session then
        return
    end

    pizzaRemote:FireServer(
        pizza.session,
        action,
        point,
        topping
    )
end

local function sendPizzaExit()
    if not alive or not autoPizza or not pizza.session then
        return false
    end

    local ok = pcall(function()
        pizzaRemote:FireServer(
            pizza.session,
            "Exit",
            nil,
            nil
        )
    end)

    if ok then
        pizza.lastExit = os.clock()
        pizza.exitAttempts += 1
        pizza.status = "Exiting completed pizza"
    else
        pizza.status = "Exit remote failed"
    end

    return ok
end

-- SERVER EVENTS

bind(pizzaRemote.OnClientEvent, function(action, session, a, b, c)
    if not alive or not autoPizza then return end

    if action == "Begin" then
        if pizza.state ~= "opening"
            or type(session) ~= "string" then
            return
        end

        pizza.session = session
        pizza.state = "making"
        pizza.phase = nil
        pizza.progress = 0
        pizza.remaining = {}
        pizza.doughStep = 0
        pizza.completedAt = 0
        pizza.lastTopping = 0
        pizza.promptBusy = false
        pizza.promptAttempts = 0
        pizza.exitConfirmed = false

        beginPhase("Dough", true)
        centerPizza()
        return
    end

    if session ~= pizza.session then return end

    if action == "Paid" then
        if pizza.state == "making" then
            pizza.count += 1
            pizza.state = "exiting"
            pizza.phase = "Finished"
            pizza.progress = 1
            pizza.lastExit = 0
            pizza.exitAttempts = 0
            pizza.exitConfirmed = false
            pizza.closedAt = 0
            pizza.status = "Paid - exiting"
            sendPizzaExit()
        end
        return
    end

    if action == "Round" then return end

    if action == "End" or action == "Cancel" then
        if pizza.state == "exiting"
            or pizza.state == "making" then
            pizza.exitConfirmed = true
            pizza.state = "waitingClose"
            pizza.status = "Session ended"
        end
        return
    end

    if pizza.state ~= "making" then return end

    if action == "Phase" then
        if type(a) == "string" then
            beginPhase(a)
            if a == "Toppings" then
                pizza.remaining = recipeToppings()
            end
        end

    elseif action == "Progress" then
        if type(a) == "string" and type(b) == "number" then
            beginPhase(a)

            if pizza.phase == a then
                pizza.progress = math.max(
                    pizza.progress,
                    math.clamp(b, 0, 1)
                )

                if pizza.progress >= 1
                    and pizza.completedAt == 0 then
                    pizza.completedAt = os.clock()
                end
            end
        end

    elseif action == "PourComplete" then
        if a == pizza.phase then
            pizza.progress = 1
            if pizza.completedAt == 0 then
                pizza.completedAt = os.clock()
            end
        end

    elseif action == "Topping" then
        if type(a) == "string" and type(c) == "number" then
            pizza.remaining[a] = c
        end
    end
end)

-- MAIN PIZZA LOOP

local function runPizza(token)
    while alive and autoPizza and token == pizzaToken do
        local state = pizza.state
        local now = os.clock()

        if state == "idle" then
            if not pizzaVisible() then
                pizza.state = "opening"
                pizza.status = "Preparing new pizza"
                pizza.promptAttempts = 0
                pizza.lastPrompt = now - 0.4
            end
            task.wait(0.04)

        elseif state == "opening" then
            if pizza.session then
                pizza.state = "making"
            elseif not pizzaVisible() then
                tryPizzaPrompt(token)
            end
            task.wait(0.04)

        elseif state == "exiting"
            or state == "waitingClose" then

            if not pizzaVisible() then
                if pizza.closedAt == 0 then
                    pizza.closedAt = now
                end

                if now - pizza.closedAt >= 0.15 then
                    restorePizzaGui()
                    pizza.session = nil
                    pizza.phase = nil
                    pizza.progress = 0
                    pizza.remaining = {}
                    pizza.state = "idle"
                    pizza.status = "Closed - restarting"
                    pizza.closedAt = 0
                    pizza.promptAttempts = 0
                    pizza.lastPrompt = now - 0.4
                end
            else
                pizza.closedAt = 0

                if pizza.session
                    and now - pizza.lastExit >= 1.0 then
                    sendPizzaExit()
                end
            end

            task.wait(0.04)

        elseif state == "making" then
            centerPizza()

            local phase = pizza.phase

            if nextPhase[phase]
                and pizza.progress >= 1
                and pizza.completedAt > 0
                and now - pizza.completedAt >= 0.1 then

                local target = nextPhase[phase]
                beginPhase(target)

                if target == "Toppings" then
                    pizza.remaining = recipeToppings()
                end

                phase = target
            end

            if phase == "Dough" then
                if pizza.progress < 1 then
                    pizza.doughStep += 1

                    local angle = pizza.doughStep * 0.28
                    local radius = 0.24

                    sendPizza(
                        "Knead",
                        Vector2.new(
                            math.cos(angle) * radius,
                            math.sin(angle) * radius
                        ),
                        nil
                    )
                end
                task.wait(0.055)

            elseif phase == "Sauce" then
                if pizza.progress < 1 then
                    sendPizza(
                        "Pour",
                        Vector2.new(-0.08625, -0.2192),
                        nil
                    )
                end
                task.wait(0.035)

            elseif phase == "Cheese" then
                if pizza.progress < 1 then
                    sendPizza(
                        "Pour",
                        Vector2.new(-0.08625, -0.2192),
                        nil
                    )
                end
                task.wait(0.055)

            elseif phase == "Toppings" then
                local chosen

                for _, name in ipairs({
                    "Pepperoni",
                    "Mushroom",
                    "Olive"
                }) do
                    if (pizza.remaining[name] or 0) > 0 then
                        chosen = name
                        break
                    end
                end

                if chosen
                    and now - pizza.lastTopping >= 0.12 then

                    sendPizza(
                        "Topping",
                        Vector2.new(0.2, 0.17),
                        chosen
                    )

                    pizza.lastTopping = now
                end
                task.wait(0.04)
            else
                task.wait(0.06)
            end
        else
            task.wait(0.08)
        end
    end
end

-- AUTO CRATES

local function findCrates()
    local result = {}

    for _, crate in ipairs(workspace:GetChildren()) do
        if crate.Name == "Crate" then
            local main = crate:FindFirstChild("Main")
            local prompt = main and main:FindFirstChild("Prompt")

            if main and main:IsA("BasePart")
                and prompt
                and prompt:IsA("ProximityPrompt")
                and prompt.Enabled then

                table.insert(result, {
                    crate = crate,
                    main = main,
                    prompt = prompt
                })
            end
        end
    end

    return result
end

local function crateGone(entry)
    return not entry.crate.Parent
        or not entry.prompt.Parent
        or not entry.prompt.Enabled
end

local function runCrates(token)
    while alive and autoCrates and token == crateToken do
        if busy then
            task.wait(0.15)
            continue
        end

        for _, entry in ipairs(findCrates()) do
            if not alive or not autoCrates
                or token ~= crateToken then
                break
            end

            if not crateGone(entry) then
                busy = true
                local root = getRoot()
                local previous = root and root.CFrame

                while alive and autoCrates
                    and token == crateToken
                    and not crateGone(entry) do

                    teleportTo(entry.main)
                    task.wait(0.25)
                    firePrompt(entry.prompt)

                    local deadline = os.clock() + 1.5
                    while os.clock() < deadline
                        and not crateGone(entry)
                        and alive and autoCrates do
                        task.wait(0.1)
                    end

                    if crateGone(entry) then break end
                    task.wait(0.35)
                end

                restore(root, previous)
                busy = false
            end
        end
        task.wait(0.5)
    end
end

-- AUTO OBBY
-- Teleport to cave, allow entrance trigger to work,
-- teleport to finish, and repeat while enabled.

local function obbyPart(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart", true)
    end

    return object:FindFirstChildWhichIsA("BasePart", true)
end

local function runObby(token)
    while alive and autoObby and token == obbyToken do
        if busy then
            task.wait(0.15)
            continue
        end

        local map = workspace:FindFirstChild("Map")
        local obby = map and map:FindFirstChild("Obby")

        local cave = obby and obby:FindFirstChild("cave")
        local finish = obby and obby:FindFirstChild("End")

        local cavePart = obbyPart(cave)
        local endPart = obbyPart(finish)

        if cavePart and endPart then
            busy = true

            -- Touch/enter the cave trigger.
            teleportTo(cavePart)
            task.wait(0.8)

            if alive and autoObby and token == obbyToken then
                -- Complete the obby.
                teleportTo(endPart)
                task.wait(0.9)
            end

            busy = false

            -- Allow reward / completion to process.
            task.wait(0.6)
        else
            task.wait(1)
        end
    end
end

