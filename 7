--------------------------------------------------
-- EXPERIMENTAL REEL CONTROLLER
--------------------------------------------------

local function findReelElements()
    local candidates = {}

    for _, obj in ipairs(playerGui:GetDescendants()) do
        if obj:IsA("Frame") and obj.Visible then
            local name = obj.Name:lower()

            if name:find("target")
                or name:find("cursor")
                or name:find("indicator")
                or name:find("marker") then

                table.insert(candidates, obj)
            end
        end
    end

    local target, cursor

    for _, obj in ipairs(candidates) do
        local name = obj.Name:lower()

        if name:find("target") or name:find("gold") then
            target = obj
        elseif name:find("cursor")
            or name:find("indicator")
            or name:find("marker") then
            cursor = obj
        end
    end

    return target, cursor
end

local function updateReeling()
    if phase ~= "reeling" then
        releaseMouse()
        return
    end

    local target, cursor = findReelElements()

    if not target or not cursor then
        releaseMouse()
        reelLabel.Text = "Reel: Waiting for GUI bar detection"
        return
    end

    local targetX =
        target.AbsolutePosition.X + target.AbsoluteSize.X / 2

    local cursorX =
        cursor.AbsolutePosition.X + cursor.AbsoluteSize.X / 2

    local parentWidth = math.max(
        1,
        target.Parent.AbsoluteSize.X
    )

    local difference = (targetX - cursorX) / parentWidth

    reelLabel.Text = string.format(
        "Reel: Target offset %.3f",
        difference
    )

    -- Experimental assumption:
    -- holding moves the indicator to the right.
    -- If it moves left instead, this must be reversed.

    if difference > HOLD_DEADBAND then
        holdMouse()
    elseif difference < -HOLD_DEADBAND then
        releaseMouse()
    else
        releaseMouse()
    end
end

--------------------------------------------------
-- SESSION EVENTS
--------------------------------------------------

table.insert(connections,
    FishingState.OnClientEvent:Connect(function(state, data)
        if destroyed or not running then return end

        data = type(data) == "table" and data or {}

        if state == "cast" then
            if phase ~= "casting" then return end

            castId = data.castId
            setPhase("waiting")
            status("Cast accepted - waiting for bite")

        elseif state == "reel" then
            if phase ~= "waiting" then return end

            if castId and data.castId
                and castId ~= data.castId then
                return
            end

            setPhase("reeling")
            status("Balancing reel bar")

        elseif state == "done" then
            if phase ~= "casting"
                and phase ~= "waiting"
                and phase ~= "reeling" then
                return
            end

            if castId and data.castId
                and castId ~= data.castId then
                return
            end

            releaseMouse()

            if data.reason == "caught" then
                catches += 1
                status("Caught: " .. tostring(data.itemName or "Unknown"))
            else
                failures += 1
                status("Fishing ended: " .. tostring(data.reason or "Unknown"))
            end

            updateStats()
            castId = nil
            setPhase("finishing")
        end
    end)
)

--------------------------------------------------
-- WORKER
--------------------------------------------------

task.spawn(function()
    while not destroyed do
        if not running then
            task.wait(0.1)
            continue
        end

        if phase == "idle" then
            local token = generation
            setPhase("equipping")

            local ok, err = ensureRod(token)

            if destroyed or not running or token ~= generation then
                continue
            end

            if not ok then
                running = false
                setPhase("idle")
                updateToggle()
                status(err or "Rod unavailable")
                continue
            end

            local water, position, distance = findWater()

            if not water then
                status("Face nearby water")
                setPhase("searching")
                continue
            end

            waterLabel.Text = "Water: " .. water.Name
                .. " (" .. distance .. " studs)"

            castId = nil
            setPhase("casting")
            status("Casting farther out")

            casts += 1
            updateStats()

            local sent = pcall(function()
                FishingCast:FireServer(water, position)
            end)

            if not sent then
                failures += 1
                updateStats()
                running = false
                setPhase("idle")
                updateToggle()
                status("Cast request failed")
            end

        elseif phase == "searching" then
            if os.clock() - phaseTime > 1 then
                setPhase("idle")
            end

        elseif phase == "casting" then
            if os.clock() - phaseTime > CAST_TIMEOUT then
                failures += 1
                updateStats()
                running = false
                FishingCancel:FireServer()
                setPhase("idle")
                updateToggle()
                status("Cast timeout - stopped")
            end

        elseif phase == "waiting" then
            if os.clock() - phaseTime > BITE_TIMEOUT then
                failures += 1
                updateStats()
                running = false
                FishingCancel:FireServer()
                setPhase("idle")
                updateToggle()
                status("Bite timeout - stopped")
            end

        elseif phase == "reeling" then
            updateReeling()

            if os.clock() - phaseTime > REEL_TIMEOUT then
                releaseMouse()
                failures += 1
                updateStats()
                running = false
                FishingCancel:FireServer()
                setPhase("idle")
                updateToggle()
                status("Reel timeout - stopped")
            end

        elseif phase == "finishing" then
            if os.clock() - phaseTime >= FINISH_DELAY then
                releaseMouse()
                setPhase("idle")
                status("Ready for next cast")
            end

        end

        task.wait(0.065)
    end
end)

