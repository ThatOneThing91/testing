--------------------------------------------------

local function getToolId(tool)
    return tonumber(
        tool:GetAttribute("ItemId")
        or tool:GetAttribute("ItemID")
        or tool:GetAttribute("itemId")
    )
end

local function getEquippedRod()
    local character = player.Character
    if not character then return nil end

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            local id = getToolId(child)
            if id and knownRodIds[id] then
                return child, id
            end
        end
    end
end

local function isBroken(item)
    if item.Broken == true or item.IsBroken == true then
        return true
    end

    local condition = tonumber(item.Condition)
    if condition and condition <= 0 then
        return true
    end

    for k, v in pairs(item.Mutators or {}) do
        if tostring(k):lower() == "broken" and v ~= false then
            return true
        end
        if tostring(v):lower() == "broken" then
            return true
        end
    end

    return false
end

local function getInventory()
    local ok, result = pcall(function()
        return GetInventory:InvokeServer()
    end)

    if not ok or type(result) ~= "table" then
        return nil
    end

    return result.Inventory or result.Items or result
end

local function ensureRod(token)
    local tool, id = getEquippedRod()
    if tool then
        rodLabel.Text = "Rod: Equipped ItemId " .. id
        return true
    end

    local inventory = getInventory()
    if not inventory then
        return false, "Inventory unavailable"
    end

    local bestGuid, bestId, bestCondition

    for guid, item in pairs(inventory) do
        if type(item) == "table" then
            local itemId = tonumber(item.ItemId)
            if itemId and knownRodIds[itemId] and not isBroken(item) then
                local condition = tonumber(item.Condition) or 0
                if not bestGuid or condition > bestCondition then
                    bestGuid = item.Guid or item.UUID or guid
                    bestId = itemId
                    bestCondition = condition
                end
            end
        end
    end

    if not bestGuid then
        return false, "No usable fishing rods"
    end

    if token ~= generation or not running then
        return false, "Cancelled"
    end

    status("Equipping fishing rod")

    local ok = pcall(function()
        EquipItem:FireServer(bestGuid)
    end)

    if not ok then
        return false, "Equip request failed"
    end

    local deadline = os.clock() + 3

    while os.clock() < deadline do
        if destroyed or not running or token ~= generation then
            return false, "Cancelled"
        end

        local equipped, equippedId = getEquippedRod()
        if equipped then
            rodLabel.Text = "Rod: Equipped ItemId " .. equippedId
            return true
        end

        task.wait(0.1)
    end

    return false, "Rod equip timeout"
end

--------------------------------------------------
-- WATER TARGETING
--------------------------------------------------

local function findWater()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = false

    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector

    for _, distance in ipairs(CAST_DISTANCES) do
        for _, offset in ipairs(SIDE_OFFSETS) do
            local point = root.Position
                + forward * distance
                + right * offset

            local result = workspace:Raycast(
                point + Vector3.new(0, 35, 0),
                Vector3.new(0, -110, 0),
                params
            )

            if result then
                local name = result.Instance.Name:lower()

                if result.Material == Enum.Material.Water
                    or name:find("water")
                    or name:find("pond")
                    or name:find("lake")
                    or name:find("river") then

                    return result.Instance, result.Position, distance
                end
            end
        end
    end
end

