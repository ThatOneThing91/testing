--------------------------------------------------
-- DELTA COMPATIBLE INPUT
--------------------------------------------------

-- This version deliberately avoids:
-- mouse1press()
-- mouse1release()

local inputAvailable = true

local function inputPosition()
    local camera = workspace.CurrentCamera

    if not camera then
        return Vector2.new(0, 0), CFrame.new()
    end

    local viewport = camera.ViewportSize

    return Vector2.new(
        viewport.X * 0.5,
        viewport.Y * 0.5
    ), camera.CFrame
end

local function releaseMouse()
    if not mouseHeld then
        return
    end

    mouseHeld = false

    local position, cameraCF = inputPosition()

    pcall(function()
        VirtualUser:Button1Up(position, cameraCF)
    end)
end

local function holdMouse()
    if mouseHeld then
        return true
    end

    if not inputAvailable then
        return false
    end

    local position, cameraCF = inputPosition()

    local ok = pcall(function()
        VirtualUser:Button1Down(position, cameraCF)
    end)

    if ok then
        mouseHeld = true
    else
        inputAvailable = false
        status("VirtualUser input unavailable")
    end

    return ok
end

local function setMouseState(shouldHold, now)
    if shouldHold == mouseHeld then
        return
    end

    if now - lastInputChange < MIN_INPUT_SWITCH then
        return
    end

    if shouldHold then
        if holdMouse() then
            lastInputChange = now
        end
    else
        releaseMouse()
        lastInputChange = now
    end
end

--------------------------------------------------
-- AUTO ROD REPLACEMENT
--------------------------------------------------

local function ensureRod(token)
    local inventory = getInventoryData()

    if not inventory then
        return false, "Inventory unavailable"
    end

    local tool, id = getEquippedRod()

    if tool then
        local guid = getToolGuid(tool)

        if guid then
            knownEquippedGuid = guid
        end

        if equippedRodUsable(tool, id, inventory) then
            rodLabel.Text =
                "Rod: Equipped ItemId " .. tostring(id)
            return true
        end
    end

    local candidates = findUsableRods(inventory)

    if #candidates == 0 then
        return false, "No usable fishing rods"
    end

    local brokenGuid = tool and (
        getToolGuid(tool) or knownEquippedGuid
    )

    for _, rod in ipairs(candidates) do
        if destroyed or not running
            or token ~= generation then
            return false, "Cancelled"
        end

        if brokenGuid and rod.guid == brokenGuid then
            continue
        end

        status("Equipping replacement rod")

        local sent = pcall(function()
            EquipItem:FireServer(rod.guid)
        end)

        if sent then
            invalidateInventory()

            local deadline = os.clock() + 3
            local nextInventoryCheck = 0

            while os.clock() < deadline do
                if destroyed or not running
                    or token ~= generation then
                    return false, "Cancelled"
                end

                local equipped, equippedId =
                    getEquippedRod()

                if equipped then
                    local equippedGuid =
                        getToolGuid(equipped)

                    local matches =
                        equippedGuid == rod.guid
                        or (
                            equippedGuid == nil
                            and rod.id ~= nil
                            and equippedId == rod.id
                        )

                    if matches
                        and os.clock() >= nextInventoryCheck then

                        nextInventoryCheck =
                            os.clock() + 0.75

                        local fresh =
                            getInventoryData(true)

                        local exactItem = fresh
                            and getInventoryItem(
                                fresh,
                                rod.guid
                            )

                        if exactItem
                            and not isBroken(exactItem)
                            and isFishingRod(
                                exactItem,
                                rod.id
                            ) then

                            knownEquippedGuid = rod.guid

                            rodLabel.Text =
                                "Rod: Equipped ItemId "
                                .. tostring(equippedId)

                            return true
                        end
                    end
                end

                task.wait(0.20)
            end
        end
    end

    return false, "Unable to equip working rod"
end

--------------------------------------------------
-- WATER DETECTION
--------------------------------------------------

local function findWater()
    local character = player.Character
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return nil
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = false

    local forward = root.CFrame.LookVector
    local right = root.CFrame.RightVector

    for _, distance in ipairs(CAST_DISTANCES) do
        for _, offset in ipairs(SIDE_OFFSETS) do
            local point =
                root.Position
                + forward * distance
                + right * offset

            local result = workspace:Raycast(
                point + Vector3.new(0, 35, 0),
                Vector3.new(0, -110, 0),
                params
            )

            if result then
                local name = normalize(result.Instance.Name)

                if result.Material == Enum.Material.Water
                    or name:find("water", 1, true)
                    or name:find("pond", 1, true)
                    or name:find("lake", 1, true)
                    or name:find("river", 1, true) then

                    return result.Instance,
                        result.Position,
                        distance
                end
            end
        end
    end

    return nil
end

