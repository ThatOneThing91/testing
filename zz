local function getReelGui()
    local fishingGui =
        playerGui:FindFirstChild("FishingReelGui")

    if not fishingGui then
        return nil
    end

    local minigame =
        fishingGui:FindFirstChild("ReelMinigame")

    if not minigame or not minigame.Visible then
        return nil
    end

    local catchBar =
        minigame:FindFirstChild("CatchBar")

    if not catchBar or not catchBar.Visible then
        return nil
    end

    local fish = catchBar:FindFirstChild("Fish")
    local zone = catchBar:FindFirstChild("Zone")

    if not fish or not zone then
        return nil
    end

    if not fish:IsA("GuiObject")
        or not zone:IsA("GuiObject")
        or not fish.Visible
        or not zone.Visible then
        return nil
    end

    return catchBar, fish, zone
end

--------------------------------------------------
-- TRACKING RESET
--------------------------------------------------

local function resetReelTracking()
    releaseMouse()

    nextReelAction = 0
    lastInputChange = 0
    lastGuiUpdate = 0

    previousFishX = nil
    previousZoneX = nil
    previousSampleTime = nil

    fishVelocity = 0
    zoneVelocity = 0
    lastGuiObjects = nil
end

--------------------------------------------------
-- REEL CONTROLLER
--------------------------------------------------

local function updateReeling()
    if phase ~= "reeling" then
        releaseMouse()
        return
    end

    local now = os.clock()

    if now < nextReelAction then
        return
    end

    nextReelAction = now + TRACK_INTERVAL

    if not inputAvailable then
        releaseMouse()
        status("Input unavailable - stopping")
        running = false
        generation += 1
        setPhase("idle")
        updateToggle()
        return
    end

    if not trackingEnabled then
        -- Timed fallback, without rapid input
        local elapsed = now - phaseTime
        local cycle = elapsed % 2

        setMouseState(cycle < 1.5, now)

        if now - lastGuiUpdate >= GUI_UPDATE_INTERVAL then
            trackingLabel.Text = "Tracking: Timed mode"
            reelLabel.Text = mouseHeld
                and "Timed | HOLD"
                or "Timed | RELEASE"

            lastGuiUpdate = now
        end

        return
    end

    local catchBar, fish, zone = getReelGui()

    if not catchBar then
        releaseMouse()

        if now - lastGuiUpdate >= GUI_UPDATE_INTERVAL then
            trackingLabel.Text =
                "Tracking: Searching for Fish / Zone"
            lastGuiUpdate = now
        end

        return
    end

    if lastGuiObjects
        and (
            lastGuiObjects.fish ~= fish
            or lastGuiObjects.zone ~= zone
        ) then

        previousFishX = nil
        previousZoneX = nil
        previousSampleTime = nil

        fishVelocity = 0
        zoneVelocity = 0
    end

    if not lastGuiObjects
        or lastGuiObjects.fish ~= fish
        or lastGuiObjects.zone ~= zone then

        lastGuiObjects = {
            fish = fish,
            zone = zone
        }
    end

    local width = math.max(
        catchBar.AbsoluteSize.X, 1
    )

    local trackX = catchBar.AbsolutePosition.X

    local fishX = (
        fish.AbsolutePosition.X
        + fish.AbsoluteSize.X * 0.5
        - trackX
    ) / width

    local zoneX = (
        zone.AbsolutePosition.X
        + zone.AbsoluteSize.X * 0.5
        - trackX
    ) / width

    local dt = previousSampleTime
        and now - previousSampleTime
        or TRACK_INTERVAL

    if dt >= 0.012 then
        if previousFishX then
            local velocity = math.clamp(
                (fishX - previousFishX) / dt,
                -3, 3
            )

            fishVelocity =
                fishVelocity * 0.6
                + velocity * 0.4
        end

        if previousZoneX then
            local velocity = math.clamp(
                (zoneX - previousZoneX) / dt,
                -3, 3
            )

            zoneVelocity =
                zoneVelocity * 0.6
                + velocity * 0.4
        end

        previousFishX = fishX
        previousZoneX = zoneX
        previousSampleTime = now
    end

    local zoneHalf =
        (zone.AbsoluteSize.X * 0.5) / width

    local fishHalf =
        (fish.AbsoluteSize.X * 0.5) / width

    local containmentHalf = math.max(
        0,
        zoneHalf - fishHalf
    )

    local rawError = fishX - zoneX
    local inside =
        math.abs(rawError) <= containmentHalf

    local desiredHold = mouseHeld
    local mode

    if not inside then
        mode = "CHASE"

        if rawError > CHASE_MARGIN then
            desiredHold = true
        elseif rawError < -CHASE_MARGIN then
            desiredHold = false
        end
    else
        mode = "FOLLOW"

        local predictedFish = math.clamp(
            fishX + fishVelocity * TRACK_LOOKAHEAD,
            0, 1
        )

        local predictedZone = math.clamp(
            zoneX + zoneVelocity * TRACK_LOOKAHEAD,
            0, 1
        )

        local error = predictedFish - predictedZone

        if error > FOLLOW_DEADZONE then
            desiredHold = true
        elseif error < -FOLLOW_DEADZONE then
            desiredHold = false
        elseif zoneVelocity > 0.035 then
            desiredHold = false
        elseif zoneVelocity < -0.035 then
            desiredHold = true
        end
    end

    setMouseState(desiredHold, now)

    if now - lastGuiUpdate >= GUI_UPDATE_INTERVAL then
        reelLabel.Text = string.format(
            "%s | %s",
            mode,
            mouseHeld and "HOLD" or "RELEASE"
        )

        trackingLabel.Text = string.format(
            "Fish %.3f | Zone %.3f | Gap %+.3f",
            fishX, zoneX, rawError
        )

        lastGuiUpdate = now
    end
end

--------------------------------------------------
-- SESSION CONTROL
--------------------------------------------------

local function cancelCast()
    pcall(function()
        FishingCancel:FireServer()
    end)
end

local function stopFishing(message, cancel)
    running = false
    generation += 1

    resetReelTracking()

    if cancel then
        cancelCast()
    end

    activeCastId = nil

    setPhase("idle")
    updateToggle()

    if message then
        status(message)
    end
end

--------------------------------------------------
-- FISHING EVENTS
--------------------------------------------------

table.insert(
    connections,
    FishingState.OnClientEvent:Connect(
        function(state, data)
            if destroyed or not running then
                return
            end

            data = type(data) == "table"
                and data or {}

            if state == "cast" then
                if phase ~= "casting" then
                    return
                end

                activeCastId = data.castId
                setPhase("waiting")
                status("Waiting for bite")

            elseif state == "reel" then
                if phase ~= "waiting" then
                    return
                end

                if activeCastId ~= nil
                    and data.castId ~= nil
                    and activeCastId ~= data.castId then
                    return
                end

                resetReelTracking()
                setPhase("reeling")
                status("Reeling...")

            elseif state == "done" then
                if phase ~= "casting"
                    and phase ~= "waiting"
                    and phase ~= "reeling" then
                    return
                end

                if activeCastId ~= nil
                    and data.castId ~= nil
                    and activeCastId ~= data.castId then
                    return
                end

                resetReelTracking()

                if data.reason == "caught" then
                    catches += 1

                    status(
                        "Caught: "
                        .. tostring(
                            data.itemName or "Unknown"
                        )
                    )
                else
                    failures += 1

                    status(
                        "Fishing ended: "
                        .. tostring(
                            data.reason or "Unknown"
                        )
                    )
                end

                updateStats()
                activeCastId = nil
                invalidateInventory()
                setPhase("finishing")
            end
        end
    )
)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

local function mainStep()
    if phase == "idle" then
        local token = generation

        setPhase("equipping")

        local ok, err = ensureRod(token)

        if destroyed or not running
            or token ~= generation then
            return
        end

        if not ok then
            status(err or "Searching for rod")
            setPhase("rod_retry")
            return
        end

        local water, position, distance = findWater()

        if not water then
            status("Face nearby water")
            setPhase("searching")
            return
        end

        waterLabel.Text = string.format(
            "Water: %s | %d studs",
            water.Name,
            distance
        )

        activeCastId = nil
        setPhase("casting")
        status("Casting...")

        casts += 1
        updateStats()

        local sent = pcall(function()
            FishingCast:FireServer(water, position)
        end)

        if not sent then
            failures += 1
            updateStats()
            cancelCast()
            setPhase("finishing")
        end

    elseif phase == "rod_retry" then
        if os.clock() - phaseTime >= ROD_RETRY_DELAY then
            invalidateInventory()
            setPhase("idle")
        end

    elseif phase == "searching" then
        if os.clock() - phaseTime >= 1 then
            setPhase("idle")
        end

    elseif phase == "casting" then
        if os.clock() - phaseTime > CAST_TIMEOUT then
            failures += 1
            updateStats()
            cancelCast()
            setPhase("finishing")
        end

    elseif phase == "waiting" then
        if os.clock() - phaseTime > BITE_TIMEOUT then
            failures += 1
            updateStats()
            cancelCast()
            setPhase("finishing")
        end

    elseif phase == "reeling" then
        updateReeling()

        if os.clock() - phaseTime > REEL_TIMEOUT then
            failures += 1
            updateStats()

            resetReelTracking()
            cancelCast()

            status("Reel timeout - retrying")
            setPhase("finishing")
        end

    elseif phase == "finishing" then
        releaseMouse()

        if os.clock() - phaseTime >= NEXT_CAST_DELAY then
            resetReelTracking()
            setPhase("idle")
            status("Starting next cast")
        end
    end
end

task.spawn(function()
    while not destroyed do
        if running then
            local ok, err = pcall(mainStep)

            if not ok then
                warn("[Auto Fishing V19]", err)
                stopFishing("Script error - stopped", true)
            end
        end

        task.wait(
            running and TRACK_INTERVAL or 0.15
        )
    end
end)

