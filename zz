    connections,
    trackButton.MouseButton1Click:Connect(function()
        trackingEnabled = not trackingEnabled

        trackButton.Text = trackingEnabled
            and "REAL GUI TRACKING: ON"
            or "REAL GUI TRACKING: OFF"

        resetReelTracking()
    end)
)

--------------------------------------------------
-- CLEANUP
--------------------------------------------------

local function cleanup()
    if destroyed then
        return
    end

    stopFishing(nil, true)
    destroyed = true

    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    gui:Destroy()

    if env.SH_FishingV19Cleanup == cleanup then
        env.SH_FishingV19Cleanup = nil
    end
end

close.MouseButton1Click:Connect(cleanup)

env.SH_FishingV19Cleanup = cleanup

status("Ready")
print("[Auto Fishing V19] Launched")
