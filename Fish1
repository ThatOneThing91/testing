-- Resolve remotes without blocking GUI launch

local remotes = {}

local function findRemote(...)
    local current = RS

    for _, name in ipairs({...}) do
        current = current:FindFirstChild(name)

        if not current then
            return nil
        end
    end

    return current
end

local function loadRemotes()
    remotes.Cast = findRemote(
        "Events", "Misc", "FishingCast"
    )

    remotes.Result = findRemote(
        "Events", "Misc", "FishingResult"
    )

    remotes.Cancel = findRemote(
        "Events", "Misc", "FishingCancel"
    )

    remotes.State = findRemote(
        "Events", "Misc", "FishingState"
    )

    remotes.Inventory = findRemote(
        "Events", "Inventory", "GetPlayerInventory"
    )

    remotes.Equip = findRemote(
        "Events", "Inventory", "EquipItem"
    )

    for name, remote in pairs(remotes) do
        if not remote then
            return false, "Missing: " .. name
        end
    end

    local required = {
        Cast = "RemoteEvent",
        Result = "RemoteEvent",
        Cancel = "RemoteEvent",
        State = "RemoteEvent",
        Inventory = "RemoteFunction",
        Equip = "RemoteEvent"
    }

    for name, className in pairs(required) do
        if not remotes[name]:IsA(className) then
            return false, name .. " has unexpected type"
        end
    end

    return true
end

local function getWater()
    local assets = workspace:FindFirstChild(
        "BBOW Builder Assets"
    )

    if not assets then return nil end

    local folder = assets:FindFirstChild(
        "Grass and Water"
    )

    if not folder then return nil end

    local model = folder:FindFirstChild("Model")
    if not model then return nil end

    return model:GetChildren()[6]
end

local function containsBroken(mutators)
    if type(mutators) ~= "table" then
        return false
    end

    for key, value in pairs(mutators) do
        if tostring(key):lower() == "broken"
            and value ~= false then
            return true
        end

        if type(value) == "string"
            and value:lower() == "broken" then
            return true
        end

        if type(value) == "table" then
            local name = value.Name or value.name
                or value.Mutator or value.mutator

            if tostring(name):lower() == "broken" then
                return true
            end
        end
    end

    return false
end

local function findRod()
    local ok, response = pcall(function()
        return remotes.Inventory:InvokeServer()
    end)

    if not ok or type(response) ~= "table" then
        return nil, "Inventory request failed"
    end

    local items = response.Items
        or response.items
        or response.Inventory
        or response.inventory
        or response

    if type(items) ~= "table" then
        return nil, "Unknown inventory format"
    end

    for key, item in pairs(items) do
        if type(item) == "table" then
            local name = tostring(
                item.Name or item.name
                or item.ItemName or item.itemName
                or item.DisplayName or item.displayName
                or ""
            ):lower()

            local category = tostring(
                item.Category or item.category
                or item.Type or item.type
                or ""
            ):lower()

            local isRod =
                name:find("fishing rod", 1, true)
                or category:find("fishing rod", 1, true)
                or category == "fishingrod"

            local broken =
                item.Broken == true
                or item.IsBroken == true
                or containsBroken(
                    item.Mutators or item.mutators
                )

            if isRod and not broken then
                local guid = item.UUID or item.uuid
                    or item.Guid or item.guid
                    or item.Id or item.id

                if not guid and type(key) == "string" then
                    guid = key
                end

                if type(guid) == "string" then
                    return guid
                end
            end
        end
    end

    return nil, "No usable rod detected"
end

local function equipRod()
    local guid, err = findRod()

    if not guid then
        return false, err
    end

    if guid ~= lastRod then
        setStatus("Equipping rod...")

        local ok = pcall(function()
            remotes.Equip:FireServer(guid)
        end)

        if not ok then
            return false, "Equip remote failed"
        end

        lastRod = guid
        task.wait(0.4)
    end

    return true
end

local function stopFishing(cancel)
    running = false
    generation += 1
    phase = "idle"
    castId = nil
    updateToggle()

    if cancel and remotes.Cancel then
        pcall(function()
            remotes.Cancel:FireServer()
        end)
    end
end

local stateConnection = nil

local function connectFishingState()
    if stateConnection then
        stateConnection:Disconnect()
        stateConnection = nil
    end

    stateConnection = remotes.State.OnClientEvent:Connect(
        function(state, data)
            if destroyed or not running then return end

            if type(data) ~= "table" then
                data = {}
            end

            if state == "cast" then
                if phase ~= "casting"
                    and phase ~= "waiting" then
                    return
                end

                castId = data.castId
                phase = "waiting"
                phaseStarted = os.clock()

                setStatus("Waiting for bite...")
                setDetail(string.format(
                    "Bite estimate: %.2fs | Cast ID: %s",
                    tonumber(data.biteIn) or 0,
                    tostring(castId)
                ))

            elseif state == "reel" then
                if phase ~= "waiting"
                    and phase ~= "casting" then
                    return
                end

                if castId ~= nil
                    and data.castId ~= nil
                    and castId ~= data.castId then
                    return
                end

                phase = "result_sent"
                phaseStarted = os.clock()

                setStatus("Reeling: " ..
                    tostring(data.itemName or "Unknown"))

                setDetail(
                    "Rarity: " .. tostring(data.rarity)
                    .. " | Difficulty: "
                    .. tostring(data.difficulty)
                )

                pcall(function()
                    remotes.Result:FireServer("caught")
                end)

            elseif state == "done" then
                if phase == "idle"
                    or phase == "preparing" then
                    return
                end

                local reason = tostring(data.reason or "")

                if reason == "caught" then
                    catches += 1

                    setStatus("Caught: " ..
                        tostring(data.itemName or "Unknown"))

                    setDetail(
                        "Rarity: " .. tostring(data.rarity)
                        .. " | Condition: "
                        .. tostring(data.condition)
                    )
                else
                    setStatus("Fishing ended: " .. reason)
                end

                castId = nil
                phase = "done"
                phaseStarted = os.clock()
                updateStats()
            end
        end
    )
end

local function startFishing()
    local ok, err = loadRemotes()

    if not ok then
        setStatus(err)
        return
    end

    local water = getWater()

    if not water then
        setStatus("Water target not found")
        return
    end

    connectFishingState()

    running = true
    generation += 1
    phase = "idle"
    lastRod = nil

    updateToggle()
    setStatus("Starting...")
    setDetail("Checking inventory")
end

toggle.MouseButton1Click:Connect(function()
    if running then
        stopFishing(true)
        setStatus("Stopped")
        setDetail("Ready to restart")
    else
        startFishing()
    end
end)

-- Fishing worker
task.spawn(function()
    while not destroyed do
        if not running then
            task.wait(0.1)

        elseif phase == "idle" or phase == "done" then
            local myGeneration = generation
            phase = "preparing"

            local equipped, err = equipRod()

            if myGeneration ~= generation or not running then
                continue
            end

            if not equipped then
                stopFishing(false)
                setStatus(err or "No usable rod")
                continue
            end

            local water = getWater()

            if not water then
                stopFishing(false)
                setStatus("Water target missing")
                continue
            end

            phase = "casting"
            phaseStarted = os.clock()
            castStarted = phaseStarted
            casts += 1
            updateStats()

            setStatus("Casting...")

            local ok = pcall(function()
                remotes.Cast:FireServer(water, CAST_POS)
            end)

            if not ok then
                setStatus("Cast remote failed")
                phase = "done"
                task.wait(1)
            end

        elseif phase == "casting" then
            if os.clock() - phaseStarted > 8 then
                setStatus("Cast timed out")
                stopFishing(true)
            end

            task.wait(0.1)

        elseif phase == "waiting" then
            if os.clock() - phaseStarted > 35 then
                setStatus("Bite timed out")
                stopFishing(true)
            end

            task.wait(0.1)

        elseif phase == "result_sent" then
            if os.clock() - phaseStarted > 12 then
                setStatus("Catch confirmation timed out")
                stopFishing(true)
            end

            task.wait(0.1)

        else
            task.wait(0.1)
        end
    end
end)

-- Draggable window
local dragging = false
local dragStart
local startPosition

table.insert(connections, title.InputBegan:Connect(
    function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then

            dragging = true
            dragStart = input.Position
            startPosition = main.Position
        end
    end
))

table.insert(connections, UIS.InputChanged:Connect(
    function(input)
        if not dragging then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then

            local delta = input.Position - dragStart

            main.Position = UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset + delta.X,
                startPosition.Y.Scale,
                startPosition.Y.Offset + delta.Y
            )
        end
    end
))

table.insert(connections, UIS.InputEnded:Connect(
    function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end
))

local function cleanup()
    if destroyed then return end

    stopFishing(true)
    destroyed = true

    if stateConnection then
        stateConnection:Disconnect()
    end

    for _, connection in ipairs(connections) do
        connection:Disconnect()
    end

    gui:Destroy()

    if env.SH_AutoFishingCleanup == cleanup then
        env.SH_AutoFishingCleanup = nil
    end
end

close.MouseButton1Click:Connect(cleanup)
env.SH_AutoFishingCleanup = cleanup

