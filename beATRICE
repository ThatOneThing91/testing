local function IsBrokenItem(item)
    if type(item) ~= "table" then
        return false
    end

    if item.name == "Broken" then
        return true
    end

    if item.Name == "Broken" then
        return true
    end

    local mutators = item.Mutators

    if type(mutators) == "table" then
        for _, mutator in pairs(mutators) do
            if type(mutator) == "table" then
                if mutator.name == "Broken"
                    or mutator.Name == "Broken" then
                    return true
                end
            end
        end
    end

    return false
end

local function FindDirtyItem()
    local washable = GetWashable()

    if type(washable) ~= "table" then
        return nil
    end

    local items =
        washable.items
        or washable.Items

    if type(items) ~= "table" then
        return nil
    end

    for _, entry in pairs(items) do
        if type(entry) == "table" then
            local guid =
                entry.guid
                or entry.GUID
                or entry.ItemGUID

            local source =
                entry.source
                or entry.Source
                or "Inventory"

            if guid
                and not IsBrokenItem(entry)
                and source == "Inventory" then

                local isDirty = false

                if entry.name == "Dirty"
                    or entry.Name == "Dirty" then
                    isDirty = true
                end

                local mutators = entry.Mutators

                if type(mutators) == "table" then
                    for _, mutator in pairs(mutators) do
                        if type(mutator) == "table" then
                            if mutator.name == "Dirty"
                                or mutator.Name == "Dirty" then
                                isDirty = true
                            end
                        end
                    end
                end

                if isDirty then
                    return tostring(guid)
                end
            end
        end
    end

    return nil
end

local function GetSlotInfo(slot)
    local result

    pcall(function()
        result = GetSlotState:InvokeServer(slot)
    end)

    return result
end

local function GetSlotCompletion(slot)
    local state = GetSlotInfo(slot)

    if type(state) ~= "table" then
        return nil
    end

    local data =
        state.ItemData
        or state.itemData
        or state

    if type(data) ~= "table" then
        return nil
    end

    local startTime =
        tonumber(
            data.StartTime
            or data.startTime
        )

    local duration =
        tonumber(
            data.Duration
            or data.duration
        )

    if startTime and duration then
        return startTime + duration
    end

    return nil
end

local function StartWashSlot(slot, guid)
    local ok, result = pcall(function()
        return StartWash:InvokeServer(
            slot,
            guid,
            "Inventory"
        )
    end)

    return ok, result
end

local function CollectAndClaim(slot)
    pcall(function()
        CollectWash:InvokeServer(slot)
    end)

    task.wait(1)

    pcall(function()
        ClaimWashedItem:InvokeServer(slot)
    end)
end

local function RunAutoWash(runId)
    task.spawn(function()
        local slotGuids = {}

        while State.AutoWash
            and RunIds.Wash == runId do

            for slot = 1, 3 do
                if not State.AutoWash
                    or RunIds.Wash ~= runId then
                    break
                end

                local completion =
                    GetSlotCompletion(slot)

                if completion then
                    if os.time() >= completion then
                        CollectAndClaim(slot)
                        task.wait(0.5)
                    end
                else
                    local guid = FindDirtyItem()

                    if guid then
                        local ok =
                            StartWashSlot(
                                slot,
                                guid
                            )

                        if ok then
                            slotGuids[slot] = guid
                        end

                        task.wait(0.5)
                    end
                end
            end

            task.wait(1)
        end
    end)
end

