--// ============================================================

local function GetAreaAuctionList()
    local list =
        AreaAuctions[State.SelectedArea]

    if not list then
        return {}
    end

    return list
end

local function StartFarming(runId)
    task.spawn(function()
        while State.Farming
            and RunIds.Farming == runId do

            local auctions =
                GetAreaAuctionList()

            if #auctions == 0 then
                Notify(
                    "Farming",
                    "No auctions available in "
                        .. State.SelectedArea,
                    2
                )

                task.wait(3)
            else
                local selectedIndex = 1

                for i, name in ipairs(auctions) do
                    if name == State.SelectedAuction then
                        selectedIndex = i
                        break
                    end
                end

                local failedAttempts = 0

                while State.Farming
                    and RunIds.Farming == runId do

                    local auctionName =
                        auctions[selectedIndex]

                    if not auctionName then
                        selectedIndex = 1
                        auctionName =
                            auctions[selectedIndex]
                    end

                    State.SelectedAuction =
                        auctionName

                    local result =
                        FarmGarage(
                            auctionName,
                            runId
                        )

                    if result == "finished" then
                        failedAttempts = 0

                        selectedIndex += 1

                        if selectedIndex > #auctions then
                            selectedIndex = 1
                        end

                        task.wait(0.5)

                    elseif result == "start_failed" then
                        failedAttempts += 1

                        -- Stay on SAME garage.
                        task.wait(5)

                    elseif result == "stopped" then
                        break
                    end
                end
            end
        end
    end)
end

