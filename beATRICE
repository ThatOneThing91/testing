--// ============================================================

local AuctionEvents =
    ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Auction")

local BidEvent =
    AuctionEvents:WaitForChild("Bid")

local RequestAuctionPause =
    AuctionEvents:WaitForChild(
        "RequestAuctionPause"
    )

local function PerformBid()
    pcall(function()
        BidEvent:FireServer()
    end)
end

local function PauseAuctionExact()
    pcall(function()
        RequestAuctionPause:FireServer(true)
    end)
end

local function PauseAuctionWithRetry(runId)
    if not State.PauseAuction then
        return
    end

    for i = 1, 8 do
        if not State.Farming
            or RunIds.Farming ~= runId then
            return
        end

        PauseAuctionExact()
        task.wait(0.25)
    end
end

--// ============================================================
--// WAIT FOR REAL AUCTION COMPLETION
--// ============================================================

local function WaitForAuctionFinished(runId)
    local sawAuction = false
    local closedChecks = 0

    while State.Farming
        and RunIds.Farming == runId do

        local container = GetAuctionContainer()
        local bidButton = GetBidButton()

        local visible =
            container
            and container.Visible

        if visible then
            sawAuction = true
            closedChecks = 0
        else
            if sawAuction then
                closedChecks += 1

                if closedChecks >= 5 then
                    return true
                end
            end
        end

        if sawAuction and not bidButton then
            -- Do not immediately advance.
            -- Wait for the actual container to close.
        end

        task.wait(0.2)
    end

    return false
end

--// ============================================================
--// FARM GARAGE
--// ============================================================

local function FarmGarage(
    garageName,
    runId
)
    if not State.Farming
        or RunIds.Farming ~= runId then
        return "stopped"
    end

    local garage =
        GetGarageByName(garageName)

    if not garage then
        return "start_failed"
    end

    local teleported =
        TeleportToGarage(garage)

    if not teleported then
        return "start_failed"
    end

    task.wait(0.75)

    if not State.Farming
        or RunIds.Farming ~= runId then
        return "stopped"
    end

    EnterGarage(garage)

    local started =
        WaitForAuctionStart(
            runId,
            30
        )

    if not started then
        return "start_failed"
    end

    --// Auction successfully started.

    if State.AutoBid then
        PerformBid()

        if State.PauseAuction then
            PauseAuctionWithRetry(runId)
        end
    end

    --// IMPORTANT:
    --// Do not advance on a timer.
    --// Wait for bidding UI to actually close.

    local finished =
        WaitForAuctionFinished(runId)

    if finished then
        return "finished"
    end

    return "stopped"
end

