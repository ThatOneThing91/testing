local function HueFromPosition(position)
    local center =
        HueWheel.AbsolutePosition
        + HueWheel.AbsoluteSize / 2

    local delta =
        position - center

    local angle =
        math.atan2(
            delta.Y,
            delta.X
        )

    local hue =
        (angle / (math.pi * 2))
        + 0.5

    if hue < 0 then
        hue += 1
    end

    return hue
end

