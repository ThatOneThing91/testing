local function GetGaragesFolder()
    return workspace:FindFirstChild("_Debris")
        and workspace._Debris:FindFirstChild("Garages")
end

local function GetGarageByName(name)
    local garages = GetGaragesFolder()

    if garages then
        local direct = garages:FindFirstChild(name)

        if direct then
            return direct
        end
    end

    local areas = workspace:FindFirstChild("Areas")

    if areas then
        local area =
            areas:FindFirstChild(State.SelectedArea)

        if area then
            return area:FindFirstChild(
                name,
                true
            )
        end
    end

    return nil
end

local function GetGarageEntry(garage)
    if not garage then
        return nil
    end

    local entry =
        garage:FindFirstChild(
            "EntrySquare",
            true
        )

    if not entry then
        return nil
    end

    return entry
end

local function GetGaragePrompt(garage)
    local entry = GetGarageEntry(garage)

    if not entry then
        return nil
    end

    return entry:FindFirstChild(
        "EnterAuction",
        true
    )
end

local function GetGarageDestination(garage)
    local entry = GetGarageEntry(garage)

    if not entry then
        return nil
    end

    local promptPart =
        entry:FindFirstChild(
            "PromptPart",
            true
        )

    if promptPart and promptPart:IsA("BasePart") then
        return promptPart
    end

    return entry:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

local function TeleportToGarage(garage)
    local destination =
        GetGarageDestination(garage)

    local root = GetRoot()

    if root and destination then
        root.CFrame =
            destination.CFrame
            + Vector3.new(0, 3, 0)

        return true
    end

    return false
end

local function EnterGarage(garage)
    local prompt = GetGaragePrompt(garage)

    if not prompt then
        return false
    end

    pcall(function()
        prompt.HoldDuration = 0
    end)

    if typeof(fireproximityprompt) == "function" then
        local ok = pcall(function()
            fireproximityprompt(prompt)
        end)

        if ok then
            return true
        end
    end

    if typeof(firePrompt) == "function" then
        local ok = pcall(function()
            firePrompt(prompt)
        end)

        if ok then
            return true
        end
    end

    return false
end

