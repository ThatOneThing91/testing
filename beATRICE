--// ============================================================

local PoliceGarages = {}

local function CheckPoliceGarage(garage)
    if not garage or not garage.Parent then
        return
    end

    if PoliceGarages[garage] then
        return
    end

    local warning = garage:FindFirstChild(
        "PoliceWarning",
        true
    )

    if warning then
        PoliceGarages[garage] = true
    end
end

local function ScanPoliceGarages()
    local garages =
        workspace:FindFirstChild("_Debris")
        and workspace._Debris:FindFirstChild("Garages")

    if not garages then
        return
    end

    for _, garage in ipairs(garages:GetChildren()) do
        CheckPoliceGarage(garage)
    end
end

task.spawn(function()
    local garages

    repeat
        garages =
            workspace:FindFirstChild("_Debris")
            and workspace._Debris:FindFirstChild("Garages")

        task.wait(1)
    until garages

    ScanPoliceGarages()

    garages.ChildAdded:Connect(function(child)
        task.wait(0.1)
        CheckPoliceGarage(child)
    end)

    garages.DescendantAdded:Connect(function(descendant)
        if descendant.Name == "PoliceWarning" then
            local garage = descendant:FindFirstAncestorOfClass("Model")

            if garage then
                CheckPoliceGarage(garage)
            end
        end
    end)
end)

local function GetPoliceGarage()
    for garage in pairs(PoliceGarages) do
        if garage and garage.Parent then
            local warning = garage:FindFirstChild(
                "PoliceWarning",
                true
            )

            if warning then
                return garage
            end
        end
    end

    return nil
end

local function TeleportToPoliceAuction()
    local garage = GetPoliceGarage()

    if not garage then
        ScanPoliceGarages()
        garage = GetPoliceGarage()
    end

    if not garage then
        Notify(
            "Police Auction",
            "No police auction found.",
            2
        )
        return
    end

    local entry = garage:FindFirstChild(
        "EntrySquare",
        true
    )

    local promptPart =
        entry and entry:FindFirstChild(
            "PromptPart",
            true
        )

    local destination =
        promptPart
        and promptPart:IsA("BasePart")
        and promptPart

    if not destination then
        destination = garage:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    local root = GetRoot()

    if root and destination then
        root.CFrame =
            destination.CFrame
            + Vector3.new(0, 3, 0)

        Notify(
            "Police Auction",
            "Teleported to " .. garage.Name,
            2
        )
    end
end

