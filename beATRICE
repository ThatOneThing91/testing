-- Replace dropdown cleanly whenever area changes.

local function RefreshAuctionDropdown()
    if not AuctionDropdown then
        return
    end

    local auctions =
        AreaAuctions[State.SelectedArea]
        or {}

    if #auctions == 0 then
        State.SelectedAuction =
            "No auctions found"

        AuctionDropdown:Set(
            "No auctions found"
        )

        return
    end

    local firstValid

    for _, name in ipairs(auctions) do
        local garage =
            GetGarageByName(name)

        if garage then
            firstValid = name
            break
        end
    end

    firstValid =
        firstValid
        or auctions[1]

    State.SelectedAuction =
        firstValid

    AuctionDropdown:Set(
        firstValid
    )
end

