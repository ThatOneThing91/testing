local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Events = ReplicatedStorage:WaitForChild("Events")
local Wash = Events:WaitForChild("Wash")

local GetWashableItems =
    Wash:WaitForChild("GetWashableItems")

local GetSlotState =
    Wash:WaitForChild("GetSlotState")

local StartWash =
    Wash:WaitForChild("StartWash")

--==================================================
-- SETTINGS
--==================================================

local MAX_SLOTS = 3
local CHECK_DELAY = 1

--==================================================
-- MUTATOR CHECK
--==================================================

local function GetMutators(data)

    local dirty = false
    local broken = false

    if typeof(data) ~= "table" then
        return dirty, broken
    end

    local mutators = data.Mutators

    if typeof(mutators) ~= "table" then
        return dirty, broken
    end

    for _, mutator in pairs(mutators) do

        if typeof(mutator) == "table" then

            local name =
                mutator.name or mutator.Name

            if name == "Dirty" then
                dirty = true
            elseif name == "Broken" then
                broken = true
            end

        end

    end

    return dirty, broken
end

--==================================================
-- GET WASHABLE INVENTORY ITEMS
--==================================================

local function GetDirtyWashableItems()

    local success, result = pcall(function()
        return GetWashableItems:InvokeServer()
    end)

    if not success then
        warn(
            "[Auto Wash] GetWashableItems failed:",
            result
        )

        return {}
    end

    if typeof(result) ~= "table"
        or typeof(result.items) ~= "table" then

        warn(
            "[Auto Wash] Unexpected washable-item data."
        )

        return {}
    end

    local items = {}

    for _, item in pairs(result.items) do

        if typeof(item) == "table"
            and item.source == "Inventory"
            and typeof(item.guid) == "string" then

            local dirty, broken =
                GetMutators(item.data)

            if dirty and not broken then

                table.insert(items, {
                    GUID = item.guid,
                    Data = item.data
                })

            elseif dirty and broken then

                print(
                    "[Auto Wash] SKIPPED BROKEN:",
                    item.guid
                )

            end

        end

    end

    return items
end

--==================================================
-- GET SLOT STATE
--==================================================

local function GetSlots()

    local success, result = pcall(function()
        return GetSlotState:InvokeServer()
    end)

    if not success then

        warn(
            "[Auto Wash] GetSlotState failed:",
            result
        )

        return nil
    end

    return result
end

--==================================================
-- CHECK IF SLOT IS EMPTY
--==================================================

local function IsSlotEmpty(slot)

    if not slot then
        return true
    end

    if not slot.ItemData then
        return true
    end

    return false
end

--==================================================
-- START WASH
--==================================================

local function StartItemWash(slotNumber, guid)

    print("")
    print("--------------------------------")
    print("[Auto Wash] Starting")
    print("Slot:", slotNumber)
    print("GUID:", guid)
    print("--------------------------------")

    local success, result = pcall(function()

        return StartWash:InvokeServer(
            slotNumber,
            guid,
            "Inventory"
        )

    end)

    if success then

        print(
            "[Auto Wash] StartWash SUCCESS"
        )

        return true

    else

        warn(
            "[Auto Wash] StartWash FAILED:",
            result
        )

        return false
    end
end

--==================================================
-- FILL EMPTY SLOTS
--==================================================

local function FillWashSlots()

    local dirtyItems =
        GetDirtyWashableItems()

    if #dirtyItems == 0 then

        print(
            "[Auto Wash] No cleanable Dirty items."
        )

        return
    end

    local slotState =
        GetSlots()

    if not slotState then
        return
    end

    local slots = slotState.slots

    if typeof(slots) ~= "table" then

        warn(
            "[Auto Wash] Slot data unavailable."
        )

        return
    end

    local unlocked =
        math.min(
            tonumber(slotState.unlockedCount) or MAX_SLOTS,
            MAX_SLOTS
        )

    local itemIndex = 1

    for slotNumber = 1, unlocked do

        if itemIndex > #dirtyItems then
            break
        end

        local slot =
            slots[slotNumber]

        if IsSlotEmpty(slot) then

            local item =
                dirtyItems[itemIndex]

            if StartItemWash(
                slotNumber,
                item.GUID
            ) then

                itemIndex += 1

                task.wait(0.5)

            end

        else

            print(
                "[Auto Wash] Slot",
                slotNumber,
                "occupied."
            )

        end

    end
end

--==================================================
-- MONITOR
--==================================================

local function PrintCompletedSlots()

    local state =
        GetSlots()

    if not state
        or typeof(state.slots) ~= "table" then

        return
    end

    for slotNumber = 1, math.min(
        tonumber(state.unlockedCount) or MAX_SLOTS,
        MAX_SLOTS
    ) do

        local slot =
            state.slots[slotNumber]

        if slot and slot.ItemData then

            local itemData =
                slot.ItemData

            local startTime =
                tonumber(itemData.StartTime)

            local duration =
                tonumber(itemData.Duration)

            if startTime and duration then

                local finishTime =
                    startTime + duration

                if os.time() >= finishTime then

                    print(
                        "[Auto Wash] SLOT",
                        slotNumber,
                        "FINISHED"
                    )

                end

            end

        end

    end
end

--==================================================
-- START
--==================================================

print("")
print("========================================")
print("          AUTO WASH STARTED")
print("========================================")

FillWashSlots()

--==================================================
-- CONTINUOUS LOOP
--==================================================

while true do

    task.wait(CHECK_DELAY)

    PrintCompletedSlots()

    -- Once collection is added, this will refill
    -- the newly freed slots automatically.
    FillWashSlots()

end
