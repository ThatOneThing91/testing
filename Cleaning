local ReplicatedStorage = game:GetService("ReplicatedStorage")

--------------------------------------------------
-- AUTO WASH TEST
--
-- FLOW:
-- GetWashableItems
--      ↓
-- StartWash
--      ↓
-- Wait for wash
--      ↓
-- CollectWash
--      ↓
-- WAIT 3 SECONDS
--      ↓
-- ClaimWashedItem
--      ↓
-- Refill slot
--------------------------------------------------

local Events = ReplicatedStorage:WaitForChild("Events")
local Wash = Events:WaitForChild("Wash")

local StartWash = Wash:WaitForChild("StartWash")
local CollectWash = Wash:WaitForChild("CollectWash")
local ClaimWashedItem = Wash:WaitForChild("ClaimWashedItem")
local GetSlotState = Wash:WaitForChild("GetSlotState")
local GetWashableItems = Wash:WaitForChild("GetWashableItems")

--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local RUNNING = true

local SLOT_COUNT = 3

local LOAD_GAP = 2
local STATE_CHECK = 0.5
local COLLECT_RETRY = 0.75
local CLAIM_RETRY = 0.75

-- You specifically wanted this:
local COLLECT_TO_CLAIM_DELAY = 3

--------------------------------------------------
-- SIMPLE LOG
--------------------------------------------------

local function log(...)
    print("[AUTO WASH]", ...)
end

--------------------------------------------------
-- GUID DETECTION
--------------------------------------------------

local function isGUID(value)
    if type(value) ~= "string" then
        return false
    end

    return value:match(
        "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
    ) ~= nil
end

local GUID_KEYS = {
    "UUID",
    "Uuid",
    "uuid",

    "GUID",
    "Guid",
    "guid",

    "ItemUUID",
    "ItemUuid",
    "itemUUID",
    "itemUuid",

    "ItemGUID",
    "ItemGuid",
    "itemGUID",
    "itemGuid",

    "UniqueId",
    "UniqueID",

    "Id",
    "ID",
    "id"
}

--------------------------------------------------
-- EXTRACT GUID
--------------------------------------------------

local function extractGUID(tbl, tableKey)

    if isGUID(tableKey) then
        return tableKey
    end

    if type(tbl) ~= "table" then
        if isGUID(tbl) then
            return tbl
        end

        return nil
    end

    for _, key in ipairs(GUID_KEYS) do

        local value = tbl[key]

        if isGUID(value) then
            return value
        end
    end

    return nil
end

--------------------------------------------------
-- GET WASHABLE ITEMS
--------------------------------------------------

local function getWashableGUIDs()

    local success, result = pcall(function()
        return GetWashableItems:InvokeServer()
    end)

    if not success then
        return {}
    end

    if type(result) ~= "table" then
        return {}
    end

    local found = {}
    local seen = {}

    local function add(guid)

        if not guid then
            return
        end

        if seen[guid] then
            return
        end

        seen[guid] = true

        table.insert(
            found,
            guid
        )
    end

    local function scan(tbl, depth)

        if type(tbl) ~= "table" then
            return
        end

        if depth > 7 then
            return
        end

        for key, value in pairs(tbl) do

            --------------------------------------------------
            -- GUID AS KEY
            --------------------------------------------------

            if isGUID(key) then
                add(key)
            end

            --------------------------------------------------
            -- TABLE ITEM
            --------------------------------------------------

            if type(value) == "table" then

                add(
                    extractGUID(
                        value,
                        key
                    )
                )

                scan(
                    value,
                    depth + 1
                )

            --------------------------------------------------
            -- GUID AS VALUE
            --------------------------------------------------

            elseif isGUID(value) then

                add(value)

            end
        end
    end

    scan(result, 0)

    return found
end

--------------------------------------------------
-- RESERVED ITEMS
--------------------------------------------------

local Reserved = {}

local function releaseGUID(guid)

    if guid then
        Reserved[guid] = nil
    end
end

local function getNextWashable()

    --------------------------------------------------
    -- ALWAYS GET FRESH LIST FROM SERVER
    --------------------------------------------------

    local guids = getWashableGUIDs()

    for _, guid in ipairs(guids) do

        if not Reserved[guid] then

            Reserved[guid] = true

            return guid
        end
    end

    return nil
end

--------------------------------------------------
-- GET SLOT STATE
--------------------------------------------------

local function getSlotState(slot)

    local success, result = pcall(function()
        return GetSlotState:InvokeServer(slot)
    end)

    if success then
        return result
    end

    return nil
end

--------------------------------------------------
-- RECURSIVE FIELD SEARCH
--------------------------------------------------

local function findField(tbl, names, depth)

    depth = depth or 0

    if type(tbl) ~= "table" then
        return nil
    end

    if depth > 8 then
        return nil
    end

    for key, value in pairs(tbl) do

        local lowerKey =
            string.lower(
                tostring(key)
            )

        for _, wanted in ipairs(names) do

            if lowerKey == wanted then
                return value
            end
        end

        if type(value) == "table" then

            local result =
                findField(
                    value,
                    names,
                    depth + 1
                )

            if result ~= nil then
                return result
            end
        end
    end

    return nil
end

--------------------------------------------------
-- SLOT HAS ITEM
--------------------------------------------------

local function slotHasItem(state)

    if type(state) ~= "table" then
        return false
    end

    --------------------------------------------------
    -- LOOK FOR GUID
    --------------------------------------------------

    local guid = findField(
        state,
        {
            "uuid",
            "guid",
            "itemuuid",
            "itemguid",
            "itemid"
        }
    )

    if guid ~= nil then
        return true
    end

    --------------------------------------------------
    -- LOOK FOR STATUS
    --------------------------------------------------

    local status = findField(
        state,
        {
            "status",
            "state",
            "washstate"
        }
    )

    if type(status) == "string" then

        local text =
            string.lower(status)

        if text:find("wash")
        or text:find("finish")
        or text:find("complete")
        or text:find("ready")
        or text:find("collect") then

            return true
        end
    end

    --------------------------------------------------
    -- TIMER DATA ALSO INDICATES OCCUPIED SLOT
    --------------------------------------------------

    local duration = findField(
        state,
        {
            "duration",
            "remaining",
            "remainingtime",
            "timeleft",
            "starttime",
            "finishtime",
            "endtime"
        }
    )

    if duration ~= nil then
        return true
    end

    return false
end

--------------------------------------------------
-- WASH FINISHED
--------------------------------------------------

local function washFinished(state)

    if type(state) ~= "table" then
        return false
    end

    --------------------------------------------------
    -- BOOLEAN
    --------------------------------------------------

    local completed = findField(
        state,
        {
            "finished",
            "complete",
            "completed",
            "done",
            "ready",

            "isfinished",
            "iscomplete",
            "iscompleted",
            "isdone",
            "isready"
        }
    )

    if completed == true then
        return true
    end

    --------------------------------------------------
    -- STATUS
    --------------------------------------------------

    local status = findField(
        state,
        {
            "status",
            "state",
            "washstate"
        }
    )

    if type(status) == "string" then

        local text =
            string.lower(status)

        if text:find("finish")
        or text:find("complete")
        or text == "done"
        or text == "ready"
        or text:find("collect") then

            return true
        end
    end

    --------------------------------------------------
    -- REMAINING TIME
    --------------------------------------------------

    local remaining = findField(
        state,
        {
            "remaining",
            "remainingtime",
            "timeremaining",
            "timeleft",
            "secondsremaining"
        }
    )

    if type(remaining) == "number"
        and remaining <= 0 then

        return true
    end

    --------------------------------------------------
    -- FINISH TIME
    --------------------------------------------------

    local finishTime = findField(
        state,
        {
            "finishtime",
            "endtime",
            "completiontime"
        }
    )

    if type(finishTime) == "number" then

        if finishTime > 1000000000 then

            if os.time() >= finishTime then
                return true
            end
        end
    end

    return false
end

--------------------------------------------------
-- START WASH
--------------------------------------------------

local function sendStartWash(slot, guid)

    local success, result = pcall(function()

        return StartWash:InvokeServer(
            slot,
            guid,
            "Inventory",
            nil
        )

    end)

    if not success then
        return false
    end

    if result == false then
        return false
    end

    return true
end

