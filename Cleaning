local ReplicatedStorage = game:GetService("ReplicatedStorage")

--------------------------------------------------
-- AUTO WASH - DURATION TEST
--
-- FLOW:
--
-- GetWashableItems
--      ↓
-- Find changing item GUID
--      ↓
-- StartWash(slot, guid, "Inventory", nil)
--      ↓
-- GetSlotState(slot)
--      ↓
-- Find Duration
--      ↓
-- Wait Duration + buffer
--      ↓
-- CollectWash(slot)
--      ↓
-- Wait 3 seconds
--      ↓
-- ClaimWashedItem(slot)
--      ↓
-- Refill same slot
--------------------------------------------------

local Wash = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Wash")

local StartWash =
    Wash:WaitForChild("StartWash")

local CollectWash =
    Wash:WaitForChild("CollectWash")

local ClaimWashedItem =
    Wash:WaitForChild("ClaimWashedItem")

local GetSlotState =
    Wash:WaitForChild("GetSlotState")

local GetWashableItems =
    Wash:WaitForChild("GetWashableItems")

--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local RUNNING = true

local SLOT_COUNT = 3

-- Give StartWash time to update server state.
local START_STATE_DELAY = 1

-- Added to Duration before CollectWash.
local FINISH_BUFFER = 0.75

-- Confirmed desired delay:
-- CollectWash -> 3 seconds -> ClaimWashedItem
local COLLECT_TO_CLAIM_DELAY = 3

-- Delay before reloading a slot.
local REFILL_DELAY = 1

-- Gap during initial 1 -> 2 -> 3 loading.
local INITIAL_LOAD_GAP = 1.5

--------------------------------------------------
-- SIMPLE LOG
--------------------------------------------------

local function log(...)
    print("[AUTO WASH]", ...)
end

--------------------------------------------------
-- GUID CHECK
--------------------------------------------------

local function isGUID(value)

    if type(value) ~= "string" then
        return false
    end

    return value:match(
        "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
    ) ~= nil
end

--------------------------------------------------
-- POSSIBLE GUID FIELDS
--------------------------------------------------

local GUID_KEYS = {

    "UUID",
    "Uuid",
    "uuid",

    "GUID",
    "Guid",
    "guid",

    "ItemUUID",
    "ItemUuid",
    "itemUUID",
    "itemUuid",

    "ItemGUID",
    "ItemGuid",
    "itemGUID",
    "itemGuid",

    "UniqueId",
    "UniqueID",

    "Id",
    "ID",
    "id"
}

--------------------------------------------------
-- EXTRACT GUID
--------------------------------------------------

local function extractGUID(tbl, tableKey)

    --------------------------------------------------
    -- GUID MAY BE TABLE KEY
    --------------------------------------------------

    if isGUID(tableKey) then
        return tableKey
    end

    --------------------------------------------------
    -- GUID MAY BE VALUE
    --------------------------------------------------

    if type(tbl) ~= "table" then

        if isGUID(tbl) then
            return tbl
        end

        return nil
    end

    --------------------------------------------------
    -- LOOK THROUGH COMMON FIELDS
    --------------------------------------------------

    for _, key in ipairs(GUID_KEYS) do

        local value = tbl[key]

        if isGUID(value) then
            return value
        end
    end

    return nil
end

--------------------------------------------------
-- GET ALL WASHABLE GUIDS
--------------------------------------------------

local function getWashableGUIDs()

    local success, result = pcall(function()

        return GetWashableItems:InvokeServer()

    end)

    if not success then
        return {}
    end

    if type(result) ~= "table" then
        return {}
    end

    local found = {}
    local seen = {}

    --------------------------------------------------
    -- ADD UNIQUE GUID
    --------------------------------------------------

    local function add(guid)

        if not guid then
            return
        end

        if seen[guid] then
            return
        end

        seen[guid] = true

        table.insert(
            found,
            guid
        )
    end

    --------------------------------------------------
    -- RECURSIVE SCAN
    --------------------------------------------------

    local function scan(tbl, depth)

        if type(tbl) ~= "table" then
            return
        end

        if depth > 7 then
            return
        end

        for key, value in pairs(tbl) do

            --------------------------------------------------
            -- GUID AS KEY
            --------------------------------------------------

            if isGUID(key) then
                add(key)
            end

            --------------------------------------------------
            -- NESTED ITEM TABLE
            --------------------------------------------------

            if type(value) == "table" then

                add(
                    extractGUID(
                        value,
                        key
                    )
                )

                scan(
                    value,
                    depth + 1
                )

            --------------------------------------------------
            -- GUID AS VALUE
            --------------------------------------------------

            elseif isGUID(value) then

                add(value)

            end
        end
    end

    scan(result, 0)

    return found
end

--------------------------------------------------
-- RESERVED ITEMS
--
-- Stops slots from selecting same item.
--------------------------------------------------

local Reserved = {}

local function releaseGUID(guid)

    if guid then
        Reserved[guid] = nil
    end
end

--------------------------------------------------
-- GET NEXT WASHABLE ITEM
--------------------------------------------------

local function getNextWashable()

    --------------------------------------------------
    -- FRESH SERVER LIST EVERY TIME
    --------------------------------------------------

    local guids =
        getWashableGUIDs()

    for _, guid in ipairs(guids) do

        if not Reserved[guid] then

            Reserved[guid] = true

            return guid
        end
    end

    return nil
end

--------------------------------------------------
-- GET SLOT STATE
--------------------------------------------------

local function getSlotState(slot)

    local success, result = pcall(function()

        return GetSlotState:InvokeServer(
            slot
        )

    end)

    if success then
        return result
    end

    return nil
end

--------------------------------------------------
-- FIND DURATION
--------------------------------------------------

local function findDuration(value, depth)

    depth = depth or 0

    if type(value) ~= "table" then
        return nil
    end

    if depth > 8 then
        return nil
    end

    for key, child in pairs(value) do

        --------------------------------------------------
        -- LOOK SPECIFICALLY FOR DURATION
        --------------------------------------------------

        if string.lower(
            tostring(key)
        ) == "duration" then

            --------------------------------------------------
            -- NUMBER
            --------------------------------------------------

            if type(child) == "number" then
                return child
            end

            --------------------------------------------------
            -- NUMBER STORED AS STRING
            --------------------------------------------------

            if type(child) == "string" then

                local number =
                    tonumber(child)

                if number then
                    return number
                end
            end
        end

        --------------------------------------------------
        -- RECURSIVE SEARCH
        --------------------------------------------------

        if type(child) == "table" then

            local found =
                findDuration(
                    child,
                    depth + 1
                )

            if found ~= nil then
                return found
            end
        end
    end

    return nil
end

--------------------------------------------------
-- START WASH
--------------------------------------------------

local function sendStartWash(slot, guid)

    local success, result = pcall(function()

        return StartWash:InvokeServer(
            slot,
            guid,
            "Inventory",
            nil
        )

    end)

    if not success then
        return false
    end

    if result == false then
        return false
    end

    return true
end

--------------------------------------------------
-- COLLECT WASH
--------------------------------------------------

local function sendCollect(slot)

    local success, result = pcall(function()

        return CollectWash:InvokeServer(
            slot
        )

    end)

    if not success then
        return false
    end

    if result == false then
        return false
    end

    return true
end

--------------------------------------------------
-- CLAIM WASHED ITEM
--------------------------------------------------

local function sendClaim(slot)

    local success, result = pcall(function()

        return ClaimWashedItem:InvokeServer(
            slot
        )

    end)

    if not success then
        return false
    end

    if result == false then
        return false
    end

    return true
end

--------------------------------------------------
-- SLOT DATA
--------------------------------------------------

local Slots = {}

for slot = 1, SLOT_COUNT do

    Slots[slot] = {

        GUID = nil,

        Busy = false,

        Duration = nil,

        Processing = false
    }
end

--------------------------------------------------
-- READ DURATION AFTER STARTING
--------------------------------------------------

local function getWashDuration(slot)

    --------------------------------------------------
    -- SERVER NEEDS TIME TO CREATE WASH STATE
    --------------------------------------------------

    task.wait(
        START_STATE_DELAY
    )

    --------------------------------------------------
    -- TRY SEVERAL TIMES
    --------------------------------------------------

    for attempt = 1, 10 do

        if not RUNNING then
            return nil
        end

        local state =
            getSlotState(slot)

        local duration =
            findDuration(state)

        if duration
            and duration >= 0 then

            return duration
        end

        task.wait(0.5)
    end

    return nil
end

--------------------------------------------------
-- LOAD ONE SLOT
--------------------------------------------------

local function loadSlot(slot)

    local info =
        Slots[slot]

    if info.Busy then
        return true
    end

    --------------------------------------------------
    -- KEEP TRYING UNTIL WE GET AN ITEM
    --------------------------------------------------

    while RUNNING and not info.Busy do

        --------------------------------------------------
        -- GET FRESH DIRTY ITEM
        --------------------------------------------------

        local guid =
            getNextWashable()

        if not guid then

            task.wait(1)

            continue
        end

        --------------------------------------------------
        -- START WASH
        --------------------------------------------------

        local started =
            sendStartWash(
                slot,
                guid
            )

        if not started then

            releaseGUID(guid)

            task.wait(1)

            continue
        end

        --------------------------------------------------
        -- SLOT NOW OWNS THIS ITEM
        --------------------------------------------------

        info.GUID = guid
        info.Busy = true

        --------------------------------------------------
        -- GET DURATION
        --------------------------------------------------

        local duration =
            getWashDuration(slot)

        info.Duration =
            duration

        if duration then

            log(
                "Slot",
                slot,
                "loaded - duration:",
                duration
            )

        else

            --------------------------------------------------
            -- DON'T THROW ITEM AWAY.
            --
            -- STARTWASH SUCCEEDED.
            -- PROCESSOR CAN RETRY DURATION.
            --------------------------------------------------

            log(
                "Slot",
                slot,
                "loaded - waiting for duration"
            )
        end

        return true
    end

    return false
end

--------------------------------------------------
-- WAIT FOR DURATION
--------------------------------------------------

local function waitForWash(slot)

    local info =
        Slots[slot]

    local duration =
        info.Duration

    --------------------------------------------------
    -- IF WE DIDN'T GET DURATION DURING LOAD,
    -- KEEP CHECKING GETSLOTSTATE.
    --------------------------------------------------

    while RUNNING and duration == nil do

        local state =
            getSlotState(slot)

        duration =
            findDuration(state)

        if duration ~= nil then

            info.Duration =
                duration

            break
        end

        task.wait(0.5)
    end

    if not RUNNING then
        return false
    end

    if duration == nil then
        return false
    end

    --------------------------------------------------
    -- SANITY CHECK
    --------------------------------------------------

    if duration < 0 then
        duration = 0
    end

    --------------------------------------------------
    -- WAIT FOR WASH TO COMPLETE
    --------------------------------------------------

    log(
        "Slot",
        slot,
        "washing"
    )

    task.wait(
        duration
        + FINISH_BUFFER
    )

    return true
end

--------------------------------------------------
-- COLLECT FINISHED WASH
--------------------------------------------------

local function collectFinishedWash(slot)

    --------------------------------------------------
    -- KEEP RETRYING UNTIL SERVER ACCEPTS
    --------------------------------------------------

    while RUNNING do

        local success =
            sendCollect(slot)

        if success then

            log(
                "Slot",
                slot,
                "collected"
            )

            return true
        end

        task.wait(0.75)
    end

    return false
end

--------------------------------------------------
-- CLAIM CLEAN ITEM
--------------------------------------------------

local function claimCleanItem(slot)

    --------------------------------------------------
    -- KEEP RETRYING UNTIL SERVER ACCEPTS
    --------------------------------------------------

    while RUNNING do

        local success =
            sendClaim(slot)

        if success then

            log(
                "Slot",
                slot,
                "claimed"
            )

            return true
        end

        task.wait(0.75)
    end

    return false
end

--------------------------------------------------
-- COMPLETE ONE SLOT
--------------------------------------------------

local function processSlot(slot)

    local info =
        Slots[slot]

    if info.Processing then
        return
    end

    info.Processing = true

    task.spawn(function()

        while RUNNING do

            --------------------------------------------------
            -- MAKE SURE SLOT HAS ITEM
            --------------------------------------------------

            if not info.Busy then

                loadSlot(slot)

                if not info.Busy then

                    task.wait(1)

                    continue
                end
            end

            --------------------------------------------------
            -- WAIT FOR WASH DURATION
            --------------------------------------------------

            local finished =
                waitForWash(slot)

            if not finished then

                task.wait(1)

                continue
            end

            --------------------------------------------------
            -- COLLECT WASHING STAGE
            --------------------------------------------------

            local collected =
                collectFinishedWash(slot)

            if not collected then
                break
            end

            --------------------------------------------------
            -- IMPORTANT:
            --
            -- CONFIRMED MANUAL TEST:
            --
            -- CollectWash
            --      ↓
            -- wait 3 seconds
            --      ↓
            -- ClaimWashedItem
            --------------------------------------------------

            log(
                "Slot",
                slot,
                "waiting 3 seconds before claim"
            )

            task.wait(
                COLLECT_TO_CLAIM_DELAY
            )

            --------------------------------------------------
            -- CLAIM CLEANED ITEM
            --------------------------------------------------

            local claimed =
                claimCleanItem(slot)

            if not claimed then
                break
            end

            --------------------------------------------------
            -- RELEASE OLD GUID
            --------------------------------------------------

            releaseGUID(
                info.GUID
            )

            --------------------------------------------------
            -- RESET SLOT
            --------------------------------------------------

            info.GUID = nil
            info.Duration = nil
            info.Busy = false

            --------------------------------------------------
            -- SERVER/INVENTORY UPDATE
            --------------------------------------------------

            task.wait(
                REFILL_DELAY
            )

            --------------------------------------------------
            -- REFILL SAME SLOT
            --------------------------------------------------

            loadSlot(slot)
        end

        info.Processing = false

    end)
end

--------------------------------------------------
-- INITIAL LOAD
--
-- FILL IN ORDER:
--
-- SLOT 1
-- SLOT 2
-- SLOT 3
--------------------------------------------------

log("AUTO WASH STARTED")

for slot = 1, SLOT_COUNT do

    loadSlot(slot)

    task.wait(
        INITIAL_LOAD_GAP
    )
end

--------------------------------------------------
-- START SLOT PROCESSORS
--------------------------------------------------

for slot = 1, SLOT_COUNT do

    processSlot(slot)

end

log("Slots 1, 2, and 3 active")
