local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Wash = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Wash")

local StartWash = Wash:WaitForChild("StartWash")
local CollectWash = Wash:WaitForChild("CollectWash")
local ClaimWashedItem = Wash:WaitForChild("ClaimWashedItem")
local GetSlotState = Wash:WaitForChild("GetSlotState")
local GetWashableItems = Wash:WaitForChild("GetWashableItems")

--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local CHECK_INTERVAL = 0.5
local running = true

--------------------------------------------------
-- LOG
--------------------------------------------------

local function log(...)
    print("[AUTO WASH]", ...)
end

--------------------------------------------------
-- UUID
--------------------------------------------------

local function getUUID(item, key)
    if type(item) ~= "table" then
        return nil
    end

    return item.UUID
        or item.Uuid
        or item.uuid
        or item.Id
        or item.ID
        or item.ItemUUID
        or item.ItemId
        or item.UniqueId
        or item.UniqueID
        or (type(key) == "string" and key or nil)
end

--------------------------------------------------
-- GET WASHABLE ITEMS
--------------------------------------------------

local function getWashableItems()
    local ok, result = pcall(function()
        return GetWashableItems:InvokeServer()
    end)

    if not ok then
        warn("[AUTO WASH] GetWashableItems failed:", result)
        return {}
    end

    if type(result) ~= "table" then
        return {}
    end

    local items = {}
    local seen = {}

    local function scan(tbl, depth)
        if depth > 6 then
            return
        end

        for key, value in pairs(tbl) do
            if type(value) == "table" then
                local uuid = getUUID(value, key)

                if uuid and not seen[uuid] then
                    seen[uuid] = true

                    table.insert(items, {
                        UUID = uuid,
                        Data = value
                    })
                end

                scan(value, depth + 1)
            end
        end
    end

    scan(result, 0)

    return items
end

--------------------------------------------------
-- SLOT STATE
--------------------------------------------------

local function getSlotState(slot)
    local ok, result = pcall(function()
        return GetSlotState:InvokeServer(slot)
    end)

    if ok then
        return result
    end

    return nil
end

--------------------------------------------------
-- SEARCH TABLE FOR VALUE
--------------------------------------------------

local function findValue(tbl, wantedKeys, depth)
    depth = depth or 0

    if depth > 6 or type(tbl) ~= "table" then
        return nil
    end

    for key, value in pairs(tbl) do
        local lowerKey = string.lower(tostring(key))

        for _, wanted in ipairs(wantedKeys) do
            if lowerKey == wanted then
                return value
            end
        end

        if type(value) == "table" then
            local found = findValue(value, wantedKeys, depth + 1)

            if found ~= nil then
                return found
            end
        end
    end

    return nil
end

--------------------------------------------------
-- DETECT FINISHED STATE
--------------------------------------------------

local function slotFinished(state)
    if type(state) ~= "table" then
        return false
    end

    --------------------------------------------------
    -- BOOLEAN COMPLETION VALUES
    --------------------------------------------------

    local completed = findValue(state, {
        "completed",
        "complete",
        "finished",
        "done",
        "ready",
        "iscompleted",
        "iscomplete",
        "isfinished",
        "isdone",
        "isready"
    })

    if completed == true then
        return true
    end

    --------------------------------------------------
    -- STATUS STRING
    --------------------------------------------------

    local status = findValue(state, {
        "status",
        "state",
        "washstate"
    })

    if type(status) == "string" then
        local s = string.lower(status)

        if s == "completed"
        or s == "complete"
        or s == "finished"
        or s == "done"
        or s == "ready"
        or s == "claim"
        or s == "collect"
        or s == "collectable"
        or s == "collectible" then
            return true
        end
    end

    --------------------------------------------------
    -- REMAINING TIME
    --------------------------------------------------

    local remaining = findValue(state, {
        "remaining",
        "remainingtime",
        "timeremaining",
        "timeleft"
    })

    if type(remaining) == "number" and remaining <= 0 then
        return true
    end

    --------------------------------------------------
    -- FINISH TIMESTAMP
    --------------------------------------------------

    local finishTime = findValue(state, {
        "finishtime",
        "endtime",
        "completiontime"
    })

    if type(finishTime) == "number" then
        local now = os.time()

        if finishTime <= now then
            return true
        end
    end

    return false
end

--------------------------------------------------
-- RESERVED ITEMS
--------------------------------------------------

local reserved = {}

local function getNextWashable()
    local items = getWashableItems()

    for _, item in ipairs(items) do
        local uuid = item.UUID

        if uuid and not reserved[uuid] then
            reserved[uuid] = true
            return uuid
        end
    end

    return nil
end

--------------------------------------------------
-- START WASH
--------------------------------------------------

local function startWash(slot, uuid)
    log("Slot", slot, "loading", uuid)

    local ok, result = pcall(function()
        return StartWash:InvokeServer(
            slot,
            uuid,
            "Inventory",
            nil
        )
    end)

    if not ok then
        warn(
            "[AUTO WASH] StartWash failed:",
            slot,
            result
        )

        return false
    end

    -- If the server explicitly returned false,
    -- don't count it as successfully started.
    if result == false then
        warn(
            "[AUTO WASH] Server rejected StartWash:",
            slot
        )

        return false
    end

    log("Slot", slot, "wash started")

    return true
end

--------------------------------------------------
-- COLLECT
--------------------------------------------------

local function collectWash(slot)
    local ok, result = pcall(function()
        return CollectWash:InvokeServer(slot)
    end)

    if not ok then
        return false
    end

    if result == false then
        return false
    end

    log("Slot", slot, "collected")

    return true
end

--------------------------------------------------
-- CLAIM WASHED ITEM
--------------------------------------------------

local function claimWashedItem(slot)
    local ok, result = pcall(function()
        return ClaimWashedItem:InvokeServer(slot)
    end)

    if not ok then
        return false
    end

    if result == false then
        return false
    end

    log("Slot", slot, "claimed washed item")

    return true
end

--------------------------------------------------
-- WAIT FOR WASH TO ACTUALLY FINISH
--------------------------------------------------

local function waitForFinished(slot)
    log("Slot", slot, "waiting for wash to finish...")

    while running do
        local state = getSlotState(slot)

        if slotFinished(state) then
            log("Slot", slot, "wash finished")
            return true
        end

        task.wait(CHECK_INTERVAL)
    end

    return false
end

--------------------------------------------------
-- PROCESS ONE SLOT
--------------------------------------------------

local function runSlot(slot)
    task.spawn(function()
        log("Slot", slot, "worker started")

        while running do

            --------------------------------------------------
            -- 1. FIND DIRTY/WASHABLE ITEM
            --------------------------------------------------

            local uuid = getNextWashable()

            if not uuid then
                task.wait(1)
                continue
            end

            --------------------------------------------------
            -- 2. START WASH
            --------------------------------------------------

            local started = startWash(slot, uuid)

            if not started then
                reserved[uuid] = nil
                task.wait(1)
                continue
            end

            --------------------------------------------------
            -- 3. WAIT UNTIL WASH FINISHES
            --------------------------------------------------

            local finished = waitForFinished(slot)

            if not finished then
                reserved[uuid] = nil
                continue
            end

            --------------------------------------------------
            -- 4. COLLECT WASH
            --------------------------------------------------

            local collected = false

            while running and not collected do
                collected = collectWash(slot)

                if not collected then
                    task.wait(0.5)
                end
            end

            if not running then
                break
            end

            --------------------------------------------------
            -- ALLOW SERVER TO MOVE INTO CLAIM STATE
            --------------------------------------------------

            task.wait(0.35)

            --------------------------------------------------
            -- 5. CLAIM WASHED ITEM
            --------------------------------------------------

            local claimed = false

            while running and not claimed do
                claimed = claimWashedItem(slot)

                if not claimed then
                    task.wait(0.5)
                end
            end

            --------------------------------------------------
            -- 6. RELEASE UUID
            --------------------------------------------------

            reserved[uuid] = nil

            if claimed then
                log(
                    "Slot",
                    slot,
                    "cycle complete"
                )
            end

            --------------------------------------------------
            -- 7. GET NEXT DIRTY ITEM
            --------------------------------------------------

            task.wait(0.35)
        end
    end)
end

--------------------------------------------------
-- START SLOTS 1, 2, 3
--------------------------------------------------

log("==============================")
log("AUTO WASH STARTED")
log("==============================")

runSlot(1)
runSlot(2)
runSlot(3)

log("Slots 1, 2, and 3 are active.")
