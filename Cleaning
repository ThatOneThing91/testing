--------------------------------------------------
-- WAIT UNTIL FINISHED
--------------------------------------------------

local function waitUntilFinished(slot)
    log(
        "Slot",
        slot,
        "waiting for wash to finish"
    )

    while running do

        local state =
            getSlotState(slot)

        if washFinished(state) then

            log(
                "Slot",
                slot,
                "wash FINISHED"
            )

            return true
        end

        task.wait(CHECK_INTERVAL)
    end

    return false
end

--------------------------------------------------
-- COMPLETE SLOT CYCLE
--------------------------------------------------

local function processLoadedSlot(slot, guid)

    --------------------------------------------------
    -- WAIT
    --------------------------------------------------

    if not waitUntilFinished(slot) then
        return
    end

    --------------------------------------------------
    -- COLLECT
    --------------------------------------------------

    local collected = false

    while running and not collected do

        collected =
            collectWash(slot)

        if not collected then
            task.wait(0.5)
        end
    end

    if not running then
        return
    end

    --------------------------------------------------
    -- SERVER TRANSITION
    --------------------------------------------------

    task.wait(CLAIM_DELAY)

    --------------------------------------------------
    -- CLAIM
    --------------------------------------------------

    local claimed = false

    while running and not claimed do

        claimed =
            claimWashedItem(slot)

        if not claimed then
            task.wait(0.5)
        end
    end

    if claimed then

        log(
            "Slot",
            slot,
            "FULL CYCLE COMPLETE"
        )

    end

    reserved[guid] = nil
end

--------------------------------------------------
-- SLOT WORKER
--------------------------------------------------

local function slotWorker(slot, firstGUID)

    task.spawn(function()

        local guid = firstGUID

        while running do

            --------------------------------------------------
            -- PROCESS CURRENT ITEM
            --------------------------------------------------

            if guid then

                processLoadedSlot(
                    slot,
                    guid
                )

                guid = nil
            end

            if not running then
                break
            end

            --------------------------------------------------
            -- GET NEW WASHABLE ITEM
            --------------------------------------------------

            guid =
                getNextWashable()

            if not guid then

                log(
                    "Slot",
                    slot,
                    "waiting for dirty item"
                )

                task.wait(1)
                continue
            end

            --------------------------------------------------
            -- START NEXT ITEM
            --------------------------------------------------

            local started =
                startWash(
                    slot,
                    guid
                )

            if not started then

                reserved[guid] = nil
                guid = nil

                task.wait(1)
            end
        end
    end)
end

--------------------------------------------------
-- INITIAL LOAD
--
-- IMPORTANT:
-- Slots are loaded ONE AT A TIME.
--------------------------------------------------

local initialGUIDs = {}

local function initialLoad()

    log("==============================")
    log("INITIAL WASHER LOAD")
    log("==============================")

    for slot = 1, 3 do

        if not running then
            return
        end

        --------------------------------------------------
        -- REFRESH GETWASHABLEITEMS
        -- BEFORE EVERY SLOT
        --------------------------------------------------

        local guid =
            getNextWashable()

        if not guid then

            log(
                "No dirty item available for slot",
                slot
            )

            initialGUIDs[slot] = nil

        else

            --------------------------------------------------
            -- START THIS SLOT
            --------------------------------------------------

            local started =
                startWash(
                    slot,
                    guid
                )

            if started then

                initialGUIDs[slot] =
                    guid

                log(
                    "Slot",
                    slot,
                    "LOADED:",
                    guid
                )

            else

                reserved[guid] = nil

                initialGUIDs[slot] =
                    nil
            end
        end

        --------------------------------------------------
        -- GIVE SERVER EXTRA TIME TO REMOVE ITEM
        -- FROM GETWASHABLEITEMS BEFORE NEXT SLOT
        --------------------------------------------------

        task.wait(1)
    end
end

--------------------------------------------------
-- START
--------------------------------------------------

log("================================")
log("AUTO WASH TEST STARTING")
log("Slots: 1, 2, 3")
log("================================")

--------------------------------------------------
-- LOAD 1 -> 2 -> 3
--------------------------------------------------

initialLoad()

--------------------------------------------------
-- NOW START INDEPENDENT WORKERS
--------------------------------------------------

for slot = 1, 3 do

    slotWorker(
        slot,
        initialGUIDs[slot]
    )

end

log("================================")
log("ALL SLOT WORKERS RUNNING")
log("================================")
