end

--------------------------------------------------
-- SLOT WORKER
--------------------------------------------------

local function runSlot(slot)
    task.spawn(function()

        log(
            "Slot",
            slot,
            "worker running"
        )

        while running do
            --------------------------------------------------
            -- STEP 1
            -- FIND A DIRTY/WASHABLE ITEM
            --------------------------------------------------

            local guid = getNextWashableGUID()

            if not guid then
                log(
                    "Slot",
                    slot,
                    "no washable item available"
                )

                task.wait(1)
                continue
            end

            --------------------------------------------------
            -- STEP 2
            -- LOAD IT INTO THIS WASH SLOT
            --------------------------------------------------

            local started =
                startWash(slot, guid)

            if not started then
                reserved[guid] = nil

                task.wait(1)
                continue
            end

            --------------------------------------------------
            -- STEP 3
            -- WAIT FOR THAT WASH TO FINISH
            --------------------------------------------------

            local finished =
                waitForWash(slot)

            if not finished then
                reserved[guid] = nil
                continue
            end

            --------------------------------------------------
            -- STEP 4
            -- COLLECT WASH
            --------------------------------------------------

            local collected = false

            while running and not collected do
                collected =
                    collectWash(slot)

                if not collected then
                    task.wait(0.5)
                end
            end

            if not running then
                break
            end

            --------------------------------------------------
            -- WAIT FOR SERVER TRANSITION
            --------------------------------------------------

            task.wait(0.5)

            --------------------------------------------------
            -- STEP 5
            -- CLAIM WASHED ITEM
            --------------------------------------------------

            local claimed = false

            while running and not claimed do
                claimed =
                    claimWashedItem(slot)

                if not claimed then
                    task.wait(0.5)
                end
            end

            --------------------------------------------------
            -- STEP 6
            -- ITEM IS DONE
            --------------------------------------------------

            if claimed then
                log(
                    "Slot",
                    slot,
                    "FULL CYCLE COMPLETE"
                )
            end

            reserved[guid] = nil

            --------------------------------------------------
            -- STEP 7
            -- LOOP BACK TO GETWASHABLEITEMS
            --------------------------------------------------

            task.wait(0.5)
        end
    end)
end

