--------------------------------------------------
-- SLOT DATA
--------------------------------------------------

local Slots = {}

for slot = 1, SLOT_COUNT do

    Slots[slot] = {
        GUID = nil,
        Busy = false,
        Processing = false
    }
end

--------------------------------------------------
-- LOAD SLOT
--------------------------------------------------

local function loadSlot(slot)

    local info = Slots[slot]

    if info.Busy then
        return true
    end

    --------------------------------------------------
    -- KEEP TRYING THIS SLOT
    --------------------------------------------------

    while RUNNING and not info.Busy do

        --------------------------------------------------
        -- GET FRESH DIRTY ITEM
        --------------------------------------------------

        local guid =
            getNextWashable()

        if not guid then

            task.wait(1)

            continue
        end

        --------------------------------------------------
        -- START
        --------------------------------------------------

        local started =
            sendStartWash(
                slot,
                guid
            )

        if not started then

            releaseGUID(guid)

            task.wait(1)

            continue
        end

        --------------------------------------------------
        -- WAIT FOR SERVER UPDATE
        --------------------------------------------------

        task.wait(1)

        --------------------------------------------------
        -- CHECK SLOT
        --------------------------------------------------

        local state =
            getSlotState(slot)

        --------------------------------------------------
        -- IF STATE CONFIRMS ITEM, GREAT.
        --
        -- IF THE GAME'S STATE FORMAT IS WEIRD,
        -- STILL KEEP THIS GUID OWNED BY THIS SLOT
        -- AFTER SUCCESSFUL STARTWASH.
        --------------------------------------------------

        info.GUID = guid
        info.Busy = true

        log(
            "Slot",
            slot,
            "loaded"
        )

        return true
    end

    return false
end

--------------------------------------------------
-- WAIT FOR FINISH
--------------------------------------------------

local function waitForFinish(slot)

    while RUNNING do

        local state =
            getSlotState(slot)

        if washFinished(state) then

            return true
        end

        task.wait(STATE_CHECK)
    end

    return false
end

--------------------------------------------------
-- COLLECT SLOT
--------------------------------------------------

local function collectSlot(slot)

    while RUNNING do

        local success =
            sendCollect(slot)

        if success then

            log(
                "Slot",
                slot,
                "collected"
            )

            return true
        end

        task.wait(COLLECT_RETRY)
    end

    return false
end

--------------------------------------------------
-- CLAIM SLOT
--------------------------------------------------

local function claimSlot(slot)

    while RUNNING do

        local success =
            sendClaim(slot)

        if success then

            log(
                "Slot",
                slot,
                "claimed"
            )

            return true
        end

        task.wait(CLAIM_RETRY)
    end

    return false
end

--------------------------------------------------
-- PROCESS SLOT
--------------------------------------------------

local function processSlot(slot)

    local info = Slots[slot]

    if info.Processing then
        return
    end

    info.Processing = true

    task.spawn(function()

        while RUNNING do

            --------------------------------------------------
            -- MAKE SURE SLOT IS LOADED
            --------------------------------------------------

            if not info.Busy then

                loadSlot(slot)

                if not info.Busy then
                    task.wait(1)
                    continue
                end
            end

            --------------------------------------------------
            -- WAIT FOR WASH
            --------------------------------------------------

            log(
                "Slot",
                slot,
                "washing"
            )

            local finished =
                waitForFinish(slot)

            if not finished then
                break
            end

            --------------------------------------------------
            -- COLLECT
            --------------------------------------------------

            local collected =
                collectSlot(slot)

            if not collected then
                break
            end

            --------------------------------------------------
            -- EXACT DELAY REQUESTED
            --------------------------------------------------

            log(
                "Slot",
                slot,
                "waiting 3 seconds"
            )

            task.wait(
                COLLECT_TO_CLAIM_DELAY
            )

            --------------------------------------------------
            -- CLAIM COMES LAST
            --------------------------------------------------

            local claimed =
                claimSlot(slot)

            if not claimed then
                break
            end

            --------------------------------------------------
            -- RELEASE OLD ITEM
            --------------------------------------------------

            releaseGUID(
                info.GUID
            )

            info.GUID = nil
            info.Busy = false

            --------------------------------------------------
            -- LET SERVER/INVENTORY UPDATE
            --------------------------------------------------

            task.wait(1)

            --------------------------------------------------
            -- REFILL THIS SAME SLOT
            --------------------------------------------------

            loadSlot(slot)
        end

        info.Processing = false

    end)
end

--------------------------------------------------
-- INITIAL LOAD
--
-- IMPORTANT:
-- COMPLETELY LOAD 1, THEN 2, THEN 3.
--------------------------------------------------

log("AUTO WASH STARTED")

for slot = 1, SLOT_COUNT do

    --------------------------------------------------
    -- DON'T MOVE TO NEXT SLOT UNTIL THIS
    -- STARTWASH CALL HAS BEEN PROCESSED.
    --------------------------------------------------

    loadSlot(slot)

    task.wait(LOAD_GAP)
end

--------------------------------------------------
-- START EACH SLOT PROCESSOR
--------------------------------------------------

for slot = 1, SLOT_COUNT do

    processSlot(slot)

end

log("Slots 1, 2, and 3 running")
