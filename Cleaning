local ReplicatedStorage = game:GetService("ReplicatedStorage")

--------------------------------------------------
-- REMOTES
--------------------------------------------------

local Wash = ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Wash")

local StartWash = Wash:WaitForChild("StartWash")
local CollectWash = Wash:WaitForChild("CollectWash")
local ClaimWashedItem = Wash:WaitForChild("ClaimWashedItem")
local GetSlotState = Wash:WaitForChild("GetSlotState")
local GetWashableItems = Wash:WaitForChild("GetWashableItems")

--------------------------------------------------
-- SETTINGS
--------------------------------------------------

local running = true

local SLOT_COUNT = 3
local CHECK_INTERVAL = 0.5

-- Delay between loading washers.
local LOAD_DELAY = 1.25

-- IMPORTANT:
-- Collect first, then wait this long before claim.
local COLLECT_TO_CLAIM_DELAY = 3

--------------------------------------------------
-- SIMPLE LOGGING
--------------------------------------------------

local function log(...)
    print("[AUTO WASH]", ...)
end

--------------------------------------------------
-- GUID DETECTION
--------------------------------------------------

local function isGUID(value)
    if type(value) ~= "string" then
        return false
    end

    return value:match(
        "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
    ) ~= nil
end

local GUID_KEYS = {
    "UUID",
    "Uuid",
    "uuid",

    "GUID",
    "Guid",
    "guid",

    "ItemUUID",
    "ItemUuid",
    "itemUUID",
    "itemUuid",

    "ItemGUID",
    "ItemGuid",
    "itemGUID",
    "itemGuid",

    "UniqueId",
    "UniqueID",

    "Id",
    "ID",
    "id"
}

--------------------------------------------------
-- GET GUID FROM TABLE
--------------------------------------------------

local function getGUID(tbl, tableKey)
    if isGUID(tableKey) then
        return tableKey
    end

    if type(tbl) ~= "table" then
        if isGUID(tbl) then
            return tbl
        end

        return nil
    end

    for _, key in ipairs(GUID_KEYS) do
        local value = tbl[key]

        if isGUID(value) then
            return value
        end
    end

    return nil
end

--------------------------------------------------
-- GET WASHABLE ITEMS
--------------------------------------------------

local function getWashableGUIDs()
    local ok, result = pcall(function()
        return GetWashableItems:InvokeServer()
    end)

    if not ok or type(result) ~= "table" then
        return {}
    end

    local found = {}
    local seen = {}

    local function add(guid)
        if guid and not seen[guid] then
            seen[guid] = true
            table.insert(found, guid)
        end
    end

    local function scan(tbl, depth)
        if type(tbl) ~= "table" or depth > 7 then
            return
        end

        for key, value in pairs(tbl) do
            if isGUID(key) then
                add(key)
            end

            if type(value) == "table" then
                add(getGUID(value, key))
                scan(value, depth + 1)

            elseif isGUID(value) then
                add(value)
            end
        end
    end

    scan(result, 0)

    return found
end

--------------------------------------------------
-- RESERVED ITEMS
--------------------------------------------------

local reserved = {}

local function getNextWashable()
    local items = getWashableGUIDs()

    for _, guid in ipairs(items) do
        if not reserved[guid] then
            reserved[guid] = true
            return guid
        end
    end

    return nil
end

--------------------------------------------------
-- SLOT STATE
--------------------------------------------------

local function getSlotState(slot)
    local ok, result = pcall(function()
        return GetSlotState:InvokeServer(slot)
    end)

    if ok then
        return result
    end

    return nil
end

--------------------------------------------------
-- RECURSIVE FIELD FINDER
--------------------------------------------------

local function findField(tbl, names, depth)
    depth = depth or 0

    if type(tbl) ~= "table" or depth > 7 then
        return nil
    end

    for key, value in pairs(tbl) do
        local name = string.lower(tostring(key))

        for _, wanted in ipairs(names) do
            if name == wanted then
                return value
            end
        end

        if type(value) == "table" then
            local found = findField(
                value,
                names,
                depth + 1
            )

            if found ~= nil then
                return found
            end
        end
    end

    return nil
end

--------------------------------------------------
-- WASH FINISHED DETECTION
--------------------------------------------------

local function washFinished(state)
    if type(state) ~= "table" then
        return false
    end

    --------------------------------------------------
    -- BOOLEAN FLAGS
    --------------------------------------------------

    local finished = findField(state, {
        "finished",
        "complete",
        "completed",
        "done",
        "ready",

        "isfinished",
        "iscomplete",
        "iscompleted",
        "isdone",
        "isready"
    })

    if finished == true then
        return true
    end

    --------------------------------------------------
    -- STATUS
    --------------------------------------------------

    local status = findField(state, {
        "status",
        "state",
        "washstate"
    })

    if type(status) == "string" then
        status = string.lower(status)

        if status:find("finished")
        or status:find("complete")
        or status == "done"
        or status == "ready"
        or status:find("collect") then
            return true
        end
    end

    --------------------------------------------------
    -- TIME LEFT
    --------------------------------------------------

    local remaining = findField(state, {
        "remaining",
        "remainingtime",
        "timeremaining",
        "timeleft",
        "secondsremaining"
    })

    if type(remaining) == "number"
        and remaining <= 0 then

        return true
    end

    --------------------------------------------------
    -- FINISH TIME
    --------------------------------------------------

    local finishTime = findField(state, {
        "finishtime",
        "endtime",
        "completiontime"
    })

    if type(finishTime) == "number"
        and finishTime > 1000000000
        and os.time() >= finishTime then

        return true
    end

    return false
end

--------------------------------------------------
-- START WASH
--------------------------------------------------

local function startWash(slot, guid)
    local ok, result = pcall(function()
        return StartWash:InvokeServer(
            slot,
            guid,
            "Inventory",
            nil
        )
    end)

    if not ok or result == false then
        return false
    end

    return true
end

--------------------------------------------------
-- COLLECT
--------------------------------------------------

local function collectWash(slot)
    local ok, result = pcall(function()
        return CollectWash:InvokeServer(slot)
    end)

    if not ok or result == false then
        return false
    end

    return true
end

--------------------------------------------------
-- CLAIM
--------------------------------------------------

local function claimWashedItem(slot)
    local ok, result = pcall(function()
        return ClaimWashedItem:InvokeServer(slot)
    end)

    if not ok or result == false then
        return false
    end

    return true
end

--------------------------------------------------
-- SLOT INFORMATION
--------------------------------------------------

local Slots = {
    [1] = {
        Guid = nil,
        Busy = false
    },

    [2] = {
        Guid = nil,
        Busy = false
    },

    [3] = {
        Guid = nil,
        Busy = false
    }
}

--------------------------------------------------
-- LOAD ONE SLOT
--------------------------------------------------

local function loadSlot(slot)
    local info = Slots[slot]

    if info.Busy then
        return false
    end

    --------------------------------------------------
    -- ALWAYS REFRESH GETWASHABLEITEMS
    --------------------------------------------------

    local guid = getNextWashable()

    if not guid then
        return false
    end

    --------------------------------------------------
    -- START WASH
    --------------------------------------------------

    local started = startWash(
        slot,
        guid
    )

    if not started then
        reserved[guid] = nil

        return false
    end

    info.Guid = guid
    info.Busy = true

    log(
        "Slot",
        slot,
        "loaded"
    )

    return true
end

--------------------------------------------------
-- FINISH ONE SLOT
--------------------------------------------------

local function finishSlot(slot)
    local info = Slots[slot]

    if not info.Busy then
        return
    end

    --------------------------------------------------
    -- WAIT UNTIL WASH IS FINISHED
    --------------------------------------------------

    while running and info.Busy do
        local state = getSlotState(slot)

        if washFinished(state) then
            break
        end

        task.wait(CHECK_INTERVAL)
    end

    if not running then
        return
    end

    --------------------------------------------------
    -- COLLECT WASH
    --------------------------------------------------

    local collected = false

    while running and not collected do
        collected = collectWash(slot)

        if not collected then
            task.wait(0.5)
        end
    end

    if not running then
        return
    end

    log(
        "Slot",
        slot,
        "collected"
    )

    --------------------------------------------------
    -- IMPORTANT:
    -- WAIT 3 SECONDS AFTER COLLECT
    --------------------------------------------------

    task.wait(COLLECT_TO_CLAIM_DELAY)

    --------------------------------------------------
    -- CLAIM WASHED ITEM
    --------------------------------------------------

    local claimed = false

    while running and not claimed do
        claimed = claimWashedItem(slot)

        if not claimed then
            task.wait(0.5)
        end
    end

    if not running then
        return
    end

    log(
        "Slot",
        slot,
        "claimed"
    )

    --------------------------------------------------
    -- CLEAR SLOT
    --------------------------------------------------

    if info.Guid then
        reserved[info.Guid] = nil
    end

    info.Guid = nil
    info.Busy = false

    --------------------------------------------------
    -- GIVE SERVER A MOMENT
    --------------------------------------------------

    task.wait(0.75)
end

--------------------------------------------------
-- SLOT PROCESSOR
--------------------------------------------------

local function startSlotProcessor(slot)
    task.spawn(function()

        while running do

            --------------------------------------------------
            -- SLOT EMPTY
            --------------------------------------------------

            if not Slots[slot].Busy then

                local loaded =
                    loadSlot(slot)

                if loaded then

                    --------------------------------------------------
                    -- THIS SLOT NOW OWNS ITS ITEM
                    --------------------------------------------------

                    finishSlot(slot)

                else
                    task.wait(1)
                end
            end

            task.wait(0.25)
        end

    end)
end

--------------------------------------------------
-- INITIAL LOAD
--
-- DELIBERATELY LOAD:
-- 1 -> 2 -> 3
--------------------------------------------------

log("AUTO WASH STARTED")

for slot = 1, SLOT_COUNT do

    local loaded = false
    local attempts = 0

    --------------------------------------------------
    -- DON'T JUST FORGET A SLOT.
    -- TRY IT SEVERAL TIMES BEFORE MOVING ON.
    --------------------------------------------------

    while running
        and not loaded
        and attempts < 5 do

        attempts += 1

        loaded =
            loadSlot(slot)

        if not loaded then
            task.wait(1)
        end
    end

    --------------------------------------------------
    -- SERVER GETS TIME TO UPDATE INVENTORY
    --------------------------------------------------

    task.wait(LOAD_DELAY)
end

--------------------------------------------------
-- START PROCESSORS
--------------------------------------------------

for slot = 1, SLOT_COUNT do
    startSlotProcessor(slot)
end

log("Slots 1, 2, and 3 active")
