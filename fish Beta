local function getReelGui()
    local fishingGui =
        playerGui:FindFirstChild(
            "FishingReelGui"
        )

    if not fishingGui then
        return nil
    end

    local minigame =
        fishingGui:FindFirstChild(
            "ReelMinigame"
        )

    if not minigame then
        return nil
    end

    local catchBar =
        minigame:FindFirstChild(
            "CatchBar"
        )

    if not catchBar then
        return nil
    end

    local fish =
        catchBar:FindFirstChild("Fish")

    local zone =
        catchBar:FindFirstChild("Zone")

    if not fish or not zone then
        return nil
    end

    if not fish:IsA("GuiObject")
        or not zone:IsA("GuiObject") then
        return nil
    end

    if not minigame.Visible
        or not catchBar.Visible
        or not fish.Visible
        or not zone.Visible then
        return nil
    end

    return catchBar, fish, zone
end

--------------------------------------------------
-- TRACKING RESET
--------------------------------------------------

local function resetReelTracking()
    releaseMouse()

    nextReelAction = 0
    reelHoldNext = true
    lastInputChange = 0

    previousFishX = nil
    previousZoneX = nil
    previousSampleTime = nil

    fishVelocity = 0
    zoneVelocity = 0

    lastGuiSeen = 0
    lastGuiObjects = nil
end

--------------------------------------------------
-- V17 CHASE / FOLLOW CONTROLLER
--------------------------------------------------

local function updateReeling()
    if phase ~= "reeling" then
        releaseMouse()
        return
    end

    local now = os.clock()

    if now < nextReelAction then
        return
    end

    if trackingEnabled then
        local catchBar, fish, zone =
            getReelGui()

        if catchBar and fish and zone then
            lastGuiSeen = now

            -- Reset measurements if the GUI
            -- was rebuilt between catches.
            if lastGuiObjects
                and (
                    lastGuiObjects.fish ~= fish
                    or lastGuiObjects.zone ~= zone
                ) then

                previousFishX = nil
                previousZoneX = nil
                previousSampleTime = nil

                fishVelocity = 0
                zoneVelocity = 0
            end

            lastGuiObjects = {
                fish = fish,
                zone = zone
            }

            local trackX =
                catchBar.AbsolutePosition.X

            local width = math.max(
                catchBar.AbsoluteSize.X,
                1
            )

            local fishX = (
                fish.AbsolutePosition.X
                + fish.AbsoluteSize.X * 0.5
                - trackX
            ) / width

            local zoneX = (
                zone.AbsolutePosition.X
                + zone.AbsoluteSize.X * 0.5
                - trackX
            ) / width

            local dt =
                previousSampleTime
                and now - previousSampleTime
                or TRACK_INTERVAL

            if dt >= 0.012 then
                if previousFishX then
                    local velocity =
                        math.clamp(
                            (
                                fishX
                                - previousFishX
                            ) / dt,
                            -3,
                            3
                        )

                    fishVelocity =
                        fishVelocity * 0.6
                        + velocity * 0.4
                end

                if previousZoneX then
                    local velocity =
                        math.clamp(
                            (
                                zoneX
                                - previousZoneX
                            ) / dt,
                            -3,
                            3
                        )

                    zoneVelocity =
                        zoneVelocity * 0.6
                        + velocity * 0.4
                end

                previousFishX = fishX
                previousZoneX = zoneX
                previousSampleTime = now
            end

            local zoneHalf = (
                zone.AbsoluteSize.X * 0.5
            ) / width

            local fishHalf = (
                fish.AbsoluteSize.X * 0.5
            ) / width

            local containmentHalf =
                math.max(
                    0,
                    zoneHalf - fishHalf
                )

            local rawError =
                fishX - zoneX

            local inside =
                math.abs(rawError)
                <= containmentHalf

            local desiredHold
            local mode

            if not inside then
                --------------------------------
                -- CHASE MODE
                --------------------------------

                mode = "CHASE"

                -- Outside zone:
                -- aggressively move toward fish.
                -- Don't allow short-term zone
                -- momentum to override direction.

                if rawError > CHASE_MARGIN then
                    desiredHold = true

                elseif rawError < -CHASE_MARGIN then
                    desiredHold = false

                else
                    desiredHold = mouseHeld
                end

            else
                --------------------------------
                -- FOLLOW MODE
                --------------------------------

                mode = "FOLLOW"

                local predictedFish =
                    math.clamp(
                        fishX
                        + fishVelocity
                        * TRACK_LOOKAHEAD,
                        0,
                        1
                    )

                local predictedZone =
                    math.clamp(
                        zoneX
                        + zoneVelocity
                        * TRACK_LOOKAHEAD,
                        0,
                        1
                    )

                local error =
                    predictedFish
                    - predictedZone

                if error > FOLLOW_DEADZONE then
                    desiredHold = true

                elseif error < -FOLLOW_DEADZONE then
                    desiredHold = false

                else
                    if zoneVelocity > 0.035 then
                        desiredHold = false

                    elseif zoneVelocity < -0.035 then
                        desiredHold = true

                    else
                        desiredHold = mouseHeld
                    end
                end
            end

            if now - lastInputChange
                >= TRACK_MIN_SWITCH then

                if desiredHold
                    and not mouseHeld then

                    if holdMouse() then
                        lastInputChange = now
                    end

                elseif not desiredHold
                    and mouseHeld then

                    releaseMouse()
                    lastInputChange = now
                end
            end

            reelLabel.Text = string.format(
                "%s | %s",
                mode,
                mouseHeld
                    and "HOLD"
                    or "RELEASE"
            )

            trackingLabel.Text =
                string.format(
                    "Fish %.3f | Zone %.3f | Gap %+.3f",
                    fishX,
                    zoneX,
                    rawError
                )

            nextReelAction =
                now + TRACK_INTERVAL

            return
        end

        ------------------------------------
        -- GUI REACQUISITION
        ------------------------------------

        trackingLabel.Text =
            "Tracking: Searching for Fish / Zone"

        -- Don't start a long hold/release cycle
        -- while real GUI tracking is enabled.
        releaseMouse()

        nextReelAction =
            now + TRACK_INTERVAL

        return
    end

    ----------------------------------------
    -- MANUAL TIMED FALLBACK MODE ONLY
    ----------------------------------------

    trackingLabel.Text =
        "Tracking: Timed mode"

    if reelHoldNext then
        holdMouse()

        reelLabel.Text =
            "Reel: Hold 1.5s"

        nextReelAction =
            now + FALLBACK_HOLD
    else
        releaseMouse()

        reelLabel.Text =
            "Reel: Release 0.5s"

        nextReelAction =
            now + FALLBACK_RELEASE
    end

    reelHoldNext = not reelHoldNext
end

--------------------------------------------------
-- SESSION CONTROL
--------------------------------------------------

local function cancelCast()
    pcall(function()
        FishingCancel:FireServer()
    end)
end

local function stopFishing(message, cancel)
    running = false
    generation += 1

    resetReelTracking()

    if cancel then
        cancelCast()
    end

    activeCastId = nil

    setPhase("idle")
    updateToggle()

    if message then
        status(message)
    end
end

--------------------------------------------------
-- FISHING EVENTS
--------------------------------------------------

table.insert(
    connections,
    FishingState.OnClientEvent:Connect(
        function(state, data)
            if destroyed or not running then
                return
            end

            data =
                type(data) == "table"
                and data
                or {}

            if state == "cast" then
                if phase ~= "casting" then
                    return
                end

                activeCastId = data.castId

                setPhase("waiting")
                status("Waiting for bite")

            elseif state == "reel" then
                if phase ~= "waiting" then
                    return
                end

                if activeCastId ~= nil
                    and data.castId ~= nil
                    and activeCastId
                        ~= data.castId then
                    return
                end

                resetReelTracking()

                setPhase("reeling")
                status("Reeling...")

            elseif state == "done" then
                if phase ~= "casting"
                    and phase ~= "waiting"
                    and phase ~= "reeling" then
                    return
                end

                if activeCastId ~= nil
                    and data.castId ~= nil
                    and activeCastId
                        ~= data.castId then
                    return
                end

                resetReelTracking()

                if data.reason == "caught" then
                    catches += 1

                    status(
                        "Caught: "
                        .. tostring(
                            data.itemName
                            or "Unknown"
                        )
                    )
                else
                    failures += 1

                    status(
                        "Fishing ended: "
                        .. tostring(
                            data.reason
                            or "Unknown"
                        )
                    )
                end

                updateStats()
                activeCastId = nil

                setPhase("finishing")
            end
        end
    )
)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

task.spawn(function()
    while not destroyed do
        if not running then
            task.wait(0.15)
            continue
        end

        if phase == "idle" then
            local token = generation

            setPhase("equipping")

            local ok, err =
                ensureRod(token)

            if destroyed
                or not running
                or token ~= generation then
                continue
            end

            if not ok then
                -- Retry inventory/rod detection
                -- instead of disabling the farm.
                status(
                    err or "Searching for rod"
                )

                setPhase("rod_retry")
                continue
            end

            local water, position, distance =
                findWater()

            if not water then
                status("Face nearby water")
                setPhase("searching")
                continue
            end

            waterLabel.Text = string.format(
                "Water: %s | %d studs",
                water.Name,
                distance
            )

            activeCastId = nil

            setPhase("casting")
            status("Casting...")

            casts += 1
            updateStats()

            local sent = pcall(function()
                FishingCast:FireServer(
                    water,
                    position
                )
            end)

            if not sent then
                failures += 1
                updateStats()

                cancelCast()
                setPhase("finishing")
            end

        elseif phase == "rod_retry" then
            if os.clock() - phaseTime >= 3 then
                setPhase("idle")
            end

        elseif phase == "searching" then
            if os.clock() - phaseTime >= 1 then
                setPhase("idle")
            end

        elseif phase == "casting" then
            if os.clock() - phaseTime
                > CAST_TIMEOUT then

                failures += 1
                updateStats()

                cancelCast()
                setPhase("finishing")
            end

        elseif phase == "waiting" then
            if os.clock() - phaseTime
                > BITE_TIMEOUT then

                failures += 1
                updateStats()

                cancelCast()
                setPhase("finishing")
            end

        elseif phase == "reeling" then
            updateReeling()

            if os.clock() - phaseTime
                > REEL_TIMEOUT then

                failures += 1
                updateStats()

                resetReelTracking()
                cancelCast()

                status(
                    "Reel timeout - retrying"
                )

                setPhase("finishing")
            end

        elseif phase == "finishing" then
            releaseMouse()

            if os.clock() - phaseTime
                >= NEXT_CAST_DELAY then

                resetReelTracking()
                setPhase("idle")

                status(
                    "Starting next cast"
                )
            end
        end

        task.wait(0.04)
    end
end)

