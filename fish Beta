local function cleanup()
    if destroyed then
        return
    end

    stopFishing(nil, true)
    destroyed = true

    for _, connection in ipairs(
        connections
    ) do
        connection:Disconnect()
    end

    gui:Destroy()

    if env.SH_FishingV17Cleanup
        == cleanup then
        env.SH_FishingV17Cleanup = nil
    end
end

close.MouseButton1Click:Connect(cleanup)

env.SH_FishingV17Cleanup = cleanup

