--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function normalize(value)
    return tostring(value or ""):lower()
end

local function getItemId(item)
    if type(item) ~= "table" then
        return nil
    end

    return tonumber(
        item.ItemId
        or item.ItemID
        or item.itemId
        or item.Id
        or item.ID
        or item.id
    )
end

local function getItemName(item)
    if type(item) ~= "table" then
        return nil
    end

    return item.Name
        or item.name
        or item.DisplayName
        or item.displayName
        or item.ItemName
        or item.itemName
end

local function excluded(name)
    name = normalize(name)

    for _, word in ipairs({
        "pickaxe",
        "pickage",
        "shovel",
        "hammer",
        "wrench",
        "sword",
        "axe",
        "drill",
        "basketball"
    }) do
        if name:find(word, 1, true) then
            return true
        end
    end

    return false
end

local function fishingName(name)
    name = normalize(name)

    if excluded(name) then
        return false
    end

    return name:find("fishing rod", 1, true)
        or name:find("fishingrod", 1, true)
        or name:find("fishing pole", 1, true)
        or name:find("fishingpole", 1, true)
end

local function fishingCategory(value)
    value = normalize(value)

    return value == "fishingrod"
        or value == "fishing rod"
        or value == "fishingpole"
        or value == "fishing pole"
end

--------------------------------------------------
-- ITEM DEFINITIONS
--------------------------------------------------

local function indexDefinitions(data, depth, visited)
    if type(data) ~= "table"
        or depth > 5
        or visited[data] then
        return
    end

    visited[data] = true

    for key, value in pairs(data) do
        if type(value) == "table" then
            local id = getItemId(value)
                or tonumber(key)

            if id then
                local name = getItemName(value)

                local category =
                    value.Category
                    or value.Type
                    or value.ItemType

                if not excluded(name)
                    and (
                        fishingName(name)
                        or fishingCategory(category)
                    ) then
                    itemDefinitions[id] = value
                end
            end

            indexDefinitions(
                value,
                depth + 1,
                visited
            )
        end
    end
end

pcall(function()
    local modules = RS:FindFirstChild("Modules")

    local items = modules
        and modules:FindFirstChild("Items")

    if items and items:IsA("ModuleScript") then
        local data = require(items)

        if type(data) == "table" then
            indexDefinitions(data, 0, {})
        end
    end
end)

local function isFishingRod(item, fallbackId)
    if type(item) ~= "table" then
        return false
    end

    local id = getItemId(item) or fallbackId
    local name = getItemName(item)

    if excluded(name) then
        return false
    end

    if fishingName(name)
        or fishingCategory(
            item.Category
            or item.Type
            or item.ItemType
        ) then
        return true
    end

    local definition =
        id and itemDefinitions[id]

    if type(definition) == "table"
        and not excluded(
            getItemName(definition)
        ) then

        return fishingName(
            getItemName(definition)
        ) or fishingCategory(
            definition.Category
            or definition.Type
            or definition.ItemType
        )
    end

    return false
end

--------------------------------------------------
-- BROKEN ITEM DETECTION
--------------------------------------------------

local function isBroken(item)
    if type(item) ~= "table" then
        return false
    end

    if item.Broken == true
        or item.IsBroken == true then
        return true
    end

    local condition = tonumber(
        item.Condition
        or item.Durability
    )

    if condition and condition <= 0 then
        return true
    end

    if normalize(item.Status) == "broken" then
        return true
    end

    for key, value in pairs(
        item.Mutators or {}
    ) do
        if normalize(key) == "broken"
            and value ~= false then
            return true
        end

        if normalize(value) == "broken" then
            return true
        end

        if type(value) == "table" then
            local name = value.Name
                or value.name
                or value.Mutator

            if normalize(name) == "broken" then
                return true
            end
        end
    end

    return false
end

--------------------------------------------------
-- INVENTORY
--------------------------------------------------

local function getInventoryData()
    local ok, data = pcall(function()
        return GetInventory:InvokeServer()
    end)

    if not ok or type(data) ~= "table" then
        return nil
    end

    local inventory =
        data.Inventory
        or data.Items
        or data

    if type(inventory) ~= "table" then
        return nil
    end

    return inventory
end

local function getInventoryItem(inventory, guid)
    if not inventory or not guid then
        return nil
    end

    if inventory[guid] then
        return inventory[guid]
    end

    for key, item in pairs(inventory) do
        if type(item) == "table" then
            local itemGuid =
                item.Guid
                or item.GUID
                or item.UUID
                or key

            if tostring(itemGuid) == tostring(guid) then
                return item
            end
        end
    end

    return nil
end

local function findUsableRods(inventory)
    local rods = {}

    for key, item in pairs(inventory) do
        if type(item) == "table"
            and isFishingRod(
                item,
                getItemId(item)
            )
            and not isBroken(item) then

            local guid =
                item.Guid
                or item.GUID
                or item.UUID
                or key

            if type(guid) == "string" then
                table.insert(rods, {
                    guid = guid,
                    id = getItemId(item),
                    condition = tonumber(
                        item.Condition
                    ) or 0
                })
            end
        end
    end

    table.sort(rods, function(a, b)
        return a.condition > b.condition
    end)

    return rods
end

--------------------------------------------------
-- EQUIPPED ROD
--------------------------------------------------

local function getToolId(tool)
    return tonumber(
        tool:GetAttribute("ItemId")
        or tool:GetAttribute("ItemID")
        or tool:GetAttribute("itemId")
    )
end

local function getToolGuid(tool)
    for _, attribute in ipairs({
        "Guid",
        "GUID",
        "UUID",
        "ItemGuid",
        "ItemGUID"
    }) do
        local value =
            tool:GetAttribute(attribute)

        if type(value) == "string" then
            return value
        end
    end

    return nil
end

local function getEquippedRod()
    local character = player.Character

    if not character then
        return nil
    end

    for _, tool in ipairs(
        character:GetChildren()
    ) do
        if tool:IsA("Tool") then
            local id = getToolId(tool)

            if isFishingRod({
                ItemId = id,
                Name = tool.Name,
                Category =
                    tool:GetAttribute("Category"),
                Type =
                    tool:GetAttribute("Type")
            }, id) then
                return tool, id
            end
        end
    end

    return nil
end

local function equippedRodUsable(
    tool,
    id,
    inventory
)
    if not tool then
        return false
    end

    if tool:GetAttribute("Broken") == true
        or tool:GetAttribute("IsBroken") == true then
        return false
    end

    local condition = tonumber(
        tool:GetAttribute("Condition")
        or tool:GetAttribute("Durability")
    )

    if condition and condition <= 0 then
        return false
    end

    local guid =
        getToolGuid(tool)
        or knownEquippedGuid

    if guid then
        local item =
            getInventoryItem(inventory, guid)

        if item then
            return isFishingRod(item, id)
                and not isBroken(item)
        end

        -- Do not trust another rod with
        -- the same ItemId.
        return false
    end

    -- Without an exact GUID, do not assume
    -- that another matching ItemId means
    -- the equipped rod is usable.
    return false
end

