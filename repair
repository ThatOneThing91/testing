local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Events = ReplicatedStorage:WaitForChild("Events")

local GetPlayerInventory = Events
    :WaitForChild("Inventory")
    :WaitForChild("GetPlayerInventory")

local RepairWithWrench = Events
    :WaitForChild("WrenchShop")
    :WaitForChild("RepairWithWrench")

print("[AUTO REPAIR] Starting...")

--==================================================
-- CHECK FOR BROKEN MUTATOR
--==================================================

local function hasBrokenMutator(value, depth)
    depth = depth or 0

    if depth > 8 then
        return false
    end

    if typeof(value) == "string" then
        return string.lower(value) == "broken"
    end

    if typeof(value) ~= "table" then
        return false
    end

    for key, child in pairs(value) do
        -- Handles formats such as:
        -- Mutators = {"Broken"}
        -- Mutators = {Broken = true}
        -- Mutator = "Broken"

        if typeof(key) == "string"
            and string.lower(key) == "broken"
            and child == true then

            return true
        end

        if hasBrokenMutator(child, depth + 1) then
            return true
        end
    end

    return false
end

--==================================================
-- FIND UUID
--==================================================

local function findUUID(item, fallbackKey)
    if typeof(item) == "table" then
        local possibleFields = {
            "UUID",
            "Uuid",
            "uuid",
            "ID",
            "Id",
            "id",
            "ItemUUID",
            "ItemUuid",
            "itemUUID",
            "UniqueId",
            "UniqueID"
        }

        for _, field in ipairs(possibleFields) do
            local value = item[field]

            if typeof(value) == "string" and #value > 0 then
                return value
            end
        end
    end

    -- Some inventory structures use the UUID as the table key.
    if typeof(fallbackKey) == "string" then
        return fallbackKey
    end

    return nil
end

--==================================================
-- GET INVENTORY
--==================================================

local success, inventory = pcall(function()
    return GetPlayerInventory:InvokeServer()
end)

if not success then
    warn("[AUTO REPAIR] Failed to get inventory:", inventory)
    return
end

if typeof(inventory) ~= "table" then
    warn("[AUTO REPAIR] Inventory response wasn't a table.")
    return
end

--==================================================
-- SCAN + REPAIR
--==================================================

local found = 0
local repaired = 0

local function scan(container)
    if typeof(container) ~= "table" then
        return
    end

    for key, item in pairs(container) do
        if typeof(item) == "table" then

            if hasBrokenMutator(item) then
                local uuid = findUUID(item, key)

                if uuid then
                    found += 1

                    print(
                        "[AUTO REPAIR] Broken item found:",
                        uuid
                    )

                    local repairSuccess, result = pcall(function()
                        return RepairWithWrench:InvokeServer(uuid)
                    end)

                    if repairSuccess then
                        repaired += 1
                        print(
                            "[AUTO REPAIR] Repaired:",
                            uuid,
                            result
                        )
                    else
                        warn(
                            "[AUTO REPAIR] Repair failed:",
                            uuid,
                            result
                        )
                    end

                    -- Don't recursively scan this same item after
                    -- we've already identified it as an inventory item.
                else
                    warn(
                        "[AUTO REPAIR] Found Broken mutator but couldn't find UUID."
                    )
                end
            else
                scan(item)
            end
        end
    end
end

scan(inventory)

print("--------------------------------")
print("[AUTO REPAIR] Broken found:", found)
print("[AUTO REPAIR] Repairs sent:", repaired)
print("[AUTO REPAIR] Finished.")
