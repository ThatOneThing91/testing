            Enum.UserInputType.MouseButton1 then

            pickerDragging = false

        end

    end
)

UserInputService.InputChanged:Connect(
    function(input)

        if pickerDragging
            and input.UserInputType ==
                Enum.UserInputType.MouseMovement then

            local delta =
                input.Position
                - pickerDragStart

            ColorPicker.Position =
                UDim2.new(
                    pickerStartPosition.X.Scale,
                    pickerStartPosition.X.Offset
                        + delta.X,

                    pickerStartPosition.Y.Scale,
                    pickerStartPosition.Y.Offset
                        + delta.Y
                )

        end

    end
)

--//========================================================
--// OPEN / CLOSE PICKER
--//========================================================

ThemeButton.MouseButton1Click:Connect(
    function()

        ColorPicker.Visible =
            not ColorPicker.Visible

    end
)

--//========================================================
--// COMMA HIDE / SHOW
--//========================================================

local HubVisible = true

UserInputService.InputBegan:Connect(
    function(input, processed)

        if processed then
            return
        end

        if input.KeyCode ==
            Enum.KeyCode.Comma then

            HubVisible =
                not HubVisible

            Main.Visible =
                HubVisible

            if not HubVisible then

                ColorPicker.Visible =
                    false

                closeDropdown()

            end
        end
    end
)

