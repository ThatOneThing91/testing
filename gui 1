--==================================================
-- WAIT FOR AUCTION TO START
--==================================================

local function WaitForAuctionStart(runId, timeout)
    local started = false
    local elapsed = 0

    while elapsed < timeout do
        if not Farming or runId ~= FarmingRunId then
            return false
        end

        local container = GetAuctionContainer()

        if container and container.Visible then
            local bidButton = GetBidButton()

            if bidButton then
                started = true
                break
            end
        end

        task.wait(0.1)
        elapsed += 0.1
    end

    return started
end

--==================================================
-- EXACT PAUSE LOGIC
--==================================================

local function PauseAuctionExact()
    local success = pcall(function()
        RequestAuctionPause:FireServer(true)
    end)

    return success
end

local function PauseAuctionWithRetry(runId)
    if not PauseAuction then
        return
    end

    PauseAuctionExact()

    for attempt = 1, 8 do
        if not Farming or runId ~= FarmingRunId then
            break
        end

        task.wait(0.25)

        pcall(function()
            RequestAuctionPause:FireServer(true)
        end)
    end
end

