--//========================================================
--// FIND SELECTED GARAGE
--//========================================================

local function findSelectedGarage()

    if not Garages then
        return nil
    end

    -- First try the exact selected garage name.

    local exact =
        Garages:FindFirstChild(
            SelectedFarm,
            true
        )

    if exact then
        return exact
    end

    -- Search descendants for exact name.

    for _, obj in ipairs(
        Garages:GetDescendants()
    ) do

        if obj.Name == SelectedFarm then
            return obj
        end

    end

    -- Fallback:
    -- only use garages belonging to the selected area.

    for _, obj in ipairs(
        Garages:GetDescendants()
    ) do

        if obj.Name == SelectedFarm then

            local parentText =
                obj:GetFullName()

            if parentText:find(
                SelectedArea,
                1,
                true
            ) then

                return obj

            end
        end
    end

    return nil
end

--//========================================================
--// FIND ENTRY PROMPT
--//========================================================

local function findAuctionPrompt(garage)

    if not garage then
        return nil
    end

    local prompt =
        garage:FindFirstChild(
            "EnterAuction",
            true
        )

    if prompt
        and prompt:IsA(
            "ProximityPrompt"
        ) then

        return prompt
    end

    local EntrySquare =
        garage:FindFirstChild(
            "EntrySquare",
            true
        )

    if EntrySquare then

        prompt =
            EntrySquare:FindFirstChild(
                "EnterAuction",
                true
            )

        if prompt
            and prompt:IsA(
                "ProximityPrompt"
            ) then

            return prompt

        end

        for _, obj in ipairs(
            EntrySquare:GetDescendants()
        ) do

            if obj:IsA(
                "ProximityPrompt"
            )
            and obj.Name ==
                "EnterAuction" then

                return obj

            end
        end
    end

    return nil
end

--//========================================================
--// TELEPORT TO SELECTED FARM
--//========================================================

local function teleportToSelectedFarm()

    local garage =
        findSelectedGarage()

    if not garage then

        notify(
            "Farming",
            "Could not find "
                .. SelectedFarm
        )

        return false
    end

    local EntrySquare =
        garage:FindFirstChild(
            "EntrySquare",
            true
        )

    if not EntrySquare then

        notify(
            "Farming",
            "EntrySquare not found"
        )

        return false
    end

    local destination =
        EntrySquare:FindFirstChild(
            "PromptPart",
            true
        )

    if not destination
        or not destination:IsA(
            "BasePart"
        ) then

        destination =
            EntrySquare:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

    end

    if not destination then

        notify(
            "Farming",
            "Farm destination not found"
        )

        return false
    end

    local character =
        LocalPlayer.Character

    if not character then
        return false
    end

    local hrp =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not hrp then
        return false
    end

    hrp.CFrame =
        destination.CFrame
        + Vector3.new(
            0,
            3,
            0
        )

    notify(
        "Farming",
        "Teleported to "
            .. SelectedFarm
    )

    return true
end

--//========================================================
--// ENTER SELECTED AUCTION
--//========================================================

local function enterSelectedAuction()

    local garage =
        findSelectedGarage()

    if not garage then

        notify(
            "Farming",
            "Could not find "
                .. SelectedFarm
        )

        return false
    end

    local prompt =
        findAuctionPrompt(
            garage
        )

    if not prompt then

        notify(
            "Farming",
            "EnterAuction prompt not found"
        )

        return false
    end

    pcall(function()
        prompt.HoldDuration = 0
    end)

    local fired = false

    pcall(function()

        if fireproximityprompt then

            fireproximityprompt(
                prompt
            )

            fired = true

        end

    end)

    if fired then

        notify(
            "Farming",
            "Entered "
                .. SelectedFarm
        )

        return true
    end

    notify(
        "Farming",
        "Prompt found - executor cannot fire prompt"
    )

    return false
end

--//========================================================
--// BID ONCE
--//========================================================

local function bidOnce()

    local PlayerGui =
        LocalPlayer:FindFirstChild(
            "PlayerGui"
        )

    if not PlayerGui then

        notify(
            "Farming",
            "PlayerGui not found"
        )

        return false
    end

    local UIControllerGui =
        PlayerGui:FindFirstChild(
            "UIControllerGui"
        )

    if not UIControllerGui then

        notify(
            "Farming",
            "Auction UI not found"
        )

        return false
    end

    local AuctionContainer =
        UIControllerGui:FindFirstChild(
            "AuctionBiddingContainer"
        )

    if not AuctionContainer then

        notify(
            "Farming",
            "Auction bidding UI not found"
        )

        return false
    end

    local BidButton =
        AuctionContainer:FindFirstChild(
            "BidButton"
        )

    if not BidButton then

        notify(
            "Farming",
            "Bid button not found"
        )

        return false
    end

    if not BidButton.Visible
        or not BidButton.Active then

        notify(
            "Farming",
            "Bid button isn't active"
        )

        return false
    end

    local success =
        pcall(function()

            BidEvent:FireServer()

        end)

    if success then

        notify(
            "Farming",
            "Bid placed"
        )

        return true
    end

    notify(
        "Farming",
        "Bid failed"
    )

    return false
end

