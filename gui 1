local AutoUnfavoriteEnabled = false
local UnfavoriteRunning = false

local InventoryEvents =
    ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Inventory")

local GetPlayerInventory =
    InventoryEvents:WaitForChild(
        "GetPlayerInventory"
    )

local ToggleFavorite =
    InventoryEvents:WaitForChild(
        "ToggleFavoriteItem"
    )

local function isUUID(value)

    if type(value) ~= "string" then
        return false
    end

    return value:match(
        "^%x%x%x%x%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%-%x%x%x%x%x%x%x%x%x%x%x%x$"
    ) ~= nil
end

local function collectUUIDs(
    tbl,
    output
)

    if type(tbl) ~= "table" then
        return
    end

    for key, value in pairs(tbl) do

        if isUUID(key) then

            table.insert(
                output,
                key
            )

        end

        if isUUID(value) then

            table.insert(
                output,
                value
            )

        end

        if type(value) == "table" then

            collectUUIDs(
                value,
                output
            )

        end

    end
end

local function autoUnfavorite()

    if UnfavoriteRunning then
        return
    end

    UnfavoriteRunning = true

    local success, inventory =
        pcall(function()

            return GetPlayerInventory:
                InvokeServer()

        end)

    if not success
        or type(inventory) ~= "table" then

        notify(
            "Auto Unfavorite",
            "Couldn't get inventory"
        )

        AutoUnfavoriteEnabled = false
        UnfavoriteRunning = false

        return
    end

    local ids = {}

    collectUUIDs(
        inventory,
        ids
    )

    notify(
        "Auto Unfavorite",
        "Found "
            .. #ids
            .. " items"
    )

    local completed = 0

    for _, itemId in ipairs(
        ids
    ) do

        if not AutoUnfavoriteEnabled then
            break
        end

        pcall(function()

            ToggleFavorite:
                InvokeServer(
                    itemId
                )

        end)

        completed += 1

        if completed % 25 == 0 then

            notify(
                "Auto Unfavorite",
                completed
                    .. " / "
                    .. #ids
            )

        end

        task.wait(0.08)

    end

    if AutoUnfavoriteEnabled then

        notify(
            "Auto Unfavorite",
            "DONE - "
                .. completed
                .. " items"
        )

        AutoUnfavoriteEnabled =
            false

    else

        notify(
            "Auto Unfavorite",
            "Stopped at "
                .. completed
        )

    end

    UnfavoriteRunning = false
end

createToggleBar(
