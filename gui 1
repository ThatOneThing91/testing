    Toggle.ZIndex = 5
    Toggle.Parent = Bar

    local ToggleCorner = Instance.new("UICorner")
    ToggleCorner.CornerRadius = UDim.new(0, 7)
    ToggleCorner.Parent = Toggle

    local enabled = false

    local object = {
        Bar = Bar,
        Label = Label,
        Toggle = Toggle,
        Stroke = Stroke,
        Enabled = false
    }

    table.insert(ToggleObjects, object)

    local function setState(state)

        enabled = state
        object.Enabled = state

        if state then

            Toggle.BackgroundColor3 = ThemeColor
            Toggle.Text = "ON"

        else

            Toggle.BackgroundColor3 = OffColor
