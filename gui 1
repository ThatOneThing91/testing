local function PerformBid()
    pcall(function()
        BidEvent:FireServer()
    end)
end

--==================================================
-- WAIT FOR AUCTION COMPLETION
--==================================================
--
-- IMPORTANT:
-- We do NOT use a fixed delay here.
--
-- The auction is considered finished when the
-- AuctionBiddingContainer / BidButton closes.
--
-- This prevents the farmer from moving to another
-- garage while the current auction is still running.
--==================================================

local function WaitForAuctionFinished(runId)
    local sawAuctionUI = false
    local closedCount = 0

    while Farming and runId == FarmingRunId do
        local container = GetAuctionContainer()
        local bidButton = GetBidButton()

        if container and container.Visible then
            sawAuctionUI = true
            closedCount = 0
        end

        if sawAuctionUI then
            local containerVisible = container and container.Visible
            local buttonVisible = bidButton ~= nil

            -- Auction UI has closed.
            if not containerVisible and not buttonVisible then
                closedCount += 1

                -- Require several consecutive closed checks
                -- so a brief UI refresh doesn't count as
                -- completion.
                if closedCount >= 5 then
                    return true
                end
            else
                closedCount = 0
            end
        end

        task.wait(0.1)
    end

    return false
end

--==================================================
-- FARM ONE GARAGE
--==================================================

local function FarmGarage(garageName, runId)
    if not Farming or runId ~= FarmingRunId then
        return false, "stopped"
    end

    Notify("Auction Farmer", "Going to " .. garageName, 2)

    if not TeleportToGarage(garageName) then
        return false, "teleport_failed"
    end

    task.wait(0.75)

    if not Farming or runId ~= FarmingRunId then
        return false, "stopped"
    end

    -- Try to start the auction.
    if not EnterGarage(garageName) then
        return false, "start_failed"
    end

    -- Wait for actual auction UI.
    local started = WaitForAuctionStart(runId, 30)

    if not started then
        -- THIS is the only situation where the
        -- farming loop retries the current garage.
        return false, "start_failed"
    end

    Notify("Auction Farmer", garageName .. " started", 2)

    --==================================================
    -- AUCTION HAS SUCCESSFULLY STARTED
    --==================================================
    -- From this point onward we DO NOT advance to
    -- another garage until the current auction closes.
    --==================================================

    if AutoBid then
        task.wait(0.05)

        if GetBidButton() then
            PerformBid()
        end
    end

    if PauseAuction then
        task.wait(0.05)
        PauseAuctionWithRetry(runId)
    end

    Notify("Auction Farmer", "Waiting for " .. garageName .. " to finish", 2)

    -- Wait for actual completion.
    local finished = WaitForAuctionFinished(runId)

    if finished then
        Notify("Auction Farmer", garageName .. " finished", 2)
        return true, "finished"
    end

    return false, "stopped"
end

--==================================================
-- NEXT GARAGE
--==================================================

local function GetNextGarage()
    local list = AuctionAreas[SelectedArea]

    if not list then
        return nil
    end

    for offset = 0, #list - 1 do
        local index = ((CurrentFarmIndex - 1 + offset) % #list) + 1
        local name = list[index]

        local garage = GetGarageByName(name)

        if garage then
            CurrentFarmIndex = index
            return name
        end
    end

    return nil
end

local function AdvanceGarage()
    local list = AuctionAreas[SelectedArea]

    if not list or #list == 0 then
        return
    end

    CurrentFarmIndex = CurrentFarmIndex + 1

    if CurrentFarmIndex > #list then
        CurrentFarmIndex = 1
    end
end

--==================================================
-- START FARMING
--==================================================

local function StartFarming()
    FarmingRunId += 1

    local runId = FarmingRunId

    task.spawn(function()
        while Farming and runId == FarmingRunId do

            local garageName = GetNextGarage()

            if not garageName then
                Notify(
                    "Auction Farmer",
                    "No auctions found in " .. SelectedArea,
                    3
                )

                task.wait(5)
                continue
            end

            local success, reason = FarmGarage(
                garageName,
                runId
            )

            if not Farming or runId ~= FarmingRunId then
                break
            end

            if success and reason == "finished" then
                -- ONLY NOW advance.
                AdvanceGarage()

                task.wait(0.5)

            elseif reason == "start_failed" then
                -- Auction failed to start.
                -- Stay on the SAME garage and retry it.
                Notify(
                    "Auction Farmer",
                    garageName .. " failed to start - retrying in 5s",
                    3
                )

                task.wait(5)

            else
                break
            end
        end
    end)
end

--==================================================
-- INSTANT UNLOAD
--==================================================

local function ExtractStringValues(object, result)
    if not object then
        return
    end

    if object:IsA("StringValue") then
        table.insert(result, object.Value)
    end

    for _, child in ipairs(object:GetChildren()) do
        ExtractStringValues(child, result)
    end
end

local function DoInstantUnload()
    local vehicleId = LocalPlayer:GetAttribute("EquippedVehicle")

    if not vehicleId then
        return false
    end

    local success, vehicleItems = pcall(function()
        return GetVehicleItems:InvokeServer(vehicleId)
    end)

    if not success or not vehicleItems then
        return false
    end

    local ids = {}

    if typeof(vehicleItems) == "table" then
        for _, item in pairs(vehicleItems) do
            if typeof(item) == "string" then
                table.insert(ids, item)
            elseif typeof(item) == "Instance" then
                ExtractStringValues(item, ids)
            elseif typeof(item) == "table" then
                for _, value in pairs(item) do
                    if typeof(value) == "string" then
                        table.insert(ids, value)
                    end
                end
            end
        end
    end

    if #ids == 0 then
        return false
    end

    local transferSuccess = pcall(function()
        TransferVehicleItemsToInventory:FireServer(ids)
    end)

    return transferSuccess
end

CreateToggle(FarmingPage, "Instant Unload", function(state)
    InstantUnload = state

    if state then
        task.spawn(function()
            while InstantUnload do
                DoInstantUnload()
                task.wait(1)
            end
        end)
    end
end)

