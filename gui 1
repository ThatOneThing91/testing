--// INITIAL COLOR
--//========================================================

do

    local h, s, v =
        Color3.toHSV(
            ThemeColor
        )

    CurrentHue = h
    CurrentSaturation = s
    CurrentValue = v

    updateSVBackground()
    updateSVSelector()
    updateHueSelector()
    updatePickedColor()

end

