local function getTeleportPart(target)

    if not target then
        return nil
    end

    if target:IsA("BasePart") then
        return target
    end

    if target:IsA("Model")
        and target.PrimaryPart then

        return target.PrimaryPart
    end

    return target:FindFirstChildWhichIsA(
        "BasePart",
        true
    )
end

local function teleportToObject(target)

    local part =
        getTeleportPart(target)

    if not part then
        return false
    end

    local character =
        LocalPlayer.Character

    if not character then
        return false
    end

    local hrp =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not hrp then
        return false
    end

    hrp.CFrame =
        part.CFrame
        + Vector3.new(
            0,
            3,
            0
        )

    return true
end

