--// INSTANT AUCTION ENTRY
do
    local hooked = {}

    local function MakeInstant(prompt)
        if prompt:IsA("ProximityPrompt")
            and prompt.Name == "EnterAuction" then

            prompt.HoldDuration = 0

            if not hooked[prompt] then
                hooked[prompt] = true

                prompt:GetPropertyChangedSignal("HoldDuration"):Connect(function()
                    if prompt.Parent then
                        prompt.HoldDuration = 0
                    end
                end)
            end
        end
    end

    createToggleBar("Instant Auction Entry", function(state)
        if state then
            Notify("Auction Entry", "Enabled", 2)

            for _, object in ipairs(workspace:GetDescendants()) do
                MakeInstant(object)
            end
        else
            Notify("Auction Entry", "Disabled", 2)
        end
    end, MainPage)

    workspace.DescendantAdded:Connect(function(object)
        if Features["Instant Auction Entry"] then
            task.defer(function()
                MakeInstant(object)
            end)
        end
    end)
end

