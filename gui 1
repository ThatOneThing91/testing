--==================================================

local function GetGarageByName(name)
    local debris = workspace:FindFirstChild("_Debris")
    local garages = debris and debris:FindFirstChild("Garages")

    if garages then
        local garage = garages:FindFirstChild(name)

        if garage then
            return garage
        end
    end

    -- SAME-AREA FALLBACK ONLY
    local areas = workspace:FindFirstChild("Areas")

    if areas then
        local area = areas:FindFirstChild(SelectedArea)

        if area then
            local found = area:FindFirstChild(name, true)

            if found then
                return found
            end
        end
    end

    return nil
end

local function GetGarageEntry(garage)
    if not garage then
        return nil
    end

    local entry = garage:FindFirstChild("EntrySquare", true)

    if entry then
        local promptPart = entry:FindFirstChild("PromptPart", true)

        if promptPart and promptPart:IsA("BasePart") then
            return promptPart
        end

        if entry:IsA("BasePart") then
            return entry
        end

        local part = entry:FindFirstChildWhichIsA("BasePart", true)

        if part then
            return part
        end
    end

    return garage:FindFirstChildWhichIsA("BasePart", true)
end

local function GetGaragePrompt(garage)
    if not garage then
        return nil
    end

    for _, obj in ipairs(garage:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Name == "EnterAuction" then
            return obj
        end
    end

    return nil
end

local function TeleportToGarage(name)
    local garage = GetGarageByName(name)

    if not garage then
        return false
    end

    local entry = GetGarageEntry(garage)

    if not entry then
        return false
    end

    local character = LocalPlayer.Character

    if not character then
        return false
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")

    if not hrp then
        return false
    end

    hrp.CFrame = entry.CFrame + Vector3.new(0, 3, 0)

    return true
end

local function EnterGarage(name)
    local garage = GetGarageByName(name)

    if not garage then
        return false
    end

    local prompt = GetGaragePrompt(garage)

    if not prompt then
        return false
    end

    pcall(function()
        prompt.HoldDuration = 0
    end)

    if typeof(fireproximityprompt) == "function" then
        local success = pcall(function()
            fireproximityprompt(prompt)
        end)

        if success then
            return true
        end
    end

    return false
end

