local function autoBid()

    while AutoBidEnabled do

        pcall(function()

            local PlayerGui =
                LocalPlayer:FindFirstChild(
                    "PlayerGui"
                )

            if not PlayerGui then
                return
            end

            local UIControllerGui =
                PlayerGui:FindFirstChild(
                    "UIControllerGui"
                )

            if not UIControllerGui then
                return
            end

            local AuctionContainer =
                UIControllerGui:FindFirstChild(
                    "AuctionBiddingContainer"
                )

            if not AuctionContainer then
                return
            end

            local BidButton =
                AuctionContainer:FindFirstChild(
                    "BidButton"
                )

            if not BidButton then
                return
            end

            if BidButton.Visible
                and BidButton.Active then

                BidEvent:FireServer()

                task.wait(0.3)

            end

        end)

        task.wait(0.1)

