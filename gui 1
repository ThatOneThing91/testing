local PoliceAuctionEnabled = false
local PoliceAuctions = {}

local Garages

pcall(function()

    Garages =
        workspace
        :WaitForChild("_Debris")
        :WaitForChild("Garages")

end)

local function checkPoliceGarage(garage)

    if not garage then
        return
    end

    if Garages
        and not garage:IsDescendantOf(
            Garages
        ) then

        return
    end

    if garage:FindFirstChild(
        "PoliceWarning",
        true
    ) then

        PoliceAuctions[
            garage
        ] = true

    end
end

local function scanPoliceAuctions()

    table.clear(
        PoliceAuctions
    )

    if not Garages then
        return
    end

    for _, garage in ipairs(
        Garages:GetChildren()
    ) do

        checkPoliceGarage(
            garage
        )

    end
end

local function teleportToPoliceAuction()

    if not Garages then
        return
    end

    scanPoliceAuctions()

    local selectedGarage

    for garage in pairs(
        PoliceAuctions
    ) do

        if garage
            and garage.Parent ==
                Garages then

            selectedGarage =
                garage

            break

        end
    end

    if not selectedGarage then

        notify(
            "Police Auction",
            "No police auction found"
        )

        return
    end

    local EntrySquare =
        selectedGarage:FindFirstChild(
            "EntrySquare",
            true
        )

    if not EntrySquare then

        notify(
            "Police Auction",
            "EntrySquare not found"
        )

        return
    end

    local PromptPart =
        EntrySquare:FindFirstChild(
            "PromptPart",
            true
        )

    local destination =
        PromptPart

    if not destination
        or not destination:IsA(
            "BasePart"
        ) then

        destination =
            EntrySquare:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

    end

    if not destination then

        notify(
            "Police Auction",
            "Destination not found"
        )

        return
    end

    local character =
        LocalPlayer.Character

    if not character then
        return
    end

    local hrp =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if not hrp then
        return
    end

    hrp.CFrame =
        destination.CFrame
        + Vector3.new(
            0,
            3,
            0
        )

    notify(
        "Police Auction",
        "Teleported to "
            .. selectedGarage.Name
    )
end

if Garages then

    Garages.ChildAdded:Connect(
        function(garage)

            task.wait(0.1)

