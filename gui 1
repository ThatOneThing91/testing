--// FARMING HELPERS

local function GetSelectedGarage()
    local debris = workspace:FindFirstChild("_Debris")

    if debris then
        local garages = debris:FindFirstChild("Garages")

        if garages then
            local direct = garages:FindFirstChild(SelectedFarm)

            if direct then
                return direct
            end
        end
    end

    -- Same-area fallback
    local areas = workspace:FindFirstChild("Areas")

    if areas then
        local area = areas:FindFirstChild(SelectedArea)

        if area then
            local found = area:FindFirstChild(SelectedFarm, true)

            if found then
                return found
            end
        end
    end

    return nil
end

local function GetCharacterRoot()
    local character = LocalPlayer.Character

    if not character then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
end

local function TeleportToFarm()
    local garage = GetSelectedGarage()

    if not garage then
        return false
    end

    local entry = garage:FindFirstChild("EntrySquare", true)

    local target = nil

    if entry then
        target =
            entry:FindFirstChild("PromptPart", true)
            or entry:FindFirstChildWhichIsA("BasePart", true)
    end

    if not target then
        target = garage:FindFirstChildWhichIsA("BasePart", true)
    end

    local hrp = GetCharacterRoot()

    if not target or not hrp then
        return false
    end

    hrp.CFrame = target.CFrame + Vector3.new(0, 3, 0)

    return true
end

local function EnterSelectedAuction()
    local garage = GetSelectedGarage()

    if not garage then
        return false
    end

    local prompt = garage:FindFirstChild("EnterAuction", true)

    if not prompt or not prompt:IsA("ProximityPrompt") then
        return false
    end

    prompt.HoldDuration = 0

    if typeof(fireproximityprompt) == "function" then
        local success = pcall(function()
            fireproximityprompt(prompt)
        end)

        return success
    end

    return false
end

local function GetBidButton()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")

    if not playerGui then
        return nil
    end

    local controller = playerGui:FindFirstChild("UIControllerGui")

    if not controller then
        return nil
    end

    local container =
        controller:FindFirstChild("AuctionBiddingContainer")

    if not container then
        return nil
    end

    local button = container:FindFirstChild("BidButton")

    if not button then
        return nil
    end

    if button.Visible and button.Active then
        return button
    end

    return nil
end

local function WaitForBidButton(runId, timeout)
    local startTime = os.clock()

    while os.clock() - startTime < timeout do
        if not Features["Farming"] then
            return nil
        end

        if FarmingRunId ~= runId then
            return nil
        end

        local button = GetBidButton()

        if button then
            return button
        end

        task.wait(0.1)
    end

    return nil
end

local function BidOnce()
    local bidEvent =
        ReplicatedStorage
        :FindFirstChild("Events")
        and ReplicatedStorage.Events:FindFirstChild("Auction")
        and ReplicatedStorage.Events.Auction:FindFirstChild("Bid")

    if not bidEvent then
        return false
    end

    local button = GetBidButton()

    if not button then
        return false
    end

    local success = pcall(function()
        bidEvent:FireServer()
    end)

    return success
end

local function PauseAuction()
    local events = ReplicatedStorage:FindFirstChild("Events")

    if not events then
        return false
    end

    local auction = events:FindFirstChild("Auction")

    if not auction then
        return false
    end

    local pauseRemote =
        auction:FindFirstChild("RequestAuctionPause")

    if not pauseRemote then
        return false
    end

    local success = pcall(function()
        pauseRemote:FireServer(true)
    end)

    return success
end

local function ResumeAuction()
    local events = ReplicatedStorage:FindFirstChild("Events")

    if not events then
        return false
    end

    local auction = events:FindFirstChild("Auction")

    if not auction then
        return false
    end

    local pauseRemote =
        auction:FindFirstChild("RequestAuctionPause")

    if not pauseRemote then
        return false
    end

    local success = pcall(function()
        pauseRemote:FireServer(false)
    end)

    return success
end

--// AUTOMATIC FARMING
local function StartFarming()
    if FarmingBusy then
        return
    end

    FarmingBusy = true
    FarmingRunId += 1

    local runId = FarmingRunId

    task.spawn(function()

        local function Cancelled()
            return
                not Features["Farming"]
                or FarmingRunId ~= runId
        end

        Notify(
            "Auction Farming",
            "Going to " .. SelectedFarm,
            2
        )

        -- STEP 1: TELEPORT
        if Cancelled() then
            FarmingBusy = false
            return
        end

        local teleported = TeleportToFarm()

        if not teleported then
            Notify(
                "Auction Farming",
                "Could not find " .. SelectedFarm,
                3
            )

            FarmingBusy = false
            return
        end

        task.wait(0.7)

        if Cancelled() then
            FarmingBusy = false
            return
        end

        -- STEP 2: ENTER AUCTION
        Notify(
            "Auction Farming",
            "Entering " .. SelectedFarm,
            2
        )

        local entered = EnterSelectedAuction()

        if not entered then
            Notify(
                "Auction Farming",
                "Could not enter auction",
                3
            )

            FarmingBusy = false
            return
        end

        -- STEP 3: WAIT FOR BID BUTTON
        Notify(
            "Auction Farming",
            "Waiting for bid button...",
            2
        )

        local bidButton = WaitForBidButton(runId, 30)

        if not bidButton or Cancelled() then
            if not Cancelled() then
                Notify(
                    "Auction Farming",
                    "Bid button never appeared",
                    3
                )
            end

            FarmingBusy = false
            return
        end

        -- STEP 4: BID
        Notify(
            "Auction Farming",
            "Bidding...",
            2
        )

        local bidSuccess = BidOnce()

        if not bidSuccess then
            Notify(
                "Auction Farming",
                "Bid failed",
                3
            )

            FarmingBusy = false
            return
        end

        task.wait(0.2)

        if Cancelled() then
            FarmingBusy = false
            return
        end

        -- STEP 5: OPTIONAL PAUSE
        if Features["Pause Auction"] then

            Notify(
                "Auction Farming",
                "Bid successful — pausing auction",
                2
            )

            local paused = PauseAuction()

            if paused then
                Notify(
                    "Auction Farming",
                    "Auction paused",
                    2
                )
            else
                Notify(
                    "Auction Farming",
                    "Could not pause auction",
                    3
                )
            end

        else

            Notify(
                "Auction Farming",
                "Bid successful",
                2
            )

        end

        FarmingBusy = false
    end)
end

