local function SetTheme(color)
    ThemeColor = color

    MainStroke.Color = color
    PickerStroke.Color = color
    WheelCenter.BackgroundColor3 = color

    TitleBar.BackgroundColor3 = color:Lerp(DarkerBackground, 0.55)

    for _, obj in ipairs(Main:GetDescendants()) do
        if obj:IsA("UIStroke") then
            if obj ~= PickerStroke then
                obj.Color = color
            end
        end
    end
end

local function UpdateThemeFromMouse()
    local mouse = UserInputService:GetMouseLocation()

    local center = HueWheel.AbsolutePosition +
        HueWheel.AbsoluteSize / 2

    local delta = mouse - center

    local angle = math.atan2(delta.Y, delta.X)
    local hue = (angle / (math.pi * 2)) % 1

    local distance = math.sqrt(delta.X * delta.X + delta.Y * delta.Y)
    local saturation = math.clamp(distance / 85, 0, 1)

    local color = Color3.fromHSV(hue, saturation, 0.75)

    SetTheme(color)
end

HueWheel.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        ThemeDragging = true
        UpdateThemeFromMouse()
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if ThemeDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        UpdateThemeFromMouse()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        ThemeDragging = false
    end
end)

