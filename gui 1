createToggleBar("Auto Unfavorite", function(state)
    if not state then
        Notify("Auto Unfavorite", "Disabled", 2)
        return
    end

    Notify("Auto Unfavorite", "Starting...", 2)

    task.spawn(function()
        pcall(function()
            local inventoryEvent =
                ReplicatedStorage
                :WaitForChild("Events")
                :WaitForChild("Inventory")
                :WaitForChild("GetPlayerInventory")

            local toggleEvent =
                ReplicatedStorage
                :WaitForChild("Events")
                :WaitForChild("Inventory")
                :WaitForChild("ToggleFavoriteItem")

            local success, inventory = pcall(function()
                return inventoryEvent:InvokeServer()
            end)

            if not success or not inventory then
                Notify("Auto Unfavorite", "Inventory not found", 3)
                return
            end

            local count = 0

            local function scan(data)
                if typeof(data) ~= "table" then
                    return
                end

                for key, value in pairs(data) do
                    if not Features["Auto Unfavorite"] then
                        return
                    end

                    if typeof(value) == "table" then
                        local id =
                            value.Id
                            or value.ID
                            or value.id
                            or value.ItemId
                            or value.itemId

                        local favorite =
                            value.Favorited
                            or value.Favorite
                            or value.IsFavorited
                            or value.isFavorite

                        if id and favorite then
                            pcall(function()
                                toggleEvent:InvokeServer(id)
                            end)

                            count += 1
                            task.wait(0.05)
                        end

                        scan(value)
                    end
                end
            end

            scan(inventory)

            Notify(
                "Auto Unfavorite",
                "Processed " .. tostring(count) .. " items",
                3
            )
        end)
    end)
end, MainPage)

