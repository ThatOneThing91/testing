--// 1. INSTANT UNLOAD
--//========================================================

local InstantUnloadEnabled = false
local UnloadBusy = false

local Vehicles =
    ReplicatedStorage
    :WaitForChild("Events")
    :WaitForChild("Vehicles")

local GetVehicleItems =
    Vehicles:WaitForChild("GetVehicleItems")

local TransferVehicleItems =
    Vehicles:WaitForChild("TransferVehicleItemsToInventory")

local function getMyVehicle(vehicleId)

    for _, obj in ipairs(workspace:GetDescendants()) do

        if obj:IsA("Model") then

            local guid =
                obj:GetAttribute("VehicleGUID")

            if guid == vehicleId then
                return obj
            end

            local guid2 =
                obj:GetAttribute("GUID")

            if guid2 == vehicleId then
                return obj
            end
        end
    end

    return nil
end

local function unloadVehicle()

    if UnloadBusy then
        return
    end

    UnloadBusy = true

    pcall(function()

        local vehicleId =
            LocalPlayer:GetAttribute(
                "EquippedVehicle"
            )

        if not vehicleId then
            return
        end

        local vehicle =
            getMyVehicle(vehicleId)

        if vehicle then

            local seat =
                vehicle:FindFirstChild(
                    "DriveSeat",
                    true
                )
                or vehicle:FindFirstChildWhichIsA(
                    "VehicleSeat",
                    true
                )

            if seat then

                local character =
                    LocalPlayer.Character

                if character then

                    local humanoid =
                        character:FindFirstChildOfClass(
                            "Humanoid"
                        )

                    if humanoid then

                        pcall(function()
                            humanoid.Sit = true
                        end)

                    end
                end
            end
        end

        local items =
            GetVehicleItems:InvokeServer(
                vehicleId
            )

        if type(items) ~= "table" then
            return
        end

        local guids = {}

        local function collect(tbl)

            for key, value in pairs(tbl) do

                if type(key) == "string" then
                    table.insert(guids, key)
                end

                if type(value) == "table" then
                    collect(value)
                end

            end
        end

        collect(items)

        if #guids == 0 then
            return
        end

        TransferVehicleItems:FireServer(
            guids
        )

        if vehicle then

            pcall(function()

                vehicle:SetAttribute(
                    "CargoWeight",
                    0
                )

            end)

        end

    end)

    UnloadBusy = false
end

createToggleBar(
    "Instant Unload",
    function(enabled)

        InstantUnloadEnabled = enabled

        if enabled then

            notify(
                "Instant Unload",
                "Enabled"
            )

            task.spawn(function()

                while InstantUnloadEnabled do

                    unloadVehicle()

                    task.wait(1)

                end

            end)

        else

            notify(
                "Instant Unload",
                "Disabled"
            )

        end

    end,
    MainPage
)

