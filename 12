local function stringify(v,depth)
    depth = depth or 0
    if depth > 3 then return "..." end
    if type(v) ~= "table" then return tostring(v) end
    local parts = {}
    local count = 0
    for k,x in pairs(v) do
        count += 1
        if count > 25 then
            table.insert(parts,"...")
            break
        end
        table.insert(parts,
            tostring(k).."="..stringify(x,depth+1))
    end
    return "{"..table.concat(parts,", ").."}"
end

local function output(message)
    if not alive then return end
    table.insert(logs,tostring(message))
    while #logs > 16 do
        table.remove(logs,1)
    end
    log.Text = table.concat(logs,"\n")
    print("[Auto Grading]",message)
end

local function invoke(name,...)
    local remote = remotes:FindFirstChild(name)
    if not remote then
        output("Missing remote: "..name)
        return false,nil
    end
    local args = table.pack(...)
    local ok,result = pcall(function()
        if remote:IsA("RemoteFunction") then
            return remote:InvokeServer(
                table.unpack(args,1,args.n))
        elseif remote:IsA("RemoteEvent") then
            remote:FireServer(
                table.unpack(args,1,args.n))
            return true
        end
        error("Unsupported remote type")
    end)
    if not ok then
        output(name.." ERROR: "..tostring(result))
    end
    return ok,result
end

