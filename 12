-- FILTER MATCHING

local function getField(item,...)
    if type(item) ~= "table" then return nil end
    for _,key in ipairs({...}) do
        if item[key] ~= nil then return item[key] end
    end
    return nil
end

local function itemMatches(item)
    if type(item) ~= "table" then return false end

    local rarity = tostring(getField(
        item,"Rarity","RarityName","rarity") or "")

    local name = tostring(getField(
        item,"Name","name","DisplayName",
        "ItemName") or ""):lower()

    name = name:gsub("^%s*%b[]%s*","")

    local mutations = getField(
        item,"Mutators","mutators","Mutations")

    local selectedCount =
        countSelected(filter.Rarities) +
        countSelected(filter.Mutators) +
        countSelected(filter.Names)

    if selectedCount == 0 then
        return filter.Mode == "Exclude Selected"
    end

    local match = filter.Rarities[rarity] == true
        or filter.Names[name] == true

    if type(mutations) == "table" then
        for k,v in pairs(mutations) do
            local mutation = type(k) == "number"
                and tostring(v) or tostring(k)
            if filter.Mutators[mutation] and v ~= false then
                match = true
            end
        end
    end

    if filter.Mode == "Grade Selected" then
        return match
    end
    return not match
end

local function itemId(item,key)
    return getField(item,
        "ItemId","ItemID","itemId","itemID",
        "Id","ID","id","UUID","Uuid") or key
end

local function getItems()
    local ok,data = invoke("GetGradableItems")
    if not ok or type(data) ~= "table" then
        return {}
    end

    local items = data.Items or data.items or data
    if type(items) ~= "table" then return {} end

    local result = {}
    for key,item in pairs(items) do
        if type(item) == "table" and itemMatches(item) then
            local id = itemId(item,key)
            if id then
                table.insert(result,{
                    id = id,
                    item = item
                })
            end
        end
    end
    return result
end

local function getSlot(slot)
    local ok,data = invoke("GetSlotState",slot)
    if ok and type(data) == "table" then
        return data
    end
    return nil
end

local function slotStatus(data)
    if not data then return "unknown" end

    local state = data.State or data.Status
        or data.state or data.status

    if type(state) == "string" then
        state = state:lower()
        if state:find("complete")
        or state:find("finished")
        or state:find("ready") then
            return "ready"
        end
        if state:find("empty")
        or state:find("idle") then
            return "empty"
        end
        if state:find("grading")
        or state:find("progress")
        or state:find("active") then
            return "working"
        end
    end

    if data.IsComplete == true
    or data.Completed == true then
        return "ready"
    end

    if data.IsEmpty == true
    or data.Empty == true then
        return "empty"
    end

    return "unknown"
end

local function processSlot(slot)
    if busy[slot] then return end
    busy[slot] = true

    local ok,err = pcall(function()
        local data = getSlot(slot)
        local state = slotStatus(data)

        if state == "ready" then
            output("Slot "..slot.." ready; collecting")

            local success,result = invoke("CollectGrade",slot)
            if not success or result == false then return end

            task.wait(.5)
            if not enabled or not alive then return end

            success,result = invoke("ClaimGradedItem",slot)
            if not success or result == false then return end

            output("Slot "..slot.." claim requested")
            task.wait(.5)

            local after = getSlot(slot)
            if slotStatus(after) == "empty" then
                output("Slot "..slot.." cleared")
            else
                output("Slot "..slot.." not yet confirmed empty")
            end

        elseif state == "empty" then
            local items = getItems()
            for _,entry in ipairs(items) do
                if not enabled or not alive then break end

                local id = tostring(entry.id)
                if not lastAttempts[id]
                or os.clock()-lastAttempts[id] > 12 then
                    lastAttempts[id] = os.clock()

                    -- Provisional StartGrading arguments
                    local success,result = invoke(
                        "StartGrading",
                        slot,
                        entry.id,
                        "Inventory",
                        nil
                    )

                    if success and result ~= false then
                        output("Start requested: slot "..slot..
                            " item "..id)
                        break
                    end
                end
            end
        end
    end)

    if not ok then
        output("Slot "..slot.." error: "..tostring(err))
    end
    busy[slot] = nil
end

